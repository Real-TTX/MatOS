# Normalize line endings: LF everywhere (container-consumed files must be LF),
# CRLF only for PowerShell scripts.
* text=auto eol=lf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.slnx text eol=lf

# Binary assets
*.png binary
*.ico binary
*.webp binary
*.jpg binary
*.jpeg binary
*.woff binary
*.woff2 binary

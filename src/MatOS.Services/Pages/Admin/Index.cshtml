@page
@model MatOS.Services.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Overview";
    ViewData["PageSub"] = "MatOS Services right now: the names, the tunnels, the visitors at the edge and the traffic (written every minute, times in UTC).";
    var tiles = new (string Label, string Value, string? Note, string Href)[]
    {
        ("MatOS installations", AdminFormat.Number(Model.Installations), $"{AdminFormat.Number(Model.DynDnsNames)} DynDNS names · {AdminFormat.Number(Model.Blocked)} blocked", "/admin/Installations"),
        ("Tunnels connected now", AdminFormat.Number(Model.Tunnels), null, "/admin/Tunnels"),
        ("Visitors at the edge now", AdminFormat.Number(Model.Visitors), "Open connections", "/admin/Tunnels"),
        ("Traffic today", AdminFormat.Bytes(Model.Today.Bytes), $"{AdminFormat.Number(Model.Today.Connections)} connections", "/admin/Statistics"),
        ("Registrations this week", AdminFormat.Number(Model.RegisteredThisWeek), "Names still registered", "/admin/Installations?sort=created&dir=desc"),
        ("DNS answers today", AdminFormat.Number(Model.DnsToday.Queries), $"{AdminFormat.Number(Model.DnsToday.Updates)} DynDNS updates", "/admin/Statistics#dns-title"),
    };
    var periodNav = new PeriodNav(Model.Period, "/admin", "traffic");
}
@functions {
    // A name in a list: a link to its page, or plain and marked when no installation holds these numbers now (given back, or its earlier holder).
    private static Microsoft.AspNetCore.Html.IHtmlContent Name(string name, bool givenBack, string href)
    {
        var e = System.Net.WebUtility.HtmlEncode(name);
        return new Microsoft.AspNetCore.Html.HtmlString(givenBack
            ? $"<div class=\"mat-table__name\"><span>{e}</span><span class=\"mat-muted mat-small\">given back</span></div>"
            : $"<div class=\"mat-table__name\"><a href=\"{System.Net.WebUtility.HtmlEncode(href)}\">{e}</a></div>");
    }
}

<div class="mat-stack mat-stack--lg">
    <section class="mat-grid mat-grid--3" aria-label="Numbers">
        @foreach (var tile in tiles)
        {
            <a class="mat-card" href="@tile.Href">
                <div class="mat-card__body mat-stat">
                    <span class="mat-stat__label">@tile.Label</span>
                    <span class="mat-stat__value">@tile.Value</span>
                    @if (tile.Note is not null)
                    {
                        <span class="mat-small mat-muted">@tile.Note</span>
                    }
                </div>
            </a>
        }
    </section>

    <section class="mat-stack mat-stack--sm" aria-labelledby="traffic-title" id="traffic">
        <div class="msv-section-head">
            <h2 class="mat-itemlist__header" id="traffic-title">Traffic</h2>
            <partial name="_Period" model="periodNav" />
        </div>
        <div class="mat-card"><div class="mat-card__body">
            <partial name="_Chart" model="Model.Traffic" />
        </div></div>
    </section>

    <div class="mat-grid mat-grid--2">
        <section class="mat-stack mat-stack--sm" aria-labelledby="top-traffic-title">
            <h2 class="mat-itemlist__header" id="top-traffic-title">Most traffic, @Model.Period.Label</h2>
            @if (Model.TopByTraffic.Count == 0)
            {
                <p class="mat-muted">No installation had traffic in this period.</p>
            }
            else
            {
                <div class="mat-table-wrap">
                    <table class="mat-table">
                        <caption class="mat-sr-only">The installations with the most traffic, @Model.Period.Label</caption>
                        <thead><tr><th scope="col">Name</th><th scope="col" class="mat-num">Traffic</th><th scope="col" class="mat-num mat-hide-sm">Connections</th></tr></thead>
                        <tbody>
                            @foreach (var u in Model.TopByTraffic)
                            {
                                <tr>
                                    <td data-label="Name">@Name(u.Key, u.GivenBack, $"/admin/Installations/Details?name={Uri.EscapeDataString(u.Key)}&period={Model.Period.Key}")</td>
                                    <td data-label="Traffic" class="mat-num">@AdminFormat.Bytes(u.Totals.Bytes)</td>
                                    <td data-label="Connections" class="mat-num mat-hide-sm">@AdminFormat.Number(u.Totals.Connections)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="mat-stack mat-stack--sm" aria-labelledby="top-visitors-title">
            <h2 class="mat-itemlist__header" id="top-visitors-title">Most visitors, @Model.Period.Label</h2>
            @if (Model.TopByVisitors.Count == 0)
            {
                <p class="mat-muted">No installation had visitors in this period.</p>
            }
            else
            {
                <div class="mat-table-wrap">
                    <table class="mat-table">
                        <caption class="mat-sr-only">The installations with the most visitors, @Model.Period.Label</caption>
                        <thead><tr><th scope="col">Name</th><th scope="col" class="mat-num">Visitors</th><th scope="col" class="mat-num mat-hide-sm">Connections</th></tr></thead>
                        <tbody>
                            @foreach (var u in Model.TopByVisitors)
                            {
                                <tr>
                                    <td data-label="Name">@Name(u.Key, u.GivenBack, $"/admin/Installations/Details?name={Uri.EscapeDataString(u.Key)}&period={Model.Period.Key}")</td>
                                    <td data-label="Visitors" class="mat-num">@AdminFormat.Number(u.Totals.Visitors)</td>
                                    <td data-label="Connections" class="mat-num mat-hide-sm">@AdminFormat.Number(u.Totals.Connections)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.Period.Size != MatOS.Services.Usage.BucketSize.Hour)
                {
                    <p class="mat-small mat-muted">Visitors are counted per hour and added up: the same visitor in two hours counts twice.</p>
                }
            }
        </section>
    </div>

    <section class="mat-stack mat-stack--sm" aria-labelledby="dropped-title">
        <h2 class="mat-itemlist__header" id="dropped-title">Tunnels that dropped often, last 24 hours</h2>
        @if (Model.Dropped.Count == 0)
        {
            <p class="mat-muted">No tunnel ended @IndexModel.DroppedAtLeast times or more in the last 24 hours.</p>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <caption class="mat-sr-only">Tunnels that ended @IndexModel.DroppedAtLeast times or more in the last 24 hours</caption>
                    <thead><tr><th scope="col">Name</th><th scope="col" class="mat-num">Ended</th><th scope="col" class="mat-hide-sm">Last</th></tr></thead>
                    <tbody>
                        @foreach (var d in Model.Dropped)
                        {
                            <tr>
                                <td data-label="Name">@Name(d.Name, d.GivenBack, $"/admin/Installations/Details?name={Uri.EscapeDataString(d.Name)}#sessions-title")</td>
                                <td data-label="Ended" class="mat-num">@d.Sessions times</td>
                                <td data-label="Last" class="mat-hide-sm mat-muted mat-nowrap">@AdminFormat.Time(d.Last)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="mat-stack mat-stack--sm" aria-labelledby="latest-title">
        <h2 class="mat-itemlist__header" id="latest-title">Latest registrations</h2>
        @if (Model.Latest.Count == 0)
        {
            <div class="mat-empty">
                <span class="mat-empty__icon"><icon name="server" /></span>
                <div class="mat-empty__title">No names yet</div>
                <p>A name appears here once MatOS or the DynDNS page registers it.</p>
            </div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <caption class="mat-sr-only">Latest registrations</caption>
                    <thead><tr><th scope="col">Name</th><th scope="col">Status</th><th scope="col" class="mat-hide-sm">Kind</th><th scope="col" class="mat-hide-sm">Created</th><th scope="col" class="mat-hide-sm">From</th></tr></thead>
                    <tbody>
                        @foreach (var row in Model.Latest)
                        {
                            <tr>
                                <td data-label="Name"><div class="mat-table__name"><a href="/admin/Installations/Details?name=@row.Instance.Name">@row.Instance.Name</a></div></td>
                                <td data-label="Status"><partial name="_StatusPill" model="row.Status" /></td>
                                <td data-label="Kind" class="mat-hide-sm">@row.Kind</td>
                                <td data-label="Created" class="mat-hide-sm mat-muted mat-nowrap">@AdminFormat.Time(row.Instance.CreateDate)</td>
                                <td data-label="From" class="mat-hide-sm mat-mono">@row.Instance.CreatedFromIp</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@model string
@*
    The <head> of every page: the toolkit MatUi (the copy MatOS.Web keeps, linked into this project), its boot script first so the saved theme
    applies before the first paint, and the few classes of its own (css/services.css). The admin area is nobody's search result (noindex) and
    sends no referrer. A public page (the layout _Public sets ViewData["Public"]) may be found, unless it says NoIndex, and keeps the referrer
    of its own site: with no-referrer a browser sends "Origin: null" on a POST, and the same-origin check of its forms would refuse it.
*@
@{
    var isPublic = ViewData["Public"] is true;
    var noIndex = !isPublic || ViewData["NoIndex"] is true;
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="@Ui.App.Accent" />
    @if (noIndex)
    {
        <meta name="robots" content="noindex, nofollow" />
    }
    <meta name="referrer" content="@(isPublic ? "same-origin" : "no-referrer")" />
    <title>@Model</title>
    <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml" />
    <script src="~/matui/matui.boot.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/matui/matui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/services.css" asp-append-version="true" />
</head>

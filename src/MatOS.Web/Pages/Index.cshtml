@* Hidden template: source of truth for system apps (role-filtered). The desktop
   free-icon field and the Start menu are built from this by desktop.js. *@
<div id="mat-system-apps" hidden>
    @foreach (var app in Model.VisibleApps)
    {
        <button class="mat-app" data-key="@app.Key" data-title="@app.Title" data-url="@app.Url" data-w="1040" data-h="680">
            <span class="mat-app-icon sys">@Html.Raw(Icon(app.Icon))</span>
            <span class="mat-app-label">@app.Title</span>
        </button>
    }
</div>

@* Free-placement desktop icon field (drag to arrange; positions persist per user). *@
<div id="mat-desktop-icons"></div>

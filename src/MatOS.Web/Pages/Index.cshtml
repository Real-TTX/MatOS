@page
@model IndexModel
@{
    ViewData["Title"] = "matOS";
    Layout = "_DesktopLayout";

    string Icon(string key) => key switch
    {
        "tasks" => "<svg viewBox='0 0 24 24' fill='none' stroke='#fff' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M3 12h4l2 5 4-12 2 7h6'/></svg>",
        "store" => "<svg viewBox='0 0 24 24' fill='none' stroke='#fff' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M3 9 4.5 4h15L21 9'/><path d='M4 9v10a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V9'/><path d='M9 9a3 3 0 0 1-6 0M15 9a3 3 0 0 1-6 0M21 9a3 3 0 0 1-6 0'/></svg>",
        "users" => "<svg viewBox='0 0 24 24' fill='none' stroke='#fff' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><circle cx='9' cy='8' r='3.2'/><path d='M3.5 20a5.5 5.5 0 0 1 11 0'/><path d='M16 5.5a3 3 0 0 1 0 5.8M20.5 20a5 5 0 0 0-4-4.9'/></svg>",
        "settings" => "<svg viewBox='0 0 24 24' fill='none' stroke='#fff' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='3'/><path d='M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-2.9 1.2V21a2 2 0 0 1-4 0v-.1A1.7 1.7 0 0 0 6.6 19l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A1.7 1.7 0 0 0 3 13.4H3a2 2 0 0 1 0-4h.1A1.7 1.7 0 0 0 4.6 6.6L4.5 6.5a2 2 0 1 1 2.8-2.8l.1.1A1.7 1.7 0 0 0 10 3V3a2 2 0 0 1 4 0v.1a1.7 1.7 0 0 0 2.9 1.2l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0 1.2 2.9H21a2 2 0 0 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z'/></svg>",
        _ => "<svg viewBox='0 0 24 24' fill='none' stroke='#fff' stroke-width='1.8'><rect x='4' y='4' width='16' height='16' rx='4'/></svg>"
    };
}

<div class="mat-grid-section-title">System</div>
<div class="mat-grid" id="mat-system-apps">
    @foreach (var app in Model.VisibleApps)
    {
        <button class="mat-app" data-key="@app.Key" data-title="@app.Title" data-url="@app.Url" data-w="1040" data-h="680">
            <span class="mat-app-icon sys">@Html.Raw(Icon(app.Icon))</span>
            <span class="mat-app-label">@app.Title</span>
        </button>
    }
</div>

<section id="mat-container-section" style="display:none">
    <div class="mat-grid-section-title">Containers</div>
    <div class="mat-grid" id="mat-container-apps"></div>
</section>

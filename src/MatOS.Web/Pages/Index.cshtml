@page
@model MatOS.Web.Pages.IndexModel
@using Kind = MatOS.Web.Pages.IndexModel.HomeKind
@{
    ViewData["Title"] = "Home";
    Layout = "_Launcher";
    var isAdmin = User.IsAdmin();
    // While the things off the screen are drawn: the greeting of Today is no heading there (the page has its h1 for a screen reader instead).
    var offScreen = false;

    // The badge on the corner of an app: nothing while it runs; otherwise an icon that tells the state together with its colour.
    string? BadgeIcon(string css) => css switch
    {
        "online" => null,
        "warn" => "alert",
        "offline" => "x",
        "busy" => "refresh",
        _ => "pause",
    };

    // What every thing of the home screen carries for js/os.js: its key in the person's layout, its name (the menu "Show again"), and for a widget its sizes.
    IHtmlContent Home(IndexModel.HomeItem item)
    {
        var html = $" data-home-key=\"{Ui.Encode(item.Key)}\" data-home-name=\"{Ui.Encode(item.Name)}\"";
        if (item.Sizes is { Count: > 1 } sizes)
        {
            html += $" data-sizes=\"{string.Join(' ', sizes)}\" data-size=\"{item.Size}\" data-size-default=\"{item.DefaultSize}\"";
        }

        return new HtmlString(html);
    }

    // An engine as an app: it opens its own window in MatOS (the engines do not allow a frame); its own pages are in its menu (a new tab).
    IHtmlContent EngineApp(IndexModel.EngineTile en)
    {
        var row = en.Row;
        var state = en.Status?.Text ?? "Not installed";
        var badge = en.Status is null ? "plus" : BadgeIcon(en.Status.Css);
        var badgeCss = en.Status is null ? "os-badge" : "os-badge os-badge--" + en.Status.Css;
        var details = row.App is null ? string.Empty : $" data-details=\"/Apps/Details?id={row.App.Id}\"";
        var tab = row.OpenUrl is null ? string.Empty : $" data-tab=\"{Ui.Encode(row.OpenUrl)}\"";
        var icon = string.IsNullOrEmpty(row.Catalog.Icon) ? string.Empty : $"<img src=\"/img/apps/{Ui.Encode(row.Catalog.Icon)}\" alt=\"\" />";
        return new HtmlString(
            $"<a class=\"os-app{(row.App is null ? " os-app--absent" : string.Empty)}\" href=\"{row.Window}\" data-window=\"{row.Window}\"{tab}{details} data-title=\"{Ui.Encode(row.Catalog.Name)}\" data-name=\"{Ui.Encode(row.Catalog.Name.ToLowerInvariant())}\" title=\"{Ui.Encode(row.Catalog.Name)} · {Ui.Encode(state)}\">" +
            $"<span class=\"os-app__icon\"><span class=\"mv-appicon\" aria-hidden=\"true\">{icon}</span>" +
            (badge is null ? string.Empty : $"<span class=\"{badgeCss}\">{Ui.Icon(badge)}</span>") +
            $"</span><span class=\"os-app__label\">{Ui.Encode(row.Catalog.Name)}</span><span class=\"mat-sr-only\">{Ui.Encode(state)}</span></a>");
    }

    // One thing of the home screen, in the way of its kind. The widgets take the size the person chose (IndexModel.SizeCss).
    async Task Item(IndexModel.HomeItem item)
    {
        var size = IndexModel.SizeCss(item.Size);
        switch (item.Kind)
        {
            case Kind.Today:
                <section class="os-widget @size os-today" aria-label="Today" data-widget @Home(item)>
                    <span class="os-today__day" data-os-clock="weekday"></span>
                    <span class="os-today__time" data-os-clock="time">--:--</span>
                    <span class="os-today__sub" data-os-clock="date"></span>
                    @if (offScreen)
                    {
                        <p class="os-today__greet" data-os-greeting="@User.GetDisplayName()">Hello, @User.GetDisplayName()</p>
                    }
                    else
                    {
                        <h1 class="os-today__greet" data-os-greeting="@User.GetDisplayName()">Hello, @User.GetDisplayName()</h1>
                    }
                </section>
                break;

            case Kind.Engines:
                @* The engines at a glance: the programs MatOS runs on. Each row opens its window. *@
                <section class="os-widget @size os-engines" aria-label="Engines" data-widget @Home(item)>
                    <span class="os-widget__head">@Ui.Icon("layers")Engines</span>
                    <div class="os-engines__list">
                        @foreach (var en in Model.Engines)
                        {
                            var css = en.Status?.Css ?? "absent";
                            <a class="os-engine" href="@en.Row.Window" data-window="@en.Row.Window" data-title="@en.Row.Catalog.Name">
                                <app-icon name="@en.Row.Catalog.Name" icon="@en.Row.Catalog.Icon" size="sm" />
                                <span class="os-engine__name">@en.Row.Catalog.Name</span>
                                <span class="os-engine__state os-engine__state--@css">@(en.Status?.Text ?? "Not installed")</span>
                            </a>
                        }
                    </div>
                </section>
                break;

            case Kind.Apps:
                <a class="os-widget @size" href="/Apps" data-window="/Apps" data-title="Apps" data-widget @Home(item)>
                    <span class="os-widget__head">@Ui.Icon("apps")Apps</span>
                    <span class="os-widget__value">@Model.Running<small> / @Model.Tiles.Count</small></span>
                    <span class="os-widget__note">running</span>
                </a>
                break;

            case Kind.Backups:
                <a class="os-widget @size @(Model.BackupNeedsLook ? "os-widget--warn" : "")" href="/Backups" data-window="/Backups" data-title="Backups" data-widget @Home(item)>
                    <span class="os-widget__head">@Ui.Icon("save")Backups</span>
                    <span class="os-widget__value">@(Model.LastBackup is { } last ? Format.Ago(last) : "Never")</span>
                    <span class="os-widget__note">@(Model.LastBackup is null ? "Back up your apps" : Model.BackupNeedsLook ? "Time for a new one" : "The newest one")</span>
                </a>
                break;

            case Kind.Activity:
                <a class="os-widget @size" href="/Jobs" data-window="/Jobs" data-title="Activity" data-widget @Home(item)>
                    <span class="os-widget__head">@Ui.Icon("activity")Activity</span>
                    <span class="os-widget__value">@(Model.ActiveJobs == 0 ? "All quiet" : $"{Model.ActiveJobs} running")</span>
                    <span class="os-widget__note">@(Model.ActiveJobs == 0 ? "Nothing is running" : Model.ActiveJobs == 1 ? "A task is running" : "Tasks are running")</span>
                </a>
                break;

            case Kind.Docker when Model.Engine.Available:
                <div class="os-widget @size" data-widget @Home(item)>
                    <span class="os-widget__head">@Ui.Icon("whale")Docker</span>
                    <span class="os-widget__value">@Model.Engine.ContainersRunning<small> containers</small></span>
                    <span class="os-widget__note">Docker @Model.Engine.Version@(Model.Engine.Load is { } load ? $" · CPU {load.CpuPercent:0} %" : "")</span>
                </div>
                break;

            case Kind.Docker:
                <div class="os-widget @size os-widget--warn" role="alert" data-widget @Home(item)>
                    <span class="os-widget__head">@Ui.Icon("alert")Docker</span>
                    <span class="os-widget__value">Not reachable</span>
                    <span class="os-widget__note">Mount /var/run/docker.sock into the container</span>
                </div>
                break;

            case Kind.Setup:
                <a class="os-widget @size os-widget--warn" href="/Wizard" data-window="/Wizard" data-title="Setup" data-widget @Home(item)>
                    <span class="os-widget__head">@Ui.Icon("sparkles")Setup</span>
                    <span class="os-widget__value">Not set up yet</span>
                    <span class="os-widget__note">Install the engines and give your apps a domain</span>
                </a>
                break;

            case Kind.Start when isAdmin:
                <a class="os-widget @size" href="/Store" data-window="/Store" data-title="Store" data-widget @Home(item)>
                    <span class="os-widget__head">@Ui.Icon("rocket")Get started</span>
                    <span class="os-widget__value">Install an app</span>
                    <span class="os-widget__note">The store has your Mat apps and more</span>
                </a>
                break;

            case Kind.Start:
                <div class="os-widget @size" data-widget @Home(item)>
                    <span class="os-widget__head">@Ui.Icon("apps")No apps yet</span>
                    <span class="os-widget__note">Ask an administrator to install some.</span>
                </div>
                break;

            case Kind.AppWidget:
                await AppWidget(item, (AppWidgetView)item.Data!, size);
                break;

            case Kind.Launcher:
                {
                    @* The app put its own icons on the home screen (contributes.launchers): one per launcher, each with the app's state and the menu of its quick actions. *@
                    var (tile, l) = ((IndexModel.Tile, LauncherTile))item.Data!;
                    var badge = BadgeIcon(tile.Status.Css);
                    var quick = l.Quick.Count == 0 ? null : System.Text.Json.JsonSerializer.Serialize(l.Quick.Select(q => new { label = q.Label, icon = q.Icon, window = q.Window, tab = q.Tab }));
                    <a class="os-app" href="@(l.Tab ?? l.Window)" @(l.Tab is not null ? Html.Raw("target=\"_blank\" rel=\"noopener\"") : null)
                       data-window="@l.Window" data-tab="@l.Tab" data-details="@tile.Details" data-manage="@(isAdmin ? $"/Apps/Manage?id={tile.App.Id}" : null)"
                       data-title="@l.Label" data-name="@($"{l.Label} {tile.App.Name}".ToLowerInvariant())" data-app-key="@l.Key" data-quick="@quick" title="@l.Label · @tile.App.Name · @tile.Status.Text" @Home(item)>
                        <span class="os-app__icon">
                            @if (l.IconUrl is not null)
                            {
                                <span class="mv-appicon" aria-hidden="true"><img src="@l.IconUrl" alt="" loading="lazy" /></span>
                            }
                            else
                            {
                                <app-icon name="@l.Label" icon="@Model.IconOf(tile.App)" />
                            }
                            @if (badge is not null)
                            {
                                <span class="os-badge os-badge--@tile.Status.Css">@Ui.Icon(badge)</span>
                            }
                            else if (l.Badge is { } count)
                            {
                                <span class="os-count">@(count > 99 ? "99+" : count.ToString(System.Globalization.CultureInfo.InvariantCulture))</span>
                            }
                        </span>
                        <span class="os-app__label">@l.Label</span>
                        <span class="mat-sr-only">@tile.App.Name · @tile.Status.Text</span>
                    </a>
                    break;
                }

            case Kind.AppTile:
                {
                    var tile = (IndexModel.Tile)item.Data!;
                    var badge = BadgeIcon(tile.Status.Css);
                    <a class="os-app" href="@(tile.Tab ?? tile.Window)" @(tile.Tab is not null ? Html.Raw("target=\"_blank\" rel=\"noopener\"") : null)
                       data-window="@tile.Window" data-tab="@tile.Tab" data-details="@tile.Details" data-manage="@(isAdmin ? $"/Apps/Manage?id={tile.App.Id}" : null)"
                       data-title="@tile.App.Name" data-name="@tile.App.Name.ToLowerInvariant()" data-app-key="app-@tile.App.Id" title="@tile.App.Name · @tile.Status.Text" @Home(item)>
                        <span class="os-app__icon">
                            <app-icon name="@tile.App.Name" icon="@Model.IconOf(tile.App)" />
                            @if (badge is not null)
                            {
                                <span class="os-badge os-badge--@tile.Status.Css">@Ui.Icon(badge)</span>
                            }
                        </span>
                        <span class="os-app__label">@tile.App.Name</span>
                        <span class="mat-sr-only">@tile.Status.Text</span>
                    </a>
                    break;
                }

            case Kind.SystemApp:
                {
                    var app = (SystemApp)item.Data!;
                    <a class="os-app" href="@app.Href" data-window="@app.Href" data-title="@app.Name" data-name="@app.Name.ToLowerInvariant()" @Home(item)>
                        <span class="os-app__icon">
                            <span class="os-ico @app.Look" aria-hidden="true">@Ui.Icon(app.Icon)</span>
                            @if (app.Count is { } count)
                            {
                                <span class="os-count">@count<span class="mat-sr-only"> @app.CountLabel</span></span>
                            }
                        </span>
                        <span class="os-app__label">@app.Name</span>
                    </a>
                    break;
                }

            case Kind.Folder:
                <button type="button" class="os-app os-folderbtn" data-os-folder="os-folder-system" aria-haspopup="dialog" data-name="system engines @string.Join(' ', Model.Engines.Select(en => en.Row.Catalog.Name.ToLowerInvariant()))" @Home(item)>
                    <span class="os-app__icon os-folderbtn__icon" aria-hidden="true">
                        @foreach (var en in Model.Engines)
                        {
                            <app-icon name="@en.Row.Catalog.Name" icon="@en.Row.Catalog.Icon" size="sm" />
                        }
                    </span>
                    <span class="os-app__label">System</span>
                </button>
                break;
        }
    }

    // The widgets of the apps (contributes.widgets): drawn from their values, the same for every app.
    async Task AppWidget(IndexModel.HomeItem item, AppWidgetView w, string size)
    {
        var css = $"os-widget {size} os-appwidget" + (w.Tone is "warn" or "error" ? " os-widget--warn" : string.Empty);
        if (w.Widget.Kind == "list")
        {
            <section class="@css" aria-label="@w.Widget.Label · @w.App.Name" data-widget @Home(item)>
                <span class="os-widget__head">@Ui.Icon(w.Icon)@w.Widget.Label</span>
                @if (w.Rows.Count == 0)
                {
                    <span class="os-widget__note">Nothing yet</span>
                }
                else
                {
                    <ul class="os-wlist">
                        @foreach (var row in w.Rows)
                        {
                            <li>
                                @if (row.Window is not null)
                                {
                                    <a class="os-wlist__item" href="@row.Window" data-window="@row.Window" data-title="@w.App.Name"><span class="os-wlist__title">@row.Title</span><small class="os-wlist__text">@row.Text</small></a>
                                }
                                else
                                {
                                    <span class="os-wlist__item"><span class="os-wlist__title">@row.Title</span><small class="os-wlist__text">@row.Text</small></span>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>
        }
        else if (w.Window is not null)
        {
            <a class="@css" href="@w.Window" data-window="@w.Window" data-title="@w.App.Name" data-widget @Home(item)>
                <partial name="_AppWidgetBody" model="w" />
            </a>
        }
        else
        {
            <div class="@css" data-widget @Home(item)>
                <partial name="_AppWidgetBody" model="w" />
            </div>
        }
    }
}
@* The home screen of MatOS (layout _Launcher): widgets of glass, the apps as icons on one or more pages, search and dock at the bottom.
   data-window: the page that opens in the window; an installed app opens there too (its target=_blank is for a click without the script and the middle button)
   unless the person chose a new tab in its menu. The person arranges it (js/os.js: drag a thing, its menu, "Edit the home screen"); IndexModel.Pages is their order. *@

@if (Model.TodayHidden)
{
    <h1 class="mat-sr-only">Hello, @User.GetDisplayName()</h1>
}

@* data-autorefresh only when there is a value: Razor writes data-x="" for a null, and the script would reload every 5 seconds. *@
<div class="os-pages" data-os-pages @(Model.RefreshMs is { } refreshMs ? Html.Raw($"data-autorefresh=\"{refreshMs}\"") : null)>
    @for (var p = 0; p < Model.Pages.Count; p++)
    {
        <div class="os-grid os-page" data-page role="group" aria-label="Page @(p + 1) of @Model.Pages.Count">
            @foreach (var item in Model.Pages[p])
            {
                await Item(item);
            }
        </div>
    }
</div>

@* What the person took off the home screen: out of sight, so that the menu "Show again" brings it back at once. *@
<div class="os-hidden" data-os-hidden hidden>
    @{ offScreen = true; }
    @foreach (var item in Model.HiddenItems)
    {
        await Item(item);
    }
</div>

@if (Model.Engines.Count > 0)
{
    @* The folder System: the engines as apps, like a folder of a phone. *@
    <div class="os-folder" id="os-folder-system" role="dialog" aria-label="System" hidden>
        <div class="os-folder__panel">
            <h2 class="os-folder__title">System</h2>
            <div class="os-folder__grid">
                @foreach (var en in Model.Engines)
                {
                    @EngineApp(en)
                }
                <a class="os-app" href="/Settings/Engines" data-window="/Settings/Engines" data-title="Engines" data-name="engines">
                    <span class="os-app__icon"><span class="os-ico os-ico--settings" aria-hidden="true">@Ui.Icon("layers")</span></span>
                    <span class="os-app__label">All engines</span>
                </a>
            </div>
        </div>
    </div>
}

<div class="os-bottom">
    <div class="os-dots" data-os-dots role="tablist" aria-label="Pages of the home screen" hidden></div>
    @* Editing the home screen (a right click, a long press: "Edit the home screen"): the things wiggle, can be dragged by touch too and taken off the screen.
       The bar takes the place of the search meanwhile. *@
    <div class="os-editbar" data-os-editbar hidden>
        <button type="button" class="os-editbar__btn" data-os-addpage>@Ui.Icon("plus")<span>Add a page</span></button>
        <button type="button" class="os-editbar__btn" data-os-showhidden aria-haspopup="menu">@Ui.Icon("eye")<span>Show again</span></button>
        <button type="button" class="os-editbar__btn os-editbar__btn--done" data-os-done>@Ui.Icon("check")<span>Done</span></button>
    </div>
    <label class="os-search">
        @Ui.Icon("search")
        <input type="search" id="home-find" placeholder="Search" data-os-search aria-label="Search apps" autocomplete="off" />
        <kbd aria-hidden="true">/</kbd>
    </label>
    <nav class="os-dock" aria-label="Dock">
        @foreach (var app in Model.Dock)
        {
            <a class="os-dock__app" href="@app.Href" data-window="@app.Href" data-title="@app.Name" aria-label="@app.Name" data-tip="@app.Name">
                <span class="os-ico @app.Look" aria-hidden="true">@Ui.Icon(app.Icon)</span>
            </a>
        }
    </nav>
</div>

@page
@model MatOS.Web.Pages.Tasks.LogModel
@{
    ViewData["Title"] = Model.Name;
    ViewData["PageSub"] = "The last lines of its log, as MatDock reads them; it follows by itself.";
    ViewData["Crumbs"] = Crumbs.Of(("Task Manager", "/Tasks"), (Model.Name, null));
}

<div class="mat-card">
    <div class="mat-card__body mat-stack">
        @* The log follows by itself (js/matos.js, data-live): it waits while the keyboard is in it. *@
        <div id="log-text" data-live="5000">
            <pre class="mat-code mv-log mv-log--tall" tabindex="0" aria-label="Log of @Model.Name">@(Model.Text.Length == 0 ? "The log is empty." : Model.Text)</pre>
        </div>
        <div class="mat-actions">
            <a href="/Tasks@(Model.Node is { } back ? "?node=" + back : string.Empty)" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
            <a href="/Tasks/Log?name=@Uri.EscapeDataString(Model.Name)@(Model.Node is { } node ? "&node=" + node : string.Empty)" class="mat-btn mat-btn--secondary"><icon name="refresh" /><span>Refresh</span></a>
        </div>
    </div>
</div>

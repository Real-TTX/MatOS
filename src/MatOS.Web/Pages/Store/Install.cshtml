@page
@model MatOS.Web.Pages.Store.InstallModel
@using MatOS.Core.Catalog
@*
    The page of an app in the store (css/store.css): a big icon, the name and the line under it, its state and one Install button; then what it is, what it
    gets from MatOS in plain words, and the options folded. The questions of the catalog come up front only when the app cannot do without an answer.
*@
@{
    var app = Model.App!;
    ViewData["Title"] = app.Name;
    ViewData["OwnHead"] = true;
    ViewData["Store"] = true;
    ViewData["Crumbs"] = Crumbs.Of(("Store", "/Store"), (app.Name, null));
    ViewData["Width"] = "narrow";
    var canInstall = AppStates.CanInstall(app.State);
    var open = Model.OpenCopy;
    var busy = open is null && Model.Installed.Count > 0 ? Model.Installed[^1] : null;
    // How far the app is, said once and in plain words (nothing for an integrated one). The catalog's own note speaks of tests and integration: it goes to the technical notes.
    var stateNote = app.State == AppStates.Integrated ? null : StoreWords.State(app.State);
    var technicalNotes = (app.StateNote is { } catalogNote ? app.Notes.Prepend(catalogNote) : app.Notes).ToList();
    var busyLabel = busy?.Lifecycle switch
    {
        MatOS.Core.Entities.AppLifecycle.Installing => "Installing…",
        MatOS.Core.Entities.AppLifecycle.Failed => "The install failed: see why",
        MatOS.Core.Entities.AppLifecycle.Removing => "Being removed…",
        _ => "Show the app",
    };
    var warn = app.State == AppStates.Alpha;
    var noteIcon = warn ? "alert" : app.State == AppStates.Preview ? "clock" : "info";
    // A first copy, or another one of an app (an engine is one part of MatOS and is installed once).
    var installable = canInstall && (Model.Installed.Count == 0 || Model.CanInstallAnother);
    var optionNames = new[] { "Name on the home screen" }.Concat(Model.Optional.Select(v => string.IsNullOrEmpty(v.Label) ? v.Key : v.Label)).ToList();

    async Task InstallButton(bool another)
    {
        if (!canInstall)
        {
            <button type="submit" class="mat-btn mat-btn--secondary mat-btn--lg mv-storepage__install" disabled aria-describedby="install-state"><icon name="clock" /><span>Coming soon</span></button>
        }
        else if (another)
        {
            <button type="submit" class="mat-btn mat-btn--ghost"><icon name="plus" /><span>Install another copy</span></button>
        }
        else
        {
            <button type="submit" class="mat-btn mat-btn--primary mat-btn--lg mv-storepage__install"><icon name="download" /><span>Install</span></button>
        }
    }

    async Task Field(MatOS.Core.Catalog.CatalogVariable variable, bool needed)
    {
        var label = string.IsNullOrEmpty(variable.Label) ? variable.Key : variable.Label;
        <mat-field label="@label" for-id="var-@variable.Key" required="@needed" hint="@(variable.Help ?? (variable.Generate ? "Leave empty to generate one." : null))">
            <input id="var-@variable.Key" name="Values[@variable.Key]"
                   value="@(variable.IsSecret ? "" : Model.Values.GetValueOrDefault(variable.Key) ?? variable.Default)"
                   type="@(variable.IsSecret ? "password" : variable.Type == "number" ? "number" : "text")"
                   class="mat-input"
                   autocomplete="@(variable.IsSecret ? "new-password" : "off")"
                   required="@needed" data-msg-required="Please enter @label." />
        </mat-field>
    }
}

<form method="post" class="mat-form mv-storepage" novalidate>
    <input type="hidden" name="Id" value="@app.Id" />

    <header class="mv-storepage__head">
        <app-icon name="@app.Name" icon="@app.Icon" size="xl" />
        <div class="mv-storepage__title">
            <h1>@app.Name</h1>
            <p class="mv-storepage__tagline">@app.Tagline</p>
            <p class="mv-storepage__meta">
                <span class="mat-pill @AppStatePill.Css(app.State)">@AppStates.Label(app.State)</span>
                <span>@app.Category</span>
                @if (open is not null)
                {
                    <span class="mv-storepage__installed"><icon name="check" /> Installed@(Model.Installed.Count > 1 ? $" ×{Model.Installed.Count}" : "")</span>
                }
            </p>
        </div>
        @if (open is not null || busy is not null || Model.Ask.Count == 0)
        {
            <div class="mv-storepage__get">
                @if (open is not null)
                {
                    <a class="mat-btn mat-btn--primary mat-btn--lg mv-storepage__install" href="/Apps/Open?id=@open.Id"><icon name="external" /><span>Open</span></a>
                    if (installable && Model.Ask.Count == 0)
                    {
                        await InstallButton(another: true);
                    }
                }
                else if (busy is not null)
                {
                    <a class="mat-btn mat-btn--secondary mat-btn--lg mv-storepage__install" href="/Apps/Details?id=@busy.Id"><icon name="info" /><span>@busyLabel</span></a>
                    if (installable && Model.Ask.Count == 0)
                    {
                        await InstallButton(another: true);
                    }
                }
                else
                {
                    await InstallButton(another: false);
                }
            </div>
        }
    </header>

    @if (stateNote is not null)
    {
        <p class="mv-storepage__note @(warn ? "mv-storepage__note--warn" : "")" id="install-state">
            <icon name="@noteIcon" />
            <span>@stateNote</span>
        </p>
    }

    <partial name="_ValidationSummary" />

    @if (Model.Errors.Count > 0)
    {
        <div class="mat-alert mat-alert--danger" role="alert">
            <icon name="x-circle" />
            <div class="mat-alert__body">
                <strong>@app.Name could not be installed.</strong>
                <ul class="mat-alert__list">
                    @foreach (var error in Model.Errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        </div>
    }

    @foreach (var conflict in Model.PortConflicts)
    {
        <div class="mat-alert mat-alert--warning">
            <icon name="alert" />
            <div class="mat-alert__body">Port <strong>@conflict.Port</strong> of this computer is taken by <strong>@conflict.Container</strong>. @app.Name may not start until that one is stopped.</div>
        </div>
    }

    @if (Model.Ask.Count > 0 && installable)
    {
        <section class="mat-card" aria-labelledby="install-ask">
            <div class="mat-card__head"><icon name="edit" /><h2 class="mat-card__title" id="install-ask">Before you install</h2></div>
            <div class="mat-card__body mat-stack">
                <div class="mat-form__grid">
                    @foreach (var variable in Model.Ask)
                    {
                        await Field(variable, needed: true);
                    }
                </div>
                <div class="mat-btn-row mat-btn-row--plain">
                    @{ await InstallButton(another: Model.Installed.Count > 0); }
                </div>
            </div>
        </section>
    }

    <section class="mv-storepage__section" aria-labelledby="store-about">
        <h2 class="mv-storepage__h" id="store-about">About</h2>
        <p class="mv-storepage__text">@app.Description</p>
        @if (!string.IsNullOrEmpty(app.Homepage))
        {
            <p><a href="@app.Homepage" target="_blank" rel="noopener"><icon name="external" /> The project's page</a></p>
        }
    </section>

    @if (Model.Connections.Count > 0)
    {
        <section class="mv-storepage__section" aria-labelledby="store-with">
            <h2 class="mv-storepage__h" id="store-with">With MatOS</h2>
            <ul class="mat-itemlist mat-itemlist--inset mat-itemlist--lines-inset">
                @foreach (var c in Model.Connections)
                {
                    <li class="mat-item mat-item--wrap">
                        <div class="mat-item__main">
                            <span class="mat-item__lead"><span class="mat-item__tile mat-item__tile--accent"><icon name="@c.Icon" /></span></span>
                            <span class="mat-item__body">
                                <span class="mat-item__title">@c.Title</span>
                                <span class="mat-item__text">@c.Text</span>
                            </span>
                        </div>
                    </li>
                }
            </ul>
        </section>
    }

    <div class="mv-storepage__folds">
        @* The notes of the catalog (and its note on the state) speak to someone who knows Docker: folded, with the options, so the page stays plain for everybody else. *@
        @if (technicalNotes.Count > 0)
        {
            <details class="mat-collapse mv-storepage__fold">
                <summary>
                    <span>Technical notes</span>
                    <icon name="chevron-down" class="mat-accordion__chev" />
                </summary>
                <div class="mat-accordion__body">
                    <ul class="mv-storepage__notes">
                        @foreach (var note in technicalNotes)
                        {
                            <li>@note</li>
                        }
                    </ul>
                </div>
            </details>
        }

        @if (installable)
        {
            <details class="mat-collapse mv-storepage__fold mv-storepage__options" open="@(Model.Errors.Count > 0)">
                <summary>
                    <span>More options</span>
                    <span class="mv-storepage__optnames"><span aria-hidden="true">· </span>@string.Join(", ", optionNames)</span>
                    <icon name="chevron-down" class="mat-accordion__chev" />
                </summary>
                <div class="mat-accordion__body">
                    <p class="mat-muted">The defaults are fine: change something only if you want to. You can change it later, too.</p>
                    <div class="mat-form__grid">
                        <mat-field label="Name on the home screen" for-id="install-name" hint="Leave it empty to keep the app's own name.">
                            <input id="install-name" name="Name" value="@Model.Name" class="mat-input" placeholder="@app.Name" />
                        </mat-field>
                        @foreach (var variable in Model.Optional)
                        {
                            await Field(variable, needed: false);
                        }
                    </div>
                </div>
            </details>
        }
    </div>
</form>

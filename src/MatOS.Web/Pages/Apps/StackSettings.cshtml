@page "/apps/stack/{name}"
@model MatOS.Web.Pages.Apps.StackSettingsModel
@{
    ViewData["Title"] = "Stack";
    Layout = "_WindowLayout";
}

<div id="st" data-name="@Model.Name">
    <div class="cs-head">
        <div class="cs-title">
            <span class="cs-icon">🧱</span>
            <div>
                <h1 id="st-name" style="margin:0;font-size:1.15rem">Loading…</h1>
                <div id="st-sub" style="color:var(--mat-text-muted);font-size:0.82rem"></div>
            </div>
            <span id="st-state" class="pill" style="margin-left:0.4rem"></span>
        </div>
        <div class="cs-actions">
            <button class="ui-btn primary" data-sa="start">Start all</button>
            <button class="ui-btn" data-sa="stop">Stop all</button>
            <button class="ui-btn" data-sa="restart">Restart all</button>
        </div>
    </div>

    <div class="card" style="padding:0;overflow:hidden;margin-bottom:1rem">
        <table class="vt" id="st-containers"></table>
    </div>

    <h2 style="font-size:0.95rem;margin:0 0 0.5rem">Volumes</h2>
    <div class="card" style="padding:0;overflow:hidden"><table class="vt" id="st-volumes"></table></div>
</div>

@section Head {
<style>
.cs-head { display:flex; align-items:flex-start; gap:1rem; margin-bottom:1rem; flex-wrap:wrap; }
.cs-title { display:flex; align-items:center; gap:0.6rem; flex:1 1 auto; }
.cs-icon { font-size:1.6rem; } .cs-actions { display:flex; gap:0.4rem; flex-wrap:wrap; }
table.vt { width:100%; border-collapse:collapse; } table.vt th, table.vt td { text-align:left; padding:0.55rem 0.9rem; }
table.vt thead th { color:var(--mat-text-muted); font-size:0.8rem; } table.vt tbody tr { border-top:1px solid var(--mat-border); }
</style>
}

@section Scripts {
<script>
(function(){
  const name=document.getElementById("st").dataset.name;
  const esc=s=>String(s==null?"":s).replace(/[&<>]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c]));
  const fmtBytes=b=>{ if(b==null||b<0)return "—"; const u=["B","KB","MB","GB","TB"];let i=0,n=b;while(n>=1024&&i<u.length-1){n/=1024;i++;}return n.toFixed(n<10&&i>0?1:0)+" "+u[i]; };

  async function stackAction(a){ try{ await fetch(`/api/v1/docker/stacks/${encodeURIComponent(name)}/${a}`,{method:"POST"});}catch(_){ } setTimeout(load,700); }
  async function cAction(id,a){ try{ await fetch(`/api/v1/docker/containers/${id}/${a}`,{method:"POST"});}catch(_){ } setTimeout(load,700); }
  function openContainer(id,cname){ window.parent.postMessage({type:"matos:open",url:"/apps/container/"+encodeURIComponent(id),title:"Container · "+cname,key:"container:"+id},location.origin); }

  document.querySelectorAll("[data-sa]").forEach(b=>b.addEventListener("click",()=>stackAction(b.dataset.sa)));

  async function load(){
    let s; try{ const r=await fetch(`/api/v1/docker/stacks/${encodeURIComponent(name)}`); if(!r.ok)throw 0; s=await r.json(); }
    catch(_){ document.getElementById("st-name").textContent="Stack not found"; return; }
    document.getElementById("st-name").textContent=s.name;
    document.getElementById("st-sub").textContent=(s.standalone?"Standalone container":"Compose stack")+(s.matosManaged?" · managed by matOS":"");
    const st=document.getElementById("st-state"); st.textContent=`${s.running}/${s.total} running`; st.className="pill "+(s.anyRunning?"on":"off");
    document.title="Stack · "+s.name;

    const rows=(s.containers||[]).map(c=>{
      const svc=c.matosManaged?"":"";
      const ports=(c.ports||[]).map(p=>p.publicPort?`${p.publicPort}→${p.privatePort}`:`${p.privatePort}`).join(", ")||"—";
      const ctl=(c.running?`<button class="ui-btn" data-c="${c.id}" data-a="stop">Stop</button><button class="ui-btn" data-c="${c.id}" data-a="restart">Restart</button>`
                          :`<button class="ui-btn primary" data-c="${c.id}" data-a="start">Start</button>`);
      return `<tr>
        <td>${c.running?'<span class="pill on">running</span>':'<span class="pill off">'+esc(c.state)+'</span>'}</td>
        <td><strong>${esc(c.name)}</strong><div class="mono" style="color:var(--mat-text-muted);font-size:0.75rem">${esc(c.image)}</div></td>
        <td class="mono">${esc(ports)}</td>
        <td style="text-align:right;white-space:nowrap">
          ${c.hasWebUi&&c.appUrl?`<button class="ui-btn" data-open="${esc(c.appUrl)}">Open</button>`:""}
          <button class="ui-btn" data-set="${c.id}" data-name="${esc(c.name)}">Settings</button>
          ${ctl}
        </td></tr>`;
    }).join("");
    document.getElementById("st-containers").innerHTML=
      `<thead><tr><th>State</th><th>Container</th><th>Ports</th><th></th></tr></thead><tbody>${rows}</tbody>`;

    // volumes used by this stack's containers
    const names=new Set((s.containers||[]).map(c=>c.name));
    let vhtml=`<thead><tr><th>Volume</th><th>Size</th><th>Used by</th><th></th></tr></thead><tbody>`;
    try{
      const vr=await fetch("/api/v1/docker/volumes"); const vd=await vr.json();
      const vols=(vd.volumes||[]).filter(v=>(v.usedBy||[]).some(u=>names.has(u)));
      vhtml += vols.length?vols.map(v=>`<tr><td class="mono">${esc(v.name)}</td><td>${fmtBytes(v.sizeBytes)}</td>
        <td class="mono" style="color:var(--mat-text-muted)">${(v.usedBy||[]).map(esc).join(", ")}</td>
        <td style="text-align:right"><button class="ui-btn" data-vol="${esc(v.name)}">Browse files</button></td></tr>`).join("")
        :`<tr><td colspan="4" style="padding:1rem;color:var(--mat-text-muted)">No named volumes.</td></tr>`;
    }catch(_){ vhtml+=`<tr><td colspan="4" style="padding:1rem;color:var(--mat-text-muted)">—</td></tr>`; }
    vhtml+="</tbody>";
    const vt=document.getElementById("st-volumes"); vt.innerHTML=vhtml;

    document.querySelectorAll("#st-containers [data-a]").forEach(b=>b.addEventListener("click",()=>cAction(b.dataset.c,b.dataset.a)));
    document.querySelectorAll("#st-containers [data-set]").forEach(b=>b.addEventListener("click",()=>openContainer(b.dataset.set,b.dataset.name)));
    document.querySelectorAll("#st-containers [data-open]").forEach(b=>b.addEventListener("click",()=>window.open(b.dataset.open,"_blank","noopener")));
    vt.querySelectorAll("[data-vol]").forEach(b=>b.addEventListener("click",()=>window.parent.postMessage({type:"matos:open",url:"/apps/files?volume="+encodeURIComponent(b.dataset.vol),title:"Files",key:"files"},location.origin)));
  }
  load(); setInterval(load,5000);
})();
</script>
}

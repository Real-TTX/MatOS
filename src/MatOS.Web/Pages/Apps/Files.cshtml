@page "/apps/files"
@model MatOS.Web.Pages.Apps.FilesModel
@{
    ViewData["Title"] = "Files";
    Layout = "_WindowLayout";
}

<div class="fx" data-volume="@(Model.Volume ?? "")" data-path="@(Model.Path ?? "")">
    <aside class="fx-side">
        <div class="fx-side-head">
            <div style="display:flex;align-items:center;justify-content:space-between">
                <span>Explorer</span>
                <button class="fx-ico-btn" id="fx-newvol-btn" title="New volume" style="width:26px;height:26px;font-size:1rem;line-height:1">＋</button>
            </div>
            <div class="fx-seg" id="fx-treemode">
                <button data-mode="volume" class="active">Volumes</button>
                <button data-mode="stack">Stacks</button>
            </div>
        </div>
        <div class="fx-tree" id="fx-tree"><div class="fx-muted" style="padding:0.6rem">Loading…</div></div>
    </aside>
    <div class="fx-split" id="fx-split" title="Drag to resize"></div>

    <section class="fx-main">
        <div class="fx-bar">
            <button class="fx-ico-btn" id="fx-up" title="Up one level">↑</button>
            <nav class="fx-crumb" id="fx-crumb"></nav>
        </div>
        <div class="fx-ribbon" id="fx-ribbon" hidden>
            <button class="fx-rb" id="fx-newfolder">📁 New folder</button>
            <button class="fx-rb" id="fx-upload">⬆ Upload</button>
            <span class="fx-sep"></span>
            <button class="fx-rb" id="fx-copy" disabled>⧉ Copy</button>
            <button class="fx-rb" id="fx-cut" disabled>✂ Cut</button>
            <button class="fx-rb" id="fx-paste" disabled>📋 Paste</button>
            <span class="fx-sep"></span>
            <button class="fx-rb" id="fx-rename" disabled>✎ Rename</button>
            <button class="fx-rb danger" id="fx-delete" disabled>🗑 Delete</button>
            <span class="spacer" style="flex:1"></span>
            <div class="fx-seg" id="fx-view">
                <button data-view="grid" title="Grid">▦</button>
                <button data-view="list" title="List">≣</button>
                <button data-view="details" class="active" title="Details">☰</button>
            </div>
            <span class="fx-sep"></span>
            <button class="fx-rb" id="fx-export" title="Download whole volume">⤓ Export</button>
            <button class="fx-rb" id="fx-import" title="Import a .tar.gz">⤒ Import</button>
        </div>
        <div class="fx-list" id="fx-list"><div class="fx-muted" style="padding:1.2rem">Select a volume to browse its files.</div></div>
    </section>

    <div class="fx-editor" id="fx-editor" hidden>
        <div class="fx-editor-head">
            <strong id="fx-editor-name" class="mono"></strong>
            <span id="fx-editor-info" class="fx-muted" style="font-size:0.8rem"></span>
            <span style="flex:1"></span>
            <button class="ui-btn primary" id="fx-save">Save</button>
            <button class="ui-btn" id="fx-close">Close</button>
        </div>
        <textarea id="fx-text" spellcheck="false"></textarea>
    </div>

    <div class="fx-viewer" id="fx-viewer" hidden>
        <div class="fx-editor-head">
            <strong id="fx-viewer-name" class="mono"></strong><span style="flex:1"></span>
            <button class="ui-btn" id="fx-viewer-dl">Download</button>
            <button class="ui-btn" id="fx-viewer-close">Close</button>
        </div>
        <div class="fx-viewer-body" id="fx-viewer-body"></div>
    </div>

    <div class="fx-dialog" id="fx-newvol" hidden>
        <div class="fx-dialog-card">
            <h3 style="margin:0 0 0.9rem">New volume</h3>
            <label class="fl"><span>Name</span><input class="ui-input" id="nv-name" placeholder="my-volume" /></label>
            <label class="fl"><span>Type</span>
                <select class="ui-select" id="nv-kind"><option value="local">Local</option><option value="smb">SMB / CIFS (network share)</option></select>
            </label>
            <div id="nv-smb" style="display:none">
                <div class="grid2">
                    <label class="fl"><span>Server</span><input class="ui-input" id="nv-server" placeholder="192.168.1.10" /></label>
                    <label class="fl"><span>Share</span><input class="ui-input" id="nv-share" placeholder="media" /></label>
                    <label class="fl"><span>Username</span><input class="ui-input" id="nv-user" placeholder="(blank = guest)" /></label>
                    <label class="fl"><span>Password</span><input class="ui-input" id="nv-pass" type="password" /></label>
                </div>
                <label class="fl"><span>Extra options <span class="fx-muted">(comma-separated cifs opts)</span></span><input class="ui-input mono" id="nv-opts" placeholder="uid=1000,gid=1000" /></label>
                <div class="fx-muted" style="font-size:0.78rem">Browsing an SMB volume's contents requires a container to mount it; creation/management works either way.</div>
            </div>
            <div style="display:flex;gap:0.5rem;margin-top:1rem"><button class="ui-btn primary" id="nv-create">Create</button><button class="ui-btn" id="nv-cancel">Cancel</button></div>
        </div>
    </div>

    <input type="file" id="fx-file" hidden />
    <input type="file" id="fx-archive" accept=".gz,.tgz,.tar,application/gzip" hidden />
    <iframe id="fx-dl" style="display:none"></iframe>
</div>

@section Head {
<style>
.fx { position:absolute; top:0; left:0; right:0; bottom:0; display:flex; background:var(--mat-bg); }
.fx-side { width:250px; flex:0 0 auto; border-right:1px solid var(--mat-border); overflow:auto; background:rgba(255,255,255,0.02); }
.fx-split { width:6px; flex:0 0 auto; cursor:col-resize; background:transparent; touch-action:none; }
.fx-split:hover, .fx-split.drag { background:var(--mat-accent); }
.fx-side-head { display:flex; flex-direction:column; gap:0.5rem; padding:0.7rem 0.8rem; border-bottom:1px solid var(--mat-border); }
.fx-side-head > span { font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:var(--mat-text-muted); }
.fx-seg { display:inline-flex; background:rgba(255,255,255,0.06); border-radius:8px; padding:2px; }
.fx-seg button { border:none; background:transparent; padding:0.28rem 0.55rem; font:inherit; font-size:0.8rem; border-radius:6px; cursor:pointer; color:var(--mat-text-muted); }
.fx-seg button.active { background:var(--mat-surface); color:var(--mat-text); box-shadow:0 1px 2px rgba(0,0,0,.08); }
.fx-tree { padding:0.3rem; }
.fx-node { }
.fx-row { display:flex; align-items:center; gap:0.25rem; padding:0.3rem 0.4rem; border-radius:7px; cursor:pointer; font-size:0.86rem; white-space:nowrap; }
.fx-row:hover { background:rgba(255,255,255,0.06); }
.fx-row.sel { background:var(--mat-accent); color:#fff; }
.fx-caret { width:15px; text-align:center; color:var(--mat-text-muted); font-size:0.65rem; flex:0 0 auto; }
.fx-row.sel .fx-caret { color:#fff; }
.fx-caret.leaf { visibility:hidden; }
.fx-children { margin-left:0.85rem; display:none; } .fx-node.open > .fx-children { display:block; }
.fx-stackhead { font-size:0.7rem; font-weight:700; color:var(--mat-text-muted); padding:0.5rem 0.4rem 0.2rem; }

.fx-main { flex:1 1 auto; display:flex; flex-direction:column; min-width:0; }
.fx-bar { display:flex; align-items:center; gap:0.5rem; padding:0.5rem 0.8rem; border-bottom:1px solid var(--mat-border); }
.fx-ico-btn { width:30px; height:30px; border:1px solid var(--mat-border); border-radius:8px; background:var(--mat-surface); cursor:pointer; flex:0 0 auto; }
.fx-ico-btn:hover { background:rgba(255,255,255,0.06); }
.fx-crumb { display:flex; align-items:center; gap:0.2rem; font-size:0.9rem; flex-wrap:wrap; min-width:0; }
.fx-crumb a { cursor:pointer; color:var(--mat-accent); padding:0.1rem 0.2rem; border-radius:5px; } .fx-crumb a:hover { background:rgba(139,92,246,0.15); }
.fx-crumb span.sep { color:var(--mat-text-muted); }
.fx-ribbon { display:flex; align-items:center; gap:0.3rem; padding:0.45rem 0.8rem; border-bottom:1px solid var(--mat-border); flex-wrap:wrap; background:rgba(255,255,255,0.02); }
.fx-rb { display:inline-flex; align-items:center; gap:0.3rem; padding:0.35rem 0.6rem; border:1px solid transparent; border-radius:8px; background:transparent; color:var(--mat-text); font:inherit; font-size:0.82rem; cursor:pointer; }
.fx-rb:hover:not(:disabled) { background:rgba(255,255,255,0.06); } .fx-rb:disabled { opacity:0.4; cursor:default; } .fx-rb.danger:hover:not(:disabled){ background:rgba(244,80,107,0.16); color:#ffb3c0; }
.fx-sep { width:1px; align-self:stretch; background:var(--mat-border); margin:0.1rem 0.2rem; }

.fx-list { flex:1 1 auto; overflow:auto; }
/* details view */
table.fx-tbl { width:100%; border-collapse:collapse; }
table.fx-tbl td, table.fx-tbl th { padding:0.45rem 0.9rem; text-align:left; }
table.fx-tbl thead th { font-size:0.76rem; color:var(--mat-text-muted); border-bottom:1px solid var(--mat-border); position:sticky; top:0; background:var(--mat-bg); }
table.fx-tbl tbody tr { border-bottom:1px solid rgba(255,255,255,0.06); cursor:default; }
table.fx-tbl tbody tr:hover { background:rgba(255,255,255,0.05); }
table.fx-tbl tbody tr.sel { background:rgba(139,92,246,0.22); }
.fx-name { display:flex; align-items:center; gap:0.5rem; } .fx-name .i { width:20px; text-align:center; }
/* grid view */
.fx-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(108px,1fr)); gap:0.4rem; padding:0.8rem; }
.fx-tile { display:flex; flex-direction:column; align-items:center; gap:0.4rem; padding:0.7rem 0.4rem; border-radius:10px; cursor:default; border:1px solid transparent; }
.fx-tile:hover { background:rgba(255,255,255,0.06); } .fx-tile.sel { background:rgba(139,92,246,0.22); border-color:rgba(139,92,246,0.5); }
.fx-tile .i { font-size:2rem; } .fx-tile .n { font-size:0.78rem; text-align:center; max-width:96px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
/* list view */
.fx-listv { columns: 2; column-gap:1rem; padding:0.6rem 0.9rem; }
.fx-li { display:flex; align-items:center; gap:0.5rem; padding:0.3rem 0.5rem; border-radius:7px; cursor:default; break-inside:avoid; }
.fx-li:hover { background:rgba(255,255,255,0.06); } .fx-li.sel { background:rgba(139,92,246,0.22); }

.fx-muted { color:var(--mat-text-muted); }
.fx-editor { position:absolute; inset:0; background:var(--mat-bg); display:flex; flex-direction:column; z-index:5; }
.fx-editor[hidden] { display:none; }
.fx-editor-head { display:flex; align-items:center; gap:0.6rem; padding:0.6rem 0.9rem; border-bottom:1px solid var(--mat-border); }
#fx-text { flex:1 1 auto; border:none; outline:none; resize:none; padding:1rem; font-family:ui-monospace,Menlo,Consolas,monospace; font-size:0.85rem; line-height:1.5; background:#0b0f1a; color:#d7def0; }
#fx-ctx { position:fixed; z-index:50; min-width:170px; background:var(--mat-surface); border:1px solid var(--mat-border); border-radius:10px; box-shadow:0 12px 34px rgba(0,0,0,.18); padding:0.3rem; }
#fx-ctx[hidden]{ display:none; }
.fx-ctx-item { display:block; width:100%; text-align:left; padding:0.45rem 0.6rem; border:none; background:transparent; border-radius:7px; cursor:pointer; font:inherit; font-size:0.85rem; color:var(--mat-text); }
.fx-ctx-item:hover { background:rgba(255,255,255,0.06); } .fx-ctx-item.danger { color:#ffb3c0; } .fx-ctx-item:disabled { opacity:0.4; }
.fx-ctx-sep { height:1px; background:var(--mat-border); margin:0.25rem 0.2rem; }
.fx-viewer { position:absolute; inset:0; background:var(--mat-bg); display:flex; flex-direction:column; z-index:6; }
.fx-viewer[hidden]{ display:none; }
.fx-viewer-body { flex:1 1 auto; overflow:auto; display:grid; place-items:center; padding:1rem; background:#0b0f1a; }
.fx-viewer-body img { max-width:100%; max-height:100%; object-fit:contain; }
.fx-viewer-body iframe { width:100%; height:100%; border:0; background:#fff; border-radius:6px; }
.fx-viewer-body video, .fx-viewer-body audio { max-width:100%; max-height:100%; }
.fx-dialog { position:absolute; inset:0; background:rgba(0,0,0,0.55); display:grid; place-items:center; z-index:10; }
.fx-dialog[hidden]{ display:none; }
.fx-dialog-card { width:min(430px,92%); background:var(--mat-surface); border:1px solid var(--mat-border); border-radius:14px; padding:1.2rem; box-shadow:0 24px 60px rgba(0,0,0,.5); }
.fl { display:flex; flex-direction:column; gap:0.3rem; margin-bottom:0.7rem; } .fl > span { font-size:0.82rem; color:var(--mat-text-muted); font-weight:600; }
.grid2 { display:grid; grid-template-columns:1fr 1fr; gap:0 0.7rem; }
</style>
}

@section Scripts {
<script>
(function(){
  const root=document.querySelector(".fx");
  const esc=s=>String(s==null?"":s).replace(/[&<>]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c]));
  const escA=s=>String(s==null?"":s).replace(/"/g,"&quot;");
  const fmtBytes=b=>{ if(b==null||b<0)return ""; const u=["B","KB","MB","GB","TB"];let i=0,n=b;while(n>=1024&&i<u.length-1){n/=1024;i++;}return n.toFixed(n<10&&i>0?1:0)+" "+u[i]; };
  const join=(a,b)=>a?(a+"/"+b):b;
  const parent=p=>{ const i=(p||"").lastIndexOf("/"); return i<0?"":p.slice(0,i); };
  const api=(v,op,q)=>`/api/v1/files/${encodeURIComponent(v)}/${op}`+(q?`?${q}`:"");
  const dl=document.getElementById("fx-dl");
  let cur={volume:null,path:""}, sel=null, clip=null, entries=[];
  let view=localStorage.getItem("fx-view")||"details";
  let treeMode=localStorage.getItem("fx-tree")||"volume";
  let treeData=null;

  function fileIcon(name,isDir){ if(isDir)return "📁"; const e=(name.split(".").pop()||"").toLowerCase();
    if(["png","jpg","jpeg","gif","svg","webp","ico","bmp"].includes(e))return "🖼️";
    if(["zip","gz","tar","tgz","rar","7z"].includes(e))return "🗜️";
    if(["json","xml","yml","yaml","js","ts","css","html","cs","sh","conf","ini","env","md","txt","log"].includes(e))return "📄";
    if(["mp3","wav","ogg","mp4","mkv","mov","webm"].includes(e))return "🎵"; if(["pdf"].includes(e))return "📕"; if(["db","sqlite"].includes(e))return "🗃️"; return "📄"; }

  async function jget(url){ const r=await fetch(url); if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.error||r.status);} return r.json(); }
  async function jpost(url,body){ const r=await fetch(url,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)}); if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.error||e.detail||r.status);} return r.json(); }

  // ---- tree ----
  const treeEl=document.getElementById("fx-tree");
  document.querySelectorAll("#fx-treemode button").forEach(b=>b.addEventListener("click",()=>{
    treeMode=b.dataset.mode; localStorage.setItem("fx-tree",treeMode);
    document.querySelectorAll("#fx-treemode button").forEach(x=>x.classList.toggle("active",x===b)); buildTree();
  }));
  function volNode(volume,path,name,leaf,isVol){
    const node=document.createElement("div"); node.className="fx-node";
    const row=document.createElement("div"); row.className="fx-row"; row.dataset.volume=volume; row.dataset.path=path;
    row.innerHTML=`<span class="fx-caret${leaf?' leaf':''}">▸</span><span class="i">${isVol?"🗄️":"📁"}</span><span>${esc(name)}</span>`;
    const kids=document.createElement("div"); kids.className="fx-children"; node.append(row,kids); let loaded=false;
    row.querySelector(".fx-caret").addEventListener("click",async e=>{ e.stopPropagation();
      if(node.classList.contains("open")){ node.classList.remove("open"); return; } node.classList.add("open");
      if(!loaded){ loaded=true; try{ const d=await jget(api(volume,"list",`path=${encodeURIComponent(path)}`));
        const dirs=d.entries.filter(x=>x.isDir); if(!dirs.length){ kids.innerHTML=`<div class="fx-muted" style="padding:0.2rem 0.5rem;font-size:0.78rem">No subfolders</div>`; }
        for(const en of dirs) kids.appendChild(volNode(volume,join(path,en.name),en.name,false,false));
      }catch(err){ kids.innerHTML=`<div class="fx-muted" style="padding:0.2rem 0.5rem">${esc(err.message)}</div>`; } }
    });
    row.addEventListener("click",()=>openFolder(volume,path));
    if(isVol) row.addEventListener("contextmenu",e=>{ e.preventDefault(); removeVolume(volume); });
    return node;
  }
  async function buildTree(){
    treeEl.innerHTML=`<div class="fx-muted" style="padding:0.6rem">Loading…</div>`;
    try{ if(!treeData){ const [v,s]=await Promise.all([jget("/api/v1/docker/volumes"),jget("/api/v1/docker/stacks").catch(()=>({stacks:[]}))]); treeData={volumes:v.volumes||[],stacks:s.stacks||[]}; } }
    catch(e){ treeEl.innerHTML=`<div class="fx-muted" style="padding:0.6rem">${esc(e.message)}</div>`; return; }
    treeEl.innerHTML="";
    if(treeMode==="volume"){
      for(const v of treeData.volumes) treeEl.appendChild(volNode(v.name,"",`${v.name}  (${fmtBytes(v.sizeBytes)})`,false,true));
      if(!treeData.volumes.length) treeEl.innerHTML=`<div class="fx-muted" style="padding:0.6rem">No volumes.</div>`;
    } else {
      let any=false;
      for(const st of treeData.stacks){
        const names=new Set((st.containers||[]).map(c=>c.name));
        const vols=treeData.volumes.filter(v=>(v.usedBy||[]).some(u=>names.has(u)));
        if(!vols.length) continue; any=true;
        const head=document.createElement("div"); head.className="fx-stackhead"; head.textContent="🧱 "+st.name; treeEl.appendChild(head);
        for(const v of vols) treeEl.appendChild(volNode(v.name,"",`${v.name}  (${fmtBytes(v.sizeBytes)})`,false,true));
      }
      if(!any) treeEl.innerHTML=`<div class="fx-muted" style="padding:0.6rem">No stacks with named volumes.</div>`;
    }
    highlightTree();
  }
  function highlightTree(){ treeEl.querySelectorAll(".fx-row").forEach(r=>r.classList.toggle("sel", r.dataset.volume===cur.volume && r.dataset.path===cur.path)); }

  // ---- main pane ----
  function crumb(){ const el=document.getElementById("fx-crumb"); el.innerHTML="";
    if(!cur.volume){ el.innerHTML=`<span class="fx-muted">No volume selected</span>`; return; }
    const mk=(t,p)=>{ const a=document.createElement("a"); a.textContent=t; a.onclick=()=>openFolder(cur.volume,p); return a; };
    el.appendChild(mk("🗄️ "+cur.volume,"")); let acc="";
    for(const part of cur.path.split("/").filter(Boolean)){ acc=join(acc,part); const s=document.createElement("span"); s.className="sep"; s.textContent="›"; el.append(s,mk(part,acc)); }
  }
  document.getElementById("fx-up").addEventListener("click",()=>{ if(cur.volume) openFolder(cur.volume,parent(cur.path)); });

  async function openFolder(volume,path){
    cur={volume,path:path||""}; sel=null; document.getElementById("fx-editor").hidden=true; document.getElementById("fx-ribbon").hidden=false;
    crumb(); highlightTree(); updateOps();
    const list=document.getElementById("fx-list"); list.innerHTML=`<div class="fx-muted" style="padding:1rem">Loading…</div>`;
    try{ const d=await jget(api(volume,"list",`path=${encodeURIComponent(cur.path)}`)); entries=d.entries; }
    catch(e){ list.innerHTML=`<div class="fx-muted" style="padding:1rem">${esc(e.message)}</div>`; return; }
    renderMain();
  }
  function renderMain(){
    const list=document.getElementById("fx-list");
    if(!entries.length){ list.innerHTML=`<div class="fx-muted" style="padding:1.2rem">Empty folder.</div>`; return; }
    if(view==="details") list.innerHTML=`<table class="fx-tbl"><thead><tr><th>Name</th><th>Size</th><th>Modified</th></tr></thead><tbody>${
      entries.map(en=>`<tr data-name="${escA(en.name)}" data-dir="${en.isDir}"><td><span class="fx-name"><span class="i">${fileIcon(en.name,en.isDir)}</span>${esc(en.name)}</span></td>
        <td class="fx-muted">${en.isDir?"":fmtBytes(en.size)}</td><td class="fx-muted">${(en.modifiedUtc||"").replace("T"," ").replace(/\..*/,"")}</td></tr>`).join("")}</tbody></table>`;
    else if(view==="grid") list.innerHTML=`<div class="fx-grid">${entries.map(en=>`<div class="fx-tile" data-name="${escA(en.name)}" data-dir="${en.isDir}"><div class="i">${fileIcon(en.name,en.isDir)}</div><div class="n">${esc(en.name)}</div></div>`).join("")}</div>`;
    else list.innerHTML=`<div class="fx-listv">${entries.map(en=>`<div class="fx-li" data-name="${escA(en.name)}" data-dir="${en.isDir}"><span class="i">${fileIcon(en.name,en.isDir)}</span><span>${esc(en.name)}</span></div>`).join("")}</div>`;
    list.querySelectorAll("[data-name]").forEach(row=>{
      row.addEventListener("click",()=>select(row));
      row.addEventListener("dblclick",()=>{ const n=row.dataset.name, isDir=row.dataset.dir==="true"; if(isDir) openFolder(cur.volume,join(cur.path,n)); else openFile(join(cur.path,n)); });
      row.addEventListener("contextmenu",async e=>{ e.preventDefault(); select(row);
        let handlers=[];
        if(sel && !sel.isDir){ const parts=sel.name.split("."); const ext=parts.length>1?"."+parts.pop().toLowerCase():"";
          if(ext){ try{ const d=await jget(`/api/v1/store/handlers?ext=${encodeURIComponent(ext)}`); handlers=d.apps||[]; }catch(_){} } }
        showCtx(e.clientX,e.clientY,true,handlers); });
    });
  }
  function select(row){ sel={name:row.dataset.name,isDir:row.dataset.dir==="true",path:join(cur.path,row.dataset.name)}; markSel(); updateOps(); }
  function markSel(){ document.querySelectorAll("#fx-list [data-name]").forEach(r=>r.classList.toggle("sel", sel && r.dataset.name===sel.name)); }

  // ---- open a file with a handler app (spawns an ephemeral container bound to the file) ----
  async function openWith(appId){
    if(!sel || sel.isDir) return;
    const name=sel.name, path=sel.path;
    try{
      const r=await jpost("/api/v1/store/open-with",{appId,volume:cur.volume,path});
      window.parent.postMessage({type:"matos:open", url:r.url, key:"open:"+r.id, title:r.title||("Open — "+name), width:1120, height:760, ephemeralId:r.id}, location.origin);
    }catch(e){ alert("Open with failed: "+e.message); }
  }

  // ---- view toggle ----
  document.querySelectorAll("#fx-view button").forEach(b=>{ b.classList.toggle("active",b.dataset.view===view);
    b.addEventListener("click",()=>{ view=b.dataset.view; localStorage.setItem("fx-view",view); document.querySelectorAll("#fx-view button").forEach(x=>x.classList.toggle("active",x===b)); renderMain(); markSel(); }); });

  // ---- ops ----
  function updateOps(){ const has=!!sel; ["fx-copy","fx-cut","fx-rename","fx-delete"].forEach(id=>document.getElementById(id).disabled=!has); document.getElementById("fx-paste").disabled=!clip; }
  document.getElementById("fx-newfolder").addEventListener("click",async()=>{ const n=prompt("New folder name:"); if(!n)return; try{ await jpost(api(cur.volume,"mkdir"),{path:join(cur.path,n)}); openFolder(cur.volume,cur.path); }catch(e){ alert(e.message); } });
  const fileInput=document.getElementById("fx-file");
  document.getElementById("fx-upload").addEventListener("click",()=>{ if(cur.volume) fileInput.click(); });
  fileInput.addEventListener("change",async()=>{ if(!fileInput.files.length)return; const fd=new FormData(); fd.append("path",cur.path); fd.append("file",fileInput.files[0]);
    try{ const r=await fetch(api(cur.volume,"upload"),{method:"POST",body:fd}); if(!r.ok)throw new Error((await r.json().catch(()=>({}))).error||r.status); openFolder(cur.volume,cur.path); }catch(e){ alert("Upload failed: "+e.message); }finally{ fileInput.value=""; } });
  document.getElementById("fx-copy").addEventListener("click",()=>{ if(sel){ clip={op:"copy",volume:cur.volume,path:sel.path,name:sel.name}; updateOps(); } });
  document.getElementById("fx-cut").addEventListener("click",()=>{ if(sel){ clip={op:"cut",volume:cur.volume,path:sel.path,name:sel.name}; updateOps(); } });
  document.getElementById("fx-paste").addEventListener("click",paste);
  async function paste(){ if(!clip)return; const body={srcVolume:clip.volume,srcPath:clip.path,dstVolume:cur.volume,dstDir:cur.path};
    try{ await jpost("/api/v1/files/"+(clip.op==="cut"?"move":"copy"),body); if(clip.op==="cut")clip=null; updateOps(); openFolder(cur.volume,cur.path); }catch(e){ alert("Paste failed: "+e.message); } }
  document.getElementById("fx-rename").addEventListener("click",doRename);
  async function doRename(){ if(!sel)return; const nn=prompt("Rename to:",sel.name); if(!nn||nn===sel.name)return; try{ await jpost(api(cur.volume,"rename"),{path:sel.path,newName:nn}); openFolder(cur.volume,cur.path); }catch(e){ alert(e.message); } }
  document.getElementById("fx-delete").addEventListener("click",doDelete);
  async function doDelete(){ if(!sel)return; if(!confirm(`Delete "${sel.name}"? This cannot be undone.`))return; try{ await jpost(api(cur.volume,"delete"),{path:sel.path}); openFolder(cur.volume,cur.path); }catch(e){ alert(e.message); } }
  document.getElementById("fx-export").addEventListener("click",()=>{ if(cur.volume) dl.src=api(cur.volume,"export"); });
  const archiveInput=document.getElementById("fx-archive");
  document.getElementById("fx-import").addEventListener("click",()=>{ if(cur.volume && confirm("Import a .tar.gz into '"+cur.volume+"'? Existing files may be overwritten.")) archiveInput.click(); });
  archiveInput.addEventListener("change",async()=>{ if(!archiveInput.files.length)return; const fd=new FormData(); fd.append("file",archiveInput.files[0]);
    try{ const r=await fetch(api(cur.volume,"import"),{method:"POST",body:fd}); if(!r.ok)throw new Error((await r.json().catch(()=>({}))).error||r.status); alert("Import complete."); openFolder(cur.volume,cur.path); }catch(e){ alert("Import failed: "+e.message); }finally{ archiveInput.value=""; } });

  // ---- context menu ----
  const ctx=document.createElement("div"); ctx.id="fx-ctx"; ctx.hidden=true; document.body.appendChild(ctx);
  function hideCtx(){ ctx.hidden=true; }
  function showCtx(x,y,onItem,handlers){
    const openWithItems = (handlers && handlers.length)
      ? [{sep:true}, ...handlers.map(h=>({label:`Open with ${h.name}`, icon:h.icon, fn:()=>openWith(h.id)}))]
      : [];
    const items = onItem ? [
      {label:"Open",fn:()=>{ if(sel.isDir)openFolder(cur.volume,sel.path); else openFile(sel.path); }},
      {label:"Download",fn:()=>{ dl.src=api(cur.volume,"download",`path=${encodeURIComponent(sel.path)}`); },hide:sel.isDir},
      ...openWithItems,
      {sep:true},{label:"Copy",fn:()=>{ clip={op:"copy",volume:cur.volume,path:sel.path,name:sel.name}; updateOps(); }},
      {label:"Cut",fn:()=>{ clip={op:"cut",volume:cur.volume,path:sel.path,name:sel.name}; updateOps(); }},
      {label:"Rename",fn:doRename},{sep:true},{label:"Delete",fn:doDelete,danger:true}
    ] : [
      {label:"Paste",fn:paste,dis:!clip},{label:"New folder",fn:()=>document.getElementById("fx-newfolder").click()},{label:"Upload",fn:()=>document.getElementById("fx-upload").click()}
    ];
    ctx.innerHTML=""; for(const it of items){ if(it.hide)continue; if(it.sep){ const s=document.createElement("div"); s.className="fx-ctx-sep"; ctx.appendChild(s); continue; }
      const b=document.createElement("button"); b.className="fx-ctx-item"+(it.danger?" danger":""); b.textContent=it.label; b.disabled=!!it.dis; b.onclick=()=>{ hideCtx(); it.fn(); }; ctx.appendChild(b); }
    ctx.hidden=false; ctx.style.left=Math.min(x,window.innerWidth-ctx.offsetWidth-8)+"px"; ctx.style.top=Math.min(y,window.innerHeight-ctx.offsetHeight-8)+"px";
  }
  document.addEventListener("click",hideCtx); document.addEventListener("scroll",hideCtx,true);

  // ---- keyboard ----
  document.addEventListener("keydown",e=>{ if(e.target.tagName==="TEXTAREA"||e.target.tagName==="INPUT")return;
    if(e.key==="Delete"&&sel)doDelete(); else if(e.key==="F2"&&sel)doRename();
    else if((e.ctrlKey||e.metaKey)&&e.key==="c"&&sel){ clip={op:"copy",volume:cur.volume,path:sel.path,name:sel.name}; updateOps(); }
    else if((e.ctrlKey||e.metaKey)&&e.key==="x"&&sel){ clip={op:"cut",volume:cur.volume,path:sel.path,name:sel.name}; updateOps(); }
    else if((e.ctrlKey||e.metaKey)&&e.key==="v"&&clip)paste();
    else if(e.key==="Backspace"&&cur.volume){ openFolder(cur.volume,parent(cur.path)); } });

  // ---- viewer (images / pdf / media) ----
  const viewerKind=path=>{ const e=(path.split(".").pop()||"").toLowerCase();
    if(["png","jpg","jpeg","gif","webp","svg","bmp","ico"].includes(e))return "image";
    if(e==="pdf")return "pdf"; if(["mp4","webm"].includes(e))return "video"; if(["mp3","wav","ogg"].includes(e))return "audio"; return null; };
  function showViewer(path,kind){ const url=api(cur.volume,"view",`path=${encodeURIComponent(path)}`); const body=document.getElementById("fx-viewer-body");
    body.innerHTML = kind==="image"?`<img src="${escA(url)}" alt="">` : kind==="pdf"?`<iframe src="${escA(url)}"></iframe>` : kind==="video"?`<video src="${escA(url)}" controls autoplay></video>` : `<audio src="${escA(url)}" controls autoplay></audio>`;
    document.getElementById("fx-viewer-name").textContent=path;
    document.getElementById("fx-viewer-dl").onclick=()=>{ dl.src=api(cur.volume,"download",`path=${encodeURIComponent(path)}`); };
    document.getElementById("fx-viewer").hidden=false; }
  document.getElementById("fx-viewer-close").addEventListener("click",()=>{ document.getElementById("fx-viewer").hidden=true; document.getElementById("fx-viewer-body").innerHTML=""; });

  // ---- editor ----
  let editing=null;
  async function openFile(path){ const vk=viewerKind(path); if(vk){ showViewer(path,vk); return; }
    let d; try{ d=await jget(api(cur.volume,"read",`path=${encodeURIComponent(path)}`)); }catch(e){ alert(e.message); return; }
    if(d.binary){ if(confirm("Binary file. Download instead?")) dl.src=api(cur.volume,"download",`path=${encodeURIComponent(path)}`); return; }
    editing=path; document.getElementById("fx-editor-name").textContent=path; document.getElementById("fx-editor-info").textContent=(d.truncated?"(truncated) ":"")+fmtBytes(d.size);
    document.getElementById("fx-text").value=d.text||""; document.getElementById("fx-editor").hidden=false; }
  document.getElementById("fx-close").addEventListener("click",()=>{ document.getElementById("fx-editor").hidden=true; editing=null; });
  document.getElementById("fx-save").addEventListener("click",async()=>{ if(editing==null)return; try{ await jpost(api(cur.volume,"write"),{path:editing,content:document.getElementById("fx-text").value});
    document.getElementById("fx-editor-info").textContent="Saved ✓"; }catch(e){ alert("Save failed: "+e.message); } });

  // ---- volume management (create local / SMB, remove) ----
  const nv=document.getElementById("fx-newvol");
  document.getElementById("fx-newvol-btn").addEventListener("click",()=>{ nv.hidden=false; });
  document.getElementById("nv-cancel").addEventListener("click",()=>{ nv.hidden=true; });
  document.getElementById("nv-kind").addEventListener("change",e=>{ document.getElementById("nv-smb").style.display=e.target.value==="smb"?"":"none"; });
  document.getElementById("nv-create").addEventListener("click",async()=>{
    const body={ name:document.getElementById("nv-name").value.trim(), kind:document.getElementById("nv-kind").value,
      server:document.getElementById("nv-server").value.trim(), share:document.getElementById("nv-share").value.trim(),
      username:document.getElementById("nv-user").value.trim(), password:document.getElementById("nv-pass").value, options:document.getElementById("nv-opts").value.trim() };
    if(!body.name){ alert("Name is required."); return; }
    try{ const r=await fetch("/api/v1/files/volumes/create",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
      if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.error||e.detail||r.status); }
      nv.hidden=true; document.getElementById("nv-name").value=""; treeData=null; buildTree();
    }catch(e){ alert("Create failed: "+e.message); }
  });
  async function removeVolume(name){
    if(!confirm(`Remove volume "${name}"? Docker refuses if it is in use.`))return;
    try{ const r=await fetch("/api/v1/files/volumes/remove",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({name})});
      if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.detail||e.error||r.status); }
      treeData=null; buildTree();
      if(cur.volume===name){ cur={volume:null,path:""}; document.getElementById("fx-list").innerHTML=`<div class="fx-muted" style="padding:1.2rem">Select a volume.</div>`; document.getElementById("fx-ribbon").hidden=true; document.getElementById("fx-crumb").innerHTML=""; }
    }catch(e){ alert("Remove failed: "+e.message); }
  }

  // empty-area context menu (bound once)
  document.getElementById("fx-list").addEventListener("contextmenu",e=>{ if(cur.volume && !e.target.closest("[data-name]")){ e.preventDefault(); sel=null; markSel(); updateOps(); showCtx(e.clientX,e.clientY,false); } });

  // ---- resizable sidebar ----
  (function(){ const side=document.querySelector(".fx-side"), split=document.getElementById("fx-split"), wrap=document.querySelector(".fx");
    const saved=parseInt(localStorage.getItem("fx-side-w")||"0",10); if(saved) side.style.width=saved+"px";
    let active=false;
    split.addEventListener("pointerdown",e=>{ active=true; split.classList.add("drag"); try{split.setPointerCapture(e.pointerId);}catch(_){} e.preventDefault(); });
    split.addEventListener("pointermove",e=>{ if(!active)return; const r=wrap.getBoundingClientRect(); let w=e.clientX-r.left; w=Math.max(160,Math.min(w,r.width-280)); side.style.width=w+"px"; });
    const end=e=>{ if(active){ active=false; split.classList.remove("drag"); try{split.releasePointerCapture(e.pointerId);}catch(_){} localStorage.setItem("fx-side-w",parseInt(side.style.width)||250); } };
    split.addEventListener("pointerup",end); split.addEventListener("pointercancel",end);
  })();

  // ---- init ----
  buildTree(); if(root.dataset.volume) openFolder(root.dataset.volume,root.dataset.path||"");
})();
</script>
}

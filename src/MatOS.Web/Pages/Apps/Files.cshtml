@page "/apps/files"
@model MatOS.Web.Pages.Apps.FilesModel
@{
    ViewData["Title"] = "Files";
    Layout = "_WindowLayout";
}

<div class="fx" data-volume="@(Model.Volume ?? "")" data-path="@(Model.Path ?? "")">
    <aside class="fx-side">
        <div class="fx-side-head">
            <span>Explorer</span>
            <button class="fx-ico-btn" id="fx-newvol-btn" title="New volume" style="width:26px;height:26px;font-size:1rem;line-height:1">＋</button>
        </div>
        <div class="fx-tree" id="fx-tree"><div class="fx-muted" style="padding:0.6rem">Loading…</div></div>
    </aside>
    <div class="fx-split" id="fx-split" title="Drag to resize"></div>

    <section class="fx-main">
        <div class="fx-tabs" id="fx-tabs"></div>
        <div class="fx-toolbar">
            <div class="fx-tb-nav">
                <button class="fx-tbtn" id="fx-back" title="Back" disabled>‹</button>
                <button class="fx-tbtn" id="fx-fwd" title="Forward" disabled>›</button>
                <button class="fx-tbtn" id="fx-up" title="Enclosing folder">↑</button>
            </div>
            <div class="fx-tb-title" id="fx-tb-title">This PC</div>
            <span class="fx-tb-flex"></span>
            <div class="fx-seg" id="fx-view">
                <button data-view="grid" title="As Icons">▦</button>
                <button data-view="list" title="As List">≣</button>
                <button data-view="details" class="active" title="As Details">☰</button>
            </div>
            <button class="fx-tbtn" id="fx-sort-btn" title="Sort by">⇅</button>
            <label class="fx-search"><input type="search" id="fx-search" placeholder="Search" autocomplete="off" /></label>
            <button class="fx-tbtn" id="fx-action-btn" title="Actions">⋯</button>
        </div>
        @* Legacy action buttons: hidden, kept for their existing wiring — surfaced via the ⋯ menu + right-click. *@
        <div class="fx-ribbon" id="fx-ribbon" hidden>
            <button class="fx-rb" id="fx-newfolder">📁 New folder</button>
            <button class="fx-rb" id="fx-upload">⬆ Upload</button>
            <button class="fx-rb" id="fx-copy" disabled>⧉ Copy</button>
            <button class="fx-rb" id="fx-cut" disabled>✂ Cut</button>
            <button class="fx-rb" id="fx-paste" disabled>📋 Paste</button>
            <button class="fx-rb" id="fx-rename" disabled>✎ Rename</button>
            <button class="fx-rb danger" id="fx-delete" disabled>🗑 Delete</button>
            <button class="fx-rb" id="fx-export" title="Download whole volume">⤓ Export</button>
            <button class="fx-rb" id="fx-import" title="Import a .tar.gz">⤒ Import</button>
        </div>
        <div class="fx-list" id="fx-list"></div>
        <div class="fx-home" id="fx-home-view"></div>
        <div class="fx-statusbar" id="fx-statusbar">
            <nav class="fx-crumb" id="fx-crumb"></nav>
            <span class="fx-tb-flex"></span>
            <span class="fx-status" id="fx-status"></span>
        </div>
    </section>

    <div class="fx-editor" id="fx-editor" hidden>
        <div class="fx-editor-head">
            <strong id="fx-editor-name" class="mono"></strong>
            <span id="fx-editor-info" class="fx-muted" style="font-size:0.8rem"></span>
            <span style="flex:1"></span>
            <button class="ui-btn primary" id="fx-save">Save</button>
            <button class="ui-btn" id="fx-close">Close</button>
        </div>
        <div class="fx-code" id="fx-code">
            <pre class="fx-hl" id="fx-hl" aria-hidden="true"><code></code></pre>
            <textarea id="fx-text" spellcheck="false" autocapitalize="off" autocomplete="off"></textarea>
        </div>
    </div>

    <div class="fx-viewer" id="fx-viewer" hidden>
        <div class="fx-editor-head">
            <strong id="fx-viewer-name" class="mono"></strong><span style="flex:1"></span>
            <button class="ui-btn" id="fx-viewer-dl">Download</button>
            <button class="ui-btn" id="fx-viewer-close">Close</button>
        </div>
        <div class="fx-viewer-body" id="fx-viewer-body"></div>
    </div>

    <div class="fx-dialog" id="fx-newvol" hidden>
        <div class="fx-dialog-card">
            <h3 style="margin:0 0 0.9rem">New volume</h3>
            <label class="fl"><span>Name</span><input class="ui-input" id="nv-name" placeholder="my-volume" /></label>
            <label class="fl"><span>Type</span>
                <select class="ui-select" id="nv-kind"><option value="local">Local</option><option value="smb">SMB / CIFS (network share)</option></select>
            </label>
            <div id="nv-smb" style="display:none">
                <div class="grid2">
                    <label class="fl"><span>Server</span><input class="ui-input" id="nv-server" placeholder="192.168.1.10" /></label>
                    <label class="fl"><span>Share</span><input class="ui-input" id="nv-share" placeholder="media" /></label>
                    <label class="fl"><span>Username</span><input class="ui-input" id="nv-user" placeholder="(blank = guest)" /></label>
                    <label class="fl"><span>Password</span><input class="ui-input" id="nv-pass" type="password" /></label>
                </div>
                <label class="fl"><span>Extra options <span class="fx-muted">(comma-separated cifs opts)</span></span><input class="ui-input mono" id="nv-opts" placeholder="uid=1000,gid=1000" /></label>
                <div class="fx-muted" style="font-size:0.78rem">Browsing an SMB volume's contents requires a container to mount it; creation/management works either way.</div>
            </div>
            <div style="display:flex;gap:0.5rem;margin-top:1rem"><button class="ui-btn primary" id="nv-create">Create</button><button class="ui-btn" id="nv-cancel">Cancel</button></div>
        </div>
    </div>

    <input type="file" id="fx-file" hidden />
    <input type="file" id="fx-archive" accept=".gz,.tgz,.tar,application/gzip" hidden />
    <iframe id="fx-dl" style="display:none"></iframe>
</div>

@section Head {
<style>
.fx { position:absolute; top:0; left:0; right:0; bottom:0; display:flex; background:var(--mat-bg); }
.fx-side { width:250px; flex:0 0 auto; border-right:1px solid var(--mat-border); overflow:auto; background:rgba(255,255,255,0.02); display:flex; flex-direction:column; }
.fx-side > .fx-tree { flex:1 1 auto; }
.fx-side-foot { border-top:1px solid var(--mat-border); padding:0.35rem; display:flex; flex-direction:column; gap:0.15rem; }
.fx-side-link { display:flex; align-items:center; gap:0.5rem; width:100%; text-align:left; padding:0.45rem 0.6rem; border:none; background:transparent; color:var(--mat-text); font:inherit; font-size:0.85rem; border-radius:7px; cursor:pointer; }
.fx-side-link:hover { background:rgba(255,255,255,0.06); }
/* This-PC (home) view */
.fx-home { flex:1 1 auto; overflow-y:auto; padding:1.3rem 1.4rem; display:none; }
.fx-home.active { display:block; }
.fx-home h1 { margin:0 0 0.5rem; font-size:1.3rem; font-weight:700; display:flex; align-items:center; gap:0.6rem; }
.fx-home h2 { margin:1.3rem 0 0.6rem; font-size:0.78rem; color:var(--mat-text-muted); font-weight:700; text-transform:uppercase; letter-spacing:0.06em; }
.fx-vgrid { display:grid; grid-template-columns:repeat(auto-fill,minmax(190px,1fr)); gap:0.9rem; }
.fx-vtile { display:flex; align-items:center; gap:0.9rem; padding:0.9rem 1rem; background:var(--mat-surface); border:1px solid var(--mat-border); border-radius:12px; cursor:pointer; text-align:left; color:var(--mat-text); font:inherit; }
.fx-vtile:hover { background:rgba(255,255,255,0.06); transform:translateY(-1px); transition:transform 0.08s ease, background 0.12s ease; }
.fx-vtile .ico { width:46px; height:46px; border-radius:10px; display:grid; place-items:center; font-size:1.7rem; background:var(--mat-surface-2); border:1px solid var(--mat-border); flex:0 0 auto; }
.fx-vtile .body { min-width:0; flex:1 1 auto; }
.fx-vtile .nm { font-weight:700; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.fx-vtile .sub { color:var(--mat-text-muted); font-size:0.76rem; margin-top:0.15rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.fx-vtile .bar { height:4px; background:rgba(255,255,255,0.08); border-radius:4px; margin-top:0.35rem; overflow:hidden; }
.fx-vtile .bar > span { display:block; height:100%; background:var(--mat-accent); }
.chip-mini { display:inline-block; font-size:0.62rem; font-weight:700; padding:0.02rem 0.35rem; border-radius:999px; background:rgba(52,211,153,0.2); color:#7ff0c4; margin-left:0.3rem; vertical-align:middle; }
.chip-mini.used { background:rgba(139,92,246,0.22); color:#c7b3ff; }
.chip-mini.warn { background:rgba(250,204,21,0.18); color:#fde68a; }
.fx-split { width:6px; flex:0 0 auto; cursor:col-resize; background:transparent; touch-action:none; }
.fx-split:hover, .fx-split.drag { background:var(--mat-accent); }
.fx-side-head { display:flex; align-items:center; justify-content:space-between; gap:0.5rem; padding:0.65rem 0.8rem; border-bottom:1px solid var(--mat-border); }
.fx-side-head > span { font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:var(--mat-text-muted); }
.fx-seg { display:inline-flex; background:rgba(255,255,255,0.06); border-radius:8px; padding:2px; }
.fx-seg button { border:none; background:transparent; padding:0.28rem 0.55rem; font:inherit; font-size:0.8rem; border-radius:6px; cursor:pointer; color:var(--mat-text-muted); }
.fx-seg button.active { background:var(--mat-surface); color:var(--mat-text); box-shadow:0 1px 2px rgba(0,0,0,.08); }
.fx-tree { padding:0.3rem 0.25rem; }
.fx-node { }
/* Accordion group (Dashboard / Volumes / Stacks / Backups) */
.fx-group { margin-bottom:0.15rem; }
.fx-group-head { display:flex; align-items:center; gap:0.35rem; width:100%; padding:0.4rem 0.5rem; border:none; background:transparent; color:var(--mat-text); font:inherit; font-size:0.88rem; font-weight:600; border-radius:8px; cursor:pointer; text-align:left; }
.fx-group-head:hover { background:rgba(255,255,255,0.06); }
.fx-group-head .i { font-size:0.98rem; }
.fx-group-head .lbl { flex:1 1 auto; }
.fx-group-head .fx-caret { width:12px; text-align:center; color:var(--mat-text-muted); font-size:0.7rem; transition:transform 0.12s ease; }
.fx-group-head .fx-caret.leaf { visibility:hidden; }
.fx-group.open > .fx-group-head .fx-caret:not(.leaf) { transform:rotate(90deg); }
.fx-group-body { display:none; padding-left:0.6rem; }
.fx-group.open > .fx-group-body { display:block; }
.fx-subhead { padding:0.35rem 0.4rem 0.15rem; color:var(--mat-text-muted); font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; }
.fx-row { display:flex; align-items:center; gap:0.25rem; padding:0.3rem 0.4rem; border-radius:7px; cursor:pointer; font-size:0.86rem; white-space:nowrap; }
.fx-row:hover { background:rgba(255,255,255,0.06); }
.fx-row.sel { background:var(--mat-accent); color:#fff; box-shadow:0 1px 5px rgba(0,0,0,.22); }
.fx-caret { width:15px; text-align:center; color:var(--mat-text-muted); font-size:0.65rem; flex:0 0 auto; }
.fx-row.sel .fx-caret { color:#fff; }
.fx-caret.leaf { visibility:hidden; }
.fx-children { margin-left:0.85rem; display:none; } .fx-node.open > .fx-children { display:block; }
.fx-stackhead { font-size:0.7rem; font-weight:700; color:var(--mat-text-muted); padding:0.5rem 0.4rem 0.2rem; }

.fx-main { flex:1 1 auto; display:flex; flex-direction:column; min-width:0; }
.fx-tabs { display:flex; align-items:stretch; gap:0.2rem; padding:0.35rem 0.5rem 0; border-bottom:1px solid var(--mat-border); overflow-x:auto; scrollbar-width:thin; }
.fx-tab { display:flex; align-items:center; gap:0.4rem; max-width:200px; padding:0.4rem 0.4rem 0.4rem 0.7rem; border:1px solid var(--mat-border); border-bottom:none; border-radius:9px 9px 0 0; background:var(--mat-surface-2); color:var(--mat-text-muted); cursor:pointer; white-space:nowrap; }
.fx-tab.active { background:var(--mat-surface); color:var(--mat-text); border-color:var(--mat-accent); }
.fx-tab-ico { flex:0 0 auto; }
.fx-tab-lbl { overflow:hidden; text-overflow:ellipsis; font-size:0.85rem; font-weight:600; }
.fx-tab-x { flex:0 0 auto; width:18px; height:18px; display:grid; place-items:center; border:none; background:transparent; color:inherit; border-radius:5px; cursor:pointer; font-size:0.95rem; line-height:1; }
.fx-tab-x:hover { background:var(--mat-surface-3, rgba(255,255,255,0.12)); }
.fx-tab-new { flex:0 0 auto; width:30px; border:none; background:transparent; color:var(--mat-text-muted); cursor:pointer; font-size:1.1rem; border-radius:8px; }
.fx-tab-new:hover { background:var(--mat-surface-2); color:var(--mat-text); }
.fx-ico-btn { width:30px; height:30px; border:1px solid var(--mat-border); border-radius:8px; background:var(--mat-surface); cursor:pointer; flex:0 0 auto; }
.fx-ico-btn:hover { background:rgba(255,255,255,0.06); }
/* macOS-style unified toolbar */
.fx-toolbar { display:flex; align-items:center; gap:0.5rem; padding:0.45rem 0.7rem; border-bottom:1px solid var(--mat-border); background:rgba(255,255,255,0.03); backdrop-filter:blur(18px) saturate(1.2); -webkit-backdrop-filter:blur(18px) saturate(1.2); }
.fx-tb-nav { display:flex; gap:0.15rem; }
.fx-tbtn { min-width:30px; height:30px; padding:0 0.5rem; border:1px solid transparent; border-radius:8px; background:transparent; color:var(--mat-text); font:inherit; font-size:1.05rem; line-height:1; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; }
.fx-tbtn:hover:not(:disabled) { background:rgba(255,255,255,0.08); }
.fx-tbtn:disabled { opacity:0.35; cursor:default; }
.fx-tb-title { font-size:0.92rem; font-weight:700; color:var(--mat-text); max-width:38%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; margin-left:0.25rem; }
.fx-tb-flex { flex:1 1 auto; min-width:0; }
.fx-search { display:inline-flex; align-items:center; gap:0.35rem; background:rgba(255,255,255,0.07); border:1px solid var(--mat-border); border-radius:8px; padding:0 0.55rem; height:30px; width:150px; transition:width 0.15s ease, border-color 0.15s ease; }
.fx-search::before { content:"🔍"; font-size:0.8rem; opacity:0.6; }
.fx-search:focus-within { width:220px; border-color:var(--mat-accent); }
.fx-search input { border:none; outline:none; background:transparent; color:var(--mat-text); font:inherit; font-size:0.85rem; width:100%; }
.fx-search input::-webkit-search-cancel-button { filter:invert(0.6); }
#fx-ribbon { display:none !important; }
/* bottom path bar + status bar */
.fx-statusbar { display:flex; align-items:center; gap:0.5rem; padding:0.3rem 0.75rem; border-top:1px solid var(--mat-border); background:rgba(255,255,255,0.02); min-height:30px; flex:0 0 auto; }
.fx-crumb { display:flex; align-items:center; gap:0.15rem; font-size:0.8rem; min-width:0; overflow:hidden; white-space:nowrap; }
.fx-crumb a { cursor:pointer; color:var(--mat-text-muted); padding:0.1rem 0.28rem; border-radius:5px; } .fx-crumb a:hover { background:rgba(255,255,255,0.08); color:var(--mat-text); }
.fx-crumb a:last-child { color:var(--mat-text); font-weight:600; }
.fx-crumb span.sep { color:var(--mat-text-muted); opacity:0.6; }
.fx-status { color:var(--mat-text-muted); font-size:0.78rem; white-space:nowrap; flex:0 0 auto; }
.fx-sortcaret { font-size:0.6rem; margin-left:0.2rem; color:var(--mat-accent); }
th.fx-sortable { cursor:pointer; user-select:none; } th.fx-sortable:hover { color:var(--mat-text); }

.fx-list { flex:1 1 auto; overflow:auto; }
/* details view */
table.fx-tbl { width:100%; border-collapse:collapse; }
table.fx-tbl td, table.fx-tbl th { padding:0.45rem 0.9rem; text-align:left; }
table.fx-tbl thead th { font-size:0.76rem; color:var(--mat-text-muted); border-bottom:1px solid var(--mat-border); position:sticky; top:0; background:var(--mat-bg); }
table.fx-tbl tbody tr { border-bottom:1px solid rgba(255,255,255,0.06); cursor:default; }
table.fx-tbl tbody tr:hover { background:rgba(255,255,255,0.05); }
table.fx-tbl tbody tr.sel { background:rgba(139,92,246,0.22); }
.fx-name { display:flex; align-items:center; gap:0.5rem; } .fx-name .i { width:20px; text-align:center; }
/* grid view */
.fx-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(108px,1fr)); gap:0.4rem; padding:0.8rem; }
.fx-tile { display:flex; flex-direction:column; align-items:center; gap:0.4rem; padding:0.7rem 0.4rem; border-radius:10px; cursor:default; border:1px solid transparent; }
.fx-tile:hover { background:rgba(255,255,255,0.06); } .fx-tile.sel { background:rgba(139,92,246,0.22); border-color:rgba(139,92,246,0.5); }
.fx-tile .i { font-size:2rem; } .fx-tile .n { font-size:0.78rem; text-align:center; max-width:96px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
/* list view */
.fx-listv { columns: 2; column-gap:1rem; padding:0.6rem 0.9rem; }
.fx-li { display:flex; align-items:center; gap:0.5rem; padding:0.3rem 0.5rem; border-radius:7px; cursor:default; break-inside:avoid; }
.fx-li:hover { background:rgba(255,255,255,0.06); } .fx-li.sel { background:rgba(139,92,246,0.22); }

.fx-muted { color:var(--mat-text-muted); }
.fx-editor { position:absolute; inset:0; background:var(--mat-bg); display:flex; flex-direction:column; z-index:5; }
.fx-editor[hidden] { display:none; }
.fx-editor-head { display:flex; align-items:center; gap:0.6rem; padding:0.6rem 0.9rem; border-bottom:1px solid var(--mat-border); }
/* Code editor: a transparent <textarea> overlaid on a syntax-highlighted <pre> backdrop.
   Both share IDENTICAL box metrics so the caret/selection line up with the coloured text. */
.fx-code { position:relative; flex:1 1 auto; overflow:hidden; background:#0b0f1a; }
.fx-hl, #fx-text {
  position:absolute; inset:0; margin:0; border:0; padding:1rem;
  font-family:ui-monospace,Menlo,Consolas,monospace; font-size:0.85rem; line-height:1.5;
  tab-size:4; white-space:pre; overflow-wrap:normal; word-break:normal;
}
.fx-hl { overflow:hidden; color:#d7def0; pointer-events:none; z-index:0; }
.fx-hl code { font:inherit; display:block; }
#fx-text { overflow:auto; z-index:1; resize:none; outline:none; background:transparent; color:transparent; caret-color:#e6ebff; }
#fx-text::selection { background:rgba(139,92,246,0.4); }
/* Token palette (Tokyo-Night-ish, tuned for the dark editor bg) */
.tk-com{color:#5c6a82;font-style:italic} .tk-str{color:#9ece6a} .tk-num{color:#ff9e64}
.tk-key{color:#bb9af7} .tk-lit{color:#ff9e64} .tk-fn{color:#7aa2f7} .tk-prop{color:#7dcfff}
.tk-tag{color:#f7768e} .tk-attr{color:#e0af68} .tk-punct{color:#89ddff}
#fx-ctx, #fx-pop { position:fixed; z-index:50; min-width:180px; background:var(--mat-surface); border:1px solid var(--mat-border); border-radius:10px; box-shadow:0 12px 34px rgba(0,0,0,.28); padding:0.3rem; }
#fx-ctx[hidden], #fx-pop[hidden]{ display:none; }
.fx-ctx-item { display:block; width:100%; text-align:left; padding:0.45rem 0.6rem; border:none; background:transparent; border-radius:7px; cursor:pointer; font:inherit; font-size:0.85rem; color:var(--mat-text); }
.fx-ctx-item:hover { background:rgba(255,255,255,0.06); } .fx-ctx-item.danger { color:#ffb3c0; } .fx-ctx-item:disabled { opacity:0.4; }
.fx-ctx-sep { height:1px; background:var(--mat-border); margin:0.25rem 0.2rem; }
.fx-viewer { position:absolute; inset:0; background:var(--mat-bg); display:flex; flex-direction:column; z-index:6; }
.fx-viewer[hidden]{ display:none; }
.fx-viewer-body { flex:1 1 auto; overflow:auto; display:grid; place-items:center; padding:1rem; background:#0b0f1a; }
.fx-viewer-body img { max-width:100%; max-height:100%; object-fit:contain; }
.fx-viewer-body iframe { width:100%; height:100%; border:0; background:#fff; border-radius:6px; }
.fx-viewer-body video, .fx-viewer-body audio { max-width:100%; max-height:100%; }
.fx-dialog { position:absolute; inset:0; background:rgba(0,0,0,0.55); display:grid; place-items:center; z-index:10; }
.fx-dialog[hidden]{ display:none; }
.fx-dialog-card { width:min(430px,92%); background:var(--mat-surface); border:1px solid var(--mat-border); border-radius:14px; padding:1.2rem; box-shadow:0 24px 60px rgba(0,0,0,.5); }
.fl { display:flex; flex-direction:column; gap:0.3rem; margin-bottom:0.7rem; } .fl > span { font-size:0.82rem; color:var(--mat-text-muted); font-weight:600; }
.grid2 { display:grid; grid-template-columns:1fr 1fr; gap:0 0.7rem; }
</style>
}

@section Scripts {
<script>
(function(){
  const root=document.querySelector(".fx");
  const esc=s=>String(s==null?"":s).replace(/[&<>]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c]));
  const escA=s=>String(s==null?"":s).replace(/"/g,"&quot;");
  const fmtBytes=b=>{ if(b==null||b<0)return ""; const u=["B","KB","MB","GB","TB"];let i=0,n=b;while(n>=1024&&i<u.length-1){n/=1024;i++;}return n.toFixed(n<10&&i>0?1:0)+" "+u[i]; };
  const join=(a,b)=>a?(a+"/"+b):b;
  const parent=p=>{ const i=(p||"").lastIndexOf("/"); return i<0?"":p.slice(0,i); };
  const api=(v,op,q)=>`/api/v1/files/${encodeURIComponent(v)}/${op}`+(q?`?${q}`:"");
  const dl=document.getElementById("fx-dl");
  let cur={volume:null,path:""}, sel=null, clip=null, entries=[];
  // Multi-tab: each tab holds one location. openFolder/showHome sync the active tab.
  let tabs=[{home:true}], at=0;
  let view=localStorage.getItem("fx-view")||"details";
  let sortKey=localStorage.getItem("fx-sortkey")||"name", sortDir=localStorage.getItem("fx-sortdir")||"asc", filter="";
  let hist=[], hi=-1, navLock=false;   // back/forward history
  let treeData=null;
  const byId=id=>document.getElementById(id);
  // Which accordion groups are open (persisted per user).
  const treeOpen = { volumes:true, stacks:false }; try{ const s=JSON.parse(localStorage.getItem("fx-tree-open")||"{}"); Object.assign(treeOpen,s); }catch(_){}
  const saveTreeOpen = () => { try{ localStorage.setItem("fx-tree-open", JSON.stringify(treeOpen)); }catch(_){}};

  function fileIcon(name,isDir){ if(isDir)return "📁"; const e=(name.split(".").pop()||"").toLowerCase();
    if(["png","jpg","jpeg","gif","svg","webp","ico","bmp"].includes(e))return "🖼️";
    if(["zip","gz","tar","tgz","rar","7z"].includes(e))return "🗜️";
    if(["json","xml","yml","yaml","js","ts","css","html","cs","sh","conf","ini","env","md","txt","log"].includes(e))return "📄";
    if(["mp3","wav","ogg","mp4","mkv","mov","webm"].includes(e))return "🎵"; if(["pdf"].includes(e))return "📕"; if(["db","sqlite"].includes(e))return "🗃️"; return "📄"; }

  async function jget(url){ const r=await fetch(url); if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.error||r.status);} return r.json(); }
  async function jpost(url,body){ const r=await fetch(url,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)}); if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.error||e.detail||r.status);} return r.json(); }

  // ---- tabs (each holds one location; openFolder/showHome sync the active tab) ----
  const tabsEl=document.getElementById("fx-tabs");
  function tabTitle(t){ if(t.home) return "This PC"; const leaf=(t.path||"").split("/").filter(Boolean).pop(); return leaf || t.volume; }
  function renderTabs(){
    tabsEl.innerHTML = tabs.map((t,i)=>`<div class="fx-tab${i===at?' active':''}" data-i="${i}"><span class="fx-tab-ico">${t.home?'🖥️':'🗄️'}</span><span class="fx-tab-lbl">${esc(tabTitle(t))}</span>${tabs.length>1?`<button class="fx-tab-x" data-close="${i}" title="Close tab">×</button>`:''}</div>`).join("")
      + `<button class="fx-tab-new" id="fx-tab-new" title="New tab">＋</button>`;
    tabsEl.querySelectorAll(".fx-tab").forEach(d=>d.addEventListener("click",e=>{ if(e.target.closest("[data-close]")) return; switchTab(+d.dataset.i); }));
    tabsEl.querySelectorAll("[data-close]").forEach(b=>b.addEventListener("click",e=>{ e.stopPropagation(); closeTab(+b.dataset.close); }));
    document.getElementById("fx-tab-new").addEventListener("click",()=>newTab());
  }
  function syncActiveTab(){ tabs[at] = cur.volume ? {home:false, volume:cur.volume, path:cur.path} : {home:true}; renderTabs(); }
  function switchTab(i){ if(i<0||i>=tabs.length) return; at=i; const t=tabs[i]; if(t.home) showHome(); else openFolder(t.volume,t.path); }
  function newTab(){ tabs.push({home:true}); at=tabs.length-1; showHome(); }
  function openInNewTab(volume,path){ tabs.push({home:false,volume,path:path||""}); at=tabs.length-1; openFolder(volume,path); }
  function closeTab(i){ if(tabs.length<=1) return; tabs.splice(i,1); if(at>i) at--; else if(at===i) at=Math.min(i, tabs.length-1); const t=tabs[at]; if(t.home) showHome(); else openFolder(t.volume,t.path); }

  // ---- tree (accordion: Dashboard / Volumes / Stacks / Backups) ----
  const treeEl=document.getElementById("fx-tree");
  function groupNode(id, iconTxt, title, expandable, onClick){
    const wrap=document.createElement("div"); wrap.className="fx-group"+((expandable && treeOpen[id])?" open":"");
    const head=document.createElement("button"); head.className="fx-group-head"; head.type="button";
    head.innerHTML=`${expandable?'<span class="fx-caret">▸</span>':'<span class="fx-caret leaf"></span>'}<span class="i">${iconTxt}</span><span class="lbl">${esc(title)}</span>`;
    wrap.appendChild(head);
    const body=document.createElement("div"); body.className="fx-group-body"; wrap.appendChild(body);
    head.addEventListener("click",e=>{
      if(!expandable){ if(onClick) onClick(); return; }
      // If a click target is the caret / whole row: toggle. If the user just wanted to activate, we treat both as toggle.
      wrap.classList.toggle("open"); treeOpen[id]=wrap.classList.contains("open"); saveTreeOpen();
      if(onClick) onClick();
    });
    return {wrap, body};
  }
  function volNode(volume,path,name,leaf,isVol){
    const node=document.createElement("div"); node.className="fx-node";
    const row=document.createElement("div"); row.className="fx-row"; row.dataset.volume=volume; row.dataset.path=path;
    row.innerHTML=`<span class="fx-caret${leaf?' leaf':''}">▸</span><span class="i">${isVol?"🗄️":"📁"}</span><span>${esc(name)}</span>`;
    const kids=document.createElement("div"); kids.className="fx-children"; node.append(row,kids); let loaded=false;
    row.querySelector(".fx-caret").addEventListener("click",async e=>{ e.stopPropagation();
      if(node.classList.contains("open")){ node.classList.remove("open"); return; } node.classList.add("open");
      if(!loaded){ loaded=true; try{ const d=await jget(api(volume,"list",`path=${encodeURIComponent(path)}`));
        const dirs=d.entries.filter(x=>x.isDir); if(!dirs.length){ kids.innerHTML=`<div class="fx-muted" style="padding:0.2rem 0.5rem;font-size:0.78rem">No subfolders</div>`; }
        for(const en of dirs) kids.appendChild(volNode(volume,join(path,en.name),en.name,false,false));
      }catch(err){ kids.innerHTML=`<div class="fx-muted" style="padding:0.2rem 0.5rem">${esc(err.message)}</div>`; } }
    });
    row.addEventListener("click",()=>openFolder(volume,path));
    if(isVol) row.addEventListener("contextmenu",e=>{ e.preventDefault(); removeVolume(volume); });
    return node;
  }
  async function buildTree(){
    treeEl.innerHTML=`<div class="fx-muted" style="padding:0.6rem">Loading…</div>`;
    try{ if(!treeData){ const [v,s]=await Promise.all([jget("/api/v1/docker/volumes"),jget("/api/v1/docker/stacks").catch(()=>({stacks:[]}))]); treeData={volumes:v.volumes||[],stacks:s.stacks||[]}; } }
    catch(e){ treeEl.innerHTML=`<div class="fx-muted" style="padding:0.6rem">${esc(e.message)}</div>`; return; }
    treeEl.innerHTML="";

    // 1. Dashboard (This PC) — leaf link
    const dash = groupNode("dashboard","🖥️","This PC",false,()=>showHome());
    treeEl.appendChild(dash.wrap);

    // 2. Volumes — expandable, Local + Network(SMB) inside
    const local=treeData.volumes.filter(v=>!v.options||v.options.type!=="cifs");
    const smb=treeData.volumes.filter(v=>v.options&&v.options.type==="cifs");
    const vols = groupNode("volumes","💾",`Volumes (${treeData.volumes.length})`,true);
    if(local.length){ const h=document.createElement("div"); h.className="fx-subhead"; h.textContent="Local"; vols.body.appendChild(h);
      for(const v of local) vols.body.appendChild(volNode(v.name,"",`${v.name}  (${fmtBytes(v.sizeBytes)})`,false,true)); }
    if(smb.length){ const h=document.createElement("div"); h.className="fx-subhead"; h.textContent="Network (SMB)"; vols.body.appendChild(h);
      for(const v of smb) vols.body.appendChild(volNode(v.name,"",`${v.name}`,false,true)); }
    if(!treeData.volumes.length) vols.body.innerHTML=`<div class="fx-muted" style="padding:0.3rem 0.6rem;font-size:0.78rem">No volumes.</div>`;
    treeEl.appendChild(vols.wrap);

    // 3. Stacks — expandable, one sub-head per stack that has volumes
    const stacksWithVols = treeData.stacks.map(st => {
      const names=new Set((st.containers||[]).map(c=>c.name));
      return { st, vols: treeData.volumes.filter(v=>(v.usedBy||[]).some(u=>names.has(u))) };
    }).filter(x => x.vols.length);
    const st = groupNode("stacks","🧱",`Stacks (${stacksWithVols.length})`,true);
    for (const {st: stack, vols: stVols} of stacksWithVols) {
      const h=document.createElement("div"); h.className="fx-subhead"; h.textContent=stack.name; st.body.appendChild(h);
      for(const v of stVols) st.body.appendChild(volNode(v.name,"",`${v.name}  (${fmtBytes(v.sizeBytes)})`,false,true));
    }
    if(!stacksWithVols.length) st.body.innerHTML=`<div class="fx-muted" style="padding:0.3rem 0.6rem;font-size:0.78rem">No stacks with volumes.</div>`;
    treeEl.appendChild(st.wrap);

    // 4. Backups — leaf link (opens the Backups app)
    const bk = groupNode("backups","💾","Backups",false,()=>{ try{ window.parent.postMessage({type:"matos:open",url:"/apps/backups",title:"Backups",key:"backups",width:1000,height:640},location.origin); }catch(_){ location.href="/apps/backups"; } });
    treeEl.appendChild(bk.wrap);

    highlightTree();
  }
  function highlightTree(){ treeEl.querySelectorAll(".fx-row").forEach(r=>r.classList.toggle("sel", r.dataset.volume===cur.volume && r.dataset.path===cur.path)); }

  // ---- main pane ----
  function setTitle(){ const el=byId("fx-tb-title"); if(!el)return;
    if(!cur.volume){ el.textContent="This PC"; return; }
    el.textContent=(cur.path||"").split("/").filter(Boolean).pop() || cur.volume; }
  function crumb(){ setTitle(); const el=document.getElementById("fx-crumb"); el.innerHTML="";
    if(!cur.volume){ el.innerHTML=`<a>🖥️ This PC</a>`; return; }
    const mk=(t,p)=>{ const a=document.createElement("a"); a.textContent=t; a.onclick=()=>openFolder(cur.volume,p); return a; };
    el.appendChild(mk("🗄️ "+cur.volume,"")); let acc="";
    for(const part of cur.path.split("/").filter(Boolean)){ acc=join(acc,part); const s=document.createElement("span"); s.className="sep"; s.textContent="›"; el.append(s,mk(part,acc)); }
  }
  document.getElementById("fx-up").addEventListener("click",()=>{ if(cur.volume) openFolder(cur.volume,parent(cur.path)); });

  // ---- back / forward history ----
  function histLoc(){ return cur.volume?{volume:cur.volume,path:cur.path}:{home:true}; }
  function sameLoc(a,b){ return a&&b&&((a.home&&b.home)||(!a.home&&!b.home&&a.volume===b.volume&&a.path===b.path)); }
  function pushHist(){ if(navLock)return; const loc=histLoc(); if(sameLoc(hist[hi],loc))return; hist=hist.slice(0,hi+1); hist.push(loc); hi=hist.length-1; updateNav(); }
  function updateNav(){ const b=byId("fx-back"),f=byId("fx-fwd"); if(b)b.disabled=hi<=0; if(f)f.disabled=hi>=hist.length-1; }
  function goHist(d){ const ni=hi+d; if(ni<0||ni>=hist.length)return; hi=ni; navLock=true; const l=hist[hi]; if(l.home)showHome(); else openFolder(l.volume,l.path); navLock=false; updateNav(); }
  byId("fx-back").addEventListener("click",()=>goHist(-1));
  byId("fx-fwd").addEventListener("click",()=>goHist(1));

  // ---- Home ("This PC") view ----
  const homeEl=document.getElementById("fx-home-view");
  function showHome(){
    cur={volume:null,path:""}; sel=null;
    document.getElementById("fx-editor").hidden=true;
    document.getElementById("fx-viewer").hidden=true;
    document.getElementById("fx-ribbon").hidden=true;
    const lst=document.getElementById("fx-list"); lst.innerHTML=""; lst.style.display="none";
    filter=""; const se0=byId("fx-search"); if(se0) se0.value="";
    crumb(); highlightTree(); updateOps(); pushHist();
    homeEl.classList.add("active");
    const vols=(treeData&&treeData.volumes)||[];
    const isSmb = v => v.options && v.options.type === "cifs";
    const local = vols.filter(v=>!isSmb(v)); const smb = vols.filter(isSmb);
    const inUse = vols.filter(v=>v.usedBy&&v.usedBy.length>0);
    const totalSize = vols.reduce((n,v)=>n+(v.sizeBytes>0?v.sizeBytes:0),0);
    const tile = v => {
      const smbChip = isSmb(v)?'<span class="chip-mini">SMB</span>':'';
      const useChip = v.usedBy&&v.usedBy.length?`<span class="chip-mini used">${v.usedBy.length} in use</span>`:'';
      const sub = isSmb(v) ? esc(v.options.device||"//?") : (v.sizeBytes>=0?fmtBytes(v.sizeBytes):"(size —)");
      return `<button class="fx-vtile" data-open="${escA(v.name)}"><span class="ico">${isSmb(v)?"🌐":"💾"}</span><div class="body"><div class="nm">${esc(v.name)}${smbChip}${useChip}</div><div class="sub">${sub}</div></div></button>`;
    };
    homeEl.innerHTML = `<h1>🖥️ This PC <span class="fx-muted" style="font-size:0.8rem;font-weight:400">${vols.length} volumes · ${fmtBytes(totalSize)} used</span></h1>
      <div class="fx-muted" style="font-size:0.85rem;margin-bottom:0.4rem">Browse Docker named volumes. Open a volume by clicking it, or use the sidebar for stacks &amp; SMB shares.</div>
      <div style="display:flex;gap:0.5rem;margin:0.7rem 0 0.3rem">
        <button class="ui-btn primary" id="fx-home-new">＋ New volume</button>
        <button class="ui-btn" id="fx-home-refresh">Refresh</button>
      </div>
      ${local.length?`<h2>Local volumes</h2><div class="fx-vgrid">${local.map(tile).join("")}</div>`:''}
      ${smb.length?`<h2>Network locations (SMB)</h2><div class="fx-vgrid">${smb.map(tile).join("")}</div>`:''}
      ${!local.length&&!smb.length?`<div class="fx-muted" style="padding:1rem">No volumes yet. Click "New volume" to create one.</div>`:''}`;
    homeEl.querySelectorAll("[data-open]").forEach(b=>b.addEventListener("click",()=>openFolder(b.dataset.open,"")));
    document.getElementById("fx-home-new").addEventListener("click",()=>{ document.getElementById("fx-newvol").hidden=false; });
    document.getElementById("fx-home-refresh").addEventListener("click",async()=>{ treeData=null; await buildTree(); showHome(); });
    syncActiveTab();
  }

  async function openFolder(volume,path){
    homeEl.classList.remove("active"); document.getElementById("fx-list").style.display="";
    cur={volume,path:path||""}; sel=null; document.getElementById("fx-editor").hidden=true; document.getElementById("fx-ribbon").hidden=false;
    filter=""; const se1=byId("fx-search"); if(se1) se1.value="";
    crumb(); highlightTree(); updateOps(); pushHist();
    const list=document.getElementById("fx-list"); list.innerHTML=`<div class="fx-muted" style="padding:1rem">Loading…</div>`;
    try{ const d=await jget(api(volume,"list",`path=${encodeURIComponent(cur.path)}`)); entries=d.entries; }
    catch(e){ list.innerHTML=`<div class="fx-muted" style="padding:1rem">${esc(e.message)}</div>`; syncActiveTab(); return; }
    renderMain();
    syncActiveTab();
  }
  // ---- sort + filter ----
  const kindOf=en=>en.isDir?"":(en.name.split(".").pop()||"").toLowerCase();
  function sortedEntries(){
    let arr=entries.slice();
    if(filter){ const f=filter.toLowerCase(); arr=arr.filter(en=>en.name.toLowerCase().includes(f)); }
    arr.sort((a,b)=>{
      if(a.isDir!==b.isDir) return a.isDir?-1:1;   // folders always first
      let r=0;
      if(sortKey==="size") r=(a.size||0)-(b.size||0);
      else if(sortKey==="date") r=String(a.modifiedUtc||"").localeCompare(String(b.modifiedUtc||""));
      else if(sortKey==="kind") r=kindOf(a).localeCompare(kindOf(b));
      if(r===0) r=a.name.localeCompare(b.name,undefined,{numeric:true,sensitivity:"base"});
      return sortDir==="desc"?-r:r;
    });
    return arr;
  }
  function setSort(k){ if(sortKey===k) sortDir=sortDir==="asc"?"desc":"asc"; else { sortKey=k; sortDir="asc"; }
    localStorage.setItem("fx-sortkey",sortKey); localStorage.setItem("fx-sortdir",sortDir); renderMain(); markSel(); }
  function updateStatus(){ const el=byId("fx-status"); if(!el)return;
    if(!cur.volume){ const n=((treeData&&treeData.volumes)||[]).length; el.textContent=n?`${n} volume${n>1?"s":""}`:""; return; }
    const arr=sortedEntries(); let s=`${arr.length} item${arr.length===1?"":"s"}`;
    if(filter) s=`${arr.length} of ${entries.length} · “${esc(filter)}”`;
    if(sel) s=`“${esc(sel.name)}” selected · `+s; el.textContent=s; }

  function renderMain(){
    const list=document.getElementById("fx-list");
    const data=sortedEntries(); updateStatus();
    if(!entries.length){ list.innerHTML=`<div class="fx-muted" style="padding:1.2rem">Empty folder.</div>`; return; }
    if(!data.length){ list.innerHTML=`<div class="fx-muted" style="padding:1.2rem">No items match “${esc(filter)}”.</div>`; return; }
    const car=k=> sortKey===k?`<span class="fx-sortcaret">${sortDir==="asc"?"▲":"▼"}</span>`:"";
    if(view==="details") list.innerHTML=`<table class="fx-tbl"><thead><tr><th class="fx-sortable" data-sort="name">Name${car("name")}</th><th class="fx-sortable" data-sort="size">Size${car("size")}</th><th class="fx-sortable" data-sort="date">Modified${car("date")}</th></tr></thead><tbody>${
      data.map(en=>`<tr data-name="${escA(en.name)}" data-dir="${en.isDir}"><td><span class="fx-name"><span class="i">${fileIcon(en.name,en.isDir)}</span>${esc(en.name)}</span></td>
        <td class="fx-muted">${en.isDir?"":fmtBytes(en.size)}</td><td class="fx-muted">${(en.modifiedUtc||"").replace("T"," ").replace(/\..*/,"")}</td></tr>`).join("")}</tbody></table>`;
    else if(view==="grid") list.innerHTML=`<div class="fx-grid">${data.map(en=>`<div class="fx-tile" data-name="${escA(en.name)}" data-dir="${en.isDir}"><div class="i">${fileIcon(en.name,en.isDir)}</div><div class="n">${esc(en.name)}</div></div>`).join("")}</div>`;
    else list.innerHTML=`<div class="fx-listv">${data.map(en=>`<div class="fx-li" data-name="${escA(en.name)}" data-dir="${en.isDir}"><span class="i">${fileIcon(en.name,en.isDir)}</span><span>${esc(en.name)}</span></div>`).join("")}</div>`;
    list.querySelectorAll("th[data-sort]").forEach(th=>th.addEventListener("click",()=>setSort(th.dataset.sort)));
    list.querySelectorAll("[data-name]").forEach(row=>{
      row.addEventListener("click",()=>select(row));
      row.addEventListener("dblclick",()=>{ const n=row.dataset.name, isDir=row.dataset.dir==="true"; if(isDir) openFolder(cur.volume,join(cur.path,n)); else openFile(join(cur.path,n)); });
      row.addEventListener("contextmenu",async e=>{ e.preventDefault(); select(row);
        let handlers=[];
        if(sel && !sel.isDir){ const parts=sel.name.split("."); const ext=parts.length>1?"."+parts.pop().toLowerCase():"";
          if(ext){ try{ const d=await jget(`/api/v1/store/handlers?ext=${encodeURIComponent(ext)}`); handlers=d.apps||[]; }catch(_){} } }
        showCtx(e.clientX,e.clientY,true,handlers); });
    });
  }
  function select(row){ sel={name:row.dataset.name,isDir:row.dataset.dir==="true",path:join(cur.path,row.dataset.name)}; markSel(); updateOps(); }
  function markSel(){ document.querySelectorAll("#fx-list [data-name]").forEach(r=>r.classList.toggle("sel", sel && r.dataset.name===sel.name)); }

  // ---- open a file with a handler app (spawns an ephemeral container bound to the file) ----
  async function openWith(appId){
    if(!sel || sel.isDir) return;
    const name=sel.name, path=sel.path;
    document.body.style.cursor="progress";
    try{
      const r=await jpost("/api/v1/store/open-with",{appId,volume:cur.volume,path});
      window.parent.postMessage({type:"matos:open", url:r.url, key:"open:"+r.id, title:r.title||("Open — "+name), width:1120, height:760, ephemeralId:r.id}, location.origin);
    }catch(e){ matDialog.alert("Open with failed: "+e.message, {title:"Open with"}); }
    finally{ document.body.style.cursor=""; }
  }

  // ---- view toggle ----
  document.querySelectorAll("#fx-view button").forEach(b=>{ b.classList.toggle("active",b.dataset.view===view);
    b.addEventListener("click",()=>{ view=b.dataset.view; localStorage.setItem("fx-view",view); document.querySelectorAll("#fx-view button").forEach(x=>x.classList.toggle("active",x===b)); renderMain(); markSel(); }); });

  // ---- ops ----
  function updateOps(){ const has=!!sel; ["fx-copy","fx-cut","fx-rename","fx-delete"].forEach(id=>document.getElementById(id).disabled=!has); document.getElementById("fx-paste").disabled=!clip; updateStatus(); }

  // ---- toolbar: search + sort/action popovers ----
  byId("fx-search").addEventListener("input",e=>{ filter=e.target.value.trim(); if(cur.volume) renderMain(); });
  byId("fx-search").addEventListener("keydown",e=>{ if(e.key==="Escape"){ e.target.value=""; filter=""; if(cur.volume) renderMain(); } });
  const pop=document.createElement("div"); pop.id="fx-pop"; pop.hidden=true; document.body.appendChild(pop);
  function hidePop(){ pop.hidden=true; }
  function showPop(anchor,items){ pop.innerHTML="";
    for(const it of items){ if(it.hide)continue; if(it.sep){ const s=document.createElement("div"); s.className="fx-ctx-sep"; pop.appendChild(s); continue; }
      const b=document.createElement("button"); b.className="fx-ctx-item"+(it.danger?" danger":""); b.textContent=it.label; b.disabled=!!it.dis;
      b.onclick=ev=>{ ev.stopPropagation(); hidePop(); it.fn(); }; pop.appendChild(b); }
    pop.hidden=false; const r=anchor.getBoundingClientRect();
    pop.style.left=Math.max(8,Math.min(r.right-pop.offsetWidth,window.innerWidth-pop.offsetWidth-8))+"px";
    pop.style.top=(r.bottom+4)+"px";
  }
  function actionItems(){ const v=!!cur.volume; return [
    {label:"New Folder",dis:!v,fn:()=>byId("fx-newfolder").click()},
    {label:"Upload…",dis:!v,fn:()=>byId("fx-upload").click()},
    {sep:true},
    {label:"Copy",dis:!sel,fn:()=>byId("fx-copy").click()},
    {label:"Cut",dis:!sel,fn:()=>byId("fx-cut").click()},
    {label:"Paste",dis:!clip,fn:()=>byId("fx-paste").click()},
    {label:"Rename…",dis:!sel,fn:()=>byId("fx-rename").click()},
    {label:"Delete",dis:!sel,danger:true,fn:()=>byId("fx-delete").click()},
    {sep:true},
    {label:"Export volume…",dis:!v,fn:()=>byId("fx-export").click()},
    {label:"Import archive…",dis:!v,fn:()=>byId("fx-import").click()},
  ]; }
  function sortItems(){ const mk=(k,l)=>({label:(sortKey===k?"✓  ":"    ")+l,fn:()=>setSort(k)});
    return [ mk("name","Name"),mk("date","Date Modified"),mk("size","Size"),mk("kind","Kind"),{sep:true},
      {label:(sortDir==="asc"?"✓  ":"    ")+"Ascending",fn:()=>{ if(sortDir!=="asc"){ sortDir="asc"; localStorage.setItem("fx-sortdir",sortDir); renderMain(); markSel(); } }},
      {label:(sortDir==="desc"?"✓  ":"    ")+"Descending",fn:()=>{ if(sortDir!=="desc"){ sortDir="desc"; localStorage.setItem("fx-sortdir",sortDir); renderMain(); markSel(); } }} ]; }
  byId("fx-action-btn").addEventListener("click",e=>{ e.stopPropagation(); if(!pop.hidden){hidePop();return;} showPop(e.currentTarget,actionItems()); });
  byId("fx-sort-btn").addEventListener("click",e=>{ e.stopPropagation(); if(!pop.hidden){hidePop();return;} showPop(e.currentTarget,sortItems()); });
  document.addEventListener("click",e=>{ if(!e.target.closest("#fx-pop")&&!e.target.closest("#fx-action-btn")&&!e.target.closest("#fx-sort-btn")) hidePop(); });
  document.addEventListener("scroll",hidePop,true);
  document.getElementById("fx-newfolder").addEventListener("click",async()=>{ const n=await matDialog.prompt("New folder name:",{title:"New folder"}); if(!n)return; try{ await jpost(api(cur.volume,"mkdir"),{path:join(cur.path,n)}); openFolder(cur.volume,cur.path); }catch(e){ matDialog.alert(e.message); } });
  const fileInput=document.getElementById("fx-file");
  document.getElementById("fx-upload").addEventListener("click",()=>{ if(cur.volume) fileInput.click(); });
  fileInput.addEventListener("change",async()=>{ if(!fileInput.files.length)return; const fd=new FormData(); fd.append("path",cur.path); fd.append("file",fileInput.files[0]);
    try{ const r=await fetch(api(cur.volume,"upload"),{method:"POST",body:fd}); if(!r.ok)throw new Error((await r.json().catch(()=>({}))).error||r.status); openFolder(cur.volume,cur.path); }catch(e){ matDialog.alert("Upload failed: "+e.message, {title:"Upload"}); }finally{ fileInput.value=""; } });
  document.getElementById("fx-copy").addEventListener("click",()=>{ if(sel){ clip={op:"copy",volume:cur.volume,path:sel.path,name:sel.name}; updateOps(); } });
  document.getElementById("fx-cut").addEventListener("click",()=>{ if(sel){ clip={op:"cut",volume:cur.volume,path:sel.path,name:sel.name}; updateOps(); } });
  document.getElementById("fx-paste").addEventListener("click",paste);
  async function paste(){ if(!clip)return; const body={srcVolume:clip.volume,srcPath:clip.path,dstVolume:cur.volume,dstDir:cur.path};
    try{ await jpost("/api/v1/files/"+(clip.op==="cut"?"move":"copy"),body); if(clip.op==="cut")clip=null; updateOps(); openFolder(cur.volume,cur.path); }catch(e){ matDialog.alert("Paste failed: "+e.message, {title:"Paste"}); } }
  document.getElementById("fx-rename").addEventListener("click",doRename);
  async function doRename(){ if(!sel)return; const nn=await matDialog.prompt("Rename to:",{value:sel.name,title:"Rename"}); if(!nn||nn===sel.name)return; try{ await jpost(api(cur.volume,"rename"),{path:sel.path,newName:nn}); openFolder(cur.volume,cur.path); }catch(e){ matDialog.alert(e.message); } }
  document.getElementById("fx-delete").addEventListener("click",doDelete);
  async function doDelete(){ if(!sel)return; if(!await matDialog.confirm(`Delete "${sel.name}"? This cannot be undone.`,{title:"Delete",danger:true,okLabel:"Delete"}))return; try{ await jpost(api(cur.volume,"delete"),{path:sel.path}); openFolder(cur.volume,cur.path); }catch(e){ matDialog.alert(e.message); } }
  document.getElementById("fx-export").addEventListener("click",()=>{ if(cur.volume) dl.src=api(cur.volume,"export"); });
  const archiveInput=document.getElementById("fx-archive");
  document.getElementById("fx-import").addEventListener("click",async()=>{ if(cur.volume && await matDialog.confirm("Import a .tar.gz into '"+cur.volume+"'? Existing files may be overwritten.",{title:"Import archive",okLabel:"Import"})) archiveInput.click(); });
  archiveInput.addEventListener("change",async()=>{ if(!archiveInput.files.length)return; const fd=new FormData(); fd.append("file",archiveInput.files[0]);
    try{ const r=await fetch(api(cur.volume,"import"),{method:"POST",body:fd}); if(!r.ok)throw new Error((await r.json().catch(()=>({}))).error||r.status); matDialog.alert("Import complete.", {title:"Import"}); openFolder(cur.volume,cur.path); }catch(e){ matDialog.alert("Import failed: "+e.message, {title:"Import"}); }finally{ archiveInput.value=""; } });

  // ---- context menu ----
  const ctx=document.createElement("div"); ctx.id="fx-ctx"; ctx.hidden=true; document.body.appendChild(ctx);
  function hideCtx(){ ctx.hidden=true; }
  function showCtx(x,y,onItem,handlers){
    const openWithItems = (handlers && handlers.length)
      ? [{sep:true}, ...handlers.map(h=>({label:`Open with ${h.name}`, icon:h.icon, fn:()=>openWith(h.id)}))]
      : [];
    const items = onItem ? [
      {label:"Open",fn:()=>{ if(sel.isDir)openFolder(cur.volume,sel.path); else openFile(sel.path); }},
      {label:"Open in new tab",fn:()=>openInNewTab(cur.volume,sel.path),hide:!sel.isDir},
      {label:"Download",fn:()=>{ dl.src=api(cur.volume,"download",`path=${encodeURIComponent(sel.path)}`); },hide:sel.isDir},
      ...openWithItems,
      {sep:true},{label:"Copy",fn:()=>{ clip={op:"copy",volume:cur.volume,path:sel.path,name:sel.name}; updateOps(); }},
      {label:"Cut",fn:()=>{ clip={op:"cut",volume:cur.volume,path:sel.path,name:sel.name}; updateOps(); }},
      {label:"Rename",fn:doRename},{sep:true},{label:"Delete",fn:doDelete,danger:true}
    ] : [
      {label:"Paste",fn:paste,dis:!clip},{label:"New folder",fn:()=>document.getElementById("fx-newfolder").click()},{label:"Upload",fn:()=>document.getElementById("fx-upload").click()}
    ];
    ctx.innerHTML=""; for(const it of items){ if(it.hide)continue; if(it.sep){ const s=document.createElement("div"); s.className="fx-ctx-sep"; ctx.appendChild(s); continue; }
      const b=document.createElement("button"); b.className="fx-ctx-item"+(it.danger?" danger":""); b.textContent=it.label; b.disabled=!!it.dis; b.onclick=()=>{ hideCtx(); it.fn(); }; ctx.appendChild(b); }
    ctx.hidden=false; ctx.style.left=Math.min(x,window.innerWidth-ctx.offsetWidth-8)+"px"; ctx.style.top=Math.min(y,window.innerHeight-ctx.offsetHeight-8)+"px";
  }
  document.addEventListener("click",hideCtx); document.addEventListener("scroll",hideCtx,true);

  // ---- keyboard ----
  document.addEventListener("keydown",e=>{ if(e.target.tagName==="TEXTAREA"||e.target.tagName==="INPUT")return;
    if(e.key==="Delete"&&sel)doDelete(); else if(e.key==="F2"&&sel)doRename();
    else if((e.ctrlKey||e.metaKey)&&e.key==="c"&&sel){ clip={op:"copy",volume:cur.volume,path:sel.path,name:sel.name}; updateOps(); }
    else if((e.ctrlKey||e.metaKey)&&e.key==="x"&&sel){ clip={op:"cut",volume:cur.volume,path:sel.path,name:sel.name}; updateOps(); }
    else if((e.ctrlKey||e.metaKey)&&e.key==="v"&&clip)paste();
    else if(e.key==="Backspace"&&cur.volume){ openFolder(cur.volume,parent(cur.path)); } });

  // ---- viewer (images / pdf / media) ----
  const viewerKind=path=>{ const e=(path.split(".").pop()||"").toLowerCase();
    if(["png","jpg","jpeg","gif","webp","svg","bmp","ico"].includes(e))return "image";
    if(e==="pdf")return "pdf"; if(["mp4","webm"].includes(e))return "video"; if(["mp3","wav","ogg"].includes(e))return "audio"; return null; };
  function showViewer(path,kind){ const url=api(cur.volume,"view",`path=${encodeURIComponent(path)}`); const body=document.getElementById("fx-viewer-body");
    body.innerHTML = kind==="image"?`<img src="${escA(url)}" alt="">` : kind==="pdf"?`<iframe src="${escA(url)}"></iframe>` : kind==="video"?`<video src="${escA(url)}" controls autoplay></video>` : `<audio src="${escA(url)}" controls autoplay></audio>`;
    document.getElementById("fx-viewer-name").textContent=path;
    document.getElementById("fx-viewer-dl").onclick=()=>{ dl.src=api(cur.volume,"download",`path=${encodeURIComponent(path)}`); };
    document.getElementById("fx-viewer").hidden=false; }
  document.getElementById("fx-viewer-close").addEventListener("click",()=>{ document.getElementById("fx-viewer").hidden=true; document.getElementById("fx-viewer-body").innerHTML=""; });

  // ---- syntax highlighting (self-contained, no external lib) ----
  // A compact tokenizer: strings / comments / numbers / keywords / properties for code & config,
  // plus a markup mode for html/xml. Unknown types fall back to plain (escaped) text.
  function hlEsc(s){ return s.replace(/[&<>]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c])); }
  const HL_KW = {
    js:"var let const function return if else for while do switch case default break continue new delete typeof instanceof in of this class extends super import export from try catch finally throw async await yield void with static get set",
    ts:"var let const function return if else for while do switch case default break continue new delete typeof instanceof in of this class extends super import export from try catch finally throw async await yield void with static get set interface type enum implements private public protected readonly namespace declare as keyof abstract",
    cs:"using namespace class struct interface enum record public private protected internal static void var new return if else for foreach while do switch case default break continue try catch finally throw async await get set this base string int bool double float long object readonly override virtual abstract sealed partial params ref out is as nameof",
    py:"def class return if elif else for while break continue import from as try except finally raise with lambda yield global nonlocal pass and or not in is del assert async await self",
    go:"func package import var const type struct interface map chan go defer return if else for range switch case default break continue select fallthrough",
    sh:"if then else elif fi for while until do done case esac function in return export local readonly echo cd exit source set unset trap",
    sql:"select from where insert update delete into values create table drop alter add primary key foreign references join left right inner outer full on group order by having limit offset as and or not null distinct union all index view database begin commit rollback",
    rust:"fn let mut const static struct enum union impl trait pub use mod match if else for while loop return break continue where async await move ref as dyn crate self super type unsafe",
    java:"package import public private protected class interface enum extends implements static final void return if else for while do switch case default break continue try catch finally throw throws new this super abstract synchronized volatile int long double float boolean char byte instanceof",
    clike:"auto break case char const continue default do double else enum extern float for goto if inline int long register return short signed sizeof static struct switch typedef union unsigned void volatile while include define",
    php:"function return if else elseif for foreach while do switch case default break continue class interface trait extends implements public private protected static final abstract new echo print try catch finally throw use namespace as instanceof",
    yaml:"", ini:"", json:"", css:""
  };
  const HL_PROF = {
    generic:(kw)=>({mode:"g",line:["//","#"],block:[["/*","*/"]],str:['"',"'","`"],kw:kwset(kw)}),
    js:{mode:"g",line:["//"],block:[["/*","*/"]],str:['"',"'","`"],kw:kwset(HL_KW.js)},
    ts:{mode:"g",line:["//"],block:[["/*","*/"]],str:['"',"'","`"],kw:kwset(HL_KW.ts)},
    cs:{mode:"g",line:["//"],block:[["/*","*/"]],str:['"',"'"],kw:kwset(HL_KW.cs)},
    py:{mode:"g",line:["#"],block:[['"""','"""'],["'''","'''"]],str:['"',"'"],kw:kwset(HL_KW.py)},
    go:{mode:"g",line:["//"],block:[["/*","*/"]],str:['"',"'","`"],kw:kwset(HL_KW.go)},
    sh:{mode:"g",line:["#"],block:[],str:['"',"'"],kw:kwset(HL_KW.sh)},
    sql:{mode:"g",line:["--"],block:[["/*","*/"]],str:["'","\""],kw:kwset(HL_KW.sql),ci:true},
    rust:{mode:"g",line:["//"],block:[["/*","*/"]],str:['"'],kw:kwset(HL_KW.rust)},
    java:{mode:"g",line:["//"],block:[["/*","*/"]],str:['"',"'"],kw:kwset(HL_KW.java)},
    clike:{mode:"g",line:["//"],block:[["/*","*/"]],str:['"',"'"],kw:kwset(HL_KW.clike)},
    php:{mode:"g",line:["//","#"],block:[["/*","*/"]],str:['"',"'"],kw:kwset(HL_KW.php)},
    css:{mode:"g",line:[],block:[["/*","*/"]],str:['"',"'"],kw:kwset("")},
    yaml:{mode:"g",line:["#"],block:[],str:['"',"'"],kw:kwset("")},
    ini:{mode:"g",line:["#",";"],block:[],str:['"',"'"],kw:kwset("")},
    json:{mode:"g",line:[],block:[],str:['"'],kw:kwset("")},
    markup:{mode:"m"}
  };
  const HL_LIT = new Set(["true","false","null","undefined","none","nil","nan","yes","no","on","off"]);
  function kwset(s){ return new Set(s.split(" ").filter(Boolean)); }
  function langOf(path){
    const base=(path.split(/[\\/]/).pop()||"").toLowerCase(), e=base.includes(".")?base.split(".").pop():base;
    if(base==="dockerfile"||base.startsWith("dockerfile.")) return HL_PROF.generic("FROM RUN CMD LABEL EXPOSE ENV ADD COPY ENTRYPOINT VOLUME USER WORKDIR ARG ONBUILD STOPSIGNAL HEALTHCHECK SHELL as");
    const m={js:"js",mjs:"js",cjs:"js",jsx:"js",ts:"ts",tsx:"ts",json:"json",json5:"json",map:"json",
      cs:"cs",csx:"cs",py:"py",pyw:"py",go:"go",rs:"rust",java:"java",php:"php",
      c:"clike",h:"clike",cpp:"clike",cc:"clike",cxx:"clike",hpp:"clike",hh:"clike",
      sh:"sh",bash:"sh",zsh:"sh",ksh:"sh",sql:"sql",
      css:"css",scss:"css",sass:"css",less:"css",
      yml:"yaml",yaml:"yaml",env:"ini",ini:"ini",conf:"ini",cfg:"ini",toml:"ini",properties:"ini",
      html:"markup",htm:"markup",xml:"markup",xhtml:"markup",svg:"markup",vue:"markup",xaml:"markup",rss:"markup"};
    return HL_PROF[m[e]] || null;
  }
  function hlTag(tag){ let out="",i=0,n=tag.length,seen=false;
    const push=(cls,txt)=>{ out+=cls?`<span class="${cls}">${hlEsc(txt)}</span>`:hlEsc(txt); };
    while(i<n){ const ch=tag[i];
      if(ch==='"'||ch==="'"){ let j=i+1; while(j<n&&tag[j]!==ch)j++; j=Math.min(j+1,n); push("tk-str",tag.slice(i,j)); i=j; continue; }
      if(ch==='<'||ch==='>'||ch==='/'||ch==='!'||ch==='?'||ch==='='){ push("tk-punct",ch); i++; continue; }
      if(/[A-Za-z_:]/.test(ch)){ let j=i; while(j<n&&/[\w:.-]/.test(tag[j]))j++; const w=tag.slice(i,j); push(seen?"tk-attr":"tk-tag",w); seen=true; i=j; continue; }
      push("",ch); i++; }
    return out; }
  function hlMarkup(code){ let out="",i=0,n=code.length;
    const push=(cls,txt)=>{ out+=cls?`<span class="${cls}">${hlEsc(txt)}</span>`:hlEsc(txt); };
    while(i<n){
      if(code.startsWith("<!--",i)){ let e=code.indexOf("-->",i); e=e<0?n:e+3; push("tk-com",code.slice(i,e)); i=e; continue; }
      if(code[i]==="<"){ let e=code.indexOf(">",i); e=e<0?n:e+1; out+=hlTag(code.slice(i,e)); i=e; continue; }
      let e=code.indexOf("<",i); e=e<0?n:e; push("",code.slice(i,e)); i=e; }
    return out; }
  function hlGeneric(code,prof){ let out="",i=0,n=code.length;
    const push=(cls,txt)=>{ out+=cls?`<span class="${cls}">${hlEsc(txt)}</span>`:hlEsc(txt); };
    while(i<n){ let done=false;
      for(const [o,c] of prof.block){ if(code.startsWith(o,i)){ let e=code.indexOf(c,i+o.length); e=e<0?n:e+c.length; push("tk-com",code.slice(i,e)); i=e; done=true; break; } }
      if(done)continue;
      for(const lc of prof.line){ if(code.startsWith(lc,i)){ let e=code.indexOf("\n",i); e=e<0?n:e; push("tk-com",code.slice(i,e)); i=e; done=true; break; } }
      if(done)continue;
      const ch=code[i];
      if(prof.str.includes(ch)){ let j=i+1; while(j<n){ if(code[j]==="\\"){ j+=2; continue; } if(code[j]===ch){ j++; break; } j++; } push("tk-str",code.slice(i,j)); i=j; continue; }
      if(/[0-9]/.test(ch) && !/[A-Za-z0-9_$]/.test(code[i-1]||"")){ let j=i; while(j<n&&/[0-9a-fA-FxXob._]/.test(code[j]))j++; push("tk-num",code.slice(i,j)); i=j; continue; }
      if(/[A-Za-z_$@@]/.test(ch)){ let j=i; while(j<n&&/[A-Za-z0-9_$@@]/.test(code[j]))j++; const w=code.slice(i,j);
        let k=j; while(k<n&&(code[k]===" "||code[k]==="\t"))k++; const nx=code[k];
        const key=prof.ci?w.toUpperCase():w;
        let cls=""; if(prof.kw.has(key)||prof.kw.has(w)) cls="tk-key"; else if(HL_LIT.has(w.toLowerCase())) cls="tk-lit"; else if(nx==="(") cls="tk-fn"; else if(nx===":"||nx==="=") cls="tk-prop";
        push(cls,w); i=j; continue; }
      if("{}()[].,;:+-*/%=<>!&|^~?".includes(ch)){ push("tk-punct",ch); i++; continue; }
      push("",ch); i++; }
    return out; }
  function highlight(code,prof){ if(!prof) return hlEsc(code); return prof.mode==="m"?hlMarkup(code):hlGeneric(code,prof); }

  // ---- editor ----
  let editing=null, editLang=null;
  const fxText=document.getElementById("fx-text"), fxHl=document.getElementById("fx-hl"), fxHlCode=fxHl.firstElementChild;
  function renderHL(){ const v=fxText.value;
    // Skip highlighting very large files to keep typing snappy — plain text still edits fine.
    fxHlCode.innerHTML = v.length>200000 ? hlEsc(v) : highlight(v,editLang);
    fxHl.scrollTop=fxText.scrollTop; fxHl.scrollLeft=fxText.scrollLeft; }
  fxText.addEventListener("input",renderHL);
  fxText.addEventListener("scroll",()=>{ fxHl.scrollTop=fxText.scrollTop; fxHl.scrollLeft=fxText.scrollLeft; });
  async function openFile(path){ const vk=viewerKind(path); if(vk){ showViewer(path,vk); return; }
    let d; try{ d=await jget(api(cur.volume,"read",`path=${encodeURIComponent(path)}`)); }catch(e){ matDialog.alert(e.message); return; }
    if(d.binary){ if(await matDialog.confirm("Binary file. Download instead?",{title:"Binary file",okLabel:"Download"})) dl.src=api(cur.volume,"download",`path=${encodeURIComponent(path)}`); return; }
    editing=path; editLang=langOf(path);
    document.getElementById("fx-editor-name").textContent=path; document.getElementById("fx-editor-info").textContent=(d.truncated?"(truncated) ":"")+fmtBytes(d.size);
    fxText.value=d.text||""; renderHL(); fxText.scrollTop=0; document.getElementById("fx-editor").hidden=false; }
  document.getElementById("fx-close").addEventListener("click",()=>{ document.getElementById("fx-editor").hidden=true; editing=null; });
  document.getElementById("fx-save").addEventListener("click",async()=>{ if(editing==null)return; try{ await jpost(api(cur.volume,"write"),{path:editing,content:document.getElementById("fx-text").value});
    document.getElementById("fx-editor-info").textContent="Saved ✓"; }catch(e){ matDialog.alert("Save failed: "+e.message, {title:"Save"}); } });

  // ---- volume management (create local / SMB, remove) ----
  const nv=document.getElementById("fx-newvol");
  document.getElementById("fx-newvol-btn").addEventListener("click",()=>{ nv.hidden=false; });
  document.getElementById("nv-cancel").addEventListener("click",()=>{ nv.hidden=true; });
  document.getElementById("nv-kind").addEventListener("change",e=>{ document.getElementById("nv-smb").style.display=e.target.value==="smb"?"":"none"; });
  document.getElementById("nv-create").addEventListener("click",async()=>{
    const body={ name:document.getElementById("nv-name").value.trim(), kind:document.getElementById("nv-kind").value,
      server:document.getElementById("nv-server").value.trim(), share:document.getElementById("nv-share").value.trim(),
      username:document.getElementById("nv-user").value.trim(), password:document.getElementById("nv-pass").value, options:document.getElementById("nv-opts").value.trim() };
    if(!body.name){ matDialog.alert("Name is required.", {title:"New volume"}); return; }
    try{ const r=await fetch("/api/v1/files/volumes/create",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
      if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.error||e.detail||r.status); }
      nv.hidden=true; document.getElementById("nv-name").value=""; treeData=null; await buildTree(); if(homeEl.classList.contains("active")) showHome();
    }catch(e){ matDialog.alert("Create failed: "+e.message, {title:"New volume"}); }
  });
  async function removeVolume(name){
    if(!await matDialog.confirm(`Remove volume "${name}"? Docker refuses if it is in use.`,{title:"Remove volume",danger:true,okLabel:"Remove"}))return;
    try{ const r=await fetch("/api/v1/files/volumes/remove",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({name})});
      if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.detail||e.error||r.status); }
      treeData=null; await buildTree();
      if(cur.volume===name){ showHome(); } else if(homeEl.classList.contains("active")) showHome();
    }catch(e){ matDialog.alert("Remove failed: "+e.message, {title:"Remove volume"}); }
  }

  // empty-area context menu (bound once)
  document.getElementById("fx-list").addEventListener("contextmenu",e=>{ if(cur.volume && !e.target.closest("[data-name]")){ e.preventDefault(); sel=null; markSel(); updateOps(); showCtx(e.clientX,e.clientY,false); } });

  // ---- resizable sidebar ----
  (function(){ const side=document.querySelector(".fx-side"), split=document.getElementById("fx-split"), wrap=document.querySelector(".fx");
    const saved=parseInt(localStorage.getItem("fx-side-w")||"0",10); if(saved) side.style.width=saved+"px";
    let active=false;
    split.addEventListener("pointerdown",e=>{ active=true; split.classList.add("drag"); try{split.setPointerCapture(e.pointerId);}catch(_){} e.preventDefault(); });
    split.addEventListener("pointermove",e=>{ if(!active)return; const r=wrap.getBoundingClientRect(); let w=e.clientX-r.left; w=Math.max(160,Math.min(w,r.width-280)); side.style.width=w+"px"; });
    const end=e=>{ if(active){ active=false; split.classList.remove("drag"); try{split.releasePointerCapture(e.pointerId);}catch(_){} localStorage.setItem("fx-side-w",parseInt(side.style.width)||250); } };
    split.addEventListener("pointerup",end); split.addEventListener("pointercancel",end);
  })();

  // ---- init ----
  (async ()=>{ await buildTree(); if(root.dataset.volume) openFolder(root.dataset.volume,root.dataset.path||""); else showHome(); })();
})();
</script>
}

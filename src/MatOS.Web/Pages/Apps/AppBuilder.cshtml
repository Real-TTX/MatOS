@page "/apps/app-builder"
@model MatOS.Web.Pages.Apps.AppBuilderModel
@{
    ViewData["Title"] = "App Builder";
    Layout = "_WindowLayout";
}

<div class="ab">
    <div class="ab-form">
        <div class="ab-head">
            <h2 id="ab-title">App Builder</h2>
            <p class="fx-muted">Design an app — icon, store tile, store page and widgets — and see it live on the right. Saves to your store; install it like any other app.</p>
        </div>

        <label class="fl"><span>Type</span>
            <select id="a-kind" class="ui-select"><option value="image">Single image</option><option value="compose">Compose stack (YAML)</option></select>
        </label>
        <div class="grid2">
            <label class="fl"><span>Display name</span><input id="a-name" class="ui-input" placeholder="My App" /></label>
            <label class="fl"><span>Category</span><input id="a-cat" class="ui-input" placeholder="Custom" /></label>
        </div>

        <div id="a-image-fields">
            <div class="grid2">
                <label class="fl"><span>Docker image *</span><input id="a-image" class="ui-input mono" placeholder="nginx:alpine" /></label>
                <label class="fl"><span>UI port</span><input id="a-port" class="ui-input" type="number" value="80" /></label>
            </div>
            <div class="grid2">
                <label class="fl"><span>Volumes <span class="fx-muted">(one path/line)</span></span><textarea id="a-vols" class="ui-input mono" rows="2" placeholder="/data"></textarea></label>
                <label class="fl"><span>Environment <span class="fx-muted">(KEY=value/line)</span></span><textarea id="a-env" class="ui-input mono" rows="2" placeholder="TZ=Europe/Berlin"></textarea></label>
            </div>
        </div>
        <div id="a-compose-fields" style="display:none">
            <div class="git-box">
                <div class="git-row">
                    <strong>Git source</strong>
                    <span class="git-status" id="a-git-status">Not linked — the compose is edited here.</span>
                    <button type="button" class="ui-btn" id="a-git-link">Link a Git repo…</button>
                    <button type="button" class="ui-btn" id="a-git-unlink" style="display:none">Unlink</button>
                </div>
                <div id="a-git-fields" style="display:none">
                    <div class="grid2">
                        <label class="fl"><span>Repository URL (https)</span><input id="g-repo" class="ui-input mono" placeholder="https://github.com/user/repo.git" /></label>
                        <label class="fl"><span>Branch <span class="fx-muted">(blank = default)</span></span><input id="g-branch" class="ui-input mono" placeholder="main" /></label>
                    </div>
                    <div class="grid2">
                        <label class="fl"><span>Compose path in repo</span><input id="g-path" class="ui-input mono" placeholder="docker-compose.yml" value="docker-compose.yml" /></label>
                        <label class="fl"><span>Access token <span class="fx-muted">(private repos)</span></span><input id="g-token" class="ui-input mono" type="password" placeholder="ghp_… (optional)" /></label>
                    </div>
                    <div style="display:flex;gap:0.5rem;align-items:center">
                        <button type="button" class="ui-btn primary" id="g-fetch">Fetch compose</button>
                        <span class="git-status" id="g-fetch-msg"></span>
                    </div>
                </div>
                <div id="a-git-policy" style="display:none">
                    <div class="grid2">
                        <label class="fl"><span>Auto-update</span>
                            <select id="g-mode" class="ui-select">
                                <option value="off">Off — never check</option>
                                <option value="flag" selected>Notify — show an update badge</option>
                                <option value="redeploy">Auto-redeploy on change</option>
                            </select></label>
                        <label class="fl"><span>Check every (minutes)</span><input id="g-interval" class="ui-input" type="number" min="5" value="60" /></label>
                    </div>
                    <div class="git-status" id="a-git-applied"></div>
                    <div style="display:flex;gap:0.5rem;margin-top:0.3rem">
                        <button type="button" class="ui-btn" id="a-git-check" style="display:none">Check for updates</button>
                        <button type="button" class="ui-btn primary" id="a-git-apply" style="display:none">Pull &amp; redeploy</button>
                    </div>
                </div>
            </div>
            <label class="fl"><span>docker-compose.yml *</span><textarea id="a-compose" class="ui-input mono" rows="8" placeholder="services:&#10;  web:&#10;    image: nginx:alpine"></textarea></label>
            <div class="grid2">
                <label class="fl"><span>UI service <span class="fx-muted">(blank = first)</span></span><input id="a-uisvc" class="ui-input mono" placeholder="web" /></label>
                <label class="fl"><span>UI port</span><input id="a-cport" class="ui-input" type="number" value="80" /></label>
            </div>
        </div>

        <label class="fl"><span>Tagline</span><input id="a-tag" class="ui-input" placeholder="Short one-liner" /></label>
        <label class="fl"><span>Description</span><textarea id="a-desc" class="ui-input" rows="2"></textarea></label>
        <label class="fl"><span>Project URL <span class="fx-muted">(GitHub URL enables the README tab)</span></span><input id="a-proj" class="ui-input" placeholder="https://github.com/user/repo" /></label>

        <div class="fl">
            <span>Icon <span class="fx-muted">(emoji, image URL, or upload)</span></span>
            <div style="display:flex;align-items:center;gap:0.6rem">
                <span class="app-ico" id="a-icon-prev" style="width:44px;height:44px">📦</span>
                <input id="a-icon" class="ui-input" placeholder="📦  or  https://…/icon.png" style="flex:1" />
                <button type="button" class="ui-btn" id="a-icon-upload">Upload…</button>
                <input type="file" id="a-icon-file" accept="image/*" hidden />
            </div>
        </div>

        <div class="fl">
            <span>Right-click actions <span class="fx-muted">(label + URL)</span></span>
            <div id="a-actions"></div>
            <button type="button" class="ui-btn" id="a-add-action" style="align-self:flex-start;margin-top:0.4rem">+ Add action</button>
        </div>

        <div class="fl">
            <span>Widgets <span class="fx-muted">(what this app offers to the desktop / taskbar)</span></span>
            <div id="a-widgets"></div>
            <button type="button" class="ui-btn" id="a-add-widget" style="align-self:flex-start;margin-top:0.4rem">+ Add widget</button>
        </div>

        <div class="fl" id="a-options-fl" style="display:none">
            <span>Install options <span class="fx-muted">(optional add-on services or either/or variants the user picks at install — each merges into the compose)</span></span>
            <div id="a-options"></div>
            <button type="button" class="ui-btn" id="a-add-option" style="align-self:flex-start;margin-top:0.4rem">+ Add option</button>
        </div>

        <div id="ab-msg" class="card" style="display:none;margin:0.8rem 0"></div>
        <div style="display:flex;gap:0.6rem;margin-top:0.6rem">
            <button class="ui-btn primary" id="a-save">Save app</button>
            <button class="ui-btn" id="a-export">Export…</button>
            <button class="ui-btn" id="a-import">Import…</button>
            <input type="file" id="a-import-file" accept=".json,application/json" hidden />
            <button class="ui-btn" id="a-reset">Reset</button>
            <button class="ui-btn" id="a-load">Edit existing…</button>
        </div>
    </div>

    <div class="ab-preview">
        <div class="ab-tabs">
            <button class="ab-tab active" data-p="tile">Store tile</button>
            <button class="ab-tab" data-p="icon">Icon</button>
            <button class="ab-tab" data-p="page">Store page</button>
            <button class="ab-tab" data-p="widgets">Widgets</button>
        </div>
        <div class="ab-pane" data-pane="tile"><div class="ab-canvas"><div id="pv-tile"></div></div></div>
        <div class="ab-pane" data-pane="icon" hidden><div class="ab-canvas ab-icon-canvas"><div id="pv-icon"></div></div></div>
        <div class="ab-pane" data-pane="page" hidden><div class="ab-canvas"><div id="pv-page"></div></div></div>
        <div class="ab-pane" data-pane="widgets" hidden><div class="ab-canvas ab-wg-canvas"><div id="pv-widgets"></div></div></div>
    </div>
</div>

@section Head {
<style>
.win-header { display:none; }
.ab { position:absolute; inset:0; display:flex; overflow:hidden; }
.ab-form { flex:0 0 46%; max-width:560px; overflow:auto; padding:1.2rem 1.3rem; border-right:1px solid var(--mat-border); }
.ab-head h2 { margin:0 0 0.2rem; font-size:1.3rem; }
.ab-head p { margin:0 0 1rem; font-size:0.85rem; }
.ab-preview { flex:1 1 auto; display:flex; flex-direction:column; min-width:0; background:var(--mat-bg); }
.ab-tabs { display:flex; gap:0.3rem; padding:0.6rem 0.9rem; border-bottom:1px solid var(--mat-border); }
.ab-tab { border:none; background:transparent; color:var(--mat-text-muted); font:inherit; font-weight:700; font-size:0.9rem; padding:0.4rem 0.85rem; border-radius:8px; cursor:pointer; }
.ab-tab:hover { color:var(--mat-text); } .ab-tab.active { background:var(--mat-accent); color:#fff; }
.ab-pane { flex:1 1 auto; overflow:auto; } .ab-pane[hidden] { display:none; }
.ab-canvas { padding:1.6rem; min-height:100%; display:block; }
.ab-icon-canvas, .ab-wg-canvas { display:grid; place-items:center; }
/* Shared bits reused from the store look */
.app-ico { width:46px; height:46px; border-radius:12px; display:grid; place-items:center; font-size:1.5rem; overflow:hidden; background:var(--mat-surface-2); border:1px solid var(--mat-border); flex:0 0 auto; }
.app-ico img { width:100%; height:100%; object-fit:cover; }
.app-row { display:flex; align-items:center; gap:0.9rem; background:var(--mat-surface); border:1px solid var(--mat-border); border-radius:16px; padding:0.85rem 1rem; max-width:420px; }
.app-row > .app-ico { width:60px; height:60px; border-radius:16px; font-size:2rem; }
.app-row .g { flex:1 1 auto; min-width:0; } .app-row .g h3 { margin:0; font-size:1.02rem; font-weight:750; display:flex; align-items:center; gap:0.35rem; flex-wrap:wrap; }
.app-row .g .tag { color:var(--mat-text-muted); font-size:0.83rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; margin-top:0.1rem; }
.app-row .acts .ui-btn { border-radius:999px; padding:0.45rem 1.1rem; font-weight:750; }
.chip { font-size:0.68rem; font-weight:700; padding:0.1rem 0.45rem; border-radius:999px; background:rgba(139,92,246,0.22); color:#c7b3ff; }
.chip.compose { background:rgba(34,184,255,0.2); color:#9fe8ff; }
.opt-row { border:1px solid var(--mat-border); border-radius:11px; padding:0.6rem 0.7rem; margin-bottom:0.6rem; background:var(--mat-surface-2); display:flex; flex-direction:column; gap:0.45rem; }
.opt-head { display:flex; gap:0.4rem; align-items:center; }
.opt-head .o-label { flex:1 1 auto; } .opt-head .o-id { flex:0 0 90px; } .opt-head .o-type { flex:0 0 130px; }
.opt-row textarea { resize:vertical; }
.o-choices .ch-row { border:1px dashed var(--mat-border); border-radius:9px; padding:0.45rem 0.55rem; margin-bottom:0.4rem; display:flex; flex-direction:column; gap:0.35rem; }
.ch-row .ch-top { display:flex; gap:0.4rem; align-items:center; } .ch-row .ch-value { flex:0 0 120px; } .ch-row .ch-label { flex:1 1 auto; }
.opt-hint { font-size:0.72rem; color:var(--mat-text-muted); }
.git-box { border:1px solid var(--mat-border); border-radius:11px; padding:0.7rem 0.8rem; margin-bottom:0.8rem; background:var(--mat-surface-2); }
.git-box.linked { border-color:var(--mat-accent); }
.git-row { display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap; }
.git-row strong { font-size:0.9rem; }
.git-status { font-size:0.78rem; color:var(--mat-text-muted); flex:1 1 auto; min-width:120px; }
.git-status.upd { color:#ffcf7a; font-weight:600; }
.git-status.ok { color:#7ff0c4; }
.git-status.err { color:#ffb3c0; }
#a-git-fields, #a-git-policy { margin-top:0.6rem; }
.pv-bigicon { width:120px; height:120px; border-radius:28px; display:grid; place-items:center; font-size:4.5rem; overflow:hidden; background:var(--mat-surface-2); border:1px solid var(--mat-border); }
.pv-bigicon img { width:100%; height:100%; object-fit:cover; }
.pv-bigicon + .pv-cap { text-align:center; margin-top:0.7rem; font-weight:700; }
/* store-page preview (compact) */
.pv-detail-head { display:flex; align-items:center; gap:1.1rem; margin-bottom:1.2rem; flex-wrap:wrap; }
.pv-detail-head .app-ico { width:80px; height:80px; border-radius:20px; font-size:2.6rem; }
.pv-detail-head h1 { margin:0; font-size:1.5rem; } .pv-detail-head .tag { color:var(--mat-text-muted); margin-top:0.2rem; }
.pv-card { background:var(--mat-surface); border:1px solid var(--mat-border); border-radius:14px; padding:1rem; margin-bottom:0.8rem; max-width:640px; }
.pv-card h3 { margin:0 0 0.4rem; font-size:1rem; } .pv-card p { margin:0; line-height:1.6; }
.pv-meta { display:grid; grid-template-columns:130px 1fr; gap:0.4rem 1rem; font-size:0.9rem; } .pv-meta dt { color:var(--mat-text-muted); } .pv-meta dd { margin:0; }
/* widget previews */
.pv-wg { position:relative; background:rgba(17,21,34,0.72); border:1px solid var(--mat-border); border-radius:18px; padding:0.9rem 1rem; color:#fff; display:inline-flex; margin:0.4rem; vertical-align:top; }
.pv-wg .wl { display:flex; align-items:center; gap:0.7rem; } .pv-wg .wi { width:40px; height:40px; border-radius:11px; display:grid; place-items:center; font-size:1.4rem; background:rgba(255,255,255,0.08); overflow:hidden; } .pv-wg .wi img { width:100%; height:100%; object-fit:cover; }
.pv-wg .wn { font-weight:750; } .pv-wg .wp { font-size:0.72rem; font-weight:700; padding:0.05rem 0.5rem; border-radius:999px; background:rgba(52,211,153,0.22); color:#7ff0c4; align-self:flex-start; margin-top:0.2rem; display:inline-block; }
.pv-wg.launch { flex-direction:column; align-items:center; text-align:center; gap:0.5rem; } .pv-wg.launch .wi { width:54px; height:54px; font-size:1.9rem; }
.pv-wg.panel { color:var(--mat-text-muted); font-size:0.82rem; align-items:center; }
.pv-wg .surf { position:absolute; top:6px; right:8px; font-size:0.62rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--mat-text-muted); }
/* form repeaters */
.fl { display:flex; flex-direction:column; gap:0.3rem; margin-bottom:0.8rem; } .fl > span { font-size:0.82rem; font-weight:600; color:var(--mat-text-muted); }
.grid2 { display:grid; grid-template-columns:1fr 1fr; gap:0 0.8rem; }
.act-row { display:flex; gap:0.4rem; margin-bottom:0.4rem; align-items:center; } .act-row input { flex:1; } .act-row .lbl { max-width:150px; }
.wg-row { display:grid; grid-template-columns:1fr 1fr auto; gap:0.4rem; margin-bottom:0.5rem; align-items:center; background:var(--mat-surface); border:1px solid var(--mat-border); border-radius:10px; padding:0.5rem; }
.wg-row .wg-line { display:contents; }
.fx-muted { color:var(--mat-text-muted); }
@@media (max-width:820px){ .ab { flex-direction:column; } .ab-form { flex:none; max-width:none; border-right:none; border-bottom:1px solid var(--mat-border); } }
</style>
}

@section Scripts {
<script>
(function(){
  const $=id=>document.getElementById(id);
  const esc=s=>String(s==null?"":s).replace(/[&<>]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c]));
  const escA=s=>String(s==null?"":s).replace(/"/g,"&quot;");
  const isImg=s=>/^(https?:|data:)/i.test(s||"");
  const iconHtml=ic=> isImg(ic) ? `<img src="${escA(ic)}" alt="">` : `<span>${esc(ic||"📦")}</span>`;
  const flash=(t,ok)=>{ const m=$("ab-msg"); m.style.display=""; m.textContent=t; m.style.borderColor=ok?"rgba(52,211,153,0.4)":"rgba(244,80,107,0.4)"; m.style.color=ok?"#7ff0c4":"#ffb3c0"; setTimeout(()=>m.style.display="none",5000); };
  const WG_SIZE={small:{w:200,h:96},medium:{w:280,h:150},large:{w:360,h:210}};
  const KIND_LABEL={status:"Status",launcher:"Launcher",info:"Live panel",iframe:"Live panel"};

  let editId="";

  // ---- gather the app definition from the form ----
  function gather(){
    const kind=$("a-kind").value;
    const env={}; $("a-env").value.split("\n").map(s=>s.trim()).filter(Boolean).forEach(l=>{ const i=l.indexOf("="); if(i>0) env[l.slice(0,i)]=l.slice(i+1); });
    const actions=[...$("a-actions").querySelectorAll(".act-row")].map(r=>({label:r.children[0].value.trim(),url:r.children[1].value.trim()})).filter(a=>a.label&&a.url);
    const widgets=[...$("a-widgets").querySelectorAll(".wg-row")].map(r=>({
      id:r.querySelector(".w-id").value.trim(), name:r.querySelector(".w-name").value.trim(),
      surface:r.querySelector(".w-surface").value, kind:r.querySelector(".w-kind").value,
      size:r.querySelector(".w-size").value, url:r.querySelector(".w-url").value.trim(), icon:""
    })).filter(w=>w.id);
    const options=[...$("a-options").querySelectorAll(".opt-row")].map(r=>{
      const type=r.querySelector(".o-type").value;
      const o={ id:r.querySelector(".o-id").value.trim(), label:r.querySelector(".o-label").value.trim(),
                description:r.querySelector(".o-desc").value.trim(), type };
      if(type==="choice"){
        o.choices=[...r.querySelectorAll(".ch-row")].map(cr=>({ value:cr.querySelector(".ch-value").value.trim(),
          label:cr.querySelector(".ch-label").value.trim(), compose:cr.querySelector(".ch-compose").value })).filter(c=>c.value);
        o.defaultChoice = o.choices.length ? o.choices[0].value : "";
      } else { o.default = r.querySelector(".o-default").checked; o.compose = r.querySelector(".o-compose").value; }
      return o;
    }).filter(o=>o.id && (o.type==="choice" ? o.choices.length : true));
    const out={
      id:editId, kind, name:$("a-name").value.trim(), category:$("a-cat").value.trim()||"Custom",
      tagline:$("a-tag").value.trim(), description:$("a-desc").value.trim(), projectUrl:$("a-proj").value.trim(),
      icon:$("a-icon").value.trim()||"📦", actions, widgets, options,
      image:$("a-image").value.trim(), uiPort:parseInt((kind==="compose"?$("a-cport"):$("a-port")).value||"80",10),
      volumes:$("a-vols").value.split("\n").map(s=>s.trim()).filter(Boolean), env,
      compose:$("a-compose").value, uiService:$("a-uisvc").value.trim()
    };
    if(kind==="compose" && gitBinding) out.git={ repo:gitBinding.repo, branch:gitBinding.branch, path:gitBinding.path,
      token:gitBinding.token||"", updateMode:$("g-mode").value||gitBinding.updateMode||"flag",
      intervalMinutes:parseInt($("g-interval").value||"60",10), appliedCommit:gitBinding.appliedCommit||"", latestCommit:gitBinding.latestCommit||"" };
    return out;
  }

  // ---- previews ----
  function renderPreview(){
    const a=gather();
    const chips=`<span class="chip">${esc(a.category)}</span>${a.kind==="compose"?'<span class="chip compose">compose</span>':''}`;
    // tile
    $("pv-tile").innerHTML=`<div class="app-row"><div class="app-ico">${iconHtml(a.icon)}</div>
      <div class="g"><h3>${esc(a.name||"App name")}${chips}</h3><div class="tag">${esc(a.tagline||a.description||"Tagline / short description")}</div></div>
      <div class="acts"><button class="ui-btn primary">Install</button></div></div>`;
    // icon
    $("pv-icon").innerHTML=`<div class="pv-bigicon">${iconHtml(a.icon)}</div><div class="pv-cap">${esc(a.name||"App name")}</div>`;
    // store page
    const rows=[["Category",esc(a.category)]];
    if(a.kind==="compose") rows.push(["Type","Compose stack"]); else if(a.image) rows.push(["Image",`<span class="mono">${esc(a.image)}</span>`]);
    if(a.volumes.length) rows.push(["Data volumes",esc(a.volumes.join(", "))]);
    if(a.projectUrl) rows.push(["Project",`<a href="${escA(a.projectUrl)}" target="_blank" rel="noopener">${esc(a.projectUrl)} ↗</a>`]);
    if(a.options && a.options.length) rows.push(["Install options", a.options.map(o=>esc(o.label||o.id)+(o.type==="choice"?" (choice)":"")).join(", ")]);
    $("pv-page").innerHTML=`<div class="pv-detail-head"><div class="app-ico">${iconHtml(a.icon)}</div>
        <div><h1>${esc(a.name||"App name")}</h1><div class="tag">${esc(a.tagline||"")}</div><div style="margin-top:0.5rem">${chips}</div></div></div>
      <div class="pv-card"><h3>About</h3><p>${esc(a.description||a.tagline||"No description.")}</p></div>
      <div class="pv-card"><h3>Details</h3><dl class="pv-meta">${rows.map(r=>`<dt>${r[0]}</dt><dd>${r[1]}</dd>`).join("")}</dl></div>`;
    // widgets
    if(!a.widgets.length){ $("pv-widgets").innerHTML=`<div class="fx-muted">No widgets yet — add one on the left to preview it here.</div>`; }
    else $("pv-widgets").innerHTML=a.widgets.map(w=>{
      const sz=WG_SIZE[w.size]||WG_SIZE.small; const ic=iconHtml(w.icon||a.icon);
      const surf=`<span class="surf">${w.surface==="taskbar"?"Taskbar":"Desktop"}</span>`;
      if(w.kind==="launcher") return `<div class="pv-wg launch" style="width:${sz.w}px;min-height:${sz.h}px">${surf}<span class="wi">${ic}</span><span class="wn">${esc(w.name||a.name)}</span></div>`;
      if(w.kind==="iframe"||w.kind==="info") return `<div class="pv-wg panel" style="width:${sz.w}px;min-height:${sz.h}px">${surf}📊 Live panel${w.url?` · <span class="mono">${esc(w.url)}</span>`:""}</div>`;
      return `<div class="pv-wg" style="width:${sz.w}px;min-height:${sz.h}px">${surf}<div class="wl"><span class="wi">${ic}</span><div><div class="wn">${esc(w.name||a.name)}</div><span class="wp">running</span></div></div></div>`;
    }).join("");
  }

  // ---- repeaters ----
  function actionRow(l,u){ const d=document.createElement("div"); d.className="act-row";
    d.innerHTML=`<input class="ui-input lbl" placeholder="Label" value="${escA(l||"")}"><input class="ui-input" placeholder="/path or https://…" value="${escA(u||"")}"><button type="button" class="ui-btn danger">✕</button>`;
    d.querySelector("button").addEventListener("click",()=>{ d.remove(); renderPreview(); }); d.querySelectorAll("input").forEach(i=>i.addEventListener("input",renderPreview)); return d; }
  $("a-add-action").addEventListener("click",()=>{ $("a-actions").appendChild(actionRow("","")); });
  function widgetRow(w){ w=w||{}; const d=document.createElement("div"); d.className="wg-row";
    d.innerHTML=`<input class="ui-input w-name" placeholder="Widget name" value="${escA(w.name||"")}"><input class="ui-input mono w-id" placeholder="id (e.g. status)" value="${escA(w.id||"")}">
      <button type="button" class="ui-btn danger" title="Remove">✕</button>
      <select class="ui-select w-surface"><option value="desktop">Desktop</option><option value="taskbar">Taskbar</option></select>
      <select class="ui-select w-kind"><option value="status">Status</option><option value="launcher">Launcher</option><option value="iframe">Live panel (iframe)</option><option value="info">Live panel (small)</option></select>
      <input class="ui-input mono w-url" placeholder="url path (iframe)" value="${escA(w.url||"")}">
      <select class="ui-select w-size" style="grid-column:1/-1"><option value="small">Small</option><option value="medium">Medium</option><option value="large">Large</option></select>`;
    if(w.surface) d.querySelector(".w-surface").value=w.surface; if(w.kind) d.querySelector(".w-kind").value=w.kind; if(w.size) d.querySelector(".w-size").value=w.size;
    d.querySelector("button").addEventListener("click",()=>{ d.remove(); renderPreview(); });
    d.querySelectorAll("input,select").forEach(i=>i.addEventListener("input",renderPreview));
    return d; }
  $("a-add-widget").addEventListener("click",()=>{ $("a-widgets").appendChild(widgetRow({size:"small"})); renderPreview(); });

  // ---- install options repeater ----
  function choiceRow(c){ c=c||{}; const d=document.createElement("div"); d.className="ch-row";
    d.innerHTML=`<div class="ch-top"><input class="ui-input ch-value" placeholder="value" value="${escA(c.value||"")}"><input class="ui-input ch-label" placeholder="Label" value="${escA(c.label||"")}"><button type="button" class="ui-btn danger ch-del" title="Remove">✕</button></div>
      <textarea class="ui-input mono ch-compose" rows="3" placeholder="services:&#10;  ...">${esc(c.compose||"")}</textarea>`;
    d.querySelector(".ch-del").addEventListener("click",()=>{ d.remove(); renderPreview(); });
    d.querySelectorAll("input,textarea").forEach(i=>i.addEventListener("input",renderPreview));
    return d; }
  function optionRow(o){ o=o||{}; const type=o.type==="choice"?"choice":"toggle"; const d=document.createElement("div"); d.className="opt-row";
    d.innerHTML=`<div class="opt-head">
        <input class="ui-input o-label" placeholder="Label (e.g. Add phpMyAdmin)" value="${escA(o.label||"")}">
        <input class="ui-input mono o-id" placeholder="id" value="${escA(o.id||"")}">
        <select class="ui-select o-type"><option value="toggle">Toggle (optional)</option><option value="choice">Choice (either/or)</option></select>
        <button type="button" class="ui-btn danger o-del" title="Remove">✕</button></div>
      <input class="ui-input o-desc" placeholder="Description (optional)" value="${escA(o.description||"")}">
      <div class="o-toggle">
        <label style="display:flex;align-items:center;gap:0.4rem;font-size:0.85rem;margin-bottom:0.35rem"><input type="checkbox" class="o-default" ${o.default?"checked":""}> On by default</label>
        <textarea class="ui-input mono o-compose" rows="4" placeholder="services:&#10;  phpmyadmin:&#10;    image: phpmyadmin:latest">${esc(o.compose||"")}</textarea>
      </div>
      <div class="o-choice" style="display:none">
        <div class="opt-hint">The first choice is the default. Each choice merges its compose fragment in.</div>
        <div class="o-choices"></div>
        <button type="button" class="ui-btn o-add-choice" style="align-self:flex-start;margin-top:0.3rem">+ Add choice</button>
      </div>`;
    const typeSel=d.querySelector(".o-type"); typeSel.value=type;
    const sync=()=>{ const ch=typeSel.value==="choice"; d.querySelector(".o-choice").style.display=ch?"":"none"; d.querySelector(".o-toggle").style.display=ch?"none":""; };
    typeSel.addEventListener("change",()=>{ sync(); renderPreview(); });
    d.querySelector(".o-del").addEventListener("click",()=>{ d.remove(); renderPreview(); });
    d.querySelector(".o-add-choice").addEventListener("click",()=>{ d.querySelector(".o-choices").appendChild(choiceRow({})); renderPreview(); });
    d.querySelectorAll(".o-label,.o-id,.o-desc,.o-default,.o-compose").forEach(i=>i.addEventListener("input",renderPreview));
    (o.choices||[]).forEach(c=>d.querySelector(".o-choices").appendChild(choiceRow(c)));
    sync();
    return d; }
  $("a-add-option").addEventListener("click",()=>{ $("a-options").appendChild(optionRow({type:"toggle"})); renderPreview(); });

  // ---- Git source (GitOps) ----
  let gitBinding=null, gitFieldsOpen=false;
  const gitEls={ box:document.querySelector(".git-box"), link:$("a-git-link"), unlink:$("a-git-unlink"),
    fields:$("a-git-fields"), policy:$("a-git-policy"), status:$("a-git-status"), applied:$("a-git-applied"),
    check:$("a-git-check"), apply:$("a-git-apply") };
  function gitStatus(el,msg,cls){ el.className="git-status"+(cls?" "+cls:""); el.textContent=msg; }
  function renderGit(){
    const linked=!!gitBinding; gitEls.box.classList.toggle("linked",linked);
    gitEls.unlink.style.display=linked?"":"none"; gitEls.link.style.display=linked?"none":"";
    gitEls.fields.style.display=(!linked&&gitFieldsOpen)?"":"none"; gitEls.policy.style.display=linked?"":"none";
    const cmp=$("a-compose"); cmp.readOnly=linked; cmp.style.opacity=linked?0.75:1;
    if(linked){
      gitStatus(gitEls.status,`Linked: ${gitBinding.repo}${gitBinding.branch?" · "+gitBinding.branch:""} · ${gitBinding.path}`,"ok");
      $("g-mode").value=gitBinding.updateMode||"flag"; $("g-interval").value=gitBinding.intervalMinutes||60;
      const upd=gitBinding.latestCommit&&gitBinding.latestCommit!==gitBinding.appliedCommit;
      gitStatus(gitEls.applied, gitBinding.appliedCommit?("Installed commit "+gitBinding.appliedCommit.slice(0,8)+(upd?" · update available "+gitBinding.latestCommit.slice(0,8):"")):"", upd?"upd":"");
      gitEls.check.style.display=editId?"":"none"; gitEls.apply.style.display=(editId&&upd)?"":"none";
    } else { gitStatus(gitEls.status,"Not linked — the compose is edited here."); gitEls.applied.textContent=""; gitEls.check.style.display="none"; gitEls.apply.style.display="none"; }
  }
  gitEls.link.addEventListener("click",()=>{ gitFieldsOpen=true; renderGit(); });
  gitEls.unlink.addEventListener("click",()=>{ gitBinding=null; gitFieldsOpen=false; renderGit(); renderPreview(); });
  $("g-mode").addEventListener("change",()=>{ if(gitBinding) gitBinding.updateMode=$("g-mode").value; });
  $("g-interval").addEventListener("input",()=>{ if(gitBinding) gitBinding.intervalMinutes=parseInt($("g-interval").value||"60",10); });
  $("g-fetch").addEventListener("click",async()=>{
    const repo=$("g-repo").value.trim(); if(!repo){ gitStatus($("g-fetch-msg"),"Enter a repository URL.","err"); return; }
    const body={ repo, branch:$("g-branch").value.trim(), path:$("g-path").value.trim()||"docker-compose.yml", token:$("g-token").value };
    gitStatus($("g-fetch-msg"),"Cloning…");
    try{ const r=await fetch("/api/v1/store/git/preview",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
      if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.detail||e.error||("HTTP "+r.status)); }
      const j=await r.json();
      $("a-kind").value="compose"; $("a-kind").dispatchEvent(new Event("change"));
      $("a-compose").value=j.compose||"";
      if((j.services||[]).length && !$("a-uisvc").value.trim()) $("a-uisvc").value=j.services[0];
      gitBinding={ repo, branch:body.branch, path:body.path, token:body.token, updateMode:$("g-mode").value||"flag", intervalMinutes:parseInt($("g-interval").value||"60",10), appliedCommit:j.commit||"", latestCommit:j.commit||"" };
      gitFieldsOpen=false; renderGit(); renderPreview();
      gitStatus($("g-fetch-msg"),`Fetched ${(j.services||[]).length} service(s) @@ ${j.commit?j.commit.slice(0,8):"HEAD"}.`,"ok");
    }catch(e){ gitStatus($("g-fetch-msg"),"Fetch failed: "+e.message,"err"); }
  });
  gitEls.check.addEventListener("click",async()=>{ if(!editId||!gitBinding) return; gitStatus(gitEls.applied,"Checking…");
    try{ const r=await fetch("/api/v1/store/git/check",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id:editId})}); const j=await r.json(); gitBinding.latestCommit=j.latest||gitBinding.latestCommit; renderGit(); }
    catch(_){ gitStatus(gitEls.applied,"Check failed.","err"); } });
  gitEls.apply.addEventListener("click",async()=>{ if(!editId||!gitBinding) return; gitStatus(gitEls.applied,"Pulling & redeploying…");
    try{ const r=await fetch("/api/v1/store/git/apply",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id:editId})});
      if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.detail||e.error||r.status); }
      const j=await r.json(); gitBinding.appliedCommit=j.commit||gitBinding.appliedCommit; gitBinding.latestCommit=j.commit||gitBinding.latestCommit;
      try{ const cat=await (await fetch("/api/v1/store/catalog")).json(); const a=(cat.apps||[]).find(x=>x.id===editId); if(a) $("a-compose").value=a.compose||$("a-compose").value; }catch(_){}
      renderGit(); flash(`Updated to ${j.commit?j.commit.slice(0,8):"latest"}${j.redeployed?` · redeployed ${j.redeployed} instance(s)`:""}.`,true);
    }catch(e){ gitStatus(gitEls.applied,"Apply failed: "+e.message,"err"); } });

  // ---- kind toggle, icon, tabs ----
  $("a-kind").addEventListener("change",()=>{ const c=$("a-kind").value==="compose"; $("a-compose-fields").style.display=c?"":"none"; $("a-image-fields").style.display=c?"none":""; $("a-options-fl").style.display=c?"":"none"; renderPreview(); });
  const iconInput=$("a-icon"), iconPrev=$("a-icon-prev");
  iconInput.addEventListener("input",()=>{ iconPrev.innerHTML=iconHtml(iconInput.value); renderPreview(); });
  $("a-icon-upload").addEventListener("click",()=>$("a-icon-file").click());
  $("a-icon-file").addEventListener("change",()=>{ const f=$("a-icon-file").files[0]; if(!f)return; if(f.size>256*1024){ flash("Icon too large (max 256 KB).",false); return; } const r=new FileReader(); r.onload=()=>{ iconInput.value=r.result; iconPrev.innerHTML=iconHtml(r.result); renderPreview(); }; r.readAsDataURL(f); });
  document.querySelectorAll(".ab-tab").forEach(t=>t.addEventListener("click",()=>{ document.querySelectorAll(".ab-tab").forEach(x=>x.classList.toggle("active",x===t)); document.querySelectorAll(".ab-pane").forEach(p=>p.hidden=p.dataset.pane!==t.dataset.p); }));
  ["a-name","a-cat","a-tag","a-desc","a-proj","a-image","a-port","a-vols","a-env","a-compose","a-uisvc","a-cport"].forEach(id=>$(id).addEventListener("input",renderPreview));

  // ---- reset / save / load ----
  function reset(){ editId=""; $("ab-title").textContent="App Builder"; ["a-name","a-cat","a-tag","a-desc","a-proj","a-image","a-vols","a-env","a-compose","a-uisvc"].forEach(i=>$(i).value=""); $("a-port").value="80"; $("a-cport").value="80"; iconInput.value="📦"; iconPrev.innerHTML="📦"; $("a-actions").innerHTML=""; $("a-widgets").innerHTML=""; $("a-options").innerHTML=""; gitBinding=null; gitFieldsOpen=false; ["g-repo","g-branch","g-token"].forEach(i=>$(i).value=""); $("g-path").value="docker-compose.yml"; gitStatus($("g-fetch-msg"),""); renderGit(); $("a-kind").value="image"; $("a-kind").dispatchEvent(new Event("change")); renderPreview(); }
  $("a-reset").addEventListener("click",reset);
  $("a-save").addEventListener("click",async()=>{
    const app=gather();
    if(app.kind!=="compose" && (!app.name||!app.image)){ flash("Display name and Docker image are required.",false); return; }
    if(app.kind==="compose" && !app.compose.trim()){ flash("A compose file is required.",false); return; }
    try{ const r=await fetch("/api/v1/store/apps",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(app)});
      if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.error||e.detail||r.status); }
      const j=await r.json(); editId=j.id||editId; flash("Saved — find it in the Store.",true);
    }catch(e){ flash("Save failed: "+e.message,false); }
  });
  // Export a self-contained store index.json (add its URL under Store → Sources on any matOS).
  const slug=s=>(s||"").toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-+|-+$/g,"");
  function download(name,text){ const b=new Blob([text],{type:"application/json"}); const u=URL.createObjectURL(b); const l=document.createElement("a"); l.href=u; l.download=name; document.body.appendChild(l); l.click(); l.remove(); setTimeout(()=>URL.revokeObjectURL(u),1500); }
  $("a-export").addEventListener("click",()=>{
    const a=gather();
    if(a.kind!=="compose" && (!a.name||!a.image)){ flash("Display name and Docker image are required to export.",false); return; }
    if(a.kind==="compose" && !a.compose.trim()){ flash("A compose file is required to export.",false); return; }
    const id=a.id||slug(a.name)||"app";
    const entry={ id, name:a.name, category:a.category, tagline:a.tagline, description:a.description, projectUrl:a.projectUrl, icon:a.icon, uiPort:a.uiPort };
    if(a.kind==="compose"){ entry.composeInline=a.compose; if(a.uiService) entry.uiService=a.uiService; }
    else { entry.image=a.image; if(a.volumes.length) entry.volumes=a.volumes; if(Object.keys(a.env).length) entry.env=a.env; }
    if(a.actions.length) entry.actions=a.actions;
    if(a.widgets.length) entry.widgets=a.widgets;
    if(a.options && a.options.length) entry.options=a.options;
    Object.keys(entry).forEach(k=>{ if(entry[k]==="" ) delete entry[k]; });
    const index={ name:(a.name||"App")+" — matOS catalog", apps:[entry] };
    download(id+".json", JSON.stringify(index,null,2));
    flash("Exported "+id+".json — host it and add its URL under Store → Sources.",true);
  });
  // Import an exported store file (a full index.json or a single app entry) into the form.
  function importEntry(en){
    const a={ id:en.id||"", name:en.name||"", category:en.category||"", tagline:en.tagline||"", description:en.description||"",
      projectUrl:en.projectUrl||"", icon:en.icon||"📦", uiPort:en.uiPort||80, uiService:en.uiService||"",
      actions:Array.isArray(en.actions)?en.actions:[], widgets:Array.isArray(en.widgets)?en.widgets:[],
      options:Array.isArray(en.options)?en.options:[] };
    const compose=en.composeInline||en.compose||"";
    if(compose && (en.composeInline || /services\s*:/.test(compose))){ a.kind="compose"; a.compose=compose; }
    else { a.kind="image"; a.image=en.image||""; a.volumes=Array.isArray(en.volumes)?en.volumes:[]; a.env=(en.env&&typeof en.env==="object")?en.env:{}; }
    loadApp(a);
  }
  $("a-import").addEventListener("click",()=>$("a-import-file").click());
  $("a-import-file").addEventListener("change",()=>{
    const f=$("a-import-file").files[0]; if(!f) return;
    const r=new FileReader();
    r.onload=()=>{ try{ const j=JSON.parse(r.result); const en=(j&&Array.isArray(j.apps)&&j.apps.length)?j.apps[0]:j;
      if(!en||typeof en!=="object"||(!en.image&&!en.compose&&!en.composeInline&&!en.name)){ flash("That doesn't look like an exported app file.",false); return; }
      importEntry(en); flash("Imported “"+(en.name||en.id||"app")+"” — review, then Save or Export.",true);
    }catch(e){ flash("Import failed: "+e.message,false); } $("a-import-file").value=""; };
    r.readAsText(f);
  });
  $("a-load").addEventListener("click",async()=>{
    let apps=[]; try{ apps=(await (await fetch("/api/v1/store/catalog")).json()).apps.filter(a=>!a.builtIn && !a.source); }catch(_){}
    if(!apps.length){ flash("No custom apps to edit yet.",false); return; }
    const id=window.prompt("App id to edit:\n"+apps.map(a=>"• "+a.id).join("\n")); if(!id) return;
    const a=apps.find(x=>x.id===id.trim()); if(!a){ flash("No app with that id.",false); return; }
    loadApp(a);
  });
  function loadApp(a){
    reset(); editId=a.id; $("ab-title").textContent="Edit "+a.name;
    $("a-name").value=a.name||""; $("a-cat").value=a.category||""; $("a-tag").value=a.tagline||""; $("a-desc").value=a.description||""; $("a-proj").value=a.projectUrl||"";
    iconInput.value=a.icon||"📦"; iconPrev.innerHTML=iconHtml(a.icon);
    $("a-kind").value=a.kind||"image"; $("a-kind").dispatchEvent(new Event("change"));
    $("a-image").value=a.image||""; $("a-port").value=a.uiPort||80; $("a-cport").value=a.uiPort||80;
    $("a-vols").value=(a.volumes||[]).join("\n"); $("a-env").value=Object.entries(a.env||{}).map(([k,v])=>k+"="+v).join("\n");
    $("a-compose").value=a.compose||""; $("a-uisvc").value=a.uiService||"";
    (a.actions||[]).forEach(ac=>$("a-actions").appendChild(actionRow(ac.label,ac.url)));
    (a.widgets||[]).forEach(w=>$("a-widgets").appendChild(widgetRow(w)));
    (a.options||[]).forEach(o=>$("a-options").appendChild(optionRow(o)));
    if(a.git && a.git.repo){ gitBinding={ repo:a.git.repo, branch:a.git.branch||"", path:a.git.path||"docker-compose.yml", token:"",
        updateMode:a.git.updateMode||"flag", intervalMinutes:a.git.intervalMinutes||60, appliedCommit:a.git.appliedCommit||"", latestCommit:a.git.latestCommit||"" }; }
    renderGit();
    renderPreview();
  }

  // open in edit mode if ?id= was passed
  const qid=new URLSearchParams(location.search).get("id");
  reset();
  if(qid){ fetch("/api/v1/store/catalog").then(r=>r.json()).then(d=>{ const a=(d.apps||[]).find(x=>x.id===qid); if(a) loadApp(a); }).catch(()=>{}); }
})();
</script>
}

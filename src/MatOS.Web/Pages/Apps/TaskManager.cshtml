@page "/apps/task-manager"
@model MatOS.Web.Pages.Apps.TaskManagerModel
@{
    ViewData["Title"] = "Task Manager";
    Layout = "_WindowLayout";
}

<div class="tm-wrap" data-focus="@(Model.Focus ?? "")">
    <aside class="tm-nav">
        <div class="tm-nav-title">Task Manager</div>
        <button class="tm-nav-btn active" data-p="general"><span class="i">📊</span> General</button>
        <button class="tm-nav-btn" data-p="apps"><span class="i">🧩</span> Apps</button>
        <button class="tm-nav-btn" data-p="stacks"><span class="i">🧱</span> Stacks</button>
        <button class="tm-nav-btn" data-p="containers"><span class="i">📦</span> Containers</button>
        <button class="tm-nav-btn" data-p="volumes"><span class="i">💾</span> Volumes</button>
        <button class="tm-nav-btn" data-p="network"><span class="i">🌐</span> Network</button>
        <div class="tm-nav-foot"><button id="tm-refresh" class="ui-btn" style="width:100%">↻ Refresh</button></div>
    </aside>

    <section class="tm-main">
        <div class="tm-main-head">
            <h1 class="tm-h" id="tm-h">General</h1>
            <span style="flex:1"></span>
            <input id="tm-filter" class="ui-input" type="search" placeholder="Filter…" hidden />
        </div>
        <div id="tm-error" class="card" style="display:none;border-color:rgba(244,80,107,0.4);background:rgba(244,80,107,0.14);color:#ffb3c0;margin-bottom:0.8rem"></div>
        <div id="tm-pane"></div>

        <div id="tm-logs" class="card" style="margin-top:1rem;display:none">
            <div style="display:flex;align-items:center;gap:0.6rem;margin-bottom:0.6rem">
                <strong id="tm-logs-title">Logs</strong>
                <span id="tm-logs-stat" class="mono fx-muted" style="color:var(--mat-text-muted)"></span>
                <span style="flex:1"></span>
                <button id="tm-logs-close" class="ui-btn">Close</button>
            </div>
            <div id="tm-logbox" class="logbox"></div>
        </div>
    </section>
</div>

@section Head {
<style>
/* full-bleed app shell with a Settings-style left nav; hide the generic window header */
.win-header { display:none; }
.tm-wrap { position:absolute; inset:0; display:flex; background:var(--mat-bg); }
.tm-nav { width:200px; flex:0 0 auto; border-right:1px solid var(--mat-border); padding:1rem 0.6rem; background:rgba(0,0,0,0.18); display:flex; flex-direction:column; gap:0.1rem; overflow:auto; }
.tm-nav-title { font-weight:800; font-size:1.15rem; padding:0.2rem 0.6rem 0.9rem; }
.tm-nav-btn { display:flex; align-items:center; gap:0.55rem; width:100%; padding:0.55rem 0.6rem; border:none; background:transparent; color:var(--mat-text); border-radius:8px; cursor:pointer; font:inherit; font-size:0.92rem; text-align:left; }
.tm-nav-btn:hover { background:var(--mat-surface-2); }
.tm-nav-btn.active { background:var(--mat-accent); color:#fff; }
.tm-nav-btn .i { font-size:1.05rem; width:1.3rem; text-align:center; }
.tm-nav-foot { margin-top:auto; padding-top:0.6rem; }
.tm-main { flex:1 1 auto; overflow:auto; padding:1.2rem 1.5rem 2rem; min-width:0; }
.tm-main-head { display:flex; align-items:center; gap:0.8rem; margin-bottom:1rem; }
.tm-h { font-size:1.5rem; font-weight:800; letter-spacing:-0.02em; margin:0; }
.tm-main-head .ui-input { max-width:260px; }
/* pills / bars */
.pill { display:inline-block; font-size:0.7rem; font-weight:700; padding:0.1rem 0.5rem; border-radius:999px; }
.pill.on { background:rgba(52,211,153,0.2); color:#7ff0c4; } .pill.off { background:rgba(244,80,107,0.16); color:#ffb3c0; }
.bar { position:relative; height:6px; border-radius:999px; background:rgba(255,255,255,0.12); overflow:hidden; min-width:60px; } .bar > span { position:absolute; inset:0 auto 0 0; background:var(--mat-accent); }
/* tables */
table.tmt { width:100%; border-collapse:collapse; }
table.tmt th, table.tmt td { padding:0.5rem 0.85rem; text-align:left; white-space:nowrap; }
table.tmt thead th { font-size:0.78rem; color:var(--mat-text-muted); border-bottom:1px solid var(--mat-border); cursor:pointer; user-select:none; }
table.tmt thead th.num, table.tmt td.num { text-align:right; }
table.tmt tbody tr { border-bottom:1px solid var(--mat-border); } table.tmt tbody tr:hover { background:rgba(255,255,255,0.05); }
.tm-acts { display:flex; gap:0.3rem; justify-content:flex-end; } .tm-acts .ui-btn { padding:0.28rem 0.5rem; font-size:0.78rem; }
/* General dashboard */
.tm-cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:0.8rem; margin-bottom:1rem; }
.tm-card { background:var(--mat-surface); border:1px solid var(--mat-border); border-radius:14px; padding:0.9rem 1rem; overflow:hidden; }
.tm-card-top { display:flex; align-items:center; gap:0.5rem; margin-bottom:0.5rem; }
.tm-card-ic { width:30px; height:30px; border-radius:9px; display:grid; place-items:center; font-size:1rem; flex:0 0 auto; }
.tm-card-k { font-size:0.74rem; color:var(--mat-text-muted); font-weight:700; text-transform:uppercase; letter-spacing:0.04em; }
.tm-card-v { font-size:1.7rem; font-weight:800; font-variant-numeric:tabular-nums; line-height:1; }
.tm-card-v small { font-size:0.9rem; color:var(--mat-text-muted); font-weight:600; }
.tm-card-spark { height:34px; margin-top:0.5rem; }
.tm-dash { display:grid; grid-template-columns:1fr 330px; gap:0.9rem; }
@@media (max-width:860px){ .tm-dash { grid-template-columns:1fr; } }
.tm-chartbox, .tm-top { background:var(--mat-surface); border:1px solid var(--mat-border); border-radius:14px; padding:0.9rem 1rem; }
.tm-chart-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:0.6rem; }
.tm-chart-head strong { font-size:1rem; }
.tm-seg { display:inline-flex; background:rgba(255,255,255,0.06); border-radius:8px; padding:2px; }
.tm-seg button { border:none; background:transparent; padding:0.25rem 0.6rem; font:inherit; font-size:0.8rem; border-radius:6px; cursor:pointer; color:var(--mat-text-muted); }
.tm-seg button.active { background:var(--mat-surface-2); color:var(--mat-text); }
.tm-big { height:250px; background:rgba(255,255,255,0.03); border:1px solid var(--mat-border); border-radius:10px; overflow:hidden; }
.tm-big .pchart { width:100%; height:100%; display:block; }
.tm-top-head { font-size:0.76rem; color:var(--mat-text-muted); font-weight:700; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.6rem; }
.tm-toprow { display:flex; align-items:center; gap:0.6rem; padding:0.4rem 0; }
.tm-appicon { width:26px; height:26px; border-radius:7px; display:inline-grid; place-items:center; overflow:hidden; flex:0 0 auto; background:var(--mat-surface-2); vertical-align:middle; }
.tm-appicon img { width:100%; height:100%; object-fit:cover; } .tm-appicon .tm-emoji { font-size:1rem; }
td .tm-appicon { margin-right:0.5rem; }
.tm-topname { flex:1 1 auto; font-weight:600; font-size:0.88rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.tm-topbar { width:70px; height:6px; border-radius:999px; background:rgba(255,255,255,0.1); overflow:hidden; flex:0 0 auto; } .tm-topbar > span { display:block; height:100%; background:var(--mat-accent); }
.tm-topval { width:52px; text-align:right; font-variant-numeric:tabular-nums; font-size:0.82rem; color:var(--mat-text-muted); }
</style>
}

@section Scripts {
<script>
(function(){
  const esc=s=>String(s==null?"":s).replace(/[&<>]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c]));
  const escA=s=>String(s==null?"":s).replace(/"/g,"&quot;");
  const fmtB=b=>{ if(b==null||b<0)return "—"; const u=["B","KB","MB","GB","TB"];let i=0,n=b;while(n>=1024&&i<u.length-1){n/=1024;i++;}return n.toFixed(n<10&&i>0?1:0)+" "+u[i]; };
  const hexA=(hex,a)=>{ const n=parseInt(hex.slice(1),16); return `rgba(${(n>>16)&255},${(n>>8)&255},${n&255},${a})`; };
  const openWin=(url,title,key)=>window.parent.postMessage({type:"matos:open",url,title,key},location.origin);
  function appIconHtml(icon){ if(!icon) return '<span class="tm-emoji">📦</span>'; if(/^(https?:|data:)/i.test(icon)) return `<img src="${escA(icon)}" alt="" draggable="false">`; return `<span class="tm-emoji">${esc(icon)}</span>`; }
  function appIcon(id){ const d=catalog[id]; return appIconHtml(d&&d.icon); }

  const LABELS={general:"General",apps:"Apps",stacks:"Stacks",containers:"Containers",volumes:"Volumes",network:"Network"};
  let section="general", filter="", sort={key:"name",dir:1}, genMetric="cpu";
  let data={containers:[],stacks:[],images:[],volumes:[],networks:[],disk:{}}, catalog={};
  const stats=new Map(); const statStreams=new Map();
  const HISTORY=60; const hist=new Map(); hist.set("cpu",[]); hist.set("mem",[]);
  const focusId=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Focus));
  const filterInput=document.getElementById("tm-filter");

  function pushHist(key,v){ let h=hist.get(key); if(!h){ h=[]; hist.set(key,h);} h.push(v); if(h.length>HISTORY) h.shift(); }
  const aggCpu=()=>{ let s=0; for(const [,v] of stats) s+=v.cpu||0; return s; };
  const aggMem=()=>{ let s=0; for(const [,v] of stats) s+=v.mem||0; return s; };

  document.querySelectorAll(".tm-nav-btn").forEach(n=>n.addEventListener("click",()=>{
    document.querySelectorAll(".tm-nav-btn").forEach(x=>x.classList.toggle("active",x===n));
    section=n.dataset.p; document.getElementById("tm-h").textContent=LABELS[section]||section;
    filterInput.value=""; filter=""; sort={key:"name",dir:1}; render();
  }));
  filterInput.addEventListener("input",e=>{ filter=e.target.value.toLowerCase(); render(); });
  document.getElementById("tm-refresh").addEventListener("click",loadAll);

  async function loadAll(){
    try{
      const [cs,ss,is,vs,ns,cat,dk]=await Promise.all([
        fetch("/api/v1/docker/containers").then(r=>r.json()),
        fetch("/api/v1/docker/stacks").then(r=>r.json()),
        fetch("/api/v1/docker/images").then(r=>r.json()),
        fetch("/api/v1/docker/volumes").then(r=>r.json()),
        fetch("/api/v1/docker/networks").then(r=>r.json()).catch(()=>({networks:[]})),
        fetch("/api/v1/store/catalog").then(r=>r.json()).catch(()=>({apps:[]})),
        fetch("/api/v1/docker/disk").then(r=>r.json()).catch(()=>({total:0,free:0,used:0}))
      ]);
      data.containers=cs.containers||[]; data.stacks=ss.stacks||[]; data.images=is.images||[]; data.volumes=vs.volumes||[]; data.networks=ns.networks||[]; data.disk=dk||{};
      catalog={}; for(const a of (cat.apps||[])) catalog[a.id]=a;
      const proj={}; for(const s of data.stacks) for(const c of (s.containers||[])) proj[c.id]=s.name;
      for(const c of data.containers) c._project=proj[c.id]||"";
      const err=cs.lastError||ss.lastError; const e=document.getElementById("tm-error");
      if(err){ e.style.display=""; e.textContent="Docker: "+err; } else e.style.display="none";
      render(); syncStats();
      if(focusId){ const c=data.containers.find(x=>x.id===focusId||x.shortId===focusId); if(c) openLogs(c.id,c.name); }
    }catch(_){ const e=document.getElementById("tm-error"); e.style.display=""; e.textContent="Docker is not reachable."; }
  }

  // ---- render dispatch ----
  function render(){
    const pane=document.getElementById("tm-pane");
    filterInput.hidden = section==="general";
    if(section==="general"){ pane.innerHTML=renderGeneral(); wireGeneral(); drawGeneral(); return; }
    let html;
    if(section==="apps") html=renderApps();
    else if(section==="stacks") html=renderStacks();
    else if(section==="containers") html=renderContainers();
    else if(section==="volumes") html=renderVolumes();
    else html=renderNetworks();
    pane.innerHTML=`<div class="card" style="padding:0;overflow:hidden">${html}</div>`;
    wireSort(); wireActions();
  }

  function sortHeader(label,key,num){ const arrow=sort.key===key?(sort.dir>0?" ▲":" ▼"):""; return `<th class="${num?'num':''}" data-sort="${key}">${label}${arrow}</th>`; }
  function applySort(rows,accessors){ const a=accessors[sort.key]; if(!a) return rows;
    return rows.slice().sort((x,y)=>{ const vx=a(x),vy=a(y); if(vx<vy)return -1*sort.dir; if(vx>vy)return 1*sort.dir; return 0; }); }
  function wireSort(){ document.querySelectorAll("#tm-pane th[data-sort]").forEach(th=>th.addEventListener("click",()=>{
    const k=th.dataset.sort; sort = sort.key===k?{key:k,dir:-sort.dir}:{key:k,dir:1}; render(); })); }
  function emptyRow(cols){ return `<tr><td colspan="${cols}" style="padding:1rem;color:var(--mat-text-muted)">Nothing here.</td></tr>`; }

  // ---- General dashboard ----
  function renderGeneral(){
    const running=data.containers.filter(c=>c.running).length;
    const imgSize=data.images.reduce((a,i)=>a+(i.sizeBytes||0),0);
    const volSize=data.volumes.reduce((a,v)=>a+(v.sizeBytes>0?v.sizeBytes:0),0);
    const disk=data.disk||{};
    const cards=[
      {k:"CPU",v:aggCpu().toFixed(1)+"%",hk:"cpu",color:"#8b5cf6",ic:"🧠"},
      {k:"Memory",v:fmtB(aggMem()),hk:"mem",color:"#22b8ff",ic:"📈"},
      {k:"Free space",v:disk.total?`${fmtB(disk.free)}<small> / ${fmtB(disk.total)}</small>`:"—",hk:"",color:"#f472b6",ic:"🗄️"},
      {k:"Containers",v:`${running}<small>/${data.containers.length}</small>`,hk:"",color:"#34d399",ic:"📦"},
      {k:"Storage",v:fmtB(imgSize+volSize),hk:"",color:"#fbbf24",ic:"💾"}
    ];
    return `<div class="tm-cards">${cards.map(c=>`
      <div class="tm-card">
        <div class="tm-card-top"><span class="tm-card-ic" style="background:${hexA(c.color,0.16)};color:${c.color}">${c.ic}</span><span class="tm-card-k">${c.k}</span></div>
        <div class="tm-card-v">${c.v}</div>
        <div class="tm-card-spark" data-gspark="${c.hk}"></div>
      </div>`).join("")}</div>
      <div class="tm-dash">
        <div class="tm-chartbox">
          <div class="tm-chart-head"><strong id="tm-gtitle">${genMetric==="cpu"?"CPU":"Memory"}</strong>
            <div class="tm-seg" id="tm-gmetric"><button data-m="cpu" class="${genMetric==="cpu"?"active":""}">CPU</button><button data-m="mem" class="${genMetric==="mem"?"active":""}">Memory</button></div></div>
          <div class="tm-big" id="tm-gbig"></div>
        </div>
        <div class="tm-top"><div class="tm-top-head">Top apps · CPU</div><div id="tm-topapps"></div></div>
      </div>`;
  }
  function wireGeneral(){ document.querySelectorAll("#tm-gmetric button").forEach(b=>b.addEventListener("click",()=>{
    genMetric=b.dataset.m; document.querySelectorAll("#tm-gmetric button").forEach(x=>x.classList.toggle("active",x===b));
    document.getElementById("tm-gtitle").textContent=genMetric==="cpu"?"CPU":"Memory"; drawGeneral(); })); }
  function drawGeneral(){
    document.querySelectorAll("#tm-pane [data-gspark]").forEach(el=>{ const k=el.dataset.gspark; if(k) miniSpark(el,hist.get(k)||[],k==="cpu"?"#8b5cf6":"#22b8ff"); });
    const h=hist.get(genMetric)||[]; const color=genMetric==="cpu"?"#8b5cf6":"#22b8ff";
    const max=genMetric==="mem"?Math.max(1,...h):Math.max(100,...h);
    const big=document.getElementById("tm-gbig"); if(big) areaChart(big,h,{max,color,id:"gmain"});
    const groups=appGroups().map(g=>({g,cpu:g.containers.reduce((a,c)=>a+((stats.get(c.id)||{}).cpu||0),0)})).sort((a,b)=>b.cpu-a.cpu).slice(0,6);
    const maxc=Math.max(1,...groups.map(x=>x.cpu));
    const el=document.getElementById("tm-topapps"); if(!el) return;
    el.innerHTML=groups.length?groups.map(({g,cpu})=>`<div class="tm-toprow"><span class="tm-appicon">${appIcon(g.app)}</span>
      <span class="tm-topname">${esc(g.title)}</span><span class="tm-topbar"><span style="width:${Math.min(100,maxc?cpu/maxc*100:0)}%"></span></span>
      <span class="tm-topval">${cpu.toFixed(1)}%</span></div>`).join(""):`<div class="fx-muted" style="padding:0.5rem 0">No matOS apps running.</div>`;
  }

  // ---- Apps (matOS-managed, grouped by app+instance, with icons) ----
  function appGroups(){
    const map=new Map();
    for(const c of data.containers){ if(!c.matosApp) continue; const key=c.matosApp+"|"+(c.matosInstance||"");
      let g=map.get(key); if(!g){ g={app:c.matosApp,instance:c.matosInstance,title:c.matosTitle||c.matosApp,stackName:c._project,containers:[]}; map.set(key,g);} g.containers.push(c); }
    return [...map.values()];
  }
  function renderApps(){
    let groups=appGroups().filter(g=>!filter||(g.title+g.app+(g.stackName||"")).toLowerCase().includes(filter));
    groups.sort((a,b)=>a.title.toLowerCase()<b.title.toLowerCase()?-1:1);
    const body=groups.map(g=>{
      const run=g.containers.filter(c=>c.running).length, tot=g.containers.length;
      const cpu=g.containers.reduce((a,c)=>a+((stats.get(c.id)||{}).cpu||0),0);
      const mem=g.containers.reduce((a,c)=>a+((stats.get(c.id)||{}).mem||0),0);
      const web=g.containers.find(c=>c.hasWebUi&&c.appUrl);
      return `<tr>
        <td><span class="tm-appicon">${appIcon(g.app)}</span><strong>${esc(g.title)}</strong><div class="fx-muted" style="font-size:0.72rem">${esc(g.stackName||g.app)}</div></td>
        <td>${run?`<span class="pill on">${run}/${tot} running</span>`:`<span class="pill off">stopped</span>`}</td>
        <td class="num">${run?cpu.toFixed(1)+"%":"—"}</td>
        <td class="num">${run?fmtB(mem):"—"}</td>
        <td><div class="tm-acts">
          ${web?`<button class="ui-btn" data-open="${escA(web.appUrl)}">Open</button>`:""}
          ${g.stackName?`<button class="ui-btn" data-set-stack="${escA(g.stackName)}">Settings</button>`:""}
        </div></td></tr>`;
    }).join("");
    return `<table class="tmt"><thead><tr><th>App</th><th>Status</th><th class="num">CPU</th><th class="num">Mem</th><th></th></tr></thead>
      <tbody>${body||emptyRow(5)}</tbody></table>`;
  }

  // ---- Containers ----
  function renderContainers(){
    let rows=data.containers.filter(c=>!filter||(c.name+c.image+c._project).toLowerCase().includes(filter));
    rows=applySort(rows,{ name:c=>c.name.toLowerCase(), image:c=>c.image.toLowerCase(), stack:c=>(c._project||"").toLowerCase(),
      state:c=>c.running?0:1, cpu:c=>(stats.get(c.id)?.cpu||0), mem:c=>(stats.get(c.id)?.mem||0) });
    const body=rows.map(c=>{
      const st=stats.get(c.id)||{};
      const ports=(c.ports||[]).map(p=>p.publicPort?`${p.publicPort}→${p.privatePort}`:`${p.privatePort}`).join(", ")||"—";
      return `<tr>
        <td>${c.running?'<span class="pill on">running</span>':'<span class="pill off">'+esc(c.state)+'</span>'}</td>
        <td><strong>${esc(c.name)}</strong></td>
        <td class="fx-muted">${esc(c._project||"—")}</td>
        <td class="mono" style="max-width:220px;overflow:hidden;text-overflow:ellipsis">${esc(c.image)}</td>
        <td class="num" data-cpu="${c.id}">${c.running?(st.cpu!=null?st.cpu.toFixed(1)+"%":"…"):"—"}</td>
        <td class="num" data-mem="${c.id}">${c.running?(st.mem!=null?fmtB(st.mem):"…"):"—"}</td>
        <td class="mono">${esc(ports)}</td>
        <td><div class="tm-acts">
          ${c.hasWebUi&&c.appUrl?`<button class="ui-btn" data-open="${escA(c.appUrl)}">Open</button>`:""}
          <button class="ui-btn" data-set="${c.id}" data-name="${escA(c.name)}">Settings</button>
          <button class="ui-btn" data-logs="${c.id}" data-name="${escA(c.name)}">Logs</button>
          ${c.running?`<button class="ui-btn" data-act="stop" data-id="${c.id}">Stop</button>`
                     :`<button class="ui-btn primary" data-act="start" data-id="${c.id}">Start</button>`}
        </div></td></tr>`;
    }).join("");
    return `<table class="tmt"><thead><tr>${sortHeader("State","state")}${sortHeader("Name","name")}${sortHeader("Stack","stack")}
      ${sortHeader("Image","image")}${sortHeader("CPU","cpu",true)}${sortHeader("Mem","mem",true)}<th>Ports</th><th></th></tr></thead>
      <tbody>${body||emptyRow(8)}</tbody></table>`;
  }

  // ---- Stacks ----
  function renderStacks(){
    let rows=data.stacks.filter(s=>!filter||s.name.toLowerCase().includes(filter));
    rows=applySort(rows,{ name:s=>s.name.toLowerCase(), state:s=>s.anyRunning?0:1, size:s=>s.total });
    const body=rows.map(s=>`<tr>
      <td>${s.anyRunning?`<span class="pill on">${s.running}/${s.total}</span>`:`<span class="pill off">stopped</span>`}</td>
      <td><strong>${esc(s.name)}</strong>${s.standalone?' <span class="fx-muted" style="font-size:0.75rem">(standalone)</span>':''}</td>
      <td class="num">${s.total}</td>
      <td>${s.matosManaged?'<span class="pill on">matOS</span>':'<span class="fx-muted">—</span>'}</td>
      <td><div class="tm-acts">
        <button class="ui-btn" data-set-stack="${escA(s.name)}">Settings</button>
        ${s.anyRunning?`<button class="ui-btn" data-sa="stop" data-name="${escA(s.name)}">Stop all</button><button class="ui-btn" data-sa="restart" data-name="${escA(s.name)}">Restart</button>`
                      :`<button class="ui-btn primary" data-sa="start" data-name="${escA(s.name)}">Start all</button>`}
      </div></td></tr>`).join("");
    return `<table class="tmt"><thead><tr>${sortHeader("State","state")}${sortHeader("Stack","name")}${sortHeader("Containers","size",true)}<th>Managed</th><th></th></tr></thead>
      <tbody>${body||emptyRow(5)}</tbody></table>`;
  }

  // ---- Volumes ----
  function renderVolumes(){
    let rows=data.volumes.filter(v=>!filter||v.name.toLowerCase().includes(filter));
    rows=applySort(rows,{ name:v=>v.name.toLowerCase(), size:v=>(v.sizeBytes>0?v.sizeBytes:0) });
    const body=rows.map(v=>`<tr>
      <td class="mono">${esc(v.name)}</td>
      <td class="num">${fmtB(v.sizeBytes)}</td>
      <td>${v.inUse?'<span class="pill on">in use</span>':'<span class="fx-muted">unused</span>'}</td>
      <td class="fx-muted mono" style="max-width:260px;overflow:hidden;text-overflow:ellipsis">${(v.usedBy||[]).map(esc).join(", ")||"—"}</td>
      <td><div class="tm-acts"><button class="ui-btn" data-files="${escA(v.name)}">Browse files</button></div></td></tr>`).join("");
    return `<table class="tmt"><thead><tr>${sortHeader("Volume","name")}${sortHeader("Size","size",true)}<th>Status</th><th>Used by</th><th></th></tr></thead>
      <tbody>${body||emptyRow(5)}</tbody></table>`;
  }

  // ---- Network (docker networks) ----
  function renderNetworks(){
    let rows=(data.networks||[]).filter(n=>!filter||(n.name+n.driver+n.subnet).toLowerCase().includes(filter));
    rows=applySort(rows,{ name:n=>n.name.toLowerCase(), driver:n=>(n.driver||"").toLowerCase(), containers:n=>n.containers });
    const body=rows.map(n=>`<tr>
      <td><strong>${esc(n.name)}</strong>${n.internal?' <span class="fx-muted" style="font-size:0.72rem">internal</span>':''}</td>
      <td class="fx-muted">${esc(n.driver)}</td>
      <td class="fx-muted">${esc(n.scope)}</td>
      <td class="mono">${esc(n.subnet||"—")}</td>
      <td class="mono fx-muted">${esc(n.gateway||"—")}</td>
      <td class="num">${n.containers}</td></tr>`).join("");
    return `<table class="tmt"><thead><tr>${sortHeader("Network","name")}${sortHeader("Driver","driver")}<th>Scope</th><th>Subnet</th><th>Gateway</th>${sortHeader("Containers","containers",true)}</tr></thead>
      <tbody>${body||emptyRow(6)}</tbody></table>`;
  }

  // ---- actions ----
  function wireActions(){
    const q=s=>document.querySelectorAll("#tm-pane "+s);
    q("[data-act]").forEach(b=>b.addEventListener("click",()=>cAction(b.dataset.id,b.dataset.act)));
    q("[data-sa]").forEach(b=>b.addEventListener("click",()=>sAction(b.dataset.name,b.dataset.sa)));
    q("[data-open]").forEach(b=>b.addEventListener("click",()=>window.open(b.dataset.open,"_blank","noopener")));
    q("[data-set]").forEach(b=>b.addEventListener("click",()=>openWin("/apps/properties?type=container&id="+encodeURIComponent(b.dataset.set),"Container · "+b.dataset.name,"container:"+b.dataset.set)));
    q("[data-set-stack]").forEach(b=>b.addEventListener("click",()=>openWin("/apps/properties?type=stack&name="+encodeURIComponent(b.dataset.setStack),"Stack · "+b.dataset.setStack,"set:"+b.dataset.setStack)));
    q("[data-files]").forEach(b=>b.addEventListener("click",()=>openWin("/apps/files?volume="+encodeURIComponent(b.dataset.files),"Files","files")));
    q("[data-logs]").forEach(b=>b.addEventListener("click",()=>openLogs(b.dataset.logs,b.dataset.name)));
  }
  async function cAction(id,a){ try{ await fetch(`/api/v1/docker/containers/${id}/${a}`,{method:"POST"});}catch(_){ } setTimeout(loadAll,700); }
  async function sAction(name,a){ try{ await fetch(`/api/v1/docker/stacks/${encodeURIComponent(name)}/${a}`,{method:"POST"});}catch(_){ } setTimeout(loadAll,700); }

  // ---- live stats: one stream per running container ----
  function syncStats(){
    const running=new Set(data.containers.filter(c=>c.running).slice(0,60).map(c=>c.id));
    for(const [id,src] of statStreams){ if(!running.has(id)){ try{src.close();}catch(_){} statStreams.delete(id); stats.delete(id); hist.delete("c:"+id); } }
    for(const id of running){ if(statStreams.has(id))continue;
      const src=new EventSource(`/api/v1/docker/containers/${id}/stats/stream`);
      src.addEventListener("stat",e=>{ try{ const s=JSON.parse(e.data);
        const cpu=+s.cpuPercent||0, mem=+s.memoryBytes||0, lim=+s.memoryLimitBytes||0;
        stats.set(id,{cpu,mem,lim});
        const cc=document.querySelector(`#tm-pane [data-cpu="${id}"]`); const mc=document.querySelector(`#tm-pane [data-mem="${id}"]`);
        if(cc)cc.textContent=cpu.toFixed(1)+"%"; if(mc)mc.textContent=fmtB(mem);
      }catch(_){}} );
      src.onerror=()=>{}; statStreams.set(id,src);
    }
  }

  // ---- charts ----
  function areaChart(el,d,o){
    const W=600,H=200,n=d.length,max=o.max||1;
    const pad=[["M0",H],...(n?d.map((v,i)=>{const x=n>1?i*(W/(n-1)):W/2; const y=H-Math.min(1,(v||0)/max)*H; return ["L"+x.toFixed(1),y.toFixed(1)];}):[]),["L"+W,H]];
    const line=n>1 ? d.map((v,i)=>{const x=i*(W/(n-1)); const y=H-Math.min(1,(v||0)/max)*H; return (i?"L":"M")+x.toFixed(1)+" "+y.toFixed(1);}).join(" ") : "";
    const area=pad.map(p=>p.join(" ")).join(" ")+" Z";
    el.innerHTML=`<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" class="pchart">
      <defs><linearGradient id="${o.id}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${o.color}" stop-opacity="0.4"/><stop offset="1" stop-color="${o.color}" stop-opacity="0"/></linearGradient></defs>
      ${[0.25,0.5,0.75].map(f=>`<line x1="0" y1="${H*f}" x2="${W}" y2="${H*f}" stroke="rgba(255,255,255,0.06)"/>`).join("")}
      <path d="${area}" fill="url(#${o.id})"/>${line?`<path d="${line}" fill="none" stroke="${o.color}" stroke-width="2" vector-effect="non-scaling-stroke"/>`:""}</svg>`;
  }
  function miniSpark(el,d,color){
    const W=200,H=34,n=d.length; if(!n){ el.innerHTML=""; return; }
    const max=Math.max(1,...d);
    const line=d.map((v,i)=>{const x=n>1?i*(W/(n-1)):W/2; const y=H-Math.min(1,(v||0)/max)*(H-3)-1.5; return (i?"L":"M")+x.toFixed(1)+" "+y.toFixed(1);}).join(" ");
    const area=`M0 ${H} `+d.map((v,i)=>{const x=n>1?i*(W/(n-1)):W/2; const y=H-Math.min(1,(v||0)/max)*(H-3)-1.5; return "L"+x.toFixed(1)+" "+y.toFixed(1);}).join(" ")+` L${W} ${H} Z`;
    el.innerHTML=`<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" style="width:100%;height:100%">
      <defs><linearGradient id="sp${color.slice(1)}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${color}" stop-opacity="0.35"/><stop offset="1" stop-color="${color}" stop-opacity="0"/></linearGradient></defs>
      <path d="${area}" fill="url(#sp${color.slice(1)})"/><path d="${line}" fill="none" stroke="${color}" stroke-width="1.5" vector-effect="non-scaling-stroke"/></svg>`;
  }

  // ---- logs drawer ----
  let logSrc=null,statSrc=null;
  function openLogs(id,name){
    document.getElementById("tm-logs").style.display="";
    document.getElementById("tm-logs-title").textContent="Logs · "+name;
    const box=document.getElementById("tm-logbox"); box.textContent="";
    const st=document.getElementById("tm-logs-stat"); st.textContent="";
    if(logSrc)logSrc.close(); if(statSrc)statSrc.close();
    logSrc=new EventSource(`/api/v1/docker/containers/${id}/logs/stream?tail=200`);
    logSrc.addEventListener("log",e=>{ box.textContent+=e.data+"\n"; box.scrollTop=box.scrollHeight; });
    statSrc=new EventSource(`/api/v1/docker/containers/${id}/stats/stream`);
    statSrc.addEventListener("stat",e=>{ try{const s=JSON.parse(e.data); st.textContent=`CPU ${s.cpuPercent}% · MEM ${fmtB(s.memoryBytes)} (${s.memoryPercent}%)`;}catch(_){}} );
  }
  document.getElementById("tm-logs-close").addEventListener("click",()=>{ if(logSrc)logSrc.close(); if(statSrc)statSrc.close(); document.getElementById("tm-logs").style.display="none"; });

  setInterval(()=>{ pushHist("cpu",aggCpu()); pushHist("mem",aggMem());
    if(section==="general") drawGeneral(); }, 2000);
  loadAll(); setInterval(loadAll,10000);
})();
</script>
}

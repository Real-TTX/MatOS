@page "/apps/task-manager"
@model MatOS.Web.Pages.Apps.TaskManagerModel
@{
    ViewData["Title"] = "Task Manager";
    ViewData["Description"] = "Live view of containers, stacks, images and volumes on this Docker host.";
    Layout = "_WindowLayout";
}

<div id="tm" data-focus="@(Model.Focus ?? "")">
    <div class="tm-tiles" id="tm-tiles"></div>

    <div class="win-toolbar">
        <div class="tabbar" id="tm-tabs">
            <button class="tab active" data-tab="containers">Containers</button>
            <button class="tab" data-tab="performance">Performance</button>
            <button class="tab" data-tab="stacks">Stacks</button>
            <button class="tab" data-tab="images">Images</button>
            <button class="tab" data-tab="volumes">Volumes</button>
        </div>
        <span class="spacer"></span>
        <input id="tm-filter" class="ui-input" type="search" placeholder="Filter…" />
        <button id="tm-refresh" class="ui-btn">Refresh</button>
    </div>

    <div id="tm-error" class="card" style="display:none;border-color:rgba(244,80,107,0.4);background:rgba(244,80,107,0.14);color:#ffb3c0;margin-bottom:0.8rem"></div>
    <div class="card" style="padding:0;overflow:hidden"><div id="tm-pane"></div></div>

    <div id="tm-logs" class="card" style="margin-top:1rem;display:none">
        <div style="display:flex;align-items:center;gap:0.6rem;margin-bottom:0.6rem">
            <strong id="tm-logs-title">Logs</strong>
            <span id="tm-logs-stat" class="mono fx-muted" style="color:var(--mat-text-muted)"></span>
            <span class="spacer" style="flex:1"></span>
            <button id="tm-logs-close" class="ui-btn">Close</button>
        </div>
        <div id="tm-logbox" class="logbox"></div>
    </div>
</div>

@section Head {
<style>
.tm-tiles { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:0.6rem; margin-bottom:1rem; }
.tm-tile { background:var(--mat-surface); border:1px solid var(--mat-border); border-radius:12px; padding:0.7rem 0.9rem; }
.tm-tile .k { color:var(--mat-text-muted); font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; }
.tm-tile .v { font-size:1.3rem; font-weight:800; font-variant-numeric:tabular-nums; }
.tabbar { display:flex; gap:0.15rem; }
.tab { border:none; background:transparent; padding:0.45rem 0.8rem; font:inherit; font-weight:600; color:var(--mat-text-muted); cursor:pointer; border-bottom:2px solid transparent; }
.tab.active { color:var(--mat-text); border-bottom-color:var(--mat-accent); }
table.tmt { width:100%; border-collapse:collapse; }
table.tmt th, table.tmt td { padding:0.5rem 0.85rem; text-align:left; white-space:nowrap; }
table.tmt thead th { font-size:0.78rem; color:var(--mat-text-muted); border-bottom:1px solid var(--mat-border); cursor:pointer; user-select:none; }
table.tmt thead th.num, table.tmt td.num { text-align:right; }
table.tmt tbody tr { border-bottom:1px solid var(--mat-border); }
table.tmt tbody tr:hover { background:rgba(255,255,255,0.05); }
.bar { position:relative; height:6px; border-radius:999px; background:rgba(255,255,255,0.12); overflow:hidden; min-width:60px; }
.bar > span { position:absolute; inset:0 auto 0 0; background:var(--mat-accent); }
/* Windows-style Performance tab: left sidebar of resources, right big graph + details */
.perf { display:grid; grid-template-columns:240px 1fr; min-height:420px; }
.perf-side { border-right:1px solid var(--mat-border); overflow-y:auto; padding:0.4rem 0; background:rgba(255,255,255,0.02); }
.perf-item { display:grid; grid-template-columns:1fr auto; grid-template-rows:auto auto; column-gap:0.5rem; padding:0.55rem 0.9rem; cursor:pointer; border-left:3px solid transparent; }
.perf-item:hover { background:rgba(255,255,255,0.05); }
.perf-item.selected { background:rgba(139,92,246,0.14); border-left-color:var(--mat-accent); }
.perf-item .lbl { font-size:0.82rem; font-weight:700; }
.perf-item .val { font-size:0.82rem; color:var(--mat-text-muted); font-variant-numeric:tabular-nums; text-align:right; }
.perf-item .spark { grid-column:1/-1; height:20px; margin-top:0.25rem; }
.perf-item.head .lbl { color:var(--mat-text-muted); font-size:0.7rem; text-transform:uppercase; letter-spacing:0.06em; }
.perf-item.head { cursor:default; padding-top:0.9rem; padding-bottom:0.2rem; }
.perf-item.head:hover { background:transparent; }
.perf-main { padding:1rem 1.2rem; display:flex; flex-direction:column; gap:0.6rem; min-width:0; }
.perf-h1 { font-size:1.05rem; font-weight:700; }
.perf-h2 { color:var(--mat-text-muted); font-size:0.78rem; margin-bottom:0.4rem; }
.perf-big { position:relative; height:220px; background:rgba(255,255,255,0.03); border:1px solid var(--mat-border); border-radius:8px; overflow:hidden; }
.perf-big .pchart { width:100%; height:100%; display:block; }
.perf-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:0.6rem; margin-top:0.6rem; }
.perf-stat { background:var(--mat-surface); border:1px solid var(--mat-border); border-radius:10px; padding:0.6rem 0.8rem; }
.perf-stat .k { font-size:0.7rem; color:var(--mat-text-muted); text-transform:uppercase; letter-spacing:0.05em; }
.perf-stat .v { font-size:1.15rem; font-weight:700; font-variant-numeric:tabular-nums; }
.tm-acts { display:flex; gap:0.3rem; justify-content:flex-end; }
.tm-acts .ui-btn { padding:0.28rem 0.5rem; font-size:0.78rem; }
</style>
}

@section Scripts {
<script>
(function(){
  const esc=s=>String(s==null?"":s).replace(/[&<>]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c]));
  const escA=s=>String(s==null?"":s).replace(/"/g,"&quot;");
  const fmtB=b=>{ if(b==null||b<0)return "—"; const u=["B","KB","MB","GB","TB"];let i=0,n=b;while(n>=1024&&i<u.length-1){n/=1024;i++;}return n.toFixed(n<10&&i>0?1:0)+" "+u[i]; };
  const openWin=(url,title,key)=>window.parent.postMessage({type:"matos:open",url,title,key},location.origin);

  let tab="containers", filter="", sort={key:"name",dir:1};
  let data={containers:[],stacks:[],images:[],volumes:[]};
  const stats=new Map(); const statStreams=new Map();
  // Per-resource history. "cpu" and "mem" are aggregates; "c:<id>" per container.
  const HISTORY=60; const hist=new Map(); hist.set("cpu",[]); hist.set("mem",[]);
  let perfSel="cpu";  // which resource is selected in the perf sidebar
  const focusId=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Focus));

  function pushHist(key, v){ let h=hist.get(key); if(!h){ h=[]; hist.set(key,h);} h.push(v); if(h.length>HISTORY) h.shift(); }

  document.querySelectorAll("#tm-tabs .tab").forEach(t=>t.addEventListener("click",()=>{
    document.querySelectorAll("#tm-tabs .tab").forEach(x=>x.classList.toggle("active",x===t));
    tab=t.dataset.tab; sort={key:"name",dir:1}; render();
  }));
  document.getElementById("tm-filter").addEventListener("input",e=>{ filter=e.target.value.toLowerCase(); render(); });
  document.getElementById("tm-refresh").addEventListener("click",loadAll);

  function stackNameOf(c){ return (c.name||""); } // display fallback
  function projectOf(c){ return c._project||""; }

  async function loadAll(){
    try{
      const [cs,ss,is,vs]=await Promise.all([
        fetch("/api/v1/docker/containers").then(r=>r.json()),
        fetch("/api/v1/docker/stacks").then(r=>r.json()),
        fetch("/api/v1/docker/images").then(r=>r.json()),
        fetch("/api/v1/docker/volumes").then(r=>r.json())
      ]);
      data.containers=cs.containers||[]; data.stacks=ss.stacks||[]; data.images=is.images||[]; data.volumes=vs.volumes||[];
      // annotate containers with their stack/project name
      const proj={}; for(const s of data.stacks) for(const c of (s.containers||[])) proj[c.id]=s.name;
      for(const c of data.containers) c._project=proj[c.id]||"";
      const err=cs.lastError||ss.lastError; const e=document.getElementById("tm-error");
      if(err){ e.style.display=""; e.textContent="Docker: "+err; } else e.style.display="none";
      tiles(); render(); syncStats();
      if(focusId){ const c=data.containers.find(x=>x.id===focusId||x.shortId===focusId); if(c) openLogs(c.id,c.name); }
    }catch(_){ const e=document.getElementById("tm-error"); e.style.display=""; e.textContent="Docker is not reachable."; }
  }

  function tiles(){
    const running=data.containers.filter(c=>c.running).length;
    const imgSize=data.images.reduce((a,i)=>a+(i.sizeBytes||0),0);
    const volSize=data.volumes.reduce((a,v)=>a+(v.sizeBytes>0?v.sizeBytes:0),0);
    document.getElementById("tm-tiles").innerHTML=`
      <div class="tm-tile"><div class="k">Containers</div><div class="v">${running}<span style="font-size:0.9rem;color:var(--mat-text-muted)"> / ${data.containers.length}</span></div></div>
      <div class="tm-tile"><div class="k">Stacks</div><div class="v">${data.stacks.length}</div></div>
      <div class="tm-tile"><div class="k">Images</div><div class="v">${data.images.length} <span style="font-size:0.8rem;color:var(--mat-text-muted)">${fmtB(imgSize)}</span></div></div>
      <div class="tm-tile"><div class="k">Volumes</div><div class="v">${data.volumes.length} <span style="font-size:0.8rem;color:var(--mat-text-muted)">${fmtB(volSize)}</span></div></div>`;
  }

  function sortHeader(label,key,num){ const arrow=sort.key===key?(sort.dir>0?" ▲":" ▼"):""; return `<th class="${num?'num':''}" data-sort="${key}">${label}${arrow}</th>`; }
  function applySort(rows,accessors){
    const a=accessors[sort.key]; if(!a) return rows;
    return rows.slice().sort((x,y)=>{ const vx=a(x),vy=a(y); if(vx<vy)return -1*sort.dir; if(vx>vy)return 1*sort.dir; return 0; });
  }
  function wireSort(){ document.querySelectorAll("#tm-pane th[data-sort]").forEach(th=>th.addEventListener("click",()=>{
    const k=th.dataset.sort; sort = sort.key===k?{key:k,dir:-sort.dir}:{key:k,dir:1}; render(); })); }

  function render(){
    const pane=document.getElementById("tm-pane");
    if(tab==="performance"){ pane.innerHTML=renderPerformance(); drawPerf(); return; }
    if(tab==="containers") pane.innerHTML=renderContainers();
    else if(tab==="stacks") pane.innerHTML=renderStacks();
    else if(tab==="images") pane.innerHTML=renderImages();
    else pane.innerHTML=renderVolumes();
    wireSort(); wireActions();
  }

  // ---- Containers ----
  function renderContainers(){
    let rows=data.containers.filter(c=>!filter||(c.name+c.image+c._project).toLowerCase().includes(filter));
    rows=applySort(rows,{ name:c=>c.name.toLowerCase(), image:c=>c.image.toLowerCase(), stack:c=>(c._project||"").toLowerCase(),
      state:c=>c.running?0:1, cpu:c=>(stats.get(c.id)?.cpu||0), mem:c=>(stats.get(c.id)?.mem||0) });
    const body=rows.map(c=>{
      const st=stats.get(c.id)||{};
      const ports=(c.ports||[]).map(p=>p.publicPort?`${p.publicPort}→${p.privatePort}`:`${p.privatePort}`).join(", ")||"—";
      return `<tr>
        <td>${c.running?'<span class="pill on">running</span>':'<span class="pill off">'+esc(c.state)+'</span>'}</td>
        <td><strong>${esc(c.name)}</strong></td>
        <td class="fx-muted">${esc(c._project||"—")}</td>
        <td class="mono" style="max-width:220px;overflow:hidden;text-overflow:ellipsis">${esc(c.image)}</td>
        <td class="num" data-cpu="${c.id}">${c.running?(st.cpu!=null?st.cpu.toFixed(1)+"%":"…"):"—"}</td>
        <td class="num" data-mem="${c.id}">${c.running?(st.mem!=null?fmtB(st.mem):"…"):"—"}</td>
        <td class="mono">${esc(ports)}</td>
        <td><div class="tm-acts">
          ${c.hasWebUi&&c.appUrl?`<button class="ui-btn" data-open="${escA(c.appUrl)}">Open</button>`:""}
          <button class="ui-btn" data-set="${c.id}" data-name="${escA(c.name)}">Settings</button>
          <button class="ui-btn" data-logs="${c.id}" data-name="${escA(c.name)}">Logs</button>
          ${c.running?`<button class="ui-btn" data-act="stop" data-id="${c.id}">Stop</button>`
                     :`<button class="ui-btn primary" data-act="start" data-id="${c.id}">Start</button>`}
        </div></td></tr>`;
    }).join("");
    return `<table class="tmt"><thead><tr>${sortHeader("State","state")}${sortHeader("Name","name")}${sortHeader("Stack","stack")}
      ${sortHeader("Image","image")}${sortHeader("CPU","cpu",true)}${sortHeader("Mem","mem",true)}<th>Ports</th><th></th></tr></thead>
      <tbody>${body||emptyRow(8)}</tbody></table>`;
  }

  // ---- Stacks ----
  function renderStacks(){
    let rows=data.stacks.filter(s=>!filter||s.name.toLowerCase().includes(filter));
    rows=applySort(rows,{ name:s=>s.name.toLowerCase(), state:s=>s.anyRunning?0:1, size:s=>s.total });
    const body=rows.map(s=>`<tr>
      <td>${s.anyRunning?`<span class="pill on">${s.running}/${s.total}</span>`:`<span class="pill off">stopped</span>`}</td>
      <td><strong>${esc(s.name)}</strong>${s.standalone?' <span class="fx-muted" style="font-size:0.75rem">(standalone)</span>':''}</td>
      <td class="num">${s.total}</td>
      <td>${s.matosManaged?'<span class="pill on">matOS</span>':'<span class="fx-muted">—</span>'}</td>
      <td><div class="tm-acts">
        <button class="ui-btn" data-set-stack="${escA(s.name)}">Settings</button>
        ${s.anyRunning?`<button class="ui-btn" data-sa="stop" data-name="${escA(s.name)}">Stop all</button><button class="ui-btn" data-sa="restart" data-name="${escA(s.name)}">Restart</button>`
                      :`<button class="ui-btn primary" data-sa="start" data-name="${escA(s.name)}">Start all</button>`}
      </div></td></tr>`).join("");
    return `<table class="tmt"><thead><tr>${sortHeader("State","state")}${sortHeader("Stack","name")}${sortHeader("Containers","size",true)}<th>Managed</th><th></th></tr></thead>
      <tbody>${body||emptyRow(5)}</tbody></table>`;
  }

  // ---- Images ----
  function renderImages(){
    let rows=data.images.filter(i=>!filter||(i.repository+i.tag).toLowerCase().includes(filter));
    rows=applySort(rows,{ repository:i=>i.repository.toLowerCase(), tag:i=>i.tag.toLowerCase(), size:i=>i.sizeBytes, created:i=>i.createdUtc });
    const body=rows.map(i=>`<tr>
      <td class="mono">${esc(i.repository)}</td><td class="mono">${esc(i.tag)}</td>
      <td class="mono fx-muted">${esc(i.shortId)}</td>
      <td class="num">${fmtB(i.sizeBytes)}</td>
      <td class="fx-muted">${(i.createdUtc||"").replace("T"," ").replace(/\..*/,"")}</td></tr>`).join("");
    return `<table class="tmt"><thead><tr>${sortHeader("Repository","repository")}${sortHeader("Tag","tag")}<th>Image ID</th>${sortHeader("Size","size",true)}${sortHeader("Created","created")}</tr></thead>
      <tbody>${body||emptyRow(5)}</tbody></table>`;
  }

  // ---- Volumes ----
  function renderVolumes(){
    let rows=data.volumes.filter(v=>!filter||v.name.toLowerCase().includes(filter));
    rows=applySort(rows,{ name:v=>v.name.toLowerCase(), size:v=>(v.sizeBytes>0?v.sizeBytes:0) });
    const body=rows.map(v=>`<tr>
      <td class="mono">${esc(v.name)}</td>
      <td class="num">${fmtB(v.sizeBytes)}</td>
      <td>${v.inUse?'<span class="pill on">in use</span>':'<span class="fx-muted">unused</span>'}</td>
      <td class="fx-muted mono" style="max-width:260px;overflow:hidden;text-overflow:ellipsis">${(v.usedBy||[]).map(esc).join(", ")||"—"}</td>
      <td><div class="tm-acts"><button class="ui-btn" data-files="${escA(v.name)}">Browse files</button></div></td></tr>`).join("");
    return `<table class="tmt"><thead><tr>${sortHeader("Volume","name")}${sortHeader("Size","size",true)}<th>Status</th><th>Used by</th><th></th></tr></thead>
      <tbody>${body||emptyRow(5)}</tbody></table>`;
  }

  function emptyRow(cols){ return `<tr><td colspan="${cols}" style="padding:1rem;color:var(--mat-text-muted)">Nothing here.</td></tr>`; }

  function wireActions(){
    const q=s=>document.querySelectorAll("#tm-pane "+s);
    q("[data-act]").forEach(b=>b.addEventListener("click",()=>cAction(b.dataset.id,b.dataset.act)));
    q("[data-sa]").forEach(b=>b.addEventListener("click",()=>sAction(b.dataset.name,b.dataset.sa)));
    q("[data-open]").forEach(b=>b.addEventListener("click",()=>window.open(b.dataset.open,"_blank","noopener")));
    q("[data-set]").forEach(b=>b.addEventListener("click",()=>openWin("/apps/container/"+encodeURIComponent(b.dataset.set),"Container · "+b.dataset.name,"container:"+b.dataset.set)));
    q("[data-set-stack]").forEach(b=>b.addEventListener("click",()=>openWin("/apps/stack/"+encodeURIComponent(b.dataset.setStack),"Stack · "+b.dataset.setStack,"set:"+b.dataset.setStack)));
    q("[data-files]").forEach(b=>b.addEventListener("click",()=>openWin("/apps/files?volume="+encodeURIComponent(b.dataset.files),"Files","files")));
    q("[data-logs]").forEach(b=>b.addEventListener("click",()=>openLogs(b.dataset.logs,b.dataset.name)));
  }
  async function cAction(id,a){ try{ await fetch(`/api/v1/docker/containers/${id}/${a}`,{method:"POST"});}catch(_){ } setTimeout(loadAll,700); }
  async function sAction(name,a){ try{ await fetch(`/api/v1/docker/stacks/${encodeURIComponent(name)}/${a}`,{method:"POST"});}catch(_){ } setTimeout(loadAll,700); }

  // ---- live stats: one stream per running container, kept in sync with the data ----
  function syncStats(){
    const running=new Set(data.containers.filter(c=>c.running).slice(0,60).map(c=>c.id));
    for(const [id,src] of statStreams){ if(!running.has(id)){ try{src.close();}catch(_){} statStreams.delete(id); stats.delete(id); hist.delete("c:"+id); } }
    for(const id of running){ if(statStreams.has(id))continue;
      const src=new EventSource(`/api/v1/docker/containers/${id}/stats/stream`);
      src.addEventListener("stat",e=>{ try{ const s=JSON.parse(e.data);
        const cpu=+s.cpuPercent||0, mem=+s.memoryBytes||0, lim=+s.memoryLimitBytes||0;
        stats.set(id,{cpu,mem,lim});
        pushHist("c:"+id, cpu);
        const cc=document.querySelector(`#tm-pane [data-cpu="${id}"]`); const mc=document.querySelector(`#tm-pane [data-mem="${id}"]`);
        if(cc)cc.textContent=cpu.toFixed(1)+"%"; if(mc)mc.textContent=fmtB(mem);
      }catch(_){}} );
      src.onerror=()=>{}; statStreams.set(id,src);
    }
  }

  // ---- Performance tab: Windows-style sidebar + detail view ----
  function perfItems(){
    const running=data.containers.filter(c=>c.running);
    const items=[{id:"cpu",label:"CPU",kind:"overview",color:"#8b5cf6",unit:"%"},
                 {id:"mem",label:"Memory",kind:"overview",color:"#22b8ff",unit:"B"}];
    for(const c of running) items.push({id:"c:"+c.id,label:c.name,kind:"container",cid:c.id,color:"#34d399",unit:"%"});
    return items;
  }
  function currentValue(it){
    if(it.id==="cpu"){ let s=0; for(const [,v] of stats) s+=v.cpu||0; return s; }
    if(it.id==="mem"){ let s=0; for(const [,v] of stats) s+=v.mem||0; return s; }
    const st=stats.get(it.cid); return st?st.cpu||0:0;
  }
  function fmtVal(it,v){ return it.unit==="B"?fmtB(v):(v||0).toFixed(1)+"%"; }
  function renderPerformance(){
    const its=perfItems();
    // Auto-select first item if the previously selected one is gone
    if(!its.find(x=>x.id===perfSel)) perfSel=its[0]?.id||"cpu";
    const side=its.map(it=>{
      const cur=currentValue(it); const h=hist.get(it.id)||[]; const max=it.unit==="B"?Math.max(1,...h,cur):Math.max(100,...h,cur);
      const group = (its[0]===it || (its[its.indexOf(it)-1]?.kind!==it.kind))
        ? `<div class="perf-item head"><span class="lbl">${it.kind==="overview"?"Overview":"Containers"}</span></div>` : "";
      return group+`<div class="perf-item ${it.id===perfSel?'selected':''}" data-perf="${escA(it.id)}">
        <span class="lbl" style="overflow:hidden;text-overflow:ellipsis">${esc(it.label)}</span>
        <span class="val">${fmtVal(it,cur)}</span>
        <span class="spark" data-spark="${escA(it.id)}"></span></div>`;
    }).join("");
    return `<div class="perf">
      <div class="perf-side" id="perf-side">${side}</div>
      <div class="perf-main" id="perf-main"></div></div>`;
  }
  function areaChart(el,d,o){
    const W=600,H=200,n=d.length,max=o.max||1;
    const pad=[["M0",H],...(n?d.map((v,i)=>{const x=n>1?i*(W/(n-1)):W/2; const y=H-Math.min(1,(v||0)/max)*H; return ["L"+x.toFixed(1),y.toFixed(1)];}):[]),["L"+W,H]];
    const line=n>1 ? d.map((v,i)=>{const x=i*(W/(n-1)); const y=H-Math.min(1,(v||0)/max)*H; return (i?"L":"M")+x.toFixed(1)+" "+y.toFixed(1);}).join(" ") : "";
    const area=pad.map(p=>p.join(" ")).join(" ")+" Z";
    el.innerHTML=`<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" class="pchart">
      <defs><linearGradient id="${o.id}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${o.color}" stop-opacity="0.35"/><stop offset="1" stop-color="${o.color}" stop-opacity="0"/></linearGradient></defs>
      ${[0.25,0.5,0.75].map(f=>`<line x1="0" y1="${H*f}" x2="${W}" y2="${H*f}" stroke="rgba(255,255,255,0.06)"/>`).join("")}
      <path d="${area}" fill="url(#${o.id})"/>${line?`<path d="${line}" fill="none" stroke="${o.color}" stroke-width="2" vector-effect="non-scaling-stroke"/>`:""}</svg>`;
  }
  function miniSpark(el,d,color){
    const W=200,H=20,n=d.length; if(!n){ el.innerHTML=""; return; }
    const max=Math.max(1,...d);
    const line=d.map((v,i)=>{const x=n>1?i*(W/(n-1)):W/2; const y=H-Math.min(1,(v||0)/max)*(H-2)-1; return (i?"L":"M")+x.toFixed(1)+" "+y.toFixed(1);}).join(" ");
    el.innerHTML=`<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" style="width:100%;height:100%"><path d="${line}" fill="none" stroke="${color}" stroke-width="1.5" vector-effect="non-scaling-stroke"/></svg>`;
  }
  function drawPerf(){
    const its=perfItems();
    // update sparklines in the sidebar
    for(const it of its){ const el=document.querySelector(`#perf-side [data-spark="${CSS.escape(it.id)}"]`); if(el) miniSpark(el, hist.get(it.id)||[], it.color); }
    // update per-item live values in the sidebar
    for(const it of its){ const row=document.querySelector(`#perf-side [data-perf="${CSS.escape(it.id)}"] .val`); if(row) row.textContent=fmtVal(it,currentValue(it)); }
    // main pane for selected
    const sel=its.find(x=>x.id===perfSel)||its[0]; if(!sel){ document.getElementById("perf-main").innerHTML=""; return; }
    const h=hist.get(sel.id)||[]; const cur=currentValue(sel); const peak=h.length?Math.max(...h):cur; const avg=h.length?h.reduce((a,b)=>a+b,0)/h.length:cur;
    const max = sel.unit==="B" ? Math.max(1, peak, cur) : Math.max(100, peak, cur);
    const containersRunning=data.containers.filter(c=>c.running).length;
    const details = sel.kind==="overview"
      ? [ ["Current", fmtVal(sel,cur)], ["Peak", fmtVal(sel,peak)], ["Average", fmtVal(sel,avg)], ["Containers", containersRunning+" running"] ]
      : (()=>{ const st=stats.get(sel.cid)||{}; const c=data.containers.find(x=>x.id===sel.cid);
              const mem=st.mem||0, lim=st.lim||0;
              return [ ["CPU", (st.cpu||0).toFixed(1)+"%"], ["Memory", fmtB(mem)+(lim?` / ${fmtB(lim)}`:"")], ["Peak CPU", peak.toFixed(1)+"%"], ["Image", c?c.image:"—"] ]; })();
    document.getElementById("perf-main").innerHTML = `
      <div class="perf-h1">${esc(sel.label)}</div>
      <div class="perf-h2">${sel.kind==="overview"?"Aggregate across all running containers":"Container"} · last ${HISTORY} samples · 2s each</div>
      <div class="perf-big" id="perf-big"></div>
      <div class="perf-grid">${details.map(([k,v])=>`<div class="perf-stat"><div class="k">${esc(k)}</div><div class="v">${esc(String(v))}</div></div>`).join("")}</div>`;
    const big=document.getElementById("perf-big"); if(big) areaChart(big,h,{max,color:sel.color,id:"gbig"});
    // wire clicks
    document.querySelectorAll("#perf-side [data-perf]").forEach(el=>el.addEventListener("click",()=>{ perfSel=el.dataset.perf; drawPerf(); document.querySelectorAll("#perf-side [data-perf]").forEach(x=>x.classList.toggle("selected",x.dataset.perf===perfSel)); }));
  }

  // ---- logs drawer ----
  let logSrc=null,statSrc=null;
  function openLogs(id,name){
    document.getElementById("tm-logs").style.display="";
    document.getElementById("tm-logs-title").textContent="Logs · "+name;
    const box=document.getElementById("tm-logbox"); box.textContent="";
    const st=document.getElementById("tm-logs-stat"); st.textContent="";
    if(logSrc)logSrc.close(); if(statSrc)statSrc.close();
    logSrc=new EventSource(`/api/v1/docker/containers/${id}/logs/stream?tail=200`);
    logSrc.addEventListener("log",e=>{ box.textContent+=e.data+"\n"; box.scrollTop=box.scrollHeight; });
    statSrc=new EventSource(`/api/v1/docker/containers/${id}/stats/stream`);
    statSrc.addEventListener("stat",e=>{ try{const s=JSON.parse(e.data); st.textContent=`CPU ${s.cpuPercent}% · MEM ${fmtB(s.memoryBytes)} (${s.memoryPercent}%)`;}catch(_){}} );
  }
  document.getElementById("tm-logs-close").addEventListener("click",()=>{ if(logSrc)logSrc.close(); if(statSrc)statSrc.close(); document.getElementById("tm-logs").style.display="none"; });

  setInterval(()=>{ let tc=0,tm=0; for(const c of data.containers){ if(c.running){ const s=stats.get(c.id); if(s){ tc+=s.cpu||0; tm+=s.mem||0; } } }
    pushHist("cpu",tc); pushHist("mem",tm);
    if(tab==="performance") drawPerf(); }, 2000);
  loadAll(); setInterval(loadAll,10000);
})();
</script>
}

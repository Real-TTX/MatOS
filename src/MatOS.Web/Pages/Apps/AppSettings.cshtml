@page "/apps/app/{id}"
@model MatOS.Web.Pages.Apps.AppSettingsModel
@{
    ViewData["Title"] = "App";
    Layout = "_WindowLayout";
}

<div id="as" data-id="@Model.Id">
    <div class="as-head">
        <span class="as-ico" id="as-ico">📦</span>
        <div style="flex:1 1 auto;min-width:0">
            <h1 id="as-name" style="margin:0;font-size:1.2rem">Loading…</h1>
            <div class="mono fx-muted" id="as-sub" style="font-size:0.8rem"></div>
        </div>
        <span id="as-state" class="pill"></span>
    </div>

    <div id="as-err" class="card" style="display:none;border-color:rgba(244,80,107,0.4);background:rgba(244,80,107,0.14);color:#ffb3c0;margin-bottom:0.8rem"></div>

    <div class="card" style="margin-bottom:1rem">
        <div class="as-row"><div><strong>Freigabe (external access)</strong><div class="fx-muted" style="font-size:0.8rem">Publish this app so it's reachable from outside matOS (reverse-proxy hostname).</div></div>
            <div id="as-pub"></div></div>
    </div>

    <div class="card" id="as-actions-card" style="margin-bottom:1rem;display:none">
        <strong>Actions</strong><div class="fx-muted" style="font-size:0.8rem;margin-bottom:0.5rem">The app's right-click actions.</div>
        <div id="as-actions" style="display:flex;flex-wrap:wrap;gap:0.4rem"></div>
    </div>

    <div class="card" style="margin-bottom:1rem">
        <strong>Lifecycle</strong>
        <div style="display:flex;gap:0.4rem;flex-wrap:wrap;margin-top:0.5rem" id="as-life"></div>
    </div>

    <div class="card" style="margin-bottom:1rem">
        <strong>Advanced</strong><div class="fx-muted" style="font-size:0.8rem;margin-bottom:0.5rem">Dig into the technical settings.</div>
        <div style="display:flex;gap:0.4rem;flex-wrap:wrap" id="as-adv"></div>
    </div>

    <div class="card" style="border-color:rgba(244,80,107,0.35)">
        <strong style="color:#ffb3c0">Danger zone</strong>
        <div style="display:flex;align-items:center;gap:0.8rem;margin-top:0.5rem;flex-wrap:wrap">
            <button class="ui-btn danger" id="as-uninstall">Uninstall app</button>
            <span class="fx-muted" style="font-size:0.82rem">Removes the app's container(s). You'll be asked about its data volumes.</span>
        </div>
    </div>
</div>

@section Head {
<style>
.as-head { display:flex; align-items:center; gap:0.9rem; margin-bottom:1rem; }
.as-ico { width:56px; height:56px; border-radius:14px; display:grid; place-items:center; font-size:1.9rem; overflow:hidden; background:var(--mat-surface-2); border:1px solid var(--mat-border); flex:0 0 auto; }
.as-ico img { width:100%; height:100%; object-fit:cover; }
.as-row { display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; }
.as-pub-in { display:flex; gap:0.4rem; align-items:center; } .as-pub-in input { width:230px; }
</style>
}

@section Scripts {
<script>
(function(){
  const id=document.getElementById("as").dataset.id;
  const esc=s=>String(s==null?"":s).replace(/[&<>]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c]));
  const escA=s=>String(s==null?"":s).replace(/"/g,"&quot;");
  const isImg=s=>/^(https?:|data:)/i.test(s||"");
  const iconHtml=ic=> isImg(ic)?`<img src="${escA(ic)}">`:`<span>${esc(ic||"📦")}</span>`;
  const openWin=(url,title,key)=>window.parent.postMessage({type:"matos:open",url,title,key},location.origin);
  const err=t=>{ const e=document.getElementById("as-err"); e.style.display=""; e.textContent=t; };
  let cur=null;

  async function load(){
    let d,routes,catalog; try{
      d=await (await fetch(`/api/v1/docker/containers/${id}/inspect`)).json();
      routes=await (await fetch("/api/v1/docker/routes")).json();
      catalog=await (await fetch("/api/v1/store/catalog")).json();
    }catch(_){ document.getElementById("as-name").textContent="Not found"; return; }
    const c=d.info; const appId=c.matosApp||""; const def=(catalog.apps||[]).find(a=>a.id===appId);
    const route=(routes.routes||[]).find(r=>r.id===id) || {};
    const project=d.composeProject||""; const isCompose=project.startsWith("matos-");
    cur={id,appId,project,isCompose,def,title:c.matosTitle||(def&&def.name)||c.name};
    document.getElementById("as-ico").innerHTML=iconHtml(def?def.icon:"📦");
    document.getElementById("as-name").textContent=cur.title;
    document.getElementById("as-sub").textContent=(isCompose?"Compose stack · "+project:"Single container")+" · "+c.image;
    const st=document.getElementById("as-state"); st.textContent=c.running?"running":c.state; st.className="pill "+(c.running?"on":"off");
    document.title="App · "+cur.title;

    // Freigabe
    const base=routes.baseDomain||"apps.localhost";
    const suggested=route.host || (appId? `${appId}.${base}`:`${c.name}.${base}`);
    document.getElementById("as-pub").innerHTML = route.published
      ? `<div class="as-pub-in"><a href="//${escA(route.host)}" target="_blank" rel="noopener" class="mono">${esc(route.host)}</a> <button class="ui-btn danger" id="as-unpub">Unpublish</button></div>`
      : `<div class="as-pub-in"><input class="ui-input mono" id="as-host" value="${escA(suggested)}"><button class="ui-btn primary" id="as-pub-btn">Publish</button></div>`;
    const pb=document.getElementById("as-pub-btn"); if(pb) pb.addEventListener("click",()=>publish(true,document.getElementById("as-host").value.trim(),pb));
    const ub=document.getElementById("as-unpub"); if(ub) ub.addEventListener("click",()=>publish(false,"",ub));

    // actions
    if(def && def.actions && def.actions.length){ document.getElementById("as-actions-card").style.display="";
      document.getElementById("as-actions").innerHTML=def.actions.map(a=>`<button class="ui-btn" data-a="${escA(a.url)}" data-l="${escA(a.label)}">${esc(a.label)}</button>`).join("");
      document.querySelectorAll("#as-actions [data-a]").forEach(b=>b.addEventListener("click",()=>{ let u=b.dataset.a; if(!/^https?:/i.test(u)&&!u.startsWith("//")){ if(!c.appUrl){ err("The app's web UI must be running for relative actions."); return; } u=c.appUrl.replace(/\/+$/,"")+(u.startsWith("/")?u:"/"+u); } openWin(u,cur.title+" · "+b.dataset.l,"act"); })); }

    // lifecycle
    const life=document.getElementById("as-life");
    life.innerHTML=(c.running?`<button class="ui-btn" data-life="stop">Stop</button><button class="ui-btn" data-life="restart">Restart</button>`:`<button class="ui-btn primary" data-life="start">Start</button>`)
      + (c.appUrl?`<button class="ui-btn" id="as-open">Open</button>`:"");
    life.querySelectorAll("[data-life]").forEach(b=>b.addEventListener("click",()=>lifecycle(b.dataset.life)));
    const ob=document.getElementById("as-open"); if(ob) ob.addEventListener("click",()=>window.open(c.appUrl,"_blank","noopener"));

    // advanced
    const adv=document.getElementById("as-adv"); adv.innerHTML="";
    if(isCompose) adv.innerHTML+=`<button class="ui-btn" id="as-stack">Stack settings</button>`;
    adv.innerHTML+=`<button class="ui-btn" id="as-cont">Container settings</button>`;
    if(def && !def.builtIn) adv.innerHTML+=`<button class="ui-btn" id="as-edit">Edit definition in Store</button>`;
    const sb=document.getElementById("as-stack"); if(sb) sb.addEventListener("click",()=>openWin("/apps/stack/"+encodeURIComponent(project),"Stack · "+cur.title,"set:"+project));
    document.getElementById("as-cont").addEventListener("click",()=>openWin("/apps/container/"+encodeURIComponent(id),"Container · "+c.name,"container:"+id));
    const eb=document.getElementById("as-edit"); if(eb) eb.addEventListener("click",()=>openWin("/apps/store","Store","store"));
  }

  async function publish(enabled,hostname,btn){ const o=btn.innerHTML; btn.disabled=true; btn.textContent=enabled?"Publishing…":"Updating…";
    try{ const r=await fetch("/api/v1/store/publish",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id,enabled,hostname})}); if(!r.ok){const e=await r.json().catch(()=>({}));throw new Error(e.detail||r.status);} setTimeout(load,2500);
    }catch(e){ err("Publish failed: "+e.message); btn.disabled=false; btn.innerHTML=o; } }
  async function lifecycle(action){ const url=cur.isCompose?`/api/v1/docker/stacks/${encodeURIComponent(cur.project)}/${action}`:`/api/v1/docker/containers/${id}/${action}`;
    try{ await fetch(url,{method:"POST"}); }catch(_){ } setTimeout(load,800); }
  document.getElementById("as-uninstall").addEventListener("click",async()=>{
    if(!await matDialog.confirm("Uninstall this app? Its container(s) will be removed.",{title:"Uninstall",danger:true,okLabel:"Uninstall"}))return; const rmVol=await matDialog.confirm("Also delete this app's data volumes? This cannot be undone.",{title:"Delete data?",danger:true,okLabel:"Delete data",cancelLabel:"Keep data"});
    try{ const r=await fetch("/api/v1/store/uninstall",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id,removeVolume:rmVol})}); if(!r.ok){const e=await r.json().catch(()=>({}));throw new Error(e.detail||r.status);}
      document.getElementById("as-name").textContent="(uninstalled)"; window.parent.postMessage({type:"matos:refresh"},location.origin);
    }catch(e){ err("Uninstall failed: "+e.message); } });

  load(); setInterval(load,6000);
})();
</script>
}

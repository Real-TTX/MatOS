@page "/apps/store"
@model MatOS.Web.Pages.Apps.StoreModel
@{
    ViewData["Title"] = "App Store";
    ViewData["Description"] = "Install apps as containers or Compose stacks. Add your own with an icon, actions and a setup wizard.";
    Layout = "_WindowLayout";
}

<div id="store" class="store-shell">
    <aside class="store-side">
        <div class="store-brand"><span aria-hidden="true">🏬</span> App Store</div>
        <div class="store-search-wrap"><span aria-hidden="true">🔎</span><input id="store-search" type="search" placeholder="Search apps…" autocomplete="off" aria-label="Search apps" /></div>
        <nav class="store-nav" id="store-nav">
            <button class="store-nav-btn active" data-tab="catalog"><span class="i" aria-hidden="true">✨</span> Discover</button>
            <button class="store-nav-btn" data-tab="installed"><span class="i" aria-hidden="true">📥</span> Installed <span id="store-count" class="store-nav-count"></span></button>
            <button class="store-nav-btn" data-tab="add"><span class="i" aria-hidden="true">＋</span> Add app</button>
            <button class="store-nav-btn" data-tab="sources"><span class="i" aria-hidden="true">🔗</span> Sources</button>
        </nav>
        <div class="store-cats-head">Categories</div>
        <nav class="store-cats" id="store-cats"></nav>
    </aside>
    <section class="store-main">
        <div id="store-msg" class="card" style="display:none;margin-bottom:1rem"></div>
        <div id="store-catalog"></div>
        <div id="store-detail" style="display:none"></div>
        <div id="store-installed" style="display:none"></div>

    <div id="store-sources" style="display:none">
        <div class="card" style="max-width:760px">
            <h2 style="margin:0 0 0.3rem;font-size:1rem">Remote catalog sources</h2>
            <p class="fx-muted" style="margin:0 0 1rem;font-size:0.85rem">Add a URL to an <span class="mono">index.json</span> (or a base URL/Git raw folder that contains one). Its apps appear in Discover. Compose files may embed an <span class="mono">x-matos</span> block; icons can be a file next to the compose (e.g. <span class="mono">icon.png</span>).</p>
            <div class="grid-src">
                <input id="src-name" class="ui-input" placeholder="Name (optional)" />
                <input id="src-url" class="ui-input mono" placeholder="https://raw.githubusercontent.com/user/repo/main/" />
                <button class="ui-btn primary" id="src-add">Add &amp; sync</button>
            </div>
            <div id="src-list" style="margin-top:1rem"></div>
        </div>
    </div>

    <div id="store-add" style="display:none">
        <div class="card" style="max-width:720px">
            <h2 style="margin:0 0 0.9rem;font-size:1rem" id="add-title">Add an app</h2>
            <input type="hidden" id="a-id" />
            <label class="fl"><span>Type</span>
                <select id="a-kind" class="ui-select"><option value="image">Single image</option><option value="compose">Compose stack (YAML)</option></select>
            </label>
            <div class="grid2">
                <label class="fl"><span>Display name @Html.Raw("<span class='fx-muted'>(or x-matos: name)</span>")</span><input id="a-name" class="ui-input" placeholder="My App" /></label>
                <label class="fl"><span>Category</span><input id="a-cat" class="ui-input" placeholder="Custom" /></label>
            </div>

            <div id="a-image-fields">
                <div class="grid2">
                    <label class="fl"><span>Docker image *</span><input id="a-image" class="ui-input mono" placeholder="nginx:alpine" /></label>
                    <label class="fl"><span>UI port</span><input id="a-port" class="ui-input" type="number" value="80" /></label>
                </div>
                <div class="grid2">
                    <label class="fl"><span>Volumes <span class="fx-muted">(one path/line)</span></span><textarea id="a-vols" class="ui-input mono" rows="2" placeholder="/data"></textarea></label>
                    <label class="fl"><span>Environment <span class="fx-muted">(KEY=value/line)</span></span><textarea id="a-env" class="ui-input mono" rows="2" placeholder="TZ=Europe/Berlin"></textarea></label>
                </div>
            </div>

            <div id="a-compose-fields" style="display:none">
                <label class="fl"><span>docker-compose.yml *</span><textarea id="a-compose" class="ui-input mono" rows="10" placeholder="x-matos:&#10;  name: MyApp&#10;  ui: { service: web, port: 8080 }&#10;services:&#10;  web:&#10;    image: nginx:alpine"></textarea></label>
                <div class="grid2">
                    <label class="fl"><span>UI service <span class="fx-muted">(blank = first)</span></span><input id="a-uisvc" class="ui-input mono" placeholder="web" /></label>
                    <label class="fl"><span>UI port</span><input id="a-cport" class="ui-input" type="number" value="80" /></label>
                </div>
                <div class="fl">
                    <span>Setup variables <span class="fx-muted">(asked on install → env for ${KEY}; or declare in x-matos: variables)</span></span>
                    <div id="a-vars"></div>
                    <button type="button" class="ui-btn" id="a-add-var" style="align-self:flex-start;margin-top:0.4rem">+ Add variable</button>
                </div>
            </div>

            <label class="fl"><span>Tagline</span><input id="a-tag" class="ui-input" placeholder="Short one-liner" /></label>
            <label class="fl"><span>Description</span><textarea id="a-desc" class="ui-input" rows="2"></textarea></label>
            <div class="fl">
                <span>Icon <span class="fx-muted">(emoji, image URL, or upload → base64)</span></span>
                <div style="display:flex;align-items:center;gap:0.6rem">
                    <span class="app-ico" id="a-icon-prev" style="width:44px;height:44px">📦</span>
                    <input id="a-icon" class="ui-input" placeholder="📦  or  https://…/icon.png" style="flex:1" />
                    <button type="button" class="ui-btn" id="a-icon-upload">Upload…</button>
                    <input type="file" id="a-icon-file" accept="image/*" hidden />
                </div>
            </div>
            <div class="fl">
                <span>Right-click actions <span class="fx-muted">(label + URL — e.g. Administration → /admin)</span></span>
                <div id="a-actions"></div>
                <button type="button" class="ui-btn" id="a-add-action" style="align-self:flex-start;margin-top:0.4rem">+ Add action</button>
            </div>
            <div style="display:flex;gap:0.6rem;margin-top:1rem">
                <button class="ui-btn primary" id="a-save">Save app</button>
                <button class="ui-btn" id="a-cancel">Reset</button>
            </div>
        </div>
    </div>
    </section>
</div>

@section Head {
<style>
/* ---- Apple-App-Store-style layout: sidebar (search + nav + categories) | main (hero + rows) ---- */
.store-shell { display:flex; gap:1.4rem; align-items:flex-start; }
.store-side { flex:0 0 210px; position:sticky; top:0; display:flex; flex-direction:column; gap:0.4rem; }
.store-brand { display:flex; align-items:center; gap:0.4rem; font-weight:850; font-size:1.1rem; letter-spacing:-0.02em; padding:0.1rem 0.4rem 0.5rem; }
.store-search-wrap { display:flex; align-items:center; gap:0.4rem; background:var(--mat-surface-2); border:1px solid var(--mat-border); border-radius:11px; padding:0.45rem 0.65rem; }
.store-search-wrap input { flex:1; min-width:0; border:none; background:transparent; color:var(--mat-text); font:inherit; outline:none; }
.store-nav { display:flex; flex-direction:column; gap:0.12rem; margin-top:0.6rem; }
.store-nav-btn { display:flex; align-items:center; gap:0.55rem; border:none; background:transparent; color:var(--mat-text-muted); font:inherit; font-weight:650; text-align:left; padding:0.5rem 0.65rem; border-radius:10px; cursor:pointer; }
.store-nav-btn .i { width:1.2rem; text-align:center; }
.store-nav-btn:hover { background:var(--mat-surface-2); color:var(--mat-text); }
.store-nav-btn.active { background:var(--mat-accent); color:#fff; }
.store-nav-count { margin-left:auto; font-size:0.78rem; opacity:0.85; }
.store-cats-head { margin-top:1rem; padding:0 0.65rem 0.2rem; font-size:0.68rem; font-weight:850; text-transform:uppercase; letter-spacing:0.08em; color:var(--mat-text-muted); }
.store-cats { display:flex; flex-direction:column; gap:0.05rem; }
.store-cat-btn { display:flex; align-items:center; gap:0.5rem; border:none; background:transparent; color:var(--mat-text-muted); font:inherit; text-align:left; padding:0.4rem 0.65rem; border-radius:10px; cursor:pointer; font-size:0.9rem; }
.store-cat-btn:hover { background:var(--mat-surface-2); color:var(--mat-text); }
.store-cat-btn.active { color:var(--mat-text); font-weight:750; background:var(--mat-surface-2); }
.store-main { flex:1 1 auto; min-width:0; }
.store-hero { position:relative; overflow:hidden; border-radius:20px; padding:1.7rem 1.9rem; margin-bottom:1.5rem; background:linear-gradient(120deg, var(--mat-accent) 0%, #c026d3 100%); color:#fff; box-shadow:0 16px 40px color-mix(in srgb, var(--mat-accent), transparent 65%); }
.store-hero .eyebrow { text-transform:uppercase; letter-spacing:0.14em; font-size:0.7rem; font-weight:850; opacity:0.9; }
.store-hero h1 { margin:0.35rem 0 0.4rem; font-size:1.9rem; letter-spacing:-0.03em; line-height:1.1; }
.store-hero p { margin:0; opacity:0.94; max-width:560px; font-size:0.95rem; }
.store-hero .glyph { position:absolute; right:-0.5rem; top:50%; transform:translateY(-50%); font-size:8rem; opacity:0.18; pointer-events:none; }
.store-sec-head { display:flex; align-items:baseline; gap:0.6rem; margin:1.5rem 0 0.8rem; }
.store-sec-head:first-child { margin-top:0; }
.store-sec-head h2 { margin:0; font-size:1.2rem; letter-spacing:-0.01em; }
.store-sec-head .cnt { color:var(--mat-text-muted); font-size:0.82rem; }
.store-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(320px,1fr)); gap:0.7rem; }
.app-row { display:flex; align-items:center; gap:0.85rem; background:var(--mat-surface); border:1px solid var(--mat-border); border-radius:15px; padding:0.75rem 0.9rem; transition:border-color .12s, background .12s; cursor:pointer; }
.app-row:hover { border-color:var(--mat-border-strong); background:var(--mat-surface-2); }
.app-row > .app-ico { width:58px; height:58px; border-radius:15px; font-size:1.9rem; }
.app-row .g { flex:1 1 auto; min-width:0; }
.app-row .g h3 { margin:0; font-size:1rem; display:flex; align-items:center; gap:0.35rem; }
.app-row .g .tag { color:var(--mat-text-muted); font-size:0.82rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.app-row .acts { display:flex; align-items:center; gap:0.3rem; flex:0 0 auto; }
.app-row .acts .ui-btn { border-radius:999px; padding:0.4rem 0.95rem; font-weight:750; }
@@media (max-width:760px){ .store-shell { flex-direction:column; } .store-side { flex:none; width:100%; position:static; } }
/* ---- App detail page ---- */
.store-crumb { display:flex; align-items:center; gap:0.4rem; flex-wrap:wrap; font-size:0.85rem; color:var(--mat-text-muted); margin-bottom:1.1rem; }
.store-crumb a { color:var(--mat-accent); cursor:pointer; }
.store-crumb a:hover { text-decoration:underline; }
.store-crumb .sep { opacity:0.5; }
.store-crumb .cur { color:var(--mat-text); font-weight:600; }
.store-detail-head { display:flex; align-items:center; gap:1.1rem; margin-bottom:1.4rem; flex-wrap:wrap; }
.detail-ico { width:88px; height:88px; border-radius:22px; display:grid; place-items:center; font-size:3rem; overflow:hidden; background:var(--mat-surface-2); border:1px solid var(--mat-border); flex:0 0 auto; }
.detail-ico img { width:100%; height:100%; object-fit:cover; }
.store-detail-head .g { flex:1 1 auto; min-width:200px; }
.store-detail-head .g h1 { margin:0; font-size:1.7rem; letter-spacing:-0.02em; }
.store-detail-head .g .tag { color:var(--mat-text-muted); font-size:0.95rem; margin-top:0.2rem; }
.store-detail-head .g .chips { display:flex; gap:0.4rem; flex-wrap:wrap; margin-top:0.55rem; }
.store-detail-head .acts { display:flex; gap:0.4rem; flex:0 0 auto; }
.store-detail-head .acts .ui-btn { border-radius:999px; padding:0.55rem 1.4rem; font-weight:750; }
.store-detail-body { display:grid; gap:1rem; }
.store-detail-body .card h3 { margin:0 0 0.5rem; font-size:1.05rem; }
.store-detail-body .card p { margin:0; color:var(--mat-text); line-height:1.6; white-space:pre-wrap; }
.detail-meta { display:grid; grid-template-columns:150px 1fr; gap:0.5rem 1rem; font-size:0.9rem; }
.detail-meta dt { color:var(--mat-text-muted); } .detail-meta dd { margin:0; }
.detail-actions { display:flex; flex-direction:column; gap:0.4rem; }
.detail-actions .da { display:flex; align-items:center; gap:0.5rem; padding:0.5rem 0.7rem; border:1px solid var(--mat-border); border-radius:10px; background:var(--mat-surface-2); font-size:0.9rem; }
.detail-actions .da .mono { color:var(--mat-text-muted); font-size:0.8rem; margin-left:auto; }
.app-card { display:flex; flex-direction:column; gap:0.5rem; background:var(--mat-surface); border:1px solid var(--mat-border); border-radius:14px; padding:1rem; }
.app-card .top { display:flex; align-items:center; gap:0.7rem; }
.app-ico { width:46px; height:46px; border-radius:12px; display:grid; place-items:center; font-size:1.5rem; overflow:hidden; background:var(--mat-surface-2); border:1px solid var(--mat-border); flex:0 0 auto; }
.app-ico img { width:100%; height:100%; object-fit:cover; }
.app-card h3 { margin:0; font-size:1rem; } .app-card .tag { color:var(--mat-text-muted); font-size:0.8rem; }
.app-card p { margin:0; color:var(--mat-text-muted); font-size:0.86rem; flex:1 1 auto; }
.app-card .foot { display:flex; align-items:center; gap:0.4rem; flex-wrap:wrap; }
.app-card .mono { font-size:0.72rem; color:var(--mat-text-muted); }
.chip { font-size:0.68rem; font-weight:700; padding:0.1rem 0.45rem; border-radius:999px; background:rgba(139,92,246,0.22); color:#c7b3ff; }
.chip.compose { background:rgba(34,184,255,0.2); color:#9fe8ff; }
.chip.src { background:rgba(52,211,153,0.2); color:#7ff0c4; }
.chip.open { background:rgba(250,204,21,0.18); color:#fde68a; }
.grid-src { display:grid; grid-template-columns:200px 1fr auto; gap:0.5rem; }
.src-row { display:flex; align-items:center; gap:0.7rem; padding:0.7rem 0.9rem; border:1px solid var(--mat-border); border-radius:12px; margin-bottom:0.6rem; background:var(--mat-surface); }
.src-row.off { opacity:0.55; } .src-row .g { flex:1 1 auto; min-width:0; } .src-row .nm { font-weight:700; }
.src-row .u { color:var(--mat-text-muted); font-size:0.76rem; word-break:break-all; } .src-row .st { font-size:0.74rem; margin-top:0.15rem; }
.src-row .st.err { color:#ffb3c0; } .src-row .st.ok { color:var(--mat-text-muted); }
.switch { position:relative; display:inline-block; width:34px; height:20px; flex:0 0 auto; cursor:pointer; }
.switch input { opacity:0; width:0; height:0; position:absolute; }
.switch .sl { position:absolute; inset:0; background:var(--mat-surface-2); border:1px solid var(--mat-border); border-radius:999px; transition:.15s; }
.switch .sl:before { content:""; position:absolute; width:14px; height:14px; left:2px; top:2px; background:var(--mat-text-muted); border-radius:50%; transition:.15s; }
.switch input:checked + .sl { background:rgba(52,211,153,0.4); border-color:transparent; }
.switch input:checked + .sl:before { transform:translateX(14px); background:#7ff0c4; }
@@media (max-width:600px){ .grid-src { grid-template-columns:1fr; } }
.inst { display:flex; align-items:center; gap:0.7rem; padding:0.7rem 0.9rem; border:1px solid var(--mat-border); border-radius:12px; margin-bottom:0.6rem; background:var(--mat-surface); }
.inst .g { flex:1 1 auto; min-width:0; } .inst .nm { font-weight:700; } .inst .sub { color:var(--mat-text-muted); font-size:0.78rem; }
.fl { display:flex; flex-direction:column; gap:0.3rem; margin-bottom:0.8rem; } .fl > span { font-size:0.82rem; font-weight:600; color:var(--mat-text-muted); }
.grid2 { display:grid; grid-template-columns:1fr 1fr; gap:0 0.8rem; }
.act-row, .var-row { display:flex; gap:0.4rem; margin-bottom:0.4rem; align-items:center; } .act-row input, .var-row input { flex:1; } .act-row .lbl, .var-row .k { max-width:140px; } .var-row .t { max-width:110px; flex:0 0 auto; } .var-row .req { display:flex; align-items:center; gap:0.25rem; font-size:0.75rem; color:var(--mat-text-muted); white-space:nowrap; }
.dlg { position:absolute; inset:0; background:rgba(0,0,0,0.55); display:grid; place-items:center; z-index:20; } .dlg[hidden]{ display:none; }
.dlg-card { width:min(440px,92%); background:var(--mat-surface); border:1px solid var(--mat-border); border-radius:14px; padding:1.2rem; box-shadow:0 24px 60px rgba(0,0,0,.5); }
.spin { width:14px; height:14px; border-radius:50%; border:2px solid rgba(255,255,255,.2); border-top-color:var(--mat-accent); display:inline-block; animation:sp .7s linear infinite; }
@@keyframes sp { to { transform:rotate(360deg); } }
@@media (max-width:600px){ .grid2 { grid-template-columns:1fr; } }
</style>
}

@section Scripts {
<script>
(function(){
  const esc=s=>String(s==null?"":s).replace(/[&<>]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c]));
  const escA=s=>String(s==null?"":s).replace(/"/g,"&quot;");
  const isImg=s=>/^(https?:|data:)/i.test(s||"");
  const iconHtml=ic=> isImg(ic) ? `<img src="${escA(ic)}" alt="">` : `<span>${esc(ic||"📦")}</span>`;
  const $=id=>document.getElementById(id);
  const catEl=$("store-catalog"), detEl=$("store-detail"), instEl=$("store-installed"), addEl=$("store-add"), srcEl=$("store-sources"), msg=$("store-msg");
  let catalog=[];
  function flash(t,ok){ msg.style.display=""; msg.style.borderColor=ok?"rgba(52,211,153,0.4)":"rgba(244,80,107,0.4)"; msg.style.background=ok?"rgba(52,211,153,0.14)":"rgba(244,80,107,0.14)"; msg.style.color=ok?"#7ff0c4":"#ffb3c0"; msg.textContent=t; setTimeout(()=>msg.style.display="none",5000); }

  document.querySelectorAll("#store-nav .store-nav-btn").forEach(t=>t.addEventListener("click",()=>{
    document.querySelectorAll("#store-nav .store-nav-btn").forEach(x=>x.classList.toggle("active",x===t));
    const tab=t.dataset.tab; catEl.style.display=tab==="catalog"?"":"none"; detEl.style.display="none"; instEl.style.display=tab==="installed"?"":"none"; addEl.style.display=tab==="add"?"":"none"; srcEl.style.display=tab==="sources"?"":"none";
    document.querySelector(".store-cats-head").style.display=tab==="catalog"?"":"none"; document.getElementById("store-cats").style.display=tab==="catalog"?"":"none";
    if(tab==="installed") loadInstalls(); if(tab==="add" && !$("a-id").value) resetForm(); if(tab==="sources") loadSources();
  }));

  let search="", activeCat="all";
  const catOf=a=>a.category||"Other";
  const matchSearch=a=>{ if(!search)return true; const q=search.toLowerCase(); return [a.name,a.tagline,a.description,a.category].some(v=>(v||"").toLowerCase().includes(q)); };
  function renderCats(){
    const cats=[...new Set(catalog.map(catOf))].sort((x,y)=>x.localeCompare(y));
    const cel=$("store-cats");
    cel.innerHTML=`<button class="store-cat-btn${activeCat==='all'?' active':''}" data-cat="all">All apps</button>`
      + cats.map(c=>`<button class="store-cat-btn${activeCat===c?' active':''}" data-cat="${escA(c)}">${esc(c)}</button>`).join("");
    cel.querySelectorAll("[data-cat]").forEach(b=>b.addEventListener("click",()=>{ activeCat=b.dataset.cat; renderCats(); renderCatalog(); }));
  }
  function appRowHtml(a){
    const opener=a.handles && a.handles.length, local=!a.builtIn && !a.source;
    const chips=`${a.source?`<span class="chip src" title="From source: ${escA(a.source)}">${esc(a.source)}</span>`:''}${local?'<span class="chip">custom</span>':''}${(a.kind==='compose'&&!a.builtIn)?'<span class="chip compose">compose</span>':''}${opener?`<span class="chip open">opens ${esc(a.handles.join(" "))}</span>`:''}`;
    const installBtn=`<button class="ui-btn primary" data-install="${escA(a.id)}" data-name="${escA(a.name)}">Install</button>`;
    const editDel=local?`<button class="ui-btn" data-edit="${escA(a.id)}" title="Edit">✎</button><button class="ui-btn danger" data-del="${escA(a.id)}" data-name="${escA(a.name)}" title="Delete">🗑</button>`:'';
    return `<div class="app-row" data-detail="${escA(a.id)}"><div class="app-ico">${iconHtml(a.icon)}</div>
      <div class="g"><h3>${esc(a.name)}${chips}</h3><div class="tag">${esc(a.tagline||a.description||'')}</div></div>
      <div class="acts">${editDel}${installBtn}</div></div>`;
  }
  const heroHtml=()=>`<div class="store-hero"><span class="glyph" aria-hidden="true">🚀</span><div class="eyebrow">matOS App Store</div><h1>Run anything as an app</h1><p>Install self-hosted apps as containers or stacks — one click, each gets its own volume and lands on your desktop.</p></div>`;
  function renderCatalog(){
    const apps=catalog.filter(a=>matchSearch(a) && (activeCat==='all'||catOf(a)===activeCat));
    let html=(activeCat==='all' && !search)?heroHtml():'';
    if(!apps.length){ catEl.innerHTML=html+`<div class="fx-muted" style="padding:1.5rem">No apps match.</div>`; return; }
    const groups={}; for(const a of apps){ (groups[catOf(a)]=groups[catOf(a)]||[]).push(a); }
    for(const cat of Object.keys(groups).sort((x,y)=>x.localeCompare(y))){
      html+=`<div class="store-sec-head"><h2>${esc(cat)}</h2><span class="cnt">${groups[cat].length} app${groups[cat].length===1?'':'s'}</span></div><div class="store-grid">${groups[cat].map(appRowHtml).join("")}</div>`;
    }
    catEl.innerHTML=html;
    catEl.querySelectorAll("[data-install]").forEach(b=>b.addEventListener("click",()=>openInstall(b.dataset.install,b.dataset.name)));
    catEl.querySelectorAll("[data-edit]").forEach(b=>b.addEventListener("click",()=>editApp(b.dataset.edit)));
    catEl.querySelectorAll("[data-del]").forEach(b=>b.addEventListener("click",()=>delApp(b.dataset.del,b.dataset.name)));
    // Click the tile (not a button) → app detail page.
    catEl.querySelectorAll(".app-row").forEach(row=>row.addEventListener("click",e=>{ if(e.target.closest(".acts")) return; openDetail(row.dataset.detail); }));
  }

  function wireDetailButtons(){
    detEl.querySelectorAll("[data-install]").forEach(b=>b.addEventListener("click",()=>openInstall(b.dataset.install,b.dataset.name)));
    detEl.querySelectorAll("[data-edit]").forEach(b=>b.addEventListener("click",()=>editApp(b.dataset.edit)));
    detEl.querySelectorAll("[data-del]").forEach(b=>b.addEventListener("click",()=>delApp(b.dataset.del,b.dataset.name)));
  }
  function showCatalog(){ detEl.style.display="none"; catEl.style.display=""; document.querySelector(".store-cats-head").style.display=""; $("store-cats").style.display=""; renderCats(); renderCatalog(); }
  function openDetail(id){
    catEl.style.display="none"; instEl.style.display="none"; addEl.style.display="none"; srcEl.style.display="none";
    document.querySelector(".store-cats-head").style.display="none"; $("store-cats").style.display="none";
    detEl.style.display=""; renderDetail(id); detEl.scrollIntoView && detEl.scrollIntoView({block:"start"});
  }
  function renderDetail(id){
    const a=catalog.find(x=>x.id===id); if(!a){ detEl.innerHTML='<div class="fx-muted" style="padding:1rem">App not found.</div>'; return; }
    const opener=a.handles&&a.handles.length, local=!a.builtIn&&!a.source, cat=catOf(a);
    const chips=`<span class="chip">${esc(cat)}</span>${a.source?`<span class="chip src">${esc(a.source)}</span>`:''}${local?'<span class="chip">custom</span>':''}${(a.kind==='compose'&&!a.builtIn)?'<span class="chip compose">compose</span>':''}${opener?`<span class="chip open">opens ${esc(a.handles.join(" "))}</span>`:''}`;
    const installBtn=`<button class="ui-btn primary" data-install="${escA(a.id)}" data-name="${escA(a.name)}">Install</button>`;
    const editDel=local?`<button class="ui-btn" data-edit="${escA(a.id)}">Edit</button><button class="ui-btn danger" data-del="${escA(a.id)}" data-name="${escA(a.name)}">Delete</button>`:'';
    const actionsCard=(a.actions&&a.actions.length)?`<div class="card"><h3>Actions</h3><div class="detail-actions">${a.actions.map(x=>`<div class="da">${esc(x.label)}<span class="mono">${esc(x.url)}</span></div>`).join("")}</div></div>`:'';
    const rows=[["Category",esc(cat)]];
    if(opener) rows.push(["Opens files", esc(a.handles.join(", "))]);
    else if(a.kind==='compose'){ if(!a.builtIn) rows.push(["Type","Compose stack"]); }
    else if(a.image) rows.push(["Image", `<span class="mono">${esc(a.image)}</span>`]);
    if(a.volumes&&a.volumes.length) rows.push(["Data volumes", esc(a.volumes.join(", "))]);
    detEl.innerHTML=`
      <nav class="store-crumb"><a data-crumb="home">Discover</a><span class="sep">›</span><a data-crumb="cat" data-cat="${escA(cat)}">${esc(cat)}</a><span class="sep">›</span><span class="cur">${esc(a.name)}</span></nav>
      <div class="store-detail-head"><div class="app-ico detail-ico">${iconHtml(a.icon)}</div>
        <div class="g"><h1>${esc(a.name)}</h1><div class="tag">${esc(a.tagline||'')}</div><div class="chips">${chips}</div></div>
        <div class="acts">${installBtn}${editDel}</div></div>
      <div class="store-detail-body">
        <div class="card"><h3>About</h3><p>${esc(a.description||a.tagline||'No description.')}</p></div>
        ${actionsCard}
        <div class="card"><h3>Details</h3><dl class="detail-meta">${rows.map(r=>`<dt>${r[0]}</dt><dd>${r[1]}</dd>`).join("")}</dl></div>
      </div>`;
    wireDetailButtons();
    detEl.querySelector('[data-crumb="home"]').addEventListener("click",()=>{ activeCat="all"; search=""; const se=$("store-search"); if(se) se.value=""; showCatalog(); });
    const cl=detEl.querySelector('[data-crumb="cat"]'); if(cl) cl.addEventListener("click",()=>{ activeCat=cl.dataset.cat; showCatalog(); });
  }
  async function loadCatalog(){
    try{ const d=await (await fetch("/api/v1/store/catalog")).json(); catalog=d.apps; }catch(_){ catEl.innerHTML="Failed to load catalog."; return; }
    renderCats(); renderCatalog();
  }
  { const se=$("store-search"); if(se) se.addEventListener("input",()=>{ search=se.value.trim(); renderCatalog(); }); }

  // Install always opens the dedicated install wizard window (params → review → install → done).
  function openInstall(id,name){ try{ window.parent.postMessage({type:"matos:open", url:"/apps/install/"+encodeURIComponent(id), key:"install:"+id, title:"Install "+(name||id), width:680, height:620}, location.origin); }catch(_){ location.href="/apps/install/"+encodeURIComponent(id); } }

  // reload when an install/uninstall happened in another window
  window.addEventListener("message",e=>{ if(e.origin!==location.origin)return; const m=e.data; if(m && m.type==="matos:reload"){ loadCatalog(); if(instEl.style.display!=="none") loadInstalls(); } });

  // Update statuses cached across renders: containerId -> { updateAvailable, error }
  let updateStatuses = {};
  async function loadInstalls(){
    let d; try{ d=await (await fetch("/api/v1/store/installs")).json(); }catch(_){ instEl.innerHTML="Failed to load."; return; }
    $("store-count").textContent=d.installs.length?`(${d.installs.length})`:"";
    if(!d.installs.length){ instEl.innerHTML=`<div class="fx-muted" style="padding:1rem">No apps installed yet — install one from Discover.</div>`; return; }
    const headerHtml=`<div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem">
      <button class="ui-btn" id="store-check-updates">🔄 Check for updates</button>
      <span id="store-updates-hint" class="fx-muted" style="font-size:0.8rem"></span>
    </div>`;
    instEl.innerHTML=headerHtml+d.installs.map(i=>{ const def=catalog.find(a=>a.id===i.app); const st=updateStatuses[i.id];
      const updChip = st && st.updateAvailable ? `<span class="chip open" style="margin-left:0.3rem">update available</span>`
                     : (st && st.error ? `<span class="chip" style="margin-left:0.3rem;background:rgba(244,80,107,0.14);color:#ffb3c0" title="${escA(st.error)}">check failed</span>` : '');
      const updBtn = st && st.updateAvailable ? `<button class="ui-btn primary" data-update="${escA(i.id)}" data-name="${escA(i.title)}">Update</button>` : '';
      return `<div class="inst"><div class="app-ico" style="width:36px;height:36px;font-size:1.1rem">${iconHtml(def?def.icon:"📦")}</div>
      <div class="g"><div class="nm">${esc(i.title)} ${i.compose?'<span class="chip compose">stack · '+i.count+'</span>':''}${updChip}</div>
        <div class="sub">${i.running?'<span class="pill on">running</span>':'<span class="pill off">stopped</span>'} · ${esc(i.name)}</div></div>
      ${updBtn}
      ${i.appUrl?`<button class="ui-btn" data-open="${escA(i.appUrl)}" data-title="${escA(i.title)}" data-key="inst:${escA(i.id)}">Open</button>`:""}
      <button class="ui-btn danger" data-uninstall="${escA(i.id)}" data-name="${escA(i.title)}">Uninstall</button></div>`; }).join("");
    // Open the installed app as a matOS window (fall back to a new tab if not embedded).
    instEl.querySelectorAll("[data-open]").forEach(b=>b.addEventListener("click",()=>{ try{ window.parent.postMessage({type:"matos:open",url:b.dataset.open,title:b.dataset.title||"App",key:b.dataset.key||"inst",width:1040,height:680},location.origin); }catch(_){ window.open(b.dataset.open,"_blank","noopener"); } }));
    instEl.querySelectorAll("[data-uninstall]").forEach(b=>b.addEventListener("click",()=>uninstall(b.dataset.uninstall,b.dataset.name)));
    instEl.querySelectorAll("[data-update]").forEach(b=>b.addEventListener("click",()=>applyUpdate(b.dataset.update,b.dataset.name,b)));
    document.getElementById("store-check-updates").addEventListener("click",checkUpdates);
  }
  async function checkUpdates(){
    const btn=document.getElementById("store-check-updates"); if(!btn)return; const orig=btn.innerHTML; btn.disabled=true; btn.innerHTML=`<span class="spin"></span> Checking…`;
    document.getElementById("store-updates-hint").textContent="";
    try{
      const r=await fetch("/api/v1/updates/check");
      if(!r.ok) throw new Error("HTTP "+r.status);
      const j=await r.json();
      updateStatuses={}; (j.statuses||[]).forEach(s=>{ updateStatuses[s.containerId]={ updateAvailable:s.updateAvailable, error:s.error }; });
      const avail=(j.statuses||[]).filter(s=>s.updateAvailable).length;
      document.getElementById("store-updates-hint").textContent = avail?`${avail} update${avail===1?"":"s"} available`:"All up to date.";
      loadInstalls();
    }catch(e){ flash("Update check failed: "+e.message,false); } finally{ btn.disabled=false; btn.innerHTML=orig; }
  }
  async function applyUpdate(id,name,btn){
    if(!await matDialog.confirm(`Update ${name}? The container will be recreated with the latest image.`,{title:"Update",okLabel:"Update"})) return;
    const orig=btn.innerHTML; btn.disabled=true; btn.innerHTML=`<span class="spin"></span>`;
    try{ const r=await fetch("/api/v1/updates/apply",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({containerId:id})});
      if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.detail||e.error||("HTTP "+r.status)); }
      flash(`Updated ${name}.`,true); delete updateStatuses[id]; loadInstalls();
    }catch(e){ flash("Update failed: "+e.message,false); btn.disabled=false; btn.innerHTML=orig; }
  }
  async function uninstall(id,name){ if(!await matDialog.confirm(`Uninstall ${name}?`,{title:"Uninstall",danger:true,okLabel:"Uninstall"}))return; const rmVol=await matDialog.confirm("Also delete this app's data volumes? This cannot be undone.",{title:"Delete data?",danger:true,okLabel:"Delete data",cancelLabel:"Keep data"});
    try{ const r=await fetch("/api/v1/store/uninstall",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id,removeVolume:rmVol})});
      if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.detail||r.status); } flash("Uninstalled "+name+".",true); loadInstalls();
    }catch(e){ flash("Uninstall failed: "+e.message,false); } }

  // ---- add/edit form ----
  $("a-kind").addEventListener("change",()=>{ const c=$("a-kind").value==="compose"; $("a-compose-fields").style.display=c?"":"none"; $("a-image-fields").style.display=c?"none":""; });
  const iconPrev=$("a-icon-prev"), iconInput=$("a-icon");
  iconInput.addEventListener("input",()=>iconPrev.innerHTML=iconHtml(iconInput.value));
  $("a-icon-upload").addEventListener("click",()=>$("a-icon-file").click());
  $("a-icon-file").addEventListener("change",()=>{ const f=$("a-icon-file").files[0]; if(!f)return; if(f.size>256*1024){ flash("Icon too large (max 256 KB).",false); return; }
    const r=new FileReader(); r.onload=()=>{ iconInput.value=r.result; iconPrev.innerHTML=iconHtml(r.result); }; r.readAsDataURL(f); });

  function actionRow(l,u){ const d=document.createElement("div"); d.className="act-row";
    d.innerHTML=`<input class="ui-input lbl" placeholder="Label" value="${escA(l||"")}"><input class="ui-input" placeholder="/path or https://…" value="${escA(u||"")}"><button type="button" class="ui-btn danger">✕</button>`;
    d.querySelector("button").addEventListener("click",()=>d.remove()); return d; }
  $("a-add-action").addEventListener("click",()=>$("a-actions").appendChild(actionRow("","")));
  function varRow(v){ v=v||{}; const d=document.createElement("div"); d.className="var-row";
    d.innerHTML=`<input class="ui-input k" placeholder="KEY" value="${escA(v.key||"")}"><input class="ui-input" placeholder="Label" value="${escA(v.label||"")}">
      <select class="ui-select t"><option value="text">text</option><option value="password">password</option><option value="number">number</option></select>
      <input class="ui-input" placeholder="default" value="${escA(v.default||"")}"><label class="req"><input type="checkbox" ${v.required?"checked":""}>req</label><button type="button" class="ui-btn danger">✕</button>`;
    d.querySelector("select").value=v.type||"text"; d.querySelector("button").addEventListener("click",()=>d.remove()); return d; }
  $("a-add-var").addEventListener("click",()=>$("a-vars").appendChild(varRow()));

  function resetForm(){ $("add-title").textContent="Add an app"; ["a-id","a-name","a-image","a-tag","a-desc","a-cat","a-vols","a-env","a-compose","a-uisvc"].forEach(i=>$(i).value="");
    $("a-port").value="80"; $("a-cport").value="80"; iconInput.value="📦"; iconPrev.innerHTML="📦"; $("a-actions").innerHTML=""; $("a-vars").innerHTML=""; $("a-kind").value="image"; $("a-kind").dispatchEvent(new Event("change")); }
  function editApp(id){ const a=catalog.find(x=>x.id===id); if(!a)return; document.querySelector('#store-nav .store-nav-btn[data-tab="add"]').click();
    $("add-title").textContent="Edit "+a.name; $("a-id").value=a.id; $("a-name").value=a.name; $("a-cat").value=a.category; $("a-tag").value=a.tagline; $("a-desc").value=a.description; iconInput.value=a.icon; iconPrev.innerHTML=iconHtml(a.icon);
    $("a-kind").value=a.kind||"image"; $("a-kind").dispatchEvent(new Event("change"));
    $("a-image").value=a.image||""; $("a-port").value=a.uiPort||80; $("a-vols").value=(a.volumes||[]).join("\n"); $("a-env").value=Object.entries(a.env||{}).map(([k,v])=>k+"="+v).join("\n");
    $("a-compose").value=a.compose||""; $("a-uisvc").value=a.uiService||""; $("a-cport").value=a.uiPort||80;
    $("a-actions").innerHTML=""; (a.actions||[]).forEach(ac=>$("a-actions").appendChild(actionRow(ac.label,ac.url)));
    $("a-vars").innerHTML=""; (a.variables||[]).forEach(v=>$("a-vars").appendChild(varRow(v))); }
  $("a-cancel").addEventListener("click",resetForm);

  $("a-save").addEventListener("click",async()=>{
    const kind=$("a-kind").value;
    const actions=[...$("a-actions").querySelectorAll(".act-row")].map(r=>({label:r.children[0].value.trim(),url:r.children[1].value.trim()})).filter(a=>a.label&&a.url);
    const variables=[...$("a-vars").querySelectorAll(".var-row")].map(r=>({key:r.children[0].value.trim(),label:r.children[1].value.trim(),type:r.children[2].value,default:r.children[3].value,required:r.children[4].querySelector("input").checked})).filter(v=>v.key);
    const env={}; $("a-env").value.split("\n").map(s=>s.trim()).filter(Boolean).forEach(l=>{ const i=l.indexOf("="); if(i>0) env[l.slice(0,i)]=l.slice(i+1); });
    const app={ id:$("a-id").value||"", kind, name:$("a-name").value.trim(), category:$("a-cat").value.trim()||"Custom", tagline:$("a-tag").value.trim(), description:$("a-desc").value.trim(),
      icon:iconInput.value.trim()||"📦", actions,
      image:$("a-image").value.trim(), uiPort:parseInt((kind==="compose"?$("a-cport"):$("a-port")).value||"80",10), volumes:$("a-vols").value.split("\n").map(s=>s.trim()).filter(Boolean), env,
      compose:$("a-compose").value, uiService:$("a-uisvc").value.trim(), variables };
    if(kind!=="compose" && (!app.name||!app.image)){ flash("Display name and Docker image are required.",false); return; }
    if(kind==="compose" && !app.compose.trim()){ flash("A compose file is required.",false); return; }
    try{ const r=await fetch("/api/v1/store/apps",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(app)});
      if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.error||e.detail||r.status); }
      flash("Saved.",true); resetForm(); await loadCatalog(); document.querySelector('#store-nav .store-nav-btn[data-tab="catalog"]').click();
    }catch(e){ flash("Save failed: "+e.message,false); }
  });
  async function delApp(id,name){ if(!await matDialog.confirm(`Delete custom app "${name}"? (Installed instances are not affected.)`,{title:"Delete app",danger:true,okLabel:"Delete"}))return;
    try{ await fetch("/api/v1/store/apps/delete",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id})}); flash("Deleted.",true); loadCatalog(); }catch(e){ flash("Delete failed.",false); } }

  // ---- remote sources ----
  const srcList=$("src-list");
  function fmtWhen(s){ if(!s)return"never"; const d=new Date(s); return isNaN(d)?"never":d.toLocaleString(); }
  async function loadSources(){
    let d; try{ const r=await fetch("/api/v1/store/sources"); if(r.status===403){ srcList.innerHTML=`<div class="fx-muted">Only administrators can manage sources.</div>`; $("src-add").disabled=true; return; } d=await r.json(); }
    catch(_){ srcList.innerHTML="Failed to load sources."; return; }
    if(!d.sources.length){ srcList.innerHTML=`<div class="fx-muted">No sources yet. Add one above — e.g. a GitHub raw URL to a folder with an index.json.</div>`; return; }
    srcList.innerHTML=d.sources.map(s=>`<div class="src-row ${s.enabled?'':'off'}">
      <label class="switch" title="Enable/disable"><input type="checkbox" data-toggle="${escA(s.id)}" ${s.enabled?'checked':''}><span class="sl"></span></label>
      <div class="g"><div class="nm">${esc(s.name)} <span class="fx-muted" style="font-weight:400">· ${s.appCount} app${s.appCount===1?'':'s'}</span></div>
        <div class="u">${esc(s.url)}</div>
        <div class="st ${s.lastError?'err':'ok'}">${s.lastError?('⚠ '+esc(s.lastError)):('synced '+fmtWhen(s.lastSync))}</div></div>
      <button class="ui-btn" data-sync="${escA(s.id)}">Sync</button>
      <button class="ui-btn danger" data-delsrc="${escA(s.id)}" data-name="${escA(s.name)}">Remove</button></div>`).join("");
    srcList.querySelectorAll("[data-toggle]").forEach(c=>c.addEventListener("change",()=>toggleSrc(c.dataset.toggle,c.checked)));
    srcList.querySelectorAll("[data-sync]").forEach(b=>b.addEventListener("click",()=>syncSrc(b.dataset.sync,b)));
    srcList.querySelectorAll("[data-delsrc]").forEach(b=>b.addEventListener("click",()=>delSrc(b.dataset.delsrc,b.dataset.name)));
  }
  $("src-add").addEventListener("click",async()=>{
    const url=$("src-url").value.trim(); if(!url){ flash("Enter a source URL.",false); return; }
    const btn=$("src-add"), orig=btn.innerHTML; btn.disabled=true; btn.innerHTML=`<span class="spin"></span> Syncing…`;
    try{ const r=await fetch("/api/v1/store/sources/add",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({name:$("src-name").value.trim(),url})});
      if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.error||e.detail||r.status); }
      const j=await r.json(); $("src-name").value=""; $("src-url").value="";
      flash(j.source.lastError?`Added, but sync failed: ${j.source.lastError}`:`Added "${j.source.name}" — ${j.source.appCount} app(s).`, !j.source.lastError);
      await loadSources(); await loadCatalog();
    }catch(e){ flash("Add failed: "+e.message,false); } finally{ btn.disabled=false; btn.innerHTML=orig; }
  });
  async function syncSrc(id,btn){ const orig=btn.innerHTML; btn.disabled=true; btn.innerHTML=`<span class="spin"></span>`;
    try{ const r=await fetch("/api/v1/store/sources/sync",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id})});
      const j=await r.json(); flash(j.source.lastError?`Sync failed: ${j.source.lastError}`:`Synced "${j.source.name}" — ${j.source.appCount} app(s).`, !j.source.lastError);
      await loadSources(); await loadCatalog();
    }catch(e){ flash("Sync failed: "+e.message,false); } finally{ btn.disabled=false; btn.innerHTML=orig; } }
  async function toggleSrc(id,enabled){ try{ await fetch("/api/v1/store/sources/toggle",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id,enabled})}); loadSources(); loadCatalog(); }catch(e){ flash("Failed.",false); } }
  async function delSrc(id,name){ if(!await matDialog.confirm(`Remove source "${name}"? Its apps disappear from Discover (installed apps are not affected).`,{title:"Remove source",danger:true,okLabel:"Remove"}))return;
    try{ await fetch("/api/v1/store/sources/delete",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id})}); flash("Removed.",true); loadSources(); loadCatalog(); }catch(e){ flash("Remove failed.",false); } }

  loadCatalog();
})();
</script>
}

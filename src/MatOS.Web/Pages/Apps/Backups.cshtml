@page "/apps/backups"
@model MatOS.Web.Pages.Apps.BackupsModel
@{
    ViewData["Title"] = "Backups";
    Layout = "_WindowLayout";
}

<div id="bk">
  <div id="bk-main">
    <div class="bk-head">
        <h1 class="bk-h">Backups</h1>
        <p class="bk-sub">Create <strong>jobs</strong> that back up whatever you pick in one tree — whole apps (compose + volumes) and individual volumes together. Run them now or on a schedule.</p>
    </div>
    <div class="bk-cards" id="bk-cards"></div>
    <div class="tabbar" id="bk-tabs">
        <button class="tab active" data-tab="jobs">Jobs</button>
        <button class="tab" data-tab="history">History</button>
    </div>
    <div class="win-toolbar" style="gap:0.6rem;flex-wrap:wrap;margin-top:0.4rem">
        <button class="ui-btn primary" id="bk-new-job">New job</button>
        <button class="ui-btn" id="bk-refresh">Refresh</button>
        <span class="fx-muted" style="font-size:0.85rem;flex:1">A backup is a gzip-compressed archive; app backups also capture the compose &amp; pinned image so a restore runs again.</span>
    </div>
    <div id="bk-msg" class="card" style="display:none;margin-bottom:0.8rem"></div>

    <div class="card" id="bk-pane-jobs" style="padding:0;overflow:hidden">
        <table class="bkt">
            <thead><tr><th>Job</th><th>Backs up</th><th>When</th><th>Last run</th><th></th></tr></thead>
            <tbody id="bk-job-rows"><tr><td colspan="5" style="padding:1rem;color:var(--mat-text-muted)">Loading…</td></tr></tbody>
        </table>
    </div>
    <div class="card" id="bk-pane-history" style="padding:0;overflow:hidden;display:none">
        <table class="bkt">
            <thead><tr><th>Created</th><th>What</th><th>Stored on</th><th class="num">Size</th><th></th></tr></thead>
            <tbody id="bk-hist-rows"><tr><td colspan="5" style="padding:1rem;color:var(--mat-text-muted)">Loading…</td></tr></tbody>
        </table>
    </div>

  </div><!-- /bk-main -->

    <!-- Full-screen job editor -->
    <div id="bk-editor" hidden>
        <div class="bk-crumb"><button type="button" class="bk-crumb-link" id="bk-crumb-back">Backups</button><span class="bk-crumb-sep">›</span><strong id="bk-crumb-cur">New job</strong></div>
        <div class="bk-editor-grid">
            <div class="bk-editor-left">
                <label class="fl"><span>Name</span><input class="ui-input" id="j-name" placeholder="Nightly backup" /></label>
                <div class="grid2">
                    <label class="fl"><span>Store on</span><select class="ui-select" id="j-tgt"></select></label>
                    <label class="fl"><span>Schedule</span>
                        <select class="ui-select" id="j-kind"><option value="manual">Manual only</option><option value="hourly">Hourly</option><option value="daily">Daily</option><option value="weekly">Weekly</option></select>
                    </label>
                </div>
                <div class="grid2">
                    <label class="fl" id="j-timerow"><span>Time (server local)</span><input class="ui-input" id="j-time" type="time" value="03:00" /></label>
                    <label class="fl" id="j-dayrow" style="display:none"><span>Day</span>
                        <select class="ui-select" id="j-day"><option value="0">Sunday</option><option value="1">Monday</option><option value="2">Tuesday</option><option value="3">Wednesday</option><option value="4">Thursday</option><option value="5">Friday</option><option value="6">Saturday</option></select>
                    </label>
                </div>
                <div class="grid2">
                    <label class="fl"><span>Keep for (days, 0 = forever)</span><input class="ui-input" id="j-ret" type="number" min="0" max="3650" value="30" /></label>
                    <label style="display:flex;align-items:center;gap:0.4rem;align-self:end;margin-bottom:0.8rem"><input type="checkbox" id="j-en" checked /> Enabled</label>
                </div>
                <label class="j-img-row"><input type="checkbox" id="j-img" checked />
                    <span><strong>Include Docker images</strong><span class="fx-muted">Whole-app backups also carry the image (docker&nbsp;save) so a restore is fully offline — no registry needed. Larger backups.</span></span></label>
            </div>
            <div class="bk-editor-right">
                <div class="jt-panel">
                    <div class="jt-panel-head">
                        <span class="jt-panel-title">What to back up</span>
                        <span class="jt-sel-count" id="j-sel-count">Nothing selected</span>
                    </div>
                    <div class="jt-search-wrap">
                        <span class="jt-search-ico">🔍</span>
                        <input class="jt-search" id="j-tree-search" placeholder="Search apps &amp; volumes…" autocomplete="off" />
                        <button type="button" class="jt-search-clear" id="j-tree-clear" title="Clear" hidden>✕</button>
                    </div>
                    <div class="job-tree job-tree-full" id="j-tree"></div>
                </div>
            </div>
        </div>
        <input type="hidden" id="j-id" />
        <div class="bk-editor-actions"><button class="ui-btn primary" id="j-save">Save job</button><button class="ui-btn" id="j-cancel">Cancel</button></div>
    </div>

    <!-- Restore into volume (volume backups) -->
    <div class="dlg" id="bk-rst-dlg" hidden><div class="dlg-card">
        <h3 style="margin:0 0 0.9rem">Restore backup</h3>
        <div class="wz-note" id="bk-rst-info" style="margin-bottom:0.9rem"></div>
        <label class="fl"><span>Restore into volume *</span><select class="ui-select" id="bk-rst-tgt"></select>
            <span class="fx-muted" style="font-size:0.78rem"><strong>Existing files in the target volume are removed first.</strong></span></label>
        <div style="display:flex;gap:0.5rem;margin-top:1rem"><button class="ui-btn primary" id="bk-rst-go">Restore</button><button class="ui-btn" id="bk-rst-cancel">Cancel</button></div>
    </div></div>

    <!-- Restore app -->
    <div class="dlg" id="bk-arst-dlg" hidden><div class="dlg-card">
        <h3 style="margin:0 0 0.9rem">Restore app</h3>
        <div class="wz-note" id="bk-arst-info" style="margin-bottom:0.9rem"></div>
        <p class="fx-muted" style="font-size:0.82rem;margin:0 0 0.9rem"><strong>This recreates the app's containers</strong> (replacing any with the same name) and <strong>overwrites the included volumes' data</strong>. The app will be started.</p>
        <div style="display:flex;gap:0.5rem"><button class="ui-btn primary" id="bk-arst-go">Restore &amp; run</button><button class="ui-btn" id="bk-arst-cancel">Cancel</button></div>
    </div></div>
</div>

@section Head {
<style>
.win-header { display:none; }
#bk { max-width:1100px; }
.bk-head { margin-bottom:1rem; }
.bk-h { font-size:1.6rem; font-weight:800; letter-spacing:-0.02em; margin:0; }
.bk-sub { margin:0.25rem 0 0; color:var(--mat-text-muted); font-size:0.9rem; }
.bk-cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:0.8rem; margin-bottom:1.2rem; }
.bk-card { background:var(--mat-surface); border:1px solid var(--mat-border); border-radius:14px; padding:0.9rem 1rem; }
.bk-card-top { display:flex; align-items:center; gap:0.5rem; margin-bottom:0.5rem; }
.bk-card-ic { width:30px; height:30px; border-radius:9px; display:grid; place-items:center; font-size:1rem; flex:0 0 auto; }
.bk-card-k { font-size:0.74rem; color:var(--mat-text-muted); font-weight:700; text-transform:uppercase; letter-spacing:0.04em; }
.bk-card-v { font-size:1.7rem; font-weight:800; font-variant-numeric:tabular-nums; line-height:1; }
table.bkt { width:100%; border-collapse:collapse; }
table.bkt th, table.bkt td { padding:0.55rem 0.9rem; text-align:left; white-space:nowrap; vertical-align:middle; }
table.bkt thead th { font-size:0.78rem; color:var(--mat-text-muted); border-bottom:1px solid var(--mat-border); }
table.bkt tbody tr { border-top:1px solid var(--mat-border); }
table.bkt th.num, table.bkt td.num { text-align:right; }
.smb-chip { font-size:0.68rem; font-weight:700; padding:0.05rem 0.4rem; border-radius:999px; background:rgba(52,211,153,0.2); color:#7ff0c4; margin-left:0.3rem; }
.pill { font-size:0.7rem; font-weight:700; padding:0.05rem 0.45rem; border-radius:999px; }
.pill.app { background:rgba(245,158,11,0.2); color:#ffcf7a; } .pill.vol { background:rgba(139,92,246,0.2); color:#c9b6ff; }
.fl { display:flex; flex-direction:column; gap:0.3rem; margin-bottom:0.8rem; } .fl > span { font-size:0.82rem; font-weight:600; color:var(--mat-text-muted); }
.grid2 { display:grid; grid-template-columns:1fr 1fr; gap:0.6rem; }
.dlg { position:absolute; inset:0; background:rgba(0,0,0,0.55); display:grid; place-items:center; z-index:30; }
.dlg[hidden]{ display:none; }
.dlg-card { width:min(460px,92%); background:var(--mat-surface); border:1px solid var(--mat-border); border-radius:14px; padding:1.2rem; box-shadow:0 24px 60px rgba(0,0,0,.5); }
.bk-job-card { width:min(560px,94%); max-height:86vh; overflow:auto; }
.wz-note { background:var(--mat-surface-2); border:1px solid var(--mat-border); border-radius:10px; padding:0.7rem 0.85rem; font-size:0.86rem; }
.bk-acts { display:flex; gap:0.3rem; justify-content:flex-end; }
.bk-acts .ui-btn { padding:0.25rem 0.55rem; font-size:0.78rem; }
.tabbar { display:flex; gap:0.15rem; border-bottom:1px solid var(--mat-border); }
.tab { border:none; background:transparent; padding:0.5rem 0.85rem; font:inherit; font-weight:600; color:var(--mat-text-muted); cursor:pointer; border-bottom:2px solid transparent; }
.tab.active { color:var(--mat-text); border-bottom-color:var(--mat-accent); }
.job-off { opacity:0.55; }
/* Tree */
.job-tree { max-height:260px; overflow-y:auto; border:1px solid var(--mat-border); border-radius:10px; padding:0.4rem 0.5rem; background:var(--mat-surface-2); }
.jt-sec { font-size:0.7rem; font-weight:800; text-transform:uppercase; letter-spacing:0.06em; color:var(--mat-text-muted); margin:0.5rem 0.15rem 0.3rem; }
.jt-sec:first-child { margin-top:0.15rem; }
.jt-app-head { display:flex; align-items:center; gap:0.4rem; padding:0.22rem 0.15rem; font-size:0.9rem; }
.jt-exp { border:none; background:transparent; color:var(--mat-text-muted); cursor:pointer; width:18px; font-size:0.8rem; padding:0; transition:transform .12s; }
.jt-exp.open { transform:rotate(90deg); }
.jt-app-title { font-weight:600; } .jt-app-meta { color:var(--mat-text-muted); font-size:0.78rem; }
.jt-vols { margin:0.1rem 0 0.25rem 1.9rem; display:none; }
.jt-vols.open { display:block; }
.jt-vol-row, .jt-std-row { display:flex; align-items:center; gap:0.4rem; padding:0.16rem 0.15rem; font-size:0.85rem; }
.jt-vol-row .fx-muted { font-size:0.74rem; }
/* Full-screen job editor */
.bk-crumb { display:flex; align-items:center; gap:0.5rem; margin-bottom:1.2rem; font-size:1.05rem; }
.bk-crumb-link { border:none; background:transparent; color:var(--mat-accent); font:inherit; font-weight:700; cursor:pointer; padding:0; }
.bk-crumb-link:hover { text-decoration:underline; }
.bk-crumb-sep { color:var(--mat-text-muted); }
#bk-crumb-cur { font-size:1.05rem; font-weight:800; letter-spacing:-0.01em; }
.bk-editor-grid { display:grid; grid-template-columns:0.85fr 1.15fr; gap:1.6rem; align-items:start; }
.bk-editor-actions { display:flex; gap:0.5rem; margin-top:1.3rem; padding-top:1rem; border-top:1px solid var(--mat-border); }
@@media (max-width:820px){ .bk-editor-grid { grid-template-columns:1fr; } }

/* Selection panel (search + tree) */
.jt-panel { border:1px solid var(--mat-border); border-radius:14px; background:var(--mat-surface); overflow:hidden; display:flex; flex-direction:column; }
.jt-panel-head { display:flex; align-items:center; justify-content:space-between; gap:0.6rem; padding:0.7rem 0.9rem; border-bottom:1px solid var(--mat-border); }
.jt-panel-title { font-weight:750; font-size:0.92rem; }
.jt-sel-count { font-size:0.76rem; font-weight:700; color:var(--mat-accent); background:color-mix(in srgb, var(--mat-accent) 15%, transparent); padding:0.12rem 0.55rem; border-radius:999px; white-space:nowrap; }
.jt-search-wrap { position:relative; display:flex; align-items:center; padding:0.6rem 0.9rem; border-bottom:1px solid var(--mat-border); }
.jt-search-ico { position:absolute; left:1.15rem; font-size:0.85rem; opacity:0.6; pointer-events:none; }
.jt-search { flex:1; background:var(--mat-surface-2); border:1px solid var(--mat-border); border-radius:9px; color:var(--mat-text); font:inherit; font-size:0.88rem; padding:0.45rem 1.9rem; }
.jt-search:focus { outline:none; border-color:var(--mat-accent); box-shadow:0 0 0 3px color-mix(in srgb, var(--mat-accent) 22%, transparent); }
.jt-search-clear { position:absolute; right:1.15rem; border:none; background:transparent; color:var(--mat-text-muted); cursor:pointer; font-size:0.8rem; }
.job-tree-full { max-height:56vh; min-height:240px; border:none; border-radius:0; background:transparent; padding:0.4rem 0.55rem; }
/* larger, nicer rows */
.jt-app-head { border-radius:9px; padding:0.34rem 0.35rem; }
.jt-app-head:hover, .jt-vol-row:hover, .jt-std-row:hover { background:var(--mat-surface-2); }
.jt-app-head.sel { background:color-mix(in srgb, var(--mat-accent) 12%, transparent); }
.jt-app-title { font-size:0.92rem; }
.jt-vol-row, .jt-std-row { border-radius:8px; padding:0.26rem 0.4rem; }
.jt-empty { padding:1.2rem; text-align:center; color:var(--mat-text-muted); font-size:0.85rem; }
.j-img-row { display:flex; align-items:flex-start; gap:0.55rem; padding:0.6rem 0.75rem; border:1px solid var(--mat-border); border-radius:10px; background:var(--mat-surface-2); margin-bottom:0.8rem; cursor:pointer; }
.j-img-row input { margin-top:0.15rem; flex:0 0 auto; }
.j-img-row strong { font-weight:700; }
.j-img-row .fx-muted { display:block; font-size:0.78rem; margin-top:0.1rem; }
</style>
}

@section Scripts {
<script>
(function(){
  const esc=s=>String(s==null?"":s).replace(/[&<>]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c]));
  const escA=s=>String(s==null?"":s).replace(/"/g,"&quot;");
  const fmtB=b=>{ if(b==null||b<0)return "—"; const u=["B","KB","MB","GB","TB"];let i=0,n=b;while(n>=1024&&i<u.length-1){n/=1024;i++;}return n.toFixed(n<10&&i>0?1:0)+" "+u[i]; };
  const fmtWhen=s=>{ if(!s)return""; const d=new Date(s); return isNaN(d)?"":d.toLocaleString(); };
  const $=id=>document.getElementById(id);
  const msg=$("bk-msg");
  const hexA=(hex,a)=>{ const n=parseInt(hex.slice(1),16); return `rgba(${(n>>16)&255},${(n>>8)&255},${n&255},${a})`; };
  const days=["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];
  function flash(t,ok){ msg.style.display=""; msg.style.borderColor=ok?"rgba(52,211,153,0.4)":"rgba(244,80,107,0.4)"; msg.style.background=ok?"rgba(52,211,153,0.14)":"rgba(244,80,107,0.14)"; msg.style.color=ok?"#7ff0c4":"#ffb3c0"; msg.textContent=t; setTimeout(()=>msg.style.display="none",6000); }

  let jobsState={jobs:[],tree:{apps:[],volumes:[],targetVolumes:[]}};
  let hist={vol:[],app:[],targets:[]};

  function updateCards(){
    const el=$("bk-cards"); if(!el) return;
    const total=(hist.vol||[]).reduce((a,b)=>a+(b.sizeBytes||0),0)+(hist.app||[]).reduce((a,b)=>a+(b.sizeBytes||0),0);
    const defs=[
      {k:"Jobs",v:(jobsState.jobs||[]).length,ic:"🗂️",color:"#8b5cf6"},
      {k:"Backups",v:(hist.vol||[]).length+(hist.app||[]).length,ic:"📦",color:"#f59e0b"},
      {k:"Total size",v:fmtB(total),ic:"💽",color:"#22b8ff"},
    ];
    el.innerHTML=defs.map(c=>`<div class="bk-card"><div class="bk-card-top"><span class="bk-card-ic" style="background:${hexA(c.color,0.16)};color:${c.color}">${c.ic}</span><span class="bk-card-k">${c.k}</span></div><div class="bk-card-v">${c.v}</div></div>`).join("");
  }

  // ---- Jobs ----
  async function loadJobs(){
    try{ jobsState=await (await fetch("/api/v1/backups/jobs")).json(); }
    catch(_){ $("bk-job-rows").innerHTML=`<tr><td colspan="5" style="padding:1rem;color:var(--mat-text-muted)">Failed to load.</td></tr>`; return; }
    updateCards();
    const js=jobsState.jobs||[];
    if(!js.length){ $("bk-job-rows").innerHTML=`<tr><td colspan="5" style="padding:1rem;color:var(--mat-text-muted)">No jobs yet — click "New job" and pick what to back up.</td></tr>`; return; }
    $("bk-job-rows").innerHTML=js.map((j,i)=>{
      const backs=targetSummary(j.targets||[]," + ")||"nothing";
      const when=j.kind==="manual"?"Manual":j.kind==="hourly"?"Hourly":j.kind==="weekly"?days[j.weekday]+" "+esc(j.time):"Daily "+esc(j.time);
      return `<tr class="${j.enabled?'':'job-off'}" data-i="${i}">
        <td><strong>${esc(j.name)}</strong>${j.lastError?'<div class="fx-muted" style="font-size:0.7rem;color:#ffb3c0">⚠ '+esc(j.lastError)+'</div>':(j.lastResult?'<div class="fx-muted" style="font-size:0.7rem">'+esc(j.lastResult)+'</div>':'')}</td>
        <td>${esc(backs)} <span class="fx-muted">→ ${esc(j.targetVolume)}</span></td>
        <td>${when}${j.enabled?"":" · off"}</td>
        <td class="fx-muted">${j.lastRunUtc?fmtWhen(j.lastRunUtc):"—"}</td>
        <td><div class="bk-acts">
          <button class="ui-btn primary" data-run="${i}">Run now</button>
          <button class="ui-btn" data-edit="${i}">Edit</button>
          <button class="ui-btn danger" data-del="${i}">Delete</button>
        </div></td></tr>`;}).join("");
    $("bk-job-rows").querySelectorAll("[data-run]").forEach(b=>b.addEventListener("click",()=>runJob(js[+b.dataset.run])));
    $("bk-job-rows").querySelectorAll("[data-edit]").forEach(b=>b.addEventListener("click",()=>openJob(js[+b.dataset.edit])));
    $("bk-job-rows").querySelectorAll("[data-del]").forEach(b=>b.addEventListener("click",()=>delJob(js[+b.dataset.del])));
  }
  async function runJob(j){
    if(!await matDialog.confirm(`Run "${j.name}" now?`,{title:"Run backup job",okLabel:"Run"})) return;
    try{ await fetch("/api/v1/backups/jobs/run",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id:j.id})});
      flash(`"${j.name}" started — you'll get a notification when it finishes.`,true);
      setTimeout(()=>{ loadJobs(); loadHistory(); }, 2500);
    }catch(e){ flash("Could not start job.",false); }
  }
  async function delJob(j){ if(!await matDialog.confirm(`Delete job "${j.name}"? (Existing backups are kept.)`,{title:"Delete job",danger:true,okLabel:"Delete"})) return;
    try{ await fetch("/api/v1/backups/jobs/delete",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id:j.id})}); loadJobs(); }
    catch(_){ flash("Delete failed.",false); } }

  // ---- Job editor + tree ----
  function renderTree(){
    const t=jobsState.tree||{apps:[],volumes:[]}; const box=$("j-tree"); box.innerHTML="";
    if((t.apps||[]).length){
      const h=document.createElement("div"); h.className="jt-sec jt-sec-apps"; h.textContent="Apps"; box.appendChild(h);
      for(const a of t.apps){
        const wrap=document.createElement("div"); wrap.className="jt-app";
        wrap.dataset.appTitle=((a.title||a.name)+" "+a.name).toLowerCase();
        const head=document.createElement("div"); head.className="jt-app-head";
        head.innerHTML=`<button type="button" class="jt-exp" title="Show parts">▸</button>
          <label style="display:flex;align-items:center;gap:0.4rem;flex:1;cursor:pointer;min-width:0"><input type="checkbox" class="jt-app-cb" data-app="${escA(a.name)}">
          <span class="jt-app-title">${esc(a.title||a.name)}</span> <span class="jt-app-meta">${a.total?`${a.running}/${a.total} · ${a.volumes.length} vol`:""}</span></label>`;
        wrap.appendChild(head);
        const vols=document.createElement("div"); vols.className="jt-vols";
        const partRows =
          `<label class="jt-vol-row jt-part"><input type="checkbox" class="jt-part-cb" data-app="${escA(a.name)}" data-part="settings"> ⚙️ App settings <span class="fx-muted" style="font-size:0.74rem">compose &amp; config</span></label>`+
          `<label class="jt-vol-row jt-part"><input type="checkbox" class="jt-part-cb" data-app="${escA(a.name)}" data-part="image"> 💿 Image</label>`;
        const volRows = a.volumes.map(v=>`<label class="jt-vol-row" data-search="${escA(String(v).toLowerCase())}"><input type="checkbox" class="jt-vol" data-app="${escA(a.name)}" data-vol="${escA(v)}"> 🗄️ ${esc(v)}</label>`).join("");
        vols.innerHTML = partRows + (volRows || `<div class="fx-muted" style="font-size:0.74rem;padding:0.1rem 0.4rem">No named volumes.</div>`);
        wrap.appendChild(vols);
        const exp=head.querySelector(".jt-exp"); exp.addEventListener("click",()=>{ exp.classList.toggle("open"); vols.classList.toggle("open"); });
        const appCb=head.querySelector(".jt-app-cb");
        appCb.addEventListener("change",()=>{ vols.querySelectorAll(".jt-vol,.jt-part-cb").forEach(c=>{ c.disabled=appCb.checked; if(appCb.checked) c.checked=false; }); head.classList.toggle("sel",appCb.checked); });
        box.appendChild(wrap);
      }
    }
    if((t.volumes||[]).length){
      const h=document.createElement("div"); h.className="jt-sec jt-sec-std"; h.textContent="Other volumes"; box.appendChild(h);
      for(const v of t.volumes){
        const row=document.createElement("label"); row.className="jt-std-row"; row.dataset.search=String(v.name).toLowerCase();
        row.innerHTML=`<input type="checkbox" class="jt-vol" data-vol="${escA(v.name)}"> ${esc(v.name)}${v.isSmb?'<span class="smb-chip">SMB</span>':""} <span class="fx-muted">${v.size>0?fmtB(v.size):""}</span>`;
        box.appendChild(row);
      }
    }
    if(!box.children.length) box.innerHTML=`<div class="jt-empty">No apps or volumes found yet.</div>`;
  }
  function targetSummary(ts, sep){
    const c=k=>ts.filter(t=>(t.type||"volume")===k).length;
    const p=[]; if(c("app"))p.push(`${c("app")} app${c("app")>1?"s":""}`); if(c("settings"))p.push(`${c("settings")} settings`);
    if(c("image"))p.push(`${c("image")} image${c("image")>1?"s":""}`); if(c("volume"))p.push(`${c("volume")} volume${c("volume")>1?"s":""}`);
    return p.join(sep);
  }
  function updateSelCount(){
    const el=$("j-sel-count"); if(!el) return; const ts=collectTargets();
    if(!ts.length){ el.textContent="Nothing selected"; el.style.opacity="0.55"; }
    else { el.style.opacity="1"; el.textContent=targetSummary(ts," · "); }
  }
  function filterTree(q){
    q=(q||"").trim().toLowerCase(); const box=$("j-tree"); if(!box) return;
    const clr=$("j-tree-clear"); if(clr) clr.hidden=!q;
    let anyApp=false, anyStd=false;
    for(const w of box.querySelectorAll(".jt-app")){
      const titleMatch=!q||(w.dataset.appTitle||"").includes(q);
      let volMatch=false;
      for(const r of w.querySelectorAll(".jt-vol-row")){ const m=!q||(r.dataset.search||"").includes(q); r.style.display=(q&&!titleMatch&&!m)?"none":""; if(q&&m) volMatch=true; }
      const show=!q||titleMatch||volMatch; w.style.display=show?"":"none"; if(show) anyApp=true;
      const vols=w.querySelector(".jt-vols"), exp=w.querySelector(".jt-exp");
      if(q&&show){ if(vols) vols.classList.add("open"); if(exp) exp.classList.add("open"); }
      else if(!q){ if(vols) vols.classList.remove("open"); if(exp) exp.classList.remove("open"); }
    }
    for(const r of box.querySelectorAll(".jt-std-row")){ const m=!q||(r.dataset.search||"").includes(q); r.style.display=m?"":"none"; if(m) anyStd=true; }
    const sa=box.querySelector(".jt-sec-apps"); if(sa) sa.style.display=anyApp?"":"none";
    const ss=box.querySelector(".jt-sec-std"); if(ss) ss.style.display=anyStd?"":"none";
  }
  $("j-tree").addEventListener("change",updateSelCount);
  $("j-tree-search").addEventListener("input",e=>filterTree(e.target.value));
  $("j-tree-clear").addEventListener("click",()=>{ $("j-tree-search").value=""; filterTree(""); $("j-tree-search").focus(); });
  function collectTargets(){
    const tree=$("j-tree"); const targets=[];
    (jobsState.tree.apps||[]).forEach(a=>{
      const cb=tree.querySelector(`.jt-app-cb[data-app="${CSS.escape(a.name)}"]`);
      if(cb&&cb.checked){ targets.push({type:"app",ref:a.name}); return; }
      const sc=tree.querySelector(`.jt-part-cb[data-app="${CSS.escape(a.name)}"][data-part="settings"]`); if(sc&&sc.checked) targets.push({type:"settings",ref:a.name});
      const ic=tree.querySelector(`.jt-part-cb[data-app="${CSS.escape(a.name)}"][data-part="image"]`); if(ic&&ic.checked) targets.push({type:"image",ref:a.name});
      tree.querySelectorAll(`.jt-vol[data-app="${CSS.escape(a.name)}"]:checked`).forEach(c=>targets.push({type:"volume",ref:c.dataset.vol}));
    });
    tree.querySelectorAll(".jt-vol:not([data-app]):checked").forEach(c=>targets.push({type:"volume",ref:c.dataset.vol}));
    return targets;
  }
  function jobKindChanged(){ const k=$("j-kind").value; $("j-timerow").style.display=(k==="manual"||k==="hourly")?"none":""; $("j-dayrow").style.display=k==="weekly"?"":"none"; }
  $("j-kind").addEventListener("change",jobKindChanged);
  function showEditor(on){ $("bk-main").style.display=on?"none":""; $("bk-editor").hidden=!on; }
  function openJob(j){
    renderTree();
    const tgt=$("j-tgt"); tgt.innerHTML=(jobsState.tree.targetVolumes||[]).map(v=>`<option value="${escA(v.name)}" ${v.name==="matos-backups"?"selected":""}>${esc(v.name)}${v.isSmb?"  (SMB)":""}</option>`).join("");
    if(j){
      $("bk-crumb-cur").textContent="Edit job"; $("j-id").value=j.id; $("j-name").value=j.name; tgt.value=j.targetVolume;
      $("j-kind").value=j.kind||"manual"; $("j-time").value=j.time||"03:00"; $("j-day").value=String(j.weekday||0); $("j-ret").value=j.retentionDays; $("j-en").checked=j.enabled; $("j-img").checked=j.includeImages!==false;
      for(const t of (j.targets||[])){
        if(t.type==="app"){ const c=$("j-tree").querySelector(`.jt-app-cb[data-app="${CSS.escape(t.ref)}"]`); if(c){ c.checked=true; c.dispatchEvent(new Event("change")); } }
        else if(t.type==="settings"||t.type==="image"){ const c=$("j-tree").querySelector(`.jt-part-cb[data-app="${CSS.escape(t.ref)}"][data-part="${t.type}"]`); if(c) c.checked=true; }
        else { const c=$("j-tree").querySelector(`.jt-vol[data-vol="${CSS.escape(t.ref)}"]`); if(c) c.checked=true; }
      }
    } else {
      $("bk-crumb-cur").textContent="New job"; $("j-id").value=""; $("j-name").value="";
      $("j-kind").value="manual"; $("j-time").value="03:00"; $("j-day").value="0"; $("j-ret").value="30"; $("j-en").checked=true; $("j-img").checked=true;
    }
    jobKindChanged(); $("j-tree-search").value=""; filterTree(""); updateSelCount(); showEditor(true);
  }
  $("bk-new-job").addEventListener("click",()=>openJob(null));
  $("bk-crumb-back").addEventListener("click",()=>showEditor(false));
  $("j-cancel").addEventListener("click",()=>showEditor(false));
  $("j-save").addEventListener("click",async()=>{
    const targets=collectTargets();
    if(!$("j-name").value.trim()){ flash("Give the job a name.",false); return; }
    if(!targets.length){ flash("Pick at least one app or volume.",false); return; }
    const job={ id:$("j-id").value, name:$("j-name").value.trim(), targets, targetVolume:$("j-tgt").value,
      kind:$("j-kind").value, time:$("j-time").value, weekday:+$("j-day").value, retentionDays:+$("j-ret").value, enabled:$("j-en").checked, includeImages:$("j-img").checked };
    try{ const r=await fetch("/api/v1/backups/jobs/save",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(job)});
      if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.error||e.detail||("HTTP "+r.status)); }
      showEditor(false); flash("Job saved.",true); loadJobs();
    }catch(e){ flash("Save failed: "+e.message,false); }
  });

  // ---- History (produced backups: apps + volumes, unified) ----
  async function loadHistory(){
    try{
      const [v,a]=await Promise.all([fetch("/api/v1/backups/list").then(r=>r.json()),fetch("/api/v1/backups/apps").then(r=>r.json())]);
      hist.vol=v.backups||[]; hist.targets=v.sourceVolumes||[]; hist.app=a.apps||[]; hist.appTargets=a.targetVolumes||[];
    }catch(_){ $("bk-hist-rows").innerHTML=`<tr><td colspan="5" style="padding:1rem;color:var(--mat-text-muted)">Failed to load.</td></tr>`; return; }
    updateCards();
    const rows=[
      ...hist.app.map(b=>({kind:"app",created:b.createdUtc,size:b.sizeBytes,tgt:b.targetVolume,file:b.fileName,title:b.title||b.stackName,sub:`${b.containers} container(s) · ${(b.volumes||[]).length} vol${b.images?` · ${b.images} img`:""}`,ref:b})),
      ...hist.vol.map(b=>({kind:"vol",created:b.createdUtc,size:b.sizeBytes,tgt:b.targetVolume,file:b.fileName,title:b.sourceVolume,sub:b.fileName,ref:b})),
    ].sort((x,y)=>new Date(y.created)-new Date(x.created));
    if(!rows.length){ $("bk-hist-rows").innerHTML=`<tr><td colspan="5" style="padding:1rem;color:var(--mat-text-muted)">No backups yet — run a job.</td></tr>`; return; }
    $("bk-hist-rows").innerHTML=rows.map((r,i)=>`<tr data-i="${i}">
      <td>${esc(fmtWhen(r.created))}</td>
      <td><span class="pill ${r.kind==="app"?"app":"vol"}">${r.kind==="app"?"APP":"VOLUME"}</span> <strong>${esc(r.title)}</strong><div class="fx-muted" style="font-size:0.72rem">${esc(r.sub)}</div></td>
      <td class="mono">${esc(r.tgt)}</td>
      <td class="num">${fmtB(r.size)}</td>
      <td><div class="bk-acts">
        <button class="ui-btn" data-rst="${i}">Restore</button>
        <button class="ui-btn" data-dl="${i}">Download</button>
        <button class="ui-btn danger" data-del="${i}">Delete</button>
      </div></td></tr>`).join("");
    const get=i=>rows[+i];
    $("bk-hist-rows").querySelectorAll("[data-rst]").forEach(b=>b.addEventListener("click",()=>{ const r=get(b.dataset.rst); r.kind==="app"?openAppRestore(r.ref):openVolRestore(r.ref); }));
    $("bk-hist-rows").querySelectorAll("[data-dl]").forEach(b=>b.addEventListener("click",()=>{ const r=get(b.dataset.dl); const base=r.kind==="app"?"/api/v1/backups/apps/download":"/api/v1/backups/download"; window.open(`${base}?volume=${encodeURIComponent(r.tgt)}&file=${encodeURIComponent(r.file)}`,"_blank"); }));
    $("bk-hist-rows").querySelectorAll("[data-del]").forEach(b=>b.addEventListener("click",()=>{ const r=get(b.dataset.del); delBackup(r); }));
  }
  async function delBackup(r){ if(!await matDialog.confirm(`Delete backup "${r.file}"?`,{title:"Delete backup",danger:true,okLabel:"Delete"})) return;
    const url=r.kind==="app"?"/api/v1/backups/apps/delete":"/api/v1/backups/delete";
    try{ await fetch(url,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({targetVolume:r.tgt,fileName:r.file})}); loadHistory(); }
    catch(_){ flash("Delete failed.",false); } }

  // volume restore
  let rstBackup=null;
  function openVolRestore(b){ rstBackup=b;
    $("bk-rst-info").innerHTML=`Restoring <strong>${esc(b.fileName)}</strong>. Original source volume: <strong>${esc(b.sourceVolume)}</strong>.`;
    const sel=$("bk-rst-tgt"); sel.innerHTML=(hist.targets||[]).map(v=>`<option value="${escA(v.name)}" ${v.name===b.sourceVolume?"selected":""}>${esc(v.name)}${v.isSmb?"  (SMB)":""}</option>`).join("");
    $("bk-rst-dlg").hidden=false; }
  $("bk-rst-cancel").addEventListener("click",()=>{ $("bk-rst-dlg").hidden=true; });
  $("bk-rst-go").addEventListener("click",async()=>{
    const b=rstBackup; if(!b) return; const into=$("bk-rst-tgt").value;
    if(!await matDialog.confirm(`Restore INTO "${into}"? Existing files in that volume are removed first.`,{title:"Restore backup",danger:true,okLabel:"Restore"})) return;
    const btn=$("bk-rst-go"); btn.disabled=true; const o=btn.textContent; btn.textContent="Restoring…";
    try{ const r=await fetch("/api/v1/backups/restore",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({targetVolume:b.targetVolume,fileName:b.fileName,restoreInto:into})});
      if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.detail||e.error||("HTTP "+r.status)); }
      flash(`Restored to ${into}.`,true); $("bk-rst-dlg").hidden=true;
    }catch(e){ flash("Restore failed: "+e.message,false); } finally{ btn.disabled=false; btn.textContent=o; }
  });
  // app restore
  let arstBackup=null;
  function openAppRestore(b){ arstBackup=b;
    $("bk-arst-info").innerHTML=`Restoring <strong>${esc(b.title||b.stackName)}</strong> — ${b.containers} container(s) and ${(b.volumes||[]).length} volume(s)${(b.volumes||[]).length?': <span class="mono">'+b.volumes.map(esc).join(", ")+'</span>':''}.`;
    $("bk-arst-dlg").hidden=false; }
  $("bk-arst-cancel").addEventListener("click",()=>{ $("bk-arst-dlg").hidden=true; });
  $("bk-arst-go").addEventListener("click",async()=>{
    const b=arstBackup; if(!b) return;
    if(!await matDialog.confirm(`Restore "${b.title||b.stackName}"? Its containers are recreated and the included volumes' data is overwritten.`,{title:"Restore app",danger:true,okLabel:"Restore & run"})) return;
    const btn=$("bk-arst-go"); btn.disabled=true; const o=btn.textContent; btn.textContent="Restoring…";
    try{ const r=await fetch("/api/v1/backups/apps/restore",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({targetVolume:b.targetVolume,fileName:b.fileName})});
      if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.detail||e.error||("HTTP "+r.status)); }
      flash(`Restored ${b.title||b.stackName} — the app is starting.`,true); $("bk-arst-dlg").hidden=true;
    }catch(e){ flash("Restore failed: "+e.message,false); } finally{ btn.disabled=false; btn.textContent=o; }
  });

  // ---- tabs ----
  let tab="jobs";
  document.querySelectorAll("#bk-tabs .tab").forEach(t=>t.addEventListener("click",()=>{
    document.querySelectorAll("#bk-tabs .tab").forEach(x=>x.classList.toggle("active",x===t));
    tab=t.dataset.tab;
    $("bk-pane-jobs").style.display=tab==="jobs"?"":"none";
    $("bk-pane-history").style.display=tab==="history"?"":"none";
    $("bk-new-job").style.display=tab==="jobs"?"":"none";
    if(tab==="history") loadHistory();
  }));
  $("bk-refresh").addEventListener("click",()=>{ if(tab==="history") loadHistory(); else loadJobs(); });

  loadJobs(); loadHistory();
})();
</script>
}

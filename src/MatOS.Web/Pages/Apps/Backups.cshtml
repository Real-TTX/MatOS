@page "/apps/backups"
@model MatOS.Web.Pages.Apps.BackupsModel
@{
    ViewData["Title"] = "Backups";
    ViewData["Description"] = "Snapshot Docker volumes to any other volume — including SMB shares for off-host storage.";
    Layout = "_WindowLayout";
}

<div id="bk">
    <div class="tabbar" id="bk-tabs">
        <button class="tab active" data-tab="backups">Backups</button>
        <button class="tab" data-tab="schedules">Schedules</button>
    </div>
    <div class="win-toolbar" style="gap:0.6rem;flex-wrap:wrap;margin-top:0.4rem">
        <button class="ui-btn primary" id="bk-new">Backup now</button>
        <button class="ui-btn primary" id="bk-new-sched" style="display:none">New schedule</button>
        <button class="ui-btn" id="bk-refresh">Refresh</button>
        <span class="fx-muted" style="font-size:0.85rem;flex:1">Backups are gzip-compressed tar archives of a volume's contents.</span>
    </div>
    <div id="bk-msg" class="card" style="display:none;margin-bottom:0.8rem"></div>
    <div class="card" id="bk-pane-backups" style="padding:0;overflow:hidden">
        <table class="bkt">
            <thead><tr><th>Created</th><th>Source volume</th><th>Stored on</th><th class="num">Size</th><th></th></tr></thead>
            <tbody id="bk-rows"><tr><td colspan="5" style="padding:1rem;color:var(--mat-text-muted)">Loading…</td></tr></tbody>
        </table>
    </div>
    <div class="card" id="bk-pane-schedules" style="padding:0;overflow:hidden;display:none">
        <table class="bkt">
            <thead><tr><th>Name</th><th>Source → Target</th><th>When</th><th>Retention</th><th>Last run</th><th></th></tr></thead>
            <tbody id="bk-sched-rows"><tr><td colspan="6" style="padding:1rem;color:var(--mat-text-muted)">Loading…</td></tr></tbody>
        </table>
    </div>

    <div class="dlg" id="bk-sched-dlg" hidden><div class="dlg-card">
        <h3 style="margin:0 0 0.9rem">Backup job</h3>
        <label class="fl"><span>Name</span><input class="ui-input" id="bk-sched-name" placeholder="Nightly full backup" /></label>
        <div class="fl">
            <span>Source volumes <span class="fx-muted">(none selected = ALL volumes)</span></span>
            <div class="bk-src-picker" id="bk-sched-srcs"></div>
        </div>
        <label class="fl"><span>Target volume</span><select class="ui-select" id="bk-sched-tgt"></select></label>
        <label class="fl"><span>Repeat</span>
            <select class="ui-select" id="bk-sched-kind"><option value="hourly">Hourly</option><option value="daily" selected>Daily</option><option value="weekly">Weekly</option></select>
        </label>
        <div id="bk-sched-timerow" class="fl"><span>Time (server local)</span><input class="ui-input" id="bk-sched-time" type="time" value="03:00" /></div>
        <div id="bk-sched-dayrow" class="fl" style="display:none"><span>Day</span>
            <select class="ui-select" id="bk-sched-day"><option value="0">Sunday</option><option value="1">Monday</option><option value="2">Tuesday</option><option value="3">Wednesday</option><option value="4">Thursday</option><option value="5">Friday</option><option value="6">Saturday</option></select>
        </div>
        <label class="fl"><span>Retention (days, 0 = keep forever)</span><input class="ui-input" id="bk-sched-ret" type="number" min="0" max="3650" value="30" /></label>
        <label style="display:flex;align-items:center;gap:0.4rem;margin:0 0 0.5rem"><input type="checkbox" id="bk-sched-en" checked /> Enabled</label>
        <input type="hidden" id="bk-sched-id" />
        <div style="display:flex;gap:0.5rem;margin-top:0.9rem"><button class="ui-btn primary" id="bk-sched-save">Save schedule</button><button class="ui-btn" id="bk-sched-cancel">Cancel</button></div>
    </div></div>

    <div class="dlg" id="bk-new-dlg" hidden><div class="dlg-card">
        <h3 style="margin:0 0 0.9rem">New backup</h3>
        <label class="fl"><span>Source volume *</span><select class="ui-select" id="bk-src"></select></label>
        <label class="fl"><span>Target (where the backup file is stored)</span><select class="ui-select" id="bk-tgt"></select>
            <span class="fx-muted" style="font-size:0.78rem">Pick a network location (SMB) for off-host backups.</span></label>
        <div style="display:flex;gap:0.5rem;margin-top:1rem"><button class="ui-btn primary" id="bk-go">Start backup</button><button class="ui-btn" id="bk-cancel">Cancel</button></div>
    </div></div>

    <div class="dlg" id="bk-rst-dlg" hidden><div class="dlg-card">
        <h3 style="margin:0 0 0.9rem">Restore backup</h3>
        <div class="wz-note" id="bk-rst-info" style="margin-bottom:0.9rem"></div>
        <label class="fl"><span>Restore into volume *</span><select class="ui-select" id="bk-rst-tgt"></select>
            <span class="fx-muted" style="font-size:0.78rem"><strong>Existing files in the target volume are removed first.</strong></span></label>
        <div style="display:flex;gap:0.5rem;margin-top:1rem"><button class="ui-btn primary" id="bk-rst-go">Restore</button><button class="ui-btn" id="bk-rst-cancel">Cancel</button></div>
    </div></div>
</div>

@section Head {
<style>
table.bkt { width:100%; border-collapse:collapse; }
table.bkt th, table.bkt td { padding:0.55rem 0.9rem; text-align:left; white-space:nowrap; vertical-align:middle; }
table.bkt thead th { font-size:0.78rem; color:var(--mat-text-muted); border-bottom:1px solid var(--mat-border); }
table.bkt tbody tr { border-top:1px solid var(--mat-border); }
table.bkt th.num, table.bkt td.num { text-align:right; }
.smb-chip { font-size:0.68rem; font-weight:700; padding:0.05rem 0.4rem; border-radius:999px; background:rgba(52,211,153,0.2); color:#7ff0c4; margin-left:0.3rem; }
.fl { display:flex; flex-direction:column; gap:0.3rem; margin-bottom:0.8rem; } .fl > span { font-size:0.82rem; font-weight:600; color:var(--mat-text-muted); }
.dlg { position:absolute; inset:0; background:rgba(0,0,0,0.55); display:grid; place-items:center; z-index:30; }
.dlg[hidden]{ display:none; }
.dlg-card { width:min(460px,92%); background:var(--mat-surface); border:1px solid var(--mat-border); border-radius:14px; padding:1.2rem; box-shadow:0 24px 60px rgba(0,0,0,.5); }
.wz-note { background:var(--mat-surface-2); border:1px solid var(--mat-border); border-radius:10px; padding:0.7rem 0.85rem; font-size:0.86rem; }
.bk-acts { display:flex; gap:0.3rem; justify-content:flex-end; }
.bk-acts .ui-btn { padding:0.25rem 0.55rem; font-size:0.78rem; }
.tabbar { display:flex; gap:0.15rem; border-bottom:1px solid var(--mat-border); }
.tab { border:none; background:transparent; padding:0.5rem 0.85rem; font:inherit; font-weight:600; color:var(--mat-text-muted); cursor:pointer; border-bottom:2px solid transparent; }
.tab.active { color:var(--mat-text); border-bottom-color:var(--mat-accent); }
.sched-off { opacity:0.55; }
.bk-src-picker { max-height:180px; overflow-y:auto; border:1px solid var(--mat-border); border-radius:8px; padding:0.4rem 0.5rem; background:var(--mat-surface-2); }
.bk-src-picker label { display:flex; align-items:center; gap:0.4rem; padding:0.2rem 0.15rem; font-size:0.86rem; }
.bk-src-picker .all { border-bottom:1px solid var(--mat-border); margin-bottom:0.3rem; padding-bottom:0.35rem; font-weight:600; }
</style>
}

@section Scripts {
<script>
(function(){
  const esc=s=>String(s==null?"":s).replace(/[&<>]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c]));
  const escA=s=>String(s==null?"":s).replace(/"/g,"&quot;");
  const fmtB=b=>{ if(b==null||b<0)return "—"; const u=["B","KB","MB","GB","TB"];let i=0,n=b;while(n>=1024&&i<u.length-1){n/=1024;i++;}return n.toFixed(n<10&&i>0?1:0)+" "+u[i]; };
  const fmtWhen=s=>{ if(!s)return""; const d=new Date(s); return isNaN(d)?"":d.toLocaleString(); };
  const $=id=>document.getElementById(id);
  const msg=$("bk-msg");
  let state={backups:[],sourceVolumes:[],targetVolumes:[]};

  function flash(t,ok){ msg.style.display=""; msg.style.borderColor=ok?"rgba(52,211,153,0.4)":"rgba(244,80,107,0.4)"; msg.style.background=ok?"rgba(52,211,153,0.14)":"rgba(244,80,107,0.14)"; msg.style.color=ok?"#7ff0c4":"#ffb3c0"; msg.textContent=t; setTimeout(()=>msg.style.display="none",6000); }

  async function load(){
    try{ state=await (await fetch("/api/v1/backups/list")).json(); }
    catch(_){ $("bk-rows").innerHTML=`<tr><td colspan="5" style="padding:1rem;color:var(--mat-text-muted)">Failed to load.</td></tr>`; return; }
    const bs=state.backups||[];
    if(!bs.length){ $("bk-rows").innerHTML=`<tr><td colspan="5" style="padding:1rem;color:var(--mat-text-muted)">No backups yet — click "Backup now" to create your first one.</td></tr>`; return; }
    $("bk-rows").innerHTML=bs.map((b,i)=>`<tr data-i="${i}">
      <td>${esc(fmtWhen(b.createdUtc))}</td>
      <td><strong>${esc(b.sourceVolume)}</strong></td>
      <td class="mono">${esc(b.targetVolume)}${(state.targetVolumes.find(v=>v.name===b.targetVolume)||{}).isSmb?'<span class="smb-chip">SMB</span>':''}<div class="fx-muted" style="font-size:0.72rem">${esc(b.fileName)}</div></td>
      <td class="num">${fmtB(b.sizeBytes)}</td>
      <td><div class="bk-acts">
        <button class="ui-btn" data-rst="${i}">Restore</button>
        <button class="ui-btn" data-dl="${i}">Download</button>
        <button class="ui-btn danger" data-del="${i}">Delete</button>
      </div></td></tr>`).join("");
    $("bk-rows").querySelectorAll("[data-rst]").forEach(b=>b.addEventListener("click",()=>openRestore(+b.dataset.rst)));
    $("bk-rows").querySelectorAll("[data-dl]").forEach(b=>b.addEventListener("click",()=>{ const x=bs[+b.dataset.dl]; window.open(`/api/v1/backups/download?volume=${encodeURIComponent(x.targetVolume)}&file=${encodeURIComponent(x.fileName)}`, "_blank"); }));
    $("bk-rows").querySelectorAll("[data-del]").forEach(b=>b.addEventListener("click",()=>del(bs[+b.dataset.del])));
  }

  // ---- New backup dialog ----
  function populateSelects(){
    const srcSel=$("bk-src"); srcSel.innerHTML=state.sourceVolumes.map(v=>`<option value="${escA(v.name)}">${esc(v.name)}${v.isSmb?"  (SMB)":""}${v.size>0?"  ·  "+fmtB(v.size):""}</option>`).join("");
    const tgtSel=$("bk-tgt"); tgtSel.innerHTML=state.targetVolumes.map(v=>`<option value="${escA(v.name)}" ${v.name==="matos-backups"?"selected":""}>${esc(v.name)}${v.isSmb?"  (SMB)":""}</option>`).join("");
  }
  $("bk-new").addEventListener("click",()=>{ if(!state.sourceVolumes.length){ flash("No volumes available.",false); return; } populateSelects(); $("bk-new-dlg").hidden=false; });
  $("bk-cancel").addEventListener("click",()=>{ $("bk-new-dlg").hidden=true; });
  $("bk-go").addEventListener("click",async()=>{
    const btn=$("bk-go"); const src=$("bk-src").value, tgt=$("bk-tgt").value;
    if(!src){ flash("Pick a source volume.",false); return; }
    if(src===tgt){ flash("Source and target must differ.",false); return; }
    btn.disabled=true; const orig=btn.textContent; btn.textContent="Backing up…";
    try{ const r=await fetch("/api/v1/backups/create",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({sourceVolume:src,targetVolume:tgt})});
      if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.detail||e.error||("HTTP "+r.status)); }
      const j=await r.json(); flash(`Backup written to ${j.backup.targetVolume}/${j.backup.fileName} (${fmtB(j.backup.sizeBytes)}).`,true);
      $("bk-new-dlg").hidden=true; load();
    }catch(e){ flash("Backup failed: "+e.message,false); } finally{ btn.disabled=false; btn.textContent=orig; }
  });

  // ---- Restore dialog ----
  let rstIdx=-1;
  function openRestore(i){ rstIdx=i; const b=state.backups[i]; if(!b) return;
    $("bk-rst-info").innerHTML=`Restoring <strong>${esc(b.fileName)}</strong> from <span class="mono">${esc(b.targetVolume)}</span>. Original source volume: <strong>${esc(b.sourceVolume)}</strong>.`;
    const sel=$("bk-rst-tgt"); sel.innerHTML=state.sourceVolumes.map(v=>`<option value="${escA(v.name)}" ${v.name===b.sourceVolume?"selected":""}>${esc(v.name)}${v.isSmb?"  (SMB)":""}</option>`).join("");
    $("bk-rst-dlg").hidden=false; }
  $("bk-rst-cancel").addEventListener("click",()=>{ $("bk-rst-dlg").hidden=true; });
  $("bk-rst-go").addEventListener("click",async()=>{
    const b=state.backups[rstIdx]; if(!b) return;
    const into=$("bk-rst-tgt").value;
    if(!confirm(`Restore backup INTO "${into}"? Existing files in that volume will be removed first.`)) return;
    const btn=$("bk-rst-go"); btn.disabled=true; const orig=btn.textContent; btn.textContent="Restoring…";
    try{ const r=await fetch("/api/v1/backups/restore",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({targetVolume:b.targetVolume,fileName:b.fileName,restoreInto:into})});
      if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.detail||e.error||("HTTP "+r.status)); }
      flash(`Restored to ${into}.`,true); $("bk-rst-dlg").hidden=true;
    }catch(e){ flash("Restore failed: "+e.message,false); } finally{ btn.disabled=false; btn.textContent=orig; }
  });

  async function del(b){ if(!confirm(`Delete backup "${b.fileName}" from ${b.targetVolume}?`)) return;
    try{ await fetch("/api/v1/backups/delete",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({targetVolume:b.targetVolume,fileName:b.fileName})}); load(); }
    catch(e){ flash("Delete failed.",false); } }

  // ---- Schedules ----
  let tab="backups", schedules=[];
  document.querySelectorAll("#bk-tabs .tab").forEach(t=>t.addEventListener("click",()=>{
    document.querySelectorAll("#bk-tabs .tab").forEach(x=>x.classList.toggle("active",x===t));
    tab=t.dataset.tab;
    $("bk-pane-backups").style.display = tab==="backups"?"":"none";
    $("bk-pane-schedules").style.display = tab==="schedules"?"":"none";
    $("bk-new").style.display = tab==="backups"?"":"none";
    $("bk-new-sched").style.display = tab==="schedules"?"":"none";
    if(tab==="schedules") loadSchedules();
  }));

  async function loadSchedules(){
    try{ const d=await (await fetch("/api/v1/backups/schedules")).json(); schedules=d.schedules||[]; }
    catch(_){ $("bk-sched-rows").innerHTML=`<tr><td colspan="6" style="padding:1rem;color:var(--mat-text-muted)">Failed to load.</td></tr>`; return; }
    const days=["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];
    if(!schedules.length){ $("bk-sched-rows").innerHTML=`<tr><td colspan="6" style="padding:1rem;color:var(--mat-text-muted)">No schedules yet — click "New schedule".</td></tr>`; return; }
    $("bk-sched-rows").innerHTML=schedules.map((s,i)=>{
      const sources = (s.sourceVolumes && s.sourceVolumes.length) ? s.sourceVolumes : (s.sourceVolume?[s.sourceVolume]:[]);
      const srcStr = sources.length===0 ? "<em>All volumes</em>" : (sources.length<=2 ? sources.map(esc).join(", ") : `${esc(sources[0])} + ${sources.length-1} more`);
      return `<tr class="${s.enabled?'':'sched-off'}" data-i="${i}">
      <td><strong>${esc(s.name)}</strong>${s.lastError?'<div class="fx-muted" style="font-size:0.7rem;color:#ffb3c0">⚠ '+esc(s.lastError)+'</div>':''}</td>
      <td class="mono">${srcStr} → ${esc(s.targetVolume)}</td>
      <td>${s.kind==="hourly"?"Hourly":s.kind==="weekly"?days[s.weekday]+" "+esc(s.time):"Daily at "+esc(s.time)}</td>
      <td>${s.retentionDays>0?s.retentionDays+" d":"∞"}</td>
      <td class="fx-muted">${s.lastRunUtc?fmtWhen(s.lastRunUtc):"—"}</td>
      <td><div class="bk-acts">
        <button class="ui-btn" data-sedit="${i}">Edit</button>
        <button class="ui-btn danger" data-sdel="${i}">Delete</button>
      </div></td></tr>`;}).join("");
    $("bk-sched-rows").querySelectorAll("[data-sedit]").forEach(b=>b.addEventListener("click",()=>openSched(schedules[+b.dataset.sedit])));
    $("bk-sched-rows").querySelectorAll("[data-sdel]").forEach(b=>b.addEventListener("click",()=>delSched(schedules[+b.dataset.sdel])));
  }

  function openSched(s){
    populateSelects();
    // Multi-checkbox source picker: first row = "All volumes", rest = per-volume checkboxes.
    const pick=$("bk-sched-srcs"); pick.innerHTML="";
    const allRow=document.createElement("label"); allRow.className="all";
    allRow.innerHTML=`<input type="checkbox" id="bk-sched-src-all"> All volumes <span class="fx-muted">— any future volume gets included too</span>`;
    pick.appendChild(allRow);
    for(const v of state.sourceVolumes){
      const row=document.createElement("label");
      row.innerHTML=`<input type="checkbox" data-src="${escA(v.name)}"> ${esc(v.name)}${v.isSmb?"  (SMB)":""}${v.size>0?"  · "+fmtB(v.size):""}`;
      pick.appendChild(row);
    }
    const allCb=$("bk-sched-src-all");
    allCb.addEventListener("change",()=>{ pick.querySelectorAll("[data-src]").forEach(c=>{ c.disabled=allCb.checked; if(allCb.checked) c.checked=false; }); });
    // Target dropdown
    const tgtSel=$("bk-sched-tgt"); tgtSel.innerHTML=$("bk-tgt").innerHTML;

    if(s){
      $("bk-sched-id").value=s.id; $("bk-sched-name").value=s.name; tgtSel.value=s.targetVolume;
      const list = (s.sourceVolumes && s.sourceVolumes.length) ? s.sourceVolumes : (s.sourceVolume?[s.sourceVolume]:[]);
      if(!list.length){ allCb.checked=true; allCb.dispatchEvent(new Event("change")); }
      else { for(const v of list){ const c=pick.querySelector(`[data-src="${CSS.escape(v)}"]`); if(c) c.checked=true; } }
      $("bk-sched-kind").value=s.kind; $("bk-sched-time").value=s.time; $("bk-sched-day").value=String(s.weekday);
      $("bk-sched-ret").value=s.retentionDays; $("bk-sched-en").checked=s.enabled;
    } else {
      $("bk-sched-id").value=""; $("bk-sched-name").value="";
      $("bk-sched-kind").value="daily"; $("bk-sched-time").value="03:00"; $("bk-sched-day").value="0";
      $("bk-sched-ret").value="30"; $("bk-sched-en").checked=true;
    }
    kindChanged();
    $("bk-sched-dlg").hidden=false;
  }
  function kindChanged(){ const k=$("bk-sched-kind").value; $("bk-sched-timerow").style.display = k==="hourly"?"none":""; $("bk-sched-dayrow").style.display = k==="weekly"?"":"none"; }
  $("bk-sched-kind").addEventListener("change",kindChanged);
  $("bk-new-sched").addEventListener("click",()=>{ if(!state.sourceVolumes.length){ flash("No volumes available.",false); return; } openSched(null); });
  $("bk-sched-cancel").addEventListener("click",()=>{ $("bk-sched-dlg").hidden=true; });
  $("bk-sched-save").addEventListener("click",async()=>{
    const allCb=$("bk-sched-src-all"); const picks=$("bk-sched-srcs");
    const sourceVolumes = allCb && allCb.checked ? [] : [...picks.querySelectorAll("[data-src]:checked")].map(c=>c.dataset.src);
    const body={ id:$("bk-sched-id").value, name:$("bk-sched-name").value.trim(),
      sourceVolumes, targetVolume:$("bk-sched-tgt").value,
      kind:$("bk-sched-kind").value, time:$("bk-sched-time").value, weekday:+$("bk-sched-day").value,
      retentionDays:+$("bk-sched-ret").value, enabled:$("bk-sched-en").checked };
    if(!(allCb && allCb.checked) && sourceVolumes.length===0){ flash("Pick at least one source volume (or check 'All volumes').",false); return; }
    if(sourceVolumes.includes(body.targetVolume)){ flash("A source volume can't equal the target.",false); return; }
    try{ const r=await fetch("/api/v1/backups/schedules/save",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
      if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.error||e.detail||("HTTP "+r.status)); }
      $("bk-sched-dlg").hidden=true; flash("Schedule saved.",true); loadSchedules();
    }catch(e){ flash("Save failed: "+e.message,false); }
  });
  async function delSched(s){ if(!confirm(`Delete schedule "${s.name}"?`)) return;
    try{ await fetch("/api/v1/backups/schedules/delete",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id:s.id})}); loadSchedules(); }
    catch(_){ flash("Delete failed.",false); } }

  $("bk-refresh").addEventListener("click",()=>{ if(tab==="schedules") loadSchedules(); else load(); });
  load();
})();
</script>
}

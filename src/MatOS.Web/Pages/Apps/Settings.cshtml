@page "/apps/settings"
@model MatOS.Web.Pages.Apps.SettingsModel
@{
    ViewData["Title"] = "Settings";
    Layout = "_WindowLayout";
}

<div class="mset">
    <aside class="mset-side">
        <div class="mset-title">Settings</div>
        <div class="mset-side-head">Personal <span class="mset-you" title="Only affects your account">👤</span></div>
        <button class="mset-nav active" data-p="appearance"><span class="i">🎨</span> Appearance</button>
        <button class="mset-nav" data-p="taskbar"><span class="i">📊</span> Taskbar</button>
        <div class="mset-side-head">System</div>
        <button class="mset-nav" data-p="general"><span class="i">⚙️</span> General</button>
        <button class="mset-nav" data-p="docker"><span class="i">🐳</span> Docker</button>
        <button class="mset-nav" data-p="about"><span class="i">ℹ️</span> About</button>
    </aside>

    <section class="mset-main">
        <form method="post">
            <div class="mset-panel active" data-panel="appearance">
                <h2>Appearance <span class="mset-you" title="Personal setting — applies to your account only">👤</span></h2>
                <div class="mset-group pad">
                    <div class="mset-grouphead">Theme</div>
                    <div class="th-picker" style="padding:0.9rem 1rem 1rem">
                        @foreach (var t in new[] { ("auto", "System"), ("light", "Light"), ("dark", "Dark") })
                        {
                            <label class="th-tile @(Model.Theme == t.Item1 ? "selected" : "")" data-key="@t.Item1">
                                <input type="radio" name="Theme" value="@t.Item1" @(Model.Theme == t.Item1 ? "checked" : "") hidden />
                                <span class="th-swatch th-@t.Item1"></span>
                                <span class="nm">@t.Item2</span>
                            </label>
                        }
                    </div>
                </div>
                <div class="mset-group pad">
                    <div class="mset-grouphead" style="display:flex;align-items:center;justify-content:space-between">
                        <span>Wallpaper</span>
                        <div class="tb-seg" id="wp-style" style="margin-right:0.9rem">
                            <button type="button" data-v="fill" class="@(Model.WallpaperStyle=="fill"?"active":"")" title="Fill the screen, cropping if needed">Fill</button>
                            <button type="button" data-v="fit" class="@(Model.WallpaperStyle=="fit"?"active":"")" title="Fit the whole image, no cropping">Fit</button>
                            <button type="button" data-v="center" class="@(Model.WallpaperStyle=="center"?"active":"")" title="Actual size, centered">Center</button>
                            <button type="button" data-v="tile" class="@(Model.WallpaperStyle=="tile"?"active":"")" title="Repeat at actual size">Tile</button>
                        </div>
                    </div>
                    <div class="wp-picker" style="padding:0.9rem 1rem 1rem">
                        @foreach (var w in Model.AllWallpapers)
                        {
                            <label class="wp-tile @(Model.Wallpaper == w.Key ? "selected" : "")" data-key="@w.Key">
                                <input type="radio" name="Wallpaper" value="@w.Key" @(Model.Wallpaper == w.Key ? "checked" : "") hidden />
                                <span class="swatch wp-@w.Key wps-fill"><span class="wp-check">✓</span></span>
                                <span class="nm">@w.Name</span>
                            </label>
                        }
                    </div>
                </div>
                <div class="mset-group pad">
                    <div class="mset-grouphead">Accent colour</div>
                    <div class="ac-picker" style="padding:0.9rem 1rem 1rem" id="ac-picker" data-current="@Model.AccentColor">
                        @{ var presets = new[] { "#8b5cf6", "#22b8ff", "#34d399", "#fbbf24", "#f4506b", "#ec4899", "#f97316" }; }
                        @foreach (var c in presets)
                        {
                            <button type="button" class="ac-swatch @(string.Equals(Model.AccentColor, c, StringComparison.OrdinalIgnoreCase) ? "selected" : "")" data-v="@c" style="background:@c"></button>
                        }
                        <label class="ac-custom" title="Custom colour">
                            <input type="color" id="ac-custom-input" value="@(string.IsNullOrWhiteSpace(Model.AccentColor) ? "#8b5cf6" : Model.AccentColor)" />
                            <span>Custom</span>
                        </label>
                        <button type="button" class="ui-btn" id="ac-reset">Reset to default</button>
                    </div>
                </div>
            </div>

            <div class="mset-panel" data-panel="taskbar">
                <h2>Taskbar <span class="mset-you" title="Personal setting — applies to your account only">👤</span></h2>
                <div class="mset-group">
                    <div class="mset-row">
                        <div class="mset-label">Position<small>Where the taskbar sits on the screen.</small></div>
                        <div class="tb-seg" id="tb-pos"><button type="button" data-v="bottom" class="@(Model.TaskbarPosition!="top"?"active":"")">Bottom</button><button type="button" data-v="top" class="@(Model.TaskbarPosition=="top"?"active":"")">Top</button></div>
                    </div>
                    <div class="mset-row">
                        <div class="mset-label">Icon alignment<small>Where the start button + window icons cluster.</small></div>
                        <div class="tb-seg" id="tb-align"><button type="button" data-v="left" class="@(Model.TaskbarAlign!="center"?"active":"")">Left</button><button type="button" data-v="center" class="@(Model.TaskbarAlign=="center"?"active":"")">Center</button></div>
                    </div>
                    <div class="mset-row">
                        <div class="mset-label">Show search pill<small>The always-visible search input next to the Start button.</small></div>
                        <label class="tb-switch"><input type="checkbox" id="tb-search" @(Model.TaskbarSearch?"checked":"")><span></span></label>
                    </div>
                    <div class="mset-row">
                        <div class="mset-label">Show labels<small>App titles next to each taskbar icon. Turn off to fit more icons (icons only).</small></div>
                        <label class="tb-switch"><input type="checkbox" id="tb-labels" @(Model.TaskbarLabels?"checked":"")><span></span></label>
                    </div>
                </div>
            </div>

            <div class="mset-panel" data-panel="general">
                <h2>General</h2>
                <div class="mset-group">
                    <div class="mset-row">
                        <div class="mset-label">Instance name</div>
                        <input class="ui-input" name="InstanceName" value="@Model.InstanceName" />
                    </div>
                    <div class="mset-row">
                        <div class="mset-label">App base domain<small>Installed apps get a subdomain here (proxied by Caddy/Matcad). <span class="mono">apps.localhost</span> works locally.</small></div>
                        <input class="ui-input" name="BaseDomain" value="@Model.BaseDomain" />
                    </div>
                </div>
            </div>

            <div class="mset-panel" data-panel="docker">
                <h2>Docker</h2>
                <div class="mset-group">
                    <div class="mset-row"><div class="mset-label">Engine endpoint</div><div class="mono fx-muted">@Model.DockerEndpoint</div></div>
                    <div class="mset-row">
                        <div class="mset-label">App network<small>Network app containers join so the reverse proxy (Caddy/Matcad) can reach them. Leave blank for the default (<span class="mono">@Model.DefaultNetwork</span>). Set this to your existing Caddy/Matcad's network if you don't use matOS's bundled proxy.</small></div>
                        <input class="ui-input mono" name="Network" value="@Model.Network" placeholder="@Model.DefaultNetwork" />
                    </div>
                    <div class="mset-row"><div class="mset-label">Volumes path</div><div class="mono fx-muted">@Model.VolumesPath</div></div>
                    <div class="mset-row"><div class="mset-label">Inventory</div><div id="mset-inv" class="fx-muted">…</div></div>
                </div>
            </div>

            <div class="mset-panel" data-panel="about">
                <h2>About</h2>
                <div class="mset-group pad">
                    <div class="mset-about">
                        <img src="~/img/logo.svg" alt="matOS" />
                        <div>
                            <div class="mset-word">mat<span>OS</span></div>
                            <div class="fx-muted" style="margin:0.15rem 0 0.5rem">@Model.Version · @Model.Channel</div>
                            <p class="fx-muted" style="margin:0;max-width:420px">A self-hosted, browser-based operating system for Docker — an iOS/umbrelOS-style desktop where every container is an app.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mset-foot">
                <button type="submit" class="ui-btn primary">Save changes</button>
                <span id="mset-saved" class="pill on" style="@(Model.Saved ? "" : "display:none")">Saved ✓</span>
            </div>
        </form>
    </section>
</div>

@section Head {
<style>
.mset { position:absolute; inset:0; display:flex; background:var(--mat-bg); }
.mset-side { width:220px; flex:0 0 auto; border-right:1px solid var(--mat-border); padding:1rem 0.6rem; background:rgba(0,0,0,0.18); overflow:auto; }
.mset-title { font-weight:800; font-size:1.15rem; padding:0.2rem 0.6rem 0.9rem; }
.mset-nav { display:flex; align-items:center; gap:0.6rem; width:100%; padding:0.5rem 0.6rem; margin-bottom:0.15rem; border:none; background:transparent; color:var(--mat-text); border-radius:8px; cursor:pointer; font:inherit; font-size:0.9rem; text-align:left; }
.mset-nav:hover { background:var(--mat-surface-2); }
.mset-nav.active { background:var(--mat-accent); color:#fff; }
.mset-nav .i { font-size:1.05rem; }
.mset-main { flex:1 1 auto; overflow:auto; padding:1.4rem 1.6rem 2.5rem; }
.mset-panel { display:none; } .mset-panel.active { display:block; }
.mset-panel h2 { margin:0 0 1rem; font-size:1.35rem; font-weight:800; letter-spacing:-0.02em; }
.mset-group { background:var(--mat-surface); border:1px solid var(--mat-border); border-radius:12px; overflow:hidden; margin-bottom:1rem; }
.mset-grouphead { padding:0.7rem 1rem 0.2rem; font-size:0.72rem; color:var(--mat-text-muted); text-transform:uppercase; letter-spacing:0.06em; font-weight:700; }
.mset-row { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:0.75rem 1rem; border-top:1px solid var(--mat-border); }
.mset-group > .mset-row:first-child { border-top:0; }
.mset-label { font-weight:600; font-size:0.92rem; } .mset-label small { display:block; color:var(--mat-text-muted); font-weight:400; font-size:0.78rem; margin-top:0.15rem; max-width:360px; }
.mset-row .ui-input { max-width:280px; width:280px; }
.mset-foot { display:flex; align-items:center; gap:0.9rem; margin-top:0.4rem; }
.mset-about { display:flex; align-items:center; gap:1.1rem; padding:1.1rem; }
.mset-about img { width:76px; height:76px; border-radius:18px; }
.mset-word { font-size:1.5rem; font-weight:800; letter-spacing:-0.02em; }
.mset-word span { background:linear-gradient(135deg,#7c6bff,#8b5cf6,#c026d3); -webkit-background-clip:text; background-clip:text; color:transparent; }
.wp-picker, .th-picker { display:grid; gap:0.7rem; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); }
.th-tile { border:2px solid transparent; border-radius:12px; overflow:hidden; cursor:pointer; background:var(--mat-surface); padding:0; }
.th-tile .th-swatch { height:64px; display:block; border-bottom:1px solid var(--mat-border); }
.th-tile .nm { padding:0.45rem 0.6rem; font-size:0.85rem; font-weight:600; text-align:left; color:var(--mat-text); }
.th-tile.selected { border-color:var(--mat-accent); box-shadow:0 0 0 3px rgba(139,92,246,0.22); }
.th-swatch.th-auto { background:linear-gradient(90deg,#f4f5fa 0 50%,#0b0f1a 50% 100%); }
.th-swatch.th-light { background:#f4f5fa; }
.th-swatch.th-dark { background:#0b0f1a; }
/* Personal-setting badge (little user icon) — same design in both sidebar sections and panel headings. */
.mset-you { display:inline-flex; align-items:center; justify-content:center; width:18px; height:18px; margin-left:0.35rem; font-size:0.72rem; background:rgba(139,92,246,0.2); color:#c7b3ff; border-radius:50%; vertical-align:middle; }
.mset-side-head { font-size:0.68rem; font-weight:700; color:var(--mat-text-muted); text-transform:uppercase; letter-spacing:0.06em; padding:0.7rem 0.75rem 0.3rem; }
.mset-side-head:first-of-type { padding-top:0.4rem; }
/* Taskbar-panel controls */
.tb-seg { display:inline-flex; background:rgba(255,255,255,0.06); border-radius:8px; padding:2px; }
.tb-seg button { border:none; background:transparent; padding:0.35rem 0.7rem; font:inherit; font-size:0.85rem; border-radius:6px; cursor:pointer; color:var(--mat-text-muted); }
.tb-seg button.active { background:var(--mat-surface); color:var(--mat-text); box-shadow:0 1px 2px rgba(0,0,0,.08); }
.tb-switch { position:relative; display:inline-block; width:38px; height:22px; }
.tb-switch input { opacity:0; width:0; height:0; }
.tb-switch span { position:absolute; inset:0; background:rgba(255,255,255,0.1); border-radius:999px; cursor:pointer; transition:background 0.15s; }
.tb-switch span::before { content:""; position:absolute; width:16px; height:16px; left:3px; top:3px; background:#fff; border-radius:50%; transition:transform 0.15s; }
.tb-switch input:checked + span { background:var(--mat-accent); }
.tb-switch input:checked + span::before { transform:translateX(16px); }
/* Bigger, clearer wallpaper thumbnails with a checkmark on the selected tile */
.wp-picker { grid-template-columns:repeat(auto-fill,minmax(190px,1fr)); }
.wp-tile .swatch { height:104px; position:relative; transition:transform 0.12s ease; }
.wp-tile:hover .swatch { transform:scale(1.02); }
.wp-check { position:absolute; top:0.4rem; right:0.4rem; width:22px; height:22px; border-radius:50%; background:var(--mat-accent); color:#fff; display:none; align-items:center; justify-content:center; font-size:0.75rem; font-weight:800; box-shadow:0 2px 8px rgba(0,0,0,.4); }
.wp-tile.selected .wp-check { display:flex; }
/* Accent colour picker */
.ac-picker { display:flex; align-items:center; gap:0.6rem; flex-wrap:wrap; }
.ac-swatch { width:34px; height:34px; border-radius:50%; border:2px solid transparent; cursor:pointer; box-shadow:0 2px 6px rgba(0,0,0,.3); position:relative; }
.ac-swatch:hover { transform:scale(1.08); }
.ac-swatch.selected { border-color:#fff; box-shadow:0 0 0 3px var(--mat-accent); }
.ac-custom { display:flex; align-items:center; gap:0.4rem; cursor:pointer; font-size:0.82rem; color:var(--mat-text-muted); padding:0.3rem 0.5rem; border-radius:8px; }
.ac-custom:hover { background:rgba(255,255,255,0.06); }
.ac-custom input[type=color] { width:34px; height:34px; border:none; border-radius:50%; padding:0; cursor:pointer; background:transparent; }
.ac-custom input[type=color]::-webkit-color-swatch-wrapper { padding:0; border-radius:50%; overflow:hidden; }
.ac-custom input[type=color]::-webkit-color-swatch { border:2px solid transparent; border-radius:50%; }
</style>
}

@section Scripts {
<script>
(function(){
  document.querySelectorAll(".mset-nav").forEach(n=>n.addEventListener("click",()=>{
    document.querySelectorAll(".mset-nav").forEach(x=>x.classList.toggle("active",x===n));
    document.querySelectorAll(".mset-panel").forEach(p=>p.classList.toggle("active",p.dataset.panel===n.dataset.p));
  }));
  // docker inventory counts
  (async function(){ try{
    const [c,i,v]=await Promise.all([fetch("/api/v1/docker/containers").then(r=>r.json()),fetch("/api/v1/docker/images").then(r=>r.json()),fetch("/api/v1/docker/volumes").then(r=>r.json())]);
    const run=(c.containers||[]).filter(x=>x.running).length;
    document.getElementById("mset-inv").textContent=`${run}/${(c.containers||[]).length} containers running · ${(i.images||[]).length} images · ${(v.volumes||[]).length} volumes`;
  }catch(_){ document.getElementById("mset-inv").textContent="Docker not reachable."; } })();

  // ---- Personal Appearance + Taskbar prefs: server already rendered the correct initial state
  // (no flash-of-default). Every control below both live-previews on the desktop AND persists
  // the FULL current state in one shot, so toggling one control never blanks another.
  const wpPicker = document.querySelector(".wp-picker");
  const thPicker = document.querySelector(".th-picker");
  const wpStyleSeg = document.getElementById("wp-style");
  const acPicker = document.getElementById("ac-picker");
  const acCustom = document.getElementById("ac-custom-input");
  const posSeg = document.getElementById("tb-pos"), alignSeg = document.getElementById("tb-align"), searchCb = document.getElementById("tb-search"), labelsCb = document.getElementById("tb-labels");

  function segValue(seg){ const b=seg && seg.querySelector("button.active"); return b?b.dataset.v:(seg?seg.querySelector("button").dataset.v:""); }
  function segSelect(seg, v){ if(seg) seg.querySelectorAll("button").forEach(b=>b.classList.toggle("active", b.dataset.v===v)); }
  function currentWallpaper(){ const t=wpPicker && wpPicker.querySelector(".wp-tile.selected"); return t?t.dataset.key:"aurora"; }
  function currentTheme(){ const t=thPicker && thPicker.querySelector(".th-tile.selected"); return t?t.dataset.key:"auto"; }
  function currentAccent(){ const s=acPicker && acPicker.querySelector(".ac-swatch.selected"); return s?s.dataset.v:(acPicker && acPicker.dataset.customActive==="1" ? acCustom.value : ""); }

  function gatherPrefs(){
    return {
      wallpaper: currentWallpaper(),
      theme: currentTheme(),
      wallpaperStyle: wpStyleSeg ? segValue(wpStyleSeg) : "fill",
      accentColor: currentAccent(),
      taskbarPosition: posSeg ? segValue(posSeg) : "bottom",
      taskbarAlign: alignSeg ? segValue(alignSeg) : "left",
      taskbarSearch: searchCb ? searchCb.checked : true,
      taskbarLabels: labelsCb ? labelsCb.checked : true,
    };
  }
  function previewAll(body){
    try{
      window.parent.postMessage({type:"matos:wallpaper", wallpaper:body.wallpaper, style:body.wallpaperStyle}, location.origin);
      window.parent.postMessage({type:"matos:theme", theme:body.theme}, location.origin);
      window.parent.postMessage({type:"matos:accent", accent:body.accentColor}, location.origin);
      window.parent.postMessage({type:"matos:taskbar", prefs:body}, location.origin);
    }catch(_){}
  }
  function saveAll(){
    const body = gatherPrefs();
    previewAll(body);
    fetch("/api/v1/desktop/prefs",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)}).catch(()=>{});
  }

  if(wpPicker) wpPicker.addEventListener("click", e=>{ const t=e.target.closest(".wp-tile"); if(!t) return;
    wpPicker.querySelectorAll(".wp-tile").forEach(x=>x.classList.toggle("selected", x===t)); saveAll(); });
  if(wpStyleSeg) wpStyleSeg.addEventListener("click", e=>{ const b=e.target.closest("button"); if(!b) return; segSelect(wpStyleSeg,b.dataset.v); saveAll(); });
  if(thPicker) thPicker.addEventListener("click", e=>{ const t=e.target.closest(".th-tile"); if(!t) return;
    thPicker.querySelectorAll(".th-tile").forEach(x=>x.classList.toggle("selected", x===t));
    const inp=t.querySelector("input"); if(inp) inp.checked=true; saveAll(); });
  if(acPicker){
    acPicker.addEventListener("click", e=>{ const b=e.target.closest(".ac-swatch"); if(!b) return;
      acPicker.querySelectorAll(".ac-swatch").forEach(x=>x.classList.toggle("selected", x===b));
      acPicker.dataset.customActive="0"; saveAll(); });
    if(acCustom) acCustom.addEventListener("input", ()=>{
      acPicker.querySelectorAll(".ac-swatch").forEach(x=>x.classList.remove("selected"));
      acPicker.dataset.customActive="1"; saveAll(); });
    const resetBtn=document.getElementById("ac-reset");
    if(resetBtn) resetBtn.addEventListener("click", ()=>{
      acPicker.querySelectorAll(".ac-swatch").forEach(x=>x.classList.remove("selected"));
      acPicker.dataset.customActive="0"; if(acCustom) acCustom.value="#8b5cf6"; saveAll(); });
  }
  [posSeg, alignSeg].forEach(seg => seg && seg.addEventListener("click", e => { const b=e.target.closest("button"); if(!b) return; segSelect(seg, b.dataset.v); saveAll(); }));
  if(searchCb) searchCb.addEventListener("change", saveAll);
  if(labelsCb) labelsCb.addEventListener("change", saveAll);

  // ---- Deep-link into a specific panel (?panel=taskbar or postMessage matos:goto-panel) ----
  function gotoPanel(name){ const nav=document.querySelector(`.mset-nav[data-p="${name}"]`); if(nav) nav.click(); }
  try{ const p=new URLSearchParams(location.search).get("panel"); if(p) gotoPanel(p); }catch(_){}
  window.addEventListener("message", e => { if(e.origin!==location.origin) return; const m=e.data; if(m && m.type==="matos:goto-panel" && m.panel) gotoPanel(m.panel); });
})();
</script>
}

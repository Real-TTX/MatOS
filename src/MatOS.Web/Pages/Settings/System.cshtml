@page
@model MatOS.Web.Pages.Settings.SystemModel
@{
    ViewData["Title"] = "System";
    ViewData["PageSub"] = "How this machine is doing, and which MatOS runs on it.";
    ViewData["Crumbs"] = Crumbs.Of(("Settings", "/Settings"), ("System", null));
    ViewData["Width"] = "narrow";

    // A load as a meter and its number; the tone turns at 75 and 90 percent.
    string Tone(double percent) => percent >= 90 ? "error" : percent >= 75 ? "warn" : "ok";
}

<partial name="_SettingsTabs" model="@("system")" />

@* A list of facts, as the settings of a phone: what a person wants to know first, the rest behind "Technical details". *@
<section class="mat-stack mat-stack--sm" aria-labelledby="sys-machine">
    <h2 class="mat-itemlist__header" id="sys-machine">This machine</h2>
    @if (Model.Engine.Available)
    {
        <ul class="mat-itemlist mat-itemlist--inset mv-facts" aria-labelledby="sys-machine">
            <li class="mat-item mat-item--wrap"><div class="mat-item__main"><span class="mat-item__body"><span class="mat-item__title">Status</span><span class="mat-item__text">Checked just now</span></span><span class="mat-item__end"><span class="mat-pill mat-pill--ok">Connected</span></span></div></li>
            @if (Model.Engine.Load is { } load)
            {
                <li class="mat-item"><div class="mat-item__main"><span class="mat-item__body"><span class="mat-item__title">Processor</span></span><span class="mat-item__end"><span class="mv-load"><progress class="mv-progress" max="100" value="@((int)load.CpuPercent)" data-tone="@Tone(load.CpuPercent)" aria-label="Processor"></progress><span>@(load.CpuPercent.ToString("0")) %</span></span></span></div></li>
                <li class="mat-item"><div class="mat-item__main"><span class="mat-item__body"><span class="mat-item__title">Memory</span></span><span class="mat-item__end"><span class="mv-load"><progress class="mv-progress" max="100" value="@((int)load.MemoryPercent)" data-tone="@Tone(load.MemoryPercent)" aria-label="Memory"></progress><span>@(load.MemoryPercent.ToString("0")) %</span></span></span></div></li>
                <li class="mat-item"><div class="mat-item__main"><span class="mat-item__body"><span class="mat-item__title">Disk</span></span><span class="mat-item__end"><span class="mv-load"><progress class="mv-progress" max="100" value="@((int)load.DiskPercent)" data-tone="@Tone(load.DiskPercent)" aria-label="Disk"></progress><span>@(load.DiskPercent.ToString("0")) %</span></span></span></div></li>
                <li class="mat-item"><div class="mat-item__main"><span class="mat-item__body"><span class="mat-item__title">Running</span></span><span class="mat-item__end"><a href="/Tasks">@Model.Engine.ContainersRunning programs</a></span></div></li>
            }
            else
            {
                <li class="mat-item"><div class="mat-item__main"><span class="mat-item__body"><span class="mat-item__title">Resources</span></span><span class="mat-item__end"><span>@Model.Engine.Cpus processors, @Format.Size(Model.Engine.MemoryBytes) memory</span></span></div></li>
                <li class="mat-item"><div class="mat-item__main"><span class="mat-item__body"><span class="mat-item__title">Running</span></span><span class="mat-item__end"><span>@Model.Engine.ContainersRunning of @Model.Engine.ContainersTotal programs</span></span></div></li>
            }
        </ul>
    }
    else
    {
        <div class="mat-alert mat-alert--danger" role="alert">
            <icon name="x-circle" />
            <div class="mat-alert__body">
                <strong>MatOS cannot reach Docker, which runs the apps, right now.</strong>
                <p class="mat-small">@Model.Engine.Error</p>
            </div>
        </div>
    }
</section>

<section class="mat-stack mat-stack--sm" aria-labelledby="sys-matos">
    <h2 class="mat-itemlist__header" id="sys-matos">MatOS</h2>
    <ul class="mat-itemlist mat-itemlist--inset mv-facts" aria-labelledby="sys-matos">
        <li class="mat-item"><div class="mat-item__main"><span class="mat-item__body"><span class="mat-item__title">Version</span></span><span class="mat-item__end"><span>@Model.Version</span></span></div></li>
        <li class="mat-item"><div class="mat-item__main"><span class="mat-item__body"><span class="mat-item__title">Store</span></span><span class="mat-item__end"><a href="/Store">@Model.CatalogTotal apps@(Model.CatalogCustom > 0 ? $" ({Model.CatalogCustom} of your own)" : "")</a></span></div></li>
        <li class="mat-item mat-item--wrap"><div class="mat-item__main"><span class="mat-item__body"><span class="mat-item__title">Addresses of the apps</span><span class="mat-item__text">@(Model.ProxyActive ? "Matcad gives every app its own address under your domain." : "Every app has a port of this machine. A domain (General) or a free address (Address) gives each its own name.")</span></span></div></li>
    </ul>
</section>

<details class="mat-collapse mv-details">
    <summary><span>Technical details</span><span class="mat-accordion__chev" aria-hidden="true"><icon name="chevron-down" /></span></summary>
    <div class="mat-accordion__body">
        <ul class="mat-itemlist mat-itemlist--inset mv-facts" aria-label="Technical details">
            @if (Model.Engine.Available)
            {
                <li class="mat-item"><div class="mat-item__main"><span class="mat-item__body"><span class="mat-item__title">Docker</span></span><span class="mat-item__end"><span>@Model.Engine.Version@(Model.Engine.Load is null && !string.IsNullOrEmpty(Model.Engine.OperatingSystem) ? $" on {Model.Engine.OperatingSystem}" : "")</span></span></div></li>
            }
            <li class="mat-item mat-item--wrap"><div class="mat-item__main"><span class="mat-item__body"><span class="mat-item__title">Shared network</span><span class="mat-item__text">Connects the reverse proxy and the web pages of the apps</span></span><span class="mat-item__end"><code>@Model.Network</code></span></div></li>
            <li class="mat-item"><div class="mat-item__main"><span class="mat-item__body"><span class="mat-item__title">This container</span></span><span class="mat-item__end"><span>@(Model.SelfContainer ?? "Not running in Docker")</span></span></div></li>
            <li class="mat-item mat-item--wrap"><div class="mat-item__main"><span class="mat-item__body"><span class="mat-item__title">Data folder</span><span class="mat-item__text">The database, the settings, the files of the apps and the backups</span></span><span class="mat-item__end"><code>@Model.DataPath</code></span></div></li>
        </ul>
    </div>
</details>

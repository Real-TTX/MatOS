@page
@using MatOS.Core.Configuration
@model MatOS.Web.Pages.Settings.EnginesModel
@{
    ViewData["Title"] = "Engines";
    ViewData["PageSub"] = "The programs MatOS is built on. Each keeps its own part of your setup.";
    ViewData["Crumbs"] = Crumbs.Of(("Settings", "/Settings"), ("Engines", null));
    ViewData["Width"] = "narrow";
    var dns = DnsProviders.Find(Model.Config.Dns.Provider);
}

<partial name="_SettingsTabs" model="@("engines")" />

@* One grouped list, as the settings of a phone: an engine per row with its state; a row opens the engine (its page in the window: open it, its details, what it does for the apps). *@
@* No heading over it: the window and the tab already say Engines. *@
<section class="mat-stack mat-stack--sm" aria-label="Engines">
    <ul class="mat-itemlist mat-itemlist--inset mat-itemlist--lines-inset mv-facts" aria-label="Engines">
        @foreach (var row in Model.Rows)
        {
            <li class="mat-item">
                <a class="mat-item__main" href="@(row.App is null ? $"/Store/Install?id={row.Catalog.Id}" : row.Window)">
                    <span class="mat-item__lead"><app-icon name="@row.Catalog.Name" icon="@row.Catalog.Icon" /></span>
                    <span class="mat-item__body">
                        <span class="mat-item__title">@row.Catalog.Name</span>
                        <span class="mat-item__text mat-item__text--clamp">@row.Owns</span>
                    </span>
                    <span class="mat-item__end">
                        @if (row.App is null)
                        {
                            <span class="mat-pill">Not installed</span>
                        }
                        else if (row.App.Lifecycle != MatOS.Core.Entities.AppLifecycle.Installed)
                        {
                            <span class="mat-pill mat-pill--busy">@row.App.Lifecycle</span>
                        }
                        else if (row.Status is { ApiVersion: >= 1 })
                        {
                            <span class="mat-pill mat-pill--ok mv-pill-dot"><span>Connected</span></span>
                        }
                        else
                        {
                            <span class="mat-pill mat-pill--warn">Not answering</span>
                        }
                        <icon name="chevron-right" />
                    </span>
                </a>
            </li>
        }
    </ul>
</section>

<section class="mat-stack mat-stack--sm" aria-labelledby="engines-handover">
    <h2 class="mat-itemlist__header" id="engines-handover">What MatOS hands over</h2>
    <ul class="mat-itemlist mat-itemlist--inset mv-facts" aria-labelledby="engines-handover">
        <li class="mat-item mat-item--wrap"><div class="mat-item__main"><span class="mat-item__body"><span class="mat-item__title">Apps are run by</span></span><span class="mat-item__end"><span>@(Model.DeployedByMatDock ? "MatDock" : "MatOS itself, until MatDock answers")</span></span></div></li>
        <li class="mat-item"><div class="mat-item__main"><span class="mat-item__body"><span class="mat-item__title">Domain</span></span><span class="mat-item__end"><span>@(string.IsNullOrEmpty(Model.Config.BaseDomain) ? "None: apps use their ports" : "*." + Model.Config.BaseDomain)</span></span></div></li>
        <li class="mat-item mat-item--wrap"><div class="mat-item__main"><span class="mat-item__body"><span class="mat-item__title">DNS provider</span>@if (dns is null) {<span class="mat-item__text">Certificates come without one; you look after DNS yourself.</span>}</span><span class="mat-item__end"><span>@(dns is null ? "None" : dns.Name)</span></span></div></li>
        @if (Model.Config.WizardCompleted)
        {
            <li class="mat-item"><div class="mat-item__main"><span class="mat-item__body"><span class="mat-item__title">Setup wizard</span></span><span class="mat-item__end"><span>@(Model.Config.WizardCompletedAt is { } at ? "Last run " + Format.DateTimeLocal(at) : "Done")</span></span></div></li>
        }
    </ul>
</section>

<div class="mat-actions">
    <form method="post" asp-page-handler="Reconnect">
        <button type="submit" class="mat-btn mat-btn--primary"><icon name="refresh" /><span>Connect again</span></button>
    </form>
    <form method="post" asp-page-handler="Adopt">
        <button type="submit" class="mat-btn mat-btn--secondary"><icon name="restore" /><span>Look for apps in MatDock</span></button>
    </form>
    <a href="/Wizard" class="mat-btn mat-btn--ghost"><icon name="sparkles" /><span>Run the setup wizard</span></a>
</div>

<details class="mat-collapse mv-details">
    <summary><span>Technical details</span><span class="mat-accordion__chev" aria-hidden="true"><icon name="chevron-down" /></span></summary>
    <div class="mat-accordion__body">
        <p class="mat-muted">Each engine shows what MatOS keeps in it with the mark <em>Managed by matos</em>: the stacks in MatDock, the routes in Matcad, the DNS records in Matddns, the apps in MatIdentity and their mail users in MatSMTP.</p>
        <ul class="mat-itemlist mat-itemlist--inset mv-facts" aria-label="Versions and addresses">
            @foreach (var row in Model.Rows.Where(r => r.Status is not null))
            {
                <li class="mat-item"><div class="mat-item__main"><span class="mat-item__body"><span class="mat-item__title">@row.Catalog.Name</span></span><span class="mat-item__end"><span>Version <code>@row.Status!.Version</code> · API v@(row.Status!.ApiVersion)</span></span></div></li>
            }
            <li class="mat-item mat-item--wrap"><div class="mat-item__main"><span class="mat-item__body"><span class="mat-item__title">May show the engines in its window</span><span class="mat-item__text">An engine learns these addresses with its next update.</span></span><span class="mat-item__end">@foreach (var origin in Model.FrameOrigins) { <code>@origin</code> }</span></div></li>
        </ul>
    </div>
</details>

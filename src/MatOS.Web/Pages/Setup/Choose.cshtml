@page
@using MatOS.Core.Configuration
@using MatOS.Core.Setup
@model MatOS.Web.Pages.Setup.ChooseModel
@{
    Layout = "_Onboarding";
    ViewData["Title"] = "How you reach your apps";
    var providers = string.Join(",", DnsProviders.All.Select(p => p.Id));
}

@* The first start, step 4: the way to the apps in three cards of one form (js/onboarding.js shows one at a time, all on the dot of this step, data-ob-dot):
   the tree, the certificates that follow from it, and the test with "Set up the rest". Meanwhile MatDock and MatSMTP install (phase 1): one line says how
   far they are (data-ob-phase1). *@
<form method="post" class="mat-form ob-flow" novalidate data-ob-flow data-ob-offset="3">
    <partial name="_Steps" model="3" />

    <p class="ob-small ob-phase1" role="status" data-ob-phase1="@MatOS.Web.Infrastructure.OnboardingEndpoints.ProgressPath" hidden></p>

    @* ------------------------------------------------------------ (a) the tree: how the apps are reached *@
    <section class="ob-card ob-step" data-ob-step data-ob-dot="3" aria-labelledby="ob-reach">
        <div class="ob-head">
            <span class="ob-head__icon" aria-hidden="true">@Ui.Icon("globe")</span>
            <h1 class="ob-title ob-title--step" id="ob-reach">How do you reach your apps?</h1>
            <p class="ob-lead">You can change this later in the settings.</p>
        </div>

        <partial name="_ValidationSummary" />

        <fieldset class="ob-reach">
            <legend class="mat-sr-only">How do you reach your apps?</legend>
            <label class="ob-choice">
                <input class="ob-choice__radio" type="radio" name="Reach" value="@Reach.Free" checked="@(Model.Reach == Reach.Free)" />
                <span class="ob-choice__icon" aria-hidden="true">@Ui.Icon("globe")</span>
                <span class="ob-choice__text">
                    <strong>A free address <span class="mat-pill mat-pill--accent">Recommended</span></strong>
                    <small>Your own name below my.mattiverse.de. Works from anywhere, HTTPS included, no router settings.</small>
                </span>
            </label>
            <label class="ob-choice">
                <input class="ob-choice__radio" type="radio" name="Reach" value="@Reach.Domain" checked="@(Model.Reach == Reach.Domain)" />
                <span class="ob-choice__icon" aria-hidden="true">@Ui.Icon("link")</span>
                <span class="ob-choice__text">
                    <strong>My own domain</strong>
                    <small>Every app gets an address below your domain, with HTTPS.</small>
                </span>
            </label>
            <label class="ob-choice">
                <input class="ob-choice__radio" type="radio" name="Reach" value="@Reach.Home" checked="@(Model.Reach == Reach.Home)" />
                <span class="ob-choice__icon" aria-hidden="true">@Ui.Icon("home")</span>
                <span class="ob-choice__text">
                    <strong>Only here at home</strong>
                    <small>No address on the internet. You open your apps from devices in your home network.</small>
                </span>
            </label>
        </fieldset>

        <div class="ob-panel" data-show-if="Reach" data-show-value="@Reach.Free" hidden="@(Model.Reach != Reach.Free)">
            @if (Model.OwnAddress is { } own)
            {
                @* This MatOS uses its free address already (Settings, Address): it is its own and stays. *@
                <mat-field label="Your address" asp-for="Name" hint="@($"{own} is yours already. Give it back in Settings, Address to choose another name.")">
                    <div class="mat-input-group">
                        <input asp-for="Name" class="mat-input mat-input--lg" readonly aria-describedby="ob-name-zone" />
                        <span class="mat-input-addon" id="ob-name-zone">.@Model.Zone</span>
                    </div>
                </mat-field>
            }
            else
            {
                @* The test (the third card) reserves the name; another name later gives that one back. *@
                <mat-field label="Your address" asp-for="Name" required="true" hint="Choose a name: 3 to 32 letters, digits and dashes. The test reserves it for you.">
                    <div class="mat-input-group">
                        <input asp-for="Name" class="mat-input mat-input--lg" required minlength="3" maxlength="32" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="anna"
                               data-msg-required="Please choose a name for your address." data-msg-range="Use 3 to 32 letters, digits and dashes." />
                        <span class="mat-input-addon">.@Model.Zone</span>
                    </div>
                </mat-field>
            }
        </div>

        <div class="ob-panel" data-show-if="Reach" data-show-value="@Reach.Domain" hidden="@(Model.Reach != Reach.Domain)">
            <div class="mat-stack">
                <mat-field label="Your domain" asp-for="BaseDomain" required="true" hint="Your apps get addresses like files.example.com.">
                    <input asp-for="BaseDomain" class="mat-input mat-input--lg" required placeholder="example.com" inputmode="url" autocomplete="off" autocapitalize="none" spellcheck="false"
                           data-msg-required="Please enter your domain, like example.com." />
                </mat-field>
                <partial name="_DnsProviderChoice" model="Model.Dns" />

                @* What to create at the DNS provider when nothing writes the records (SetupPlan.RecordsFor): records by hand, or a provider with a fixed IP (no
                   Matddns then). js/onboarding.js shows the card for either answer, writes the domain and the addresses (the fixed IP, else what MatOS Services
                   saw at /api/setup/ip) and shows the rows that apply: A (and AAAA with an IPv6), or CNAME when a host name is given (by hand only). *@
                <div class="ob-records mat-stack" data-ob-records="@MatOS.Web.Infrastructure.SetupEndpoints.IpPath" data-ob-records-manual="@SetupPlan.ManualDns"
                     data-ob-records-providers="@providers" data-ob-records-fixed="@DnsIp.Fixed"
                     hidden="@(Model.Dns.Chosen != SetupPlan.ManualDns && !(DnsProviders.Find(Model.Dns.Chosen) is not null && Model.Dns.Dns.IpAnswer == DnsIp.Fixed))">
                    <p class="ob-small">Create these entries at your DNS provider. MatOS cannot write them for you.</p>
                    <div class="mat-table-wrap">
                        <table class="mat-table">
                            <caption class="mat-sr-only">The records of your domain</caption>
                            <thead>
                                <tr><th scope="col">Name</th><th scope="col">Type</th><th scope="col">Points to</th><th scope="col">What to do</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var record in Model.Records)
                                {
                                    var self = record.Name.StartsWith("*.", StringComparison.Ordinal) ? "*" : MatOS.Core.Integrations.ProxyPublisher.SelfSlug;
                                    <tr data-ob-record="@record.Type.ToLowerInvariant()" hidden="@(record.Type != "A")">
                                        <td data-label="Name"><code data-ob-record-name="@self">@record.Name</code></td>
                                        <td data-label="Type">@record.Type</td>
                                        <td data-label="Points to"><code data-ob-record-value="@record.Type.ToLowerInvariant()">@record.Value</code></td>
                                        <td data-label="What to do">@record.Sentence</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="mat-stack" data-show-if="DnsProvider" data-show-value="@SetupPlan.ManualDns" hidden="@(Model.Dns.Chosen != SetupPlan.ManualDns)">
                        <mat-field label="A host name instead of an IP address (optional)" asp-for="DnsCname" hint="Your router's own DynDNS name, like home.example.net: the entries then point to it (CNAME).">
                            <input asp-for="DnsCname" class="mat-input" placeholder="home.example.net" inputmode="url" autocomplete="off" autocapitalize="none" spellcheck="false" />
                        </mat-field>
                        <p class="ob-note">@Ui.Icon("info")<span>Records by hand point to one address: your router must let 80 and 443 in. Behind a shared connection (CGNAT, DS-Lite) this cannot work: choose your DNS provider instead and "I'm not sure", and MatOS takes the tunnel of MatOS Services.</span></p>
                    </div>
                </div>
            </div>
        </div>

        <div class="ob-panel" data-show-if="Reach" data-show-value="@Reach.Home" hidden="@(Model.Reach != Reach.Home)">
            @if (Model.LocalBrowser)
            {
                @* Opened as localhost: no address for the phone. The address of this computer is asked here, not hidden under Advanced. *@
                <div class="mat-stack">
                    <p class="ob-note">@Ui.Icon("info")<span>You opened MatOS as <code>@Request.Host.Host</code>, a name only this computer knows. Your phone and your other devices need the address of this computer in your home network.</span></p>
                    <mat-field label="The address of this computer" asp-for="PublicHost" hint="How your phone and other devices reach this computer, like 192.168.1.20 or nas.local. Your router's list of devices shows it.">
                        <input asp-for="PublicHost" class="mat-input mat-input--lg" placeholder="192.168.1.20" inputmode="url" autocomplete="off" autocapitalize="none" spellcheck="false" />
                    </mat-field>
                </div>
            }
            else
            {
                <p class="ob-note">@Ui.Icon("info")<span>Every app gets a port of this computer, like <code>@(Model.PublicHost ?? "192.168.1.20"):8100</code>. You can add an address later in the settings.</span></p>
            }
        </div>

        <details class="mat-collapse ob-advanced">
            <summary><span>Advanced</span><span class="mat-accordion__chev" aria-hidden="true">@Ui.Icon("chevron-down")</span></summary>
            <div class="mat-accordion__body mat-stack">
                @if (!Model.LocalBrowser)
                {
                    <mat-field label="The address of this computer" asp-for="PublicHost" hint="How your devices at home reach it, like nas.local or 192.168.1.20.">
                        <input asp-for="PublicHost" class="mat-input" placeholder="nas.local" inputmode="url" autocomplete="off" autocapitalize="none" spellcheck="false" />
                    </mat-field>
                }
                @* An own domain whose records Matddns keeps (a provider, a changing IP): MatOS picks the route itself (through your router when the ports answer,
                   else through MatOS Services). Records by hand and a fixed IP are reached only through the router (SetupPlan.Normalize). *@
                <div data-show-if="Reach" data-show-value="@Reach.Domain" hidden="@(Model.Reach != Reach.Domain)">
                    <div data-show-if="DnsProvider" data-show-value="@providers" hidden="@(DnsProviders.Find(Model.Dns.Chosen) is null)">
                        <fieldset class="mat-field mat-fieldset" data-show-if="DnsIp" data-show-value="@DnsIp.Dynamic,@DnsIp.Unsure" hidden="@(Model.Dns.Dns.IpAnswer == DnsIp.Fixed)">
                            <legend class="mat-legend">Reaching your domain from outside</legend>
                            <div class="mat-choices">
                                <label class="mat-choice">
                                    <input type="radio" name="RoutePolicy" value="@MatOS.Core.Integrations.DomainRoute.Auto" checked="@(Model.RoutePolicy != MatOS.Core.Integrations.DomainRoute.Direct)" />
                                    <span class="mat-choice__text">
                                        <strong>MatOS takes care of it</strong>
                                        <small>Through your router when it lets the connections in, else through MatOS Services. Works without router settings.</small>
                                    </span>
                                </label>
                                <label class="mat-choice">
                                    <input type="radio" name="RoutePolicy" value="@MatOS.Core.Integrations.DomainRoute.Direct" checked="@(Model.RoutePolicy == MatOS.Core.Integrations.DomainRoute.Direct)" />
                                    <span class="mat-choice__text">
                                        <strong>Only through my router</strong>
                                        <small>You forward the ports 80 and 443 to this computer yourself.</small>
                                    </span>
                                </label>
                            </div>
                        </fieldset>
                    </div>
                </div>
            </div>
        </details>

        <div class="mat-btn-row mat-btn-row--plain ob-actions">
            <button type="button" class="mat-btn mat-btn--primary mat-btn--lg" data-ob-next><span>Next</span><icon name="arrow-right" /></button>
        </div>
    </section>

    @* ------------------------------------------------------------ (b) the certificates that follow from the way *@
    <section class="ob-card ob-step" data-ob-step data-ob-dot="3" aria-labelledby="ob-certs">
        <div class="ob-head">
            <span class="ob-head__icon" aria-hidden="true">@Ui.Icon("lock")</span>
            <h2 class="ob-title ob-title--step" id="ob-certs">Certificates</h2>
            <p class="ob-lead">They make the padlock in the browser: your apps are reached with HTTPS.</p>
        </div>

        <div class="ob-panel" data-show-if="Reach" data-show-value="@Reach.Domain" hidden="@(Model.Reach != Reach.Domain)">
            <div data-show-if="DnsProvider" data-show-value="@providers" hidden="@(DnsProviders.Find(Model.Dns.Chosen) is null)">
                <fieldset class="mat-field mat-fieldset">
                    <legend class="mat-legend">How many certificates?</legend>
                    <div class="mat-choices">
                        <label class="mat-choice">
                            <input type="radio" name="Certificates" value="@CertificateMode.Wildcard" checked="@(Model.Certificates != CertificateMode.PerApp)" />
                            <span class="mat-choice__text">
                                <strong>One certificate for all your apps <span class="mat-pill mat-pill--accent">Recommended</span></strong>
                                <small>A new app works at once. Technically a wildcard certificate for *.your-domain, through the account of your DNS provider.</small>
                            </span>
                        </label>
                        <label class="mat-choice">
                            <input type="radio" name="Certificates" value="@CertificateMode.PerApp" checked="@(Model.Certificates == CertificateMode.PerApp)" />
                            <span class="mat-choice__text">
                                <strong>A certificate for each app</strong>
                                <small>Every address is listed in public certificate logs. Technically one Let's Encrypt certificate per host name.</small>
                            </span>
                        </label>
                    </div>
                </fieldset>
            </div>
            <div data-show-if="DnsProvider" data-show-value="@SetupPlan.ManualDns" hidden="@(Model.Dns.Chosen != SetupPlan.ManualDns)">
                <p class="ob-note">@Ui.Icon("info")<span>Without the account of your DNS provider every app gets a certificate of its own, a moment after it is installed. Your router must let port 80 or 443 in for that.</span></p>
            </div>
        </div>

        <div class="ob-panel" data-show-if="Reach" data-show-value="@Reach.Free" hidden="@(Model.Reach != Reach.Free)">
            <div class="mat-stack">
                <p class="ob-note">@Ui.Icon("info")<span>Every app gets a certificate of its own, a moment after it is installed. Nothing to set up.</span></p>
                <p class="ob-small">Let's Encrypt, who issues them, allows 50 certificates per registered domain and week, and 5 failed attempts per address and hour. The free addresses share my.mattiverse.de, so a new app may have to wait a little.</p>
            </div>
        </div>

        <div class="ob-panel" data-show-if="Reach" data-show-value="@Reach.Home" hidden="@(Model.Reach != Reach.Home)">
            <p class="ob-note">@Ui.Icon("info")<span>At home your apps use plain http: no certificates needed.</span></p>
        </div>

        <div class="mat-btn-row mat-btn-row--plain ob-actions">
            <button type="button" class="mat-btn mat-btn--primary mat-btn--lg" data-ob-next><span>Next</span><icon name="arrow-right" /></button>
            <button type="button" class="mat-btn mat-btn--ghost" data-ob-prev><icon name="chevron-left" /><span>Back</span></button>
        </div>
    </section>

    @* ------------------------------------------------------------ (c) the test and "Set up the rest" *@
    <section class="ob-card ob-step" data-ob-step data-ob-dot="3" aria-labelledby="ob-test">
        <div class="ob-head">
            <span class="ob-head__icon" aria-hidden="true">@Ui.Icon("check-circle")</span>
            <h2 class="ob-title ob-title--step" id="ob-test">A quick test</h2>
            @* What "Set up the rest" will do, in one sentence (SetupPlan.Summary; the test writes it again from the answers as they are). *@
            <p class="ob-lead ob-summary" data-ob-test-summary>@Model.Summary</p>
        </div>

        @* Filled by js/onboarding.js from POST /api/setup/test; a row that does not belong to the chosen way is hidden. *@
        <ol class="ob-tasks" data-ob-test="@MatOS.Web.Infrastructure.SetupEndpoints.TestPath">
            @foreach (var key in SetupTest.All)
            {
                <li class="ob-task" data-ob-test-row="@key" data-state="waiting">
                    <span class="ob-task__mark" aria-hidden="true">
                        <span class="ob-task__dot"></span>
                        <span class="ob-task__spin"></span>
                        <span class="ob-task__ok">@Ui.Icon("check")</span>
                        <span class="ob-task__warn">@Ui.Icon("alert")</span>
                        <span class="ob-task__bad">@Ui.Icon("x")</span>
                    </span>
                    <span class="ob-task__text">
                        <span class="ob-task__label" data-ob-test-label>@SetupTest.Label(key)</span>
                        <span class="ob-task__state" data-ob-test-text>@(SetupTest.IsAdvisory(key) ? "Checked when the test runs. It only advises." : "Checked when the test runs.")</span>
                    </span>
                </li>
            }
        </ol>

        <p class="ob-small" role="status" aria-live="polite" data-ob-test-say>"Set up the rest" tests your answers again before it starts.</p>

        <div class="mat-btn-row mat-btn-row--plain ob-actions">
            <button type="submit" class="mat-btn mat-btn--primary mat-btn--lg ob-go" data-ob-go><icon name="rocket" /><span>Set up the rest</span></button>
            <button type="button" class="mat-btn mat-btn--secondary" data-ob-test-run><icon name="refresh" /><span>Run the test again</span></button>
            <button type="button" class="mat-btn mat-btn--ghost" data-ob-prev><icon name="chevron-left" /><span>Back</span></button>
        </div>
    </section>
</form>

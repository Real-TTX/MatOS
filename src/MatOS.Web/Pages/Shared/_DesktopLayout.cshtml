@using MatOS.Web.Config
@using MatOS.Web.Services
@using MatOS.Web.Auth
@inject JsonConfigService Config
@inject DesktopLayoutService DesktopSvc
@{
    var desktop = Config.Get<DesktopConfig>("desktop");
    var system = Config.Get<SystemConfig>("system");
    var uid = User.GetUserId()?.ToString() ?? "0";
    var prefs = DesktopSvc.GetPrefs(uid);
    var wallpaper = Wallpapers.Normalize(string.IsNullOrWhiteSpace(prefs.Wallpaper) ? desktop.Wallpaper : prefs.Wallpaper);
    var wpStyle = prefs.WallpaperStyle is "fill" or "fit" or "center" or "tile" ? prefs.WallpaperStyle : "fill";
    var effTheme = string.IsNullOrWhiteSpace(prefs.Theme) ? desktop.Theme : prefs.Theme;
    var theme = (effTheme ?? "auto").ToLowerInvariant() switch { "light" => "light", "dark" => "dark", _ => "auto" };
    var osStyle = prefs.OsStyle == "macos" ? "macos" : "windows";
    var accent = prefs.AccentColor;
    var name = User.Identity?.Name ?? "user";
    var role = User.IsAdmin() ? "Administrator" : "User";
    var initial = string.IsNullOrEmpty(name) ? "?" : name[..1].ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="en" data-theme="@theme" data-os="@osStyle">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@(ViewData["Title"] ?? system.InstanceName)</title>
    <meta name="theme-color" content="#0b0f1a" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <link rel="manifest" href="~/site.webmanifest" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/desktop.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/window.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dialog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/macos.css" asp-append-version="true" />
    @if (!string.IsNullOrWhiteSpace(accent))
    {
        <style>:root{--accent:@accent;--accent-2:@accent;--accent-grad:@accent;--mat-accent:@accent;--mat-accent-2:@accent;}</style>
    }
</head>
@{
    var bodyClasses = string.Join(" ", new[] { prefs.TaskbarPosition == "top" ? "tb-top" : null, prefs.TaskbarAlign == "center" ? "tb-center" : null, !prefs.TaskbarLabels ? "tb-no-labels" : null }.Where(c => c != null));
}
<body class="@bodyClasses">
    <div id="mat-wallpaper" class="wp-@wallpaper wps-@wpStyle"></div>

    <main id="mat-desktop">
        @RenderBody()
    </main>

    <div id="mat-windows"></div>

    <!-- Start menu (opens from the Start button) -->
    <div id="mat-startmenu" hidden>
        <div class="sm-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input id="mat-start-search" type="search" placeholder="Search apps…" autocomplete="off" aria-label="Search apps" />
        </div>
        <div class="sm-body">
            <div class="sm-section-title" id="sm-system-title">System</div>
            <div class="sm-list" id="sm-system"></div>
            <div class="sm-section-title" id="sm-apps-title">Apps</div>
            <div class="sm-list" id="sm-apps"></div>
            <div class="sm-section-title" id="sm-containers-title">Containers</div>
            <div class="sm-list" id="sm-containers"></div>
            <div class="sm-empty" id="sm-empty" hidden>No matching apps.</div>
        </div>
        <div class="sm-footer">
            <div class="sm-user" data-open-url="/apps/account" data-open-title="My Account" data-open-key="account" style="cursor:pointer" title="My account">
                <span class="mat-avatar">@initial</span>
                <div><div class="nm">@name</div><div class="rl">@role</div></div>
            </div>
            <div class="sm-foot-actions">
                <button class="sm-foot-btn" data-open-url="/apps/settings" data-open-title="Settings" data-open-key="settings" title="Settings" aria-label="Settings">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-2.9 1.2V21a2 2 0 0 1-4 0v-.1A1.7 1.7 0 0 0 6.6 19l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A1.7 1.7 0 0 0 3 13.4H3a2 2 0 0 1 0-4h.1A1.7 1.7 0 0 0 4.6 6.6L4.5 6.5a2 2 0 1 1 2.8-2.8l.1.1A1.7 1.7 0 0 0 10 3V3a2 2 0 0 1 4 0v.1a1.7 1.7 0 0 0 2.9 1.2l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9z"/></svg>
                </button>
                <form method="post" action="/logout">
                    <button class="sm-foot-btn" type="submit" title="Sign out" aria-label="Sign out">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Notification center (opens from the bell in the tray) -->
    <div id="mat-notify" hidden>
        <div class="mat-notify-head">
            <strong>Notifications</strong>
            <span style="flex:1"></span>
            <button class="mat-notify-btn" id="mat-notify-mark-all" title="Mark all as read">✓</button>
            <button class="mat-notify-btn" id="mat-notify-clear" title="Clear all">🗑</button>
        </div>
        <div class="mat-notify-list" id="mat-notify-list"></div>
    </div>

    <!-- Toast layer for transient notifications -->
    <div id="mat-toasts"></div>

    <!-- Taskbar -->
    <footer id="mat-taskbar">
        <!-- Only occupies a grid column in "center" alignment mode, to balance #mat-tray on the
             other side so the cluster below lands in the true middle (Windows-11 style). -->
        <div class="tb-spacer" aria-hidden="true"></div>
        <div id="mat-tb-cluster">
            <button id="mat-start-btn" title="Start" aria-label="Start menu" aria-haspopup="true">
                <img src="~/favicon.svg" alt="Start" />
            </button>
            <div id="mat-tb-search" title="Search apps">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <input id="mat-tb-search-input" type="search" placeholder="Search" autocomplete="off" aria-label="Search apps" />
            </div>
            <div id="mat-tasks-pinned"></div>
            <div id="mat-tasks"></div>
        </div>
        <div id="mat-tray">
            <div id="mat-tray-widgets"></div>
            <button id="mat-bell" title="Notifications" aria-label="Notifications" aria-haspopup="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
                <span class="mat-bell-badge" id="mat-bell-badge" hidden>0</span>
            </button>
            <div class="mat-user">
                <button class="mat-user-btn" id="mat-user-btn" aria-haspopup="true" title="@name">
                    <span class="mat-avatar">@initial</span>
                </button>
                <div class="mat-user-menu" id="mat-user-menu" role="menu">
                    <div class="who">
                        <div class="name">@name</div>
                        <div class="role">@role</div>
                    </div>
                    <button class="mat-menu-item" role="menuitem"
                            data-open-url="/apps/account" data-open-title="My Account" data-open-key="account">My account</button>
                    <button class="mat-menu-item" role="menuitem"
                            data-open-url="/apps/settings" data-open-title="Settings" data-open-key="settings">Settings</button>
                    <button class="mat-menu-item" role="menuitem"
                            data-open-url="/apps/task-manager" data-open-title="Task Manager" data-open-key="task-manager">Task Manager</button>
                    <form method="post" action="/logout">
                        <button class="mat-menu-item" type="submit" role="menuitem">Sign out</button>
                    </form>
                </div>
            </div>
            <div class="mat-clock" id="mat-clock"></div>
            <button id="mat-show-desktop" title="Show desktop" aria-label="Show desktop"></button>
        </div>
    </footer>

    <script>
      // Resolve auto->light/dark from the OS preference, and update whenever it changes.
      (function(){ const html=document.documentElement; const stored=html.getAttribute("data-theme")||"auto";
        const apply=()=>{ if(html.getAttribute("data-theme-user")==="auto" || (!html.getAttribute("data-theme-user") && stored==="auto")){
          const dark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          html.setAttribute("data-theme", dark?"dark":"light"); }};
        if(stored==="auto"){ html.setAttribute("data-theme-user","auto"); apply();
          if(window.matchMedia) window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change",apply); }
        else { html.setAttribute("data-theme-user", stored); }
      })();
    </script>
    <script src="~/js/dialog.js" asp-append-version="true"></script>
    <script src="~/js/window-manager.js" asp-append-version="true"></script>
    <script src="~/js/desktop.js" asp-append-version="true"></script>
    <script src="~/js/dock.js" asp-append-version="true"></script>
</body>
</html>

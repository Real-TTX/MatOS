# Build output
**/bin/
**/obj/
[Bb]in/
[Oo]bj/

# IDE / editor
.vs/
.idea/
.vscode/
*.user

# Local runtime data (JSON configs, keys, backups) — anchored to the exact dev-mode
# data dir (contentRoot/data, see MatosPaths.cs) so this can never again shadow a
# source folder that merely shares the name at a different path or case (this is
# exactly what silently dropped src/MatOS.Web/Data/Entities.cs from every commit:
# an unanchored `data/` pattern + Windows git's case-insensitive matching hid the
# whole folder without a single local warning).
/src/MatOS.Web/data/
/src/MatOS.Web/appdata/
*.db

# OS junk
Thumbs.db
.DS_Store

# ad-hoc scratch files created by test scripts (should live in scratchpad, not the repo)
/l.html
/lay*.json
/routes*.json
/set.html
/t.txt

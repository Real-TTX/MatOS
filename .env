# matOS stack configuration.
# MATOS_VERSION is normally set by scripts/deploy.ps1 (see scripts/version.ps1).
MATOS_VERSION=local

# Version/tag of the sibling Matcad reverse-proxy stack images (ghcr.io/real-ttx/matcad*).
MATCAD_VERSION=latest

# Override the Matcad image (e.g. a locally-built matcad:local). Defaults to the GHCR image above.
# MATCAD_IMAGE=matcad:local

# Shared secret matOS uses to call Matcad's REST API (the Proxy app). Must be identical on both
# containers; Matcad's API is disabled until this is set. Change this for any real deployment.
MATCAD_API_KEY=matos-dev-local-key-change-me

# Base domain matOS uses to build per-app subdomains for the Caddy/Matcad proxy.
# *.localhost resolves to loopback in modern browsers, so this works locally with no DNS.
BASE_DOMAIN=apps.localhost
